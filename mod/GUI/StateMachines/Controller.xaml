<ls:StateMachine xmlns:ls="clr-namespace:ls;assembly=Code"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ls:StateMachine.States>
        <!-- BG3's own loading screen for a move, which is no load to BG3 (MoveLoading.lua fires the events).
             The widget is BG3's, as its state "Loading" names it; the attributes are its state "Movie"'s, so
             the HUD below stays alive and hidden and comes back as it was. -->
        <ls:State Name = "GameRoot" ModType="Extend">
            <ls:State.Events>
                <ls:StateEvent Name = "OpenWowMoveLoading">
                    <ls:StateEvent.Actions>
                        <ls:PushState Name="WowMoveLoading"/>
                    </ls:StateEvent.Actions>
                </ls:StateEvent>
            </ls:State.Events>
        </ls:State>

        <ls:State Name = "WowMoveLoading" Layout = "Common" Owner = "Player" DisableStatesBelow = "True" HideStatesBelow = "True" IsModal="True" IsModdable="False">
            <ls:State.Widgets>
                <ls:StateWidget Filename="LoadingScreen.xaml" Layer="Default" BlockedLoading="True"/>
            </ls:State.Widgets>
            <ls:State.Events>
                <ls:StateEvent Name = "OpenWowMoveLoading"/>
                <ls:StateEvent Name = "CloseWowMoveLoading">
                    <ls:StateEvent.Actions>
                        <ls:RemoveState/>
                    </ls:StateEvent.Actions>
                </ls:StateEvent>
            </ls:State.Events>
        </ls:State>
    </ls:StateMachine.States>
</ls:StateMachine>
