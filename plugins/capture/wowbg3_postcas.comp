// WOW-BG3 capture layer (wdpostcas, wowbg3_fxbg.inc.c): after BG3's CAS sharpening, its input over its output where the
// pixel is pure WoW ground (patch46: wdbloom's mask from the composite, as wdpost). Everything else keeps BG3's sharpening.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(r32f, set = 0, binding = 0) uniform readonly image2D nob;
layout(set = 0, binding = 5) uniform sampler2D cin;                     // CAS's input (the display transform's output)
layout(rgb10_a2, set = 0, binding = 6) uniform writeonly image2D cout;  // CAS's output
void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy), sz = imageSize(nob);
    if (q.x >= sz.x || q.y >= sz.y) return;
    if (!(imageLoad(nob, q).r > 0.5)) return;
    imageStore(cout, q, texelFetch(cin, q, 0));
}
