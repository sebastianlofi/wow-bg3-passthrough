// WOW-BG3 capture layer (wdpostcas, wowbg3_fxbg.inc.c): after BG3's CAS sharpening, where the pixel is pure WoW ground
// (patch46: wdbloom's mask from the composite, as wdpost) and BG3 drew nothing over it after the feed (the mask says 2,
// wowbg3_post.frag), WoW's own displayed colour of that pixel over CAS's output.
// BG3's display transform takes a bright saturated colour towards white, so no value fed before it comes out as WoW's
// quest mark yellow or a lit window; here, after it, the pixel is WoW's as WoW drew it. Without a colour from the feed
// for the pixel: CAS's input (no sharpening). Everything else keeps BG3's picture.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(r32f, set = 0, binding = 0) uniform readonly image2D nob;
layout(set = 0, binding = 1) uniform sampler2D wdsp;                    // WoW's own colour per pixel (the feed), a 1 where written
layout(set = 0, binding = 3) uniform sampler2D late;                    // BG3's late addition over a pure pixel: its share of BG3's pixel a channel, a 1 (wowbg3_post.frag)
layout(set = 0, binding = 5) uniform sampler2D cin;                     // CAS's input (the display transform's output)
layout(rgb10_a2, set = 0, binding = 6) uniform image2D cout;  // CAS's output (read for BG3's own pixels under WoW's fog)
layout(push_constant) uniform PC { uint dbg; } pc;  // word wdpcdbg: the mask's classes as colours
void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy), sz = imageSize(nob);
    if (q.x >= sz.x || q.y >= sz.y) return;
    float n = imageLoad(nob, q).r;
    vec4 w = texelFetch(wdsp, q, 0);
    if (pc.dbg != 0u) {  // pure and untouched: WoW's colour; pure at the composite only: blue; under an addition: red its share, green its gain
        vec4 l = texelFetch(late, q, 0);
        if (n > 1.5 && l.a > 0.5) imageStore(cout, q, vec4(1.0, 0.0, 1.0, 1.0));
        else if (n > 1.5) imageStore(cout, q, vec4(w.rgb, 1.0));
        else if (n > 0.5) imageStore(cout, q, vec4(0.0, 0.0, 1.0, 1.0));
        else if (n < 0.0) { float v = -n - 1.0; imageStore(cout, q, vec4(0.15 + 0.85 * floor(v) / 255.0, fract(v), 0.0, 1.0)); }
        return;
    }
    // WoW's ground under something of BG3's (wowbg3_blmask.frag: -(1 + t * 255 + g)): WoW's own colour, lightened by g,
    // for WoW's share, BG3's picture for BG3's share t. Nearly all BG3's: its sharpened output stays.
    if (n < 0.0) {
        float v = -n - 1.0, t = floor(v) / 255.0, g = fract(v);
        if (w.a > 0.5 && t < 0.98) imageStore(cout, q, vec4(mix(min(w.rgb * (1.0 + g), vec3(1.0)), texelFetch(cin, q, 0).rgb, t), 1.0));
        return;
    }
    if (!(n > 0.5)) {
        // BG3's own pixel. At a figure's edge BG3's TAA has blended the figure with BG3's picture of the ground behind
        // it, which is not the ground shown beside it (WoW's own colour, darker at night; BG3's is washed near white
        // during a bright cast): a light ring around every figure. Where a neighbour is pure WoW ground, the pixel's
        // share of ground is found from the three colours BG3 displayed (this pixel, the ground beside it, the figure
        // two pixels further in) and BG3's ground in it is changed for WoW's.
        vec3 o = imageLoad(cout, q).rgb;
        const ivec2 D[4] = ivec2[4](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
        vec3 pg = vec3(0.0), wg = vec3(0.0); vec2 dir = vec2(0.0); float k = 0.0;
        for (int i = 0; i < 4; i++) {
            ivec2 r = clamp(q + D[i], ivec2(0), sz - 1);
            vec4 wr = texelFetch(wdsp, r, 0);
            if (imageLoad(nob, r).r > 1.5 && wr.a > 0.5 && wr.a < 1.5) { pg += texelFetch(cin, r, 0).rgb; wg += wr.rgb; dir += vec2(D[i]); k += 1.0; }
        }
        if (k > 0.5 && k < 3.5) {
            pg /= k; wg /= k;
            ivec2 in2 = clamp(q - ivec2(round(normalize(dir + vec2(1e-4)) * 2.0)), ivec2(0), sz - 1);
            if (!(imageLoad(nob, in2).r > 0.5) && !(imageLoad(nob, in2).r < 0.0)) {
                vec3 fg = texelFetch(cin, in2, 0).rgb - pg, me = texelFetch(cin, q, 0).rgb - pg;
                float ff = dot(fg, fg);
                if (ff > 0.0004) o = clamp(o + (1.0 - clamp(dot(me, fg) / ff, 0.0, 1.0)) * (wg - pg), vec3(0.0), vec3(1.0));
            }
            imageStore(cout, q, vec4(o, 1.0));
        }
        // WoW's fog for it (the feed: the fog's colour, alpha 2 + WoW's factor): blended as WoW blends, in displayed colours.
        if (w.a >= 2.0 && w.a < 2.999) imageStore(cout, q, vec4(mix(w.rgb, o, w.a - 2.0), 1.0));
        return;
    }
    vec4 c = texelFetch(cin, q, 0);
    if (!(n > 1.5 && w.a > 0.5)) { imageStore(cout, q, c); return; }
    // WoW's own colour, and over it what BG3 drew there after its composite: a glow adds its share of BG3's displayed
    // pixel, smoke takes its part of WoW's colour away.
    vec4 l = texelFetch(late, q, 0);
    imageStore(cout, q, vec4(l.a > 0.5 ? clamp(mix(w.rgb * (1.0 + l.rgb), w.rgb + c.rgb * l.rgb, step(vec3(0.0), l.rgb)), vec3(0.0), vec3(1.0)) : w.rgb, 1.0));
}
