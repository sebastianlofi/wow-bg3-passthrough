// WOW-BG3 capture layer (wowbg3_fxbg.inc.c): what one of BG3's passes changed at a WoW pixel, joined to what BG3 drew there
// before (late: BG3's share of the pixel a channel, a 1). Two uses (push constant `mode`):
//   0: after one of BG3's overlay passes (between its TAA and its display transform, there only while something is aimed or
//      highlighted: an ability's area on the ground, an outline), at a pixel wdpost left WoW's own (wowbg3_post.frag).
//   1: after each of BG3's effects passes on the composite's image (late_pass_end), at a pixel that was WoW's ground at the
//      composite (wowbg3_blmask.frag: 1 pure, 0.3 with something drawn before the composite). BG3 draws its effects in
//      several such passes a frame (nine passes on scene targets, three on the composite's image, in a slot frame of
//      2026-11-12); each pass is folded in as it ends. Only the last one used to be kept (one copy before and after),
//      and what an earlier pass drew was lost: the attack preview's figure, drawn in the pass before the last, came out as
//      WoW's ground (a play report: "the white character outline showing where the character will end up doesn't show
//      unless I hold shift").
// The pass reads the scene and writes it again: where the two differ, its share of the written pixel a channel joins `late`,
// shares multiplied as the passes follow each other. wdpostcas adds that share of BG3's displayed pixel to WoW's own colour.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(r32f, set = 0, binding = 0) uniform readonly image2D nob;   // the pixel's class (wowbg3_blmask.frag, wowbg3_post.frag)
layout(set = 0, binding = 1) uniform sampler2D before;             // the scene the pass read
layout(set = 0, binding = 2) uniform sampler2D after;              // and what it wrote
layout(rgba16f, set = 0, binding = 3) uniform image2D late;
layout(push_constant) uniform PC { uint mode; } pc;
void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy), sz = imageSize(nob);
    if (q.x >= sz.x || q.y >= sz.y) return;
    float n = imageLoad(nob, q).r;
    // WoW's own colour shows here, alone or under a decal (n below 0, wowbg3_blmask.frag). Under a decal these passes used
    // to be skipped, and what BG3 drew over a surface (a spell's particles, an ability's preview) showed only by the
    // decal's share of the pixel: behind the surface, and over water not at all (a play report).
    if (pc.mode == 1u ? !(n > 0.25 || n < 0.0) : !(n > 1.5 || (n > 0.35 && n < 0.45) || n < 0.0)) return;
    vec3 b = texelFetch(before, q, 0).rgb, a = texelFetch(after, q, 0).rgb;
    if (!any(greaterThan(abs(a - b), max(a, b) * 0.02 + vec3(1e-6)))) return;
    // The added light's share (0..1), or minus the part of the light taken away (-1..0). Not a difference of displayed
    // colours: BG3's picture of the ground can be far brighter than WoW's (its exposure during a bright cast), and taking
    // that much off WoW's night ground left it black.
    vec3 l2 = mix(-(1.0 - a / max(b, vec3(1e-6))), (a - b) / max(a, vec3(1e-6)), step(b, a));
    vec4 l = imageLoad(late, q);
    vec3 l1 = l.a > 0.5 ? l.rgb : vec3(0.0);
    // The two in a row: what both let through, and the light either added; one number a channel holds the light when
    // there is any, else the loss.
    vec3 thru = (1.0 + min(l1, vec3(0.0))) * (1.0 + min(l2, vec3(0.0)));
    vec3 add = 1.0 - (1.0 - max(l1, vec3(0.0))) * (1.0 - max(l2, vec3(0.0)));
    imageStore(late, q, vec4(mix(thru - 1.0, add, step(vec3(0.005), add)), 1.0));
}
