  "picks": [
    {"w": ["Backstab", "Sinister Strike"], "star": true, "tiers": [[1, "Target_SneakAttack", {"weapon": true, "dmg": false}]], "why": "BG3's own rule: only with advantage or an ally beside the target. A lone thief can't, a pack's thief can, as a WoW rogue needs your back."},
    {"w": ["Net", "Hooked Net", "Battle Net", "Electrified Net"], "star": true, "when": {"word": "murloc"}, "tiers": [[1, "Projectile_Net_Sahuagin", {"every": "fight"}]], "why": "Murlocs throw the net of BG3's own fish-folk, the Sahuagin."},
    {"w": ["Net", "Hooked Net", "Battle Net", "Electrified Net"], "tiers": [[1, "Projectile_ThrowNet", {"every": "fight"}]], "why": "A net is a net: Restrained, and you cut yourself out."},
    {"w": ["Polymorph", "Polymorph: Sheep", "Greater Polymorph"], "star": true, "tiers": [[18, "Target_Polymorph", {"every": "fight", "doubt": "the sheep: what the WoW model does while BG3 says sheep"}]], "why": "BG3's Polymorph turns you into a sheep too. Same spell, same sheep."},
    {"w": ["Hex", "Polymorph: Chicken"], "star": true, "tiers": [[18, "Target_Polymorph", {"every": "fight", "doubt": "the sheep: what the WoW model does while BG3 says sheep"}]], "why": "A witch doctor's Hex was a frog in WoW, BG3 has only the sheep."},
    {"w": ["Sleep", "Crystalline Slumber", "Druid's Slumber", "Enchanting Lullaby"], "star": true, "tiers": [[10, "Target_Sleep", {"every": "fight"}]], "why": "BG3's Sleep only takes targets under 24 HP: the fairness rule comes built in."},
    {"w": ["Frost Armor", "Ice Armor"], "star": true, "tiers": [[1, "Shout_ArmorOfAgathys", {"every": "fight"}]], "why": "A mage's Frost Armor chills whoever hits it; Armour of Agathys is the BG3 spell that does exactly that."},
    {"w": ["Demon Armor", "Demon Skin"], "star": true, "tiers": [[1, "Shout_MageArmor_ArmorOfShadows", {"every": "fight"}]], "why": "A warlock's armour spell is the BG3 warlock's Armour of Shadows."},
    {"w": ["Shadow Bolt", "Void Bolt"], "star": true, "tiers": [[1, "Projectile_EldritchBlast", {"dmg": true, "type": "Necrotic"}]], "why": "Every WoW warlock spams Shadow Bolt; every BG3 warlock spams Eldritch Blast. Necrotic instead of Force to keep the school."},
    {"w": ["Frostbolt", "Weak Frostbolt", "Frost Shock"], "star": true, "tiers": [[1, "Projectile_RayOfFrost", {"dmg": true}]], "why": "Cold damage and a slow, in both games."},
    {"w": ["Arcane Missiles", "Arcane Bolt", "Charged Arcane Bolt"], "star": true, "tiers": [[1, "Projectile_MagicMissile", {"dmg": true}]], "why": "Missiles that always land are missiles that always land."},
    {"w": ["Blink"], "star": true, "tiers": [[1, "Target_MistyStep_Free", {"every": "recharge"}]], "why": "Blink out of melee is Misty Step, and BG3's AI already uses it to escape."},
    {"w": ["Fireball", "Pyroblast"], "tiers": [[1, "Projectile_FireBolt", {"dmg": true}], [24, "Projectile_Fireball", {"dmg": true, "every": "fight"}]], "why": "A low-level Fireball is a bolt. From level 24 the mage throws the real one, once a fight: the moment you learn to spread out."},
    {"w": ["Scorch", "Fire Blast", "Flamespit"], "tiers": [[1, "Projectile_FireBolt", {"dmg": true}], [14, "Projectile_ScorchingRay", {"dmg": true, "every": "recharge"}]], "why": "Quick fire: a bolt, then rays."},
    {"w": ["Immolate", "Flame Shock", "Holy Fire"], "star": true, "tiers": [[1, "Projectile_FireBolt", {"dmg": true, "rider": ["BURNING", 2, null]}]], "why": "A hit that leaves you on fire: Fire Bolt plus BG3's Burning. BG3's water douses it."},
    {"w": ["Flamestrike"], "star": true, "tiers": [[16, "Target_FlameStrike", {"dmg": true, "every": "fight"}]], "why": "Same name, same pillar of fire, fire and radiant."},
    {"w": ["Rain of Fire"], "tiers": [[16, "Target_FlameStrike", {"dmg": true, "every": "fight"}]], "why": "BG3 has no burning rain; the pillar is the nearest area of fire."},
    {"w": ["Blizzard"], "star": true, "tiers": [[16, "Target_SleetStorm", {"every": "fight"}]], "why": "An ice storm you must walk out of, on slippery ground. Ice on the floor is BG3's own."},
    {"w": ["Cone of Cold"], "star": true, "tiers": [[20, "Zone_ConeOfCold", {"dmg": true, "every": "fight"}]], "why": "Same spell, same cone."},
    {"w": ["Frost Nova"], "star": true, "tiers": [[8, "Shout_ArmsOfHadar", {"every": "fight", "rider": ["ENSNARED", 1, null], "type": "Cold", "dmg": true, "doubt": "built from Arms of Hadar's ring: looks like shadow tendrils, not ice"}]], "why": "Everyone near the mage is stuck to the floor. BG3 has no frost ring, so this is its reach-all-around ring with cold damage."},
    {"w": ["Slow"], "star": true, "tiers": [[14, "Target_Slow", {"every": "fight"}]], "why": "Same name, and in BG3 it also takes an action: a slowed fighter really does less."},
    {"w": ["Counterspell"], "star": true, "tiers": [[14, "Target_Counterspell", {"every": "fight", "doubt": "a reaction: BG3 asks during your cast; needs a harness look"}]], "why": "The mage stops your spell in BG3 too."},
    {"w": ["Fire Ward", "Quick Flame Ward"], "tiers": [[1, "Target_ProtectionFromEnergy_Fire", {"every": "fight"}]], "why": "Fire resistance for the fight."},
    {"w": ["Frost Ward", "Quick Frost Ward"], "tiers": [[1, "Target_ProtectionFromEnergy_Cold", {"every": "fight"}]], "why": "Cold resistance for the fight."},
    {"w": ["Fire Shield", "Fire Shield II", "Fire Shield III", "Fire Shield IV", "Aura of Flames", "Inferno Shell"], "star": true, "tiers": [[1, "Shout_ArmorOfAgathys", {"every": "fight", "type": "Fire"}], [16, "Shout_FireShield_Warm", {"every": "fight"}]], "why": "Hit it and you burn. From 16 BG3's real Fire Shield, same name."},
    {"w": ["Lightning Shield", "Lightning Barrier", "Lightning Hide"], "tiers": [[1, "Shout_ArmorOfAgathys", {"every": "fight", "type": "Lightning"}]], "why": "Hit it and you are shocked: the retaliation of Agathys in lightning."},
    {"w": ["Thorns", "Thorns Aura", "Razor Mane", "Coat of Thistlefur", "Spikes"], "tiers": [[1, "Shout_ArmorOfAgathys", {"every": "fight", "type": "Piercing"}]], "why": "Hit it and you bleed: the retaliation of Agathys in thorns."},

    {"w": ["Lightning Bolt", "Lizard Bolt"], "star": true, "tiers": [[1, "Projectile_WitchBolt", {"dmg": true}], [18, "Zone_LightningBolt", {"dmg": true, "every": "recharge"}]], "why": "A shaman's bolt that keeps arcing: Witch Bolt. From 18 BG3's own Lightning Bolt, a line: stand apart."},
    {"w": ["Chain Lightning", "Chained Bolt", "Chain Bolt", "Forked Lightning"], "star": true, "tiers": [[14, "Projectile_ChainLightning", {"dmg": true, "every": "recharge"}]], "why": "Same name, same jumps between your party."},
    {"w": ["Earth Shock"], "star": true, "tiers": [[1, "Target_ShockingGrasp", {"dmg": true, "type": "Thunder"}]], "why": "WoW's interrupt. Shocking Grasp takes your reaction, the nearest thing BG3 has."},
    {"w": ["Healing Wave", "Lesser Healing Wave", "Healing Touch", "Holy Light", "Regrowth", "Heal", "Lesser Heal", "Great Heal", "Greater Heal", "Dark Mending"], "tiers": [[1, "Target_CureWounds", {"every": "recharge"}]], "why": "The plain heal: an action, a touch; the priest must walk up to whoever it heals. Kill the healer first works."},
    {"w": ["Flash Heal", "Renew", "Rejuvenation", "Lesser Heal", "Wild Regeneration"], "star": true, "tiers": [[1, "Target_HealingWord", {"every": "recharge"}]], "why": "The fast heal: a bonus action at range, so the healer also attacks that turn, like an instant in WoW."},
    {"w": ["Chain Heal", "Prayer of Healing", "Mass Healing"], "star": true, "tiers": [[8, "Shout_PrayerOfHealing", {"every": "fight"}]], "why": "Heals the whole pack once."},
