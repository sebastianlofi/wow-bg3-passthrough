+    // pos <enc> <guid> <x> <y> <z>: a held mob stands where BG3's fight put it
+    // (its model already does on the owner's client), facing the owner, so its
+    // corpse lies there and the owner can loot it ("corpse too
+    // far away"). Only a living member of the owner's running encounter, on the
+    // owner's map, within PLACE_RANGE of the owner. Applying the same line again
+    // changes nothing.
+    void Place(Player* p, std::string const& enc, std::string const& guidText,
+        std::string const& xText, std::string const& yText, std::string const& zText, Out& out)
+    {
+        ObjectGuid g;
+        if (!ParseGuid(guidText, g))
+            return out.Add("WOWBG3 pos " + enc + " " + guidText + " refused badguid");
+        std::string const head = "WOWBG3 pos " + enc + " " + Hex(g) + " ";
+        std::string const* texts[3] = { &xText, &yText, &zText };
+        float xyz[3] = { 0.0f, 0.0f, 0.0f };
+        for (int i = 0; i < 3; ++i)
+        {
+            char* end = nullptr;
+            xyz[i] = strtof(texts[i]->c_str(), &end);
+            if (texts[i]->empty() || !end || *end || !std::isfinite(xyz[i]))
+                return out.Add(head + "refused badpos");
+        }
+        float const x = xyz[0], y = xyz[1], z = xyz[2];
+        if (!MaNGOS::IsValidMapCoord(x, y, z))
+            return out.Add(head + "refused badpos");
+
+        ObjectGuid const pg = p->GetObjectGuid();
+        uint32 map = 0, instance = 0;
+        {
+            WriteLock lock(g_lock);
+            Fighter& f = g_fighters[pg];
+            if (f.IsClosed(enc))
+                return out.Add(head + "refused closed");
+            if (!f.active || f.active->id != enc)
+                return out.Add(head + "refused unknown");
+            Mob* m = f.active->Find(g);
+            if (!m)
+                return out.Add(head + "refused notmember");
+            f.active->last = WorldTimer::getMSTime();
+            if (m->killed)
+                return out.Add(head + "dead");
+            map = f.active->map;
+            instance = f.active->instance;
+        }
+
+        if (char const* why = CheckPlayer(p))
+            return out.Add(head + "refused " + why);
+        Creature* c = FindMob(map, instance, g, p);
+        if (!c || !c->IsAlive())
+            return out.Add(head + "gone");
+        if (p->GetMapId() != map || p->GetInstanceId() != instance ||
+            p->GetDistance(x, y, z, SizeFactor::None) > PLACE_RANGE)
+            return out.Add(head + "refused far");
+        if (c->GetDistance(x, y, z, SizeFactor::None) < 0.5f)
+            return out.Add(head + "ok same");
+        float const facing = std::atan2(p->GetPositionY() - y, p->GetPositionX() - x);
+        c->NearTeleportTo(x, y, z, facing < 0.0f ? facing + 2.0f * float(M_PI) : facing);
+        out.Add(head + "ok");
+    }
+
