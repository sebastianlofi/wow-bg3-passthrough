+    // faction (0009, WOW-BG3 tele.sh to the other side's towns): the player counts as the
+    // given side until logout or `faction own`: its faction template becomes that side's race's
+    // (Orc for horde, Human for alliance) and every reputation faction is forced to the rank that
+    // race starts with (forced reactions, as SPELL_AURA_FORCE_REACTION does), so guards and towns
+    // treat the player as that side. Team, quests and saved reputation are unchanged.
+    std::mutex g_factionLock;
+    std::unordered_map<uint64, std::vector<uint32>> g_factionForced;
+
+    void Faction(Player* p, std::string const& side, Out& out)
+    {
+        uint8 const race = side == "horde" ? uint8(RACE_ORC) : side == "alliance" ? uint8(RACE_HUMAN) : p->GetRace();
+        ReputationMgr& rep = p->GetReputationMgr();
+        std::lock_guard<std::mutex> lock(g_factionLock);
+        std::vector<uint32>& mine = g_factionForced[p->GetObjectGuid().GetRawValue()];
+        for (uint32 id : mine)
+            rep.ApplyForceReaction(id, REP_NEUTRAL, false);
+        mine.clear();
+        if (side != "own")
+        {
+            uint32 const raceMask = 1u << (race - 1);
+            uint32 const classMask = p->GetClassMask();
+            for (auto const& kv : sObjectMgr.GetFactionMap())
+            {
+                FactionEntry const* f = &kv.second;
+                if (f->reputationListID < 0)
+                    continue;
+                int const idx = f->GetIndexFitTo(raceMask, classMask);
+                int32 const base = idx >= 0 ? f->BaseRepValue[idx] : 0;
+                rep.ApplyForceReaction(f->ID, ReputationMgr::ReputationToRank(base), true);
+                mine.push_back(f->ID);
+            }
+        }
+        p->SetFactionTemplateId(Player::GetFactionForRace(race));
+        rep.SendForceReactions();
+        out.Add("WOWBG3 faction " + side + " " + std::to_string(p->GetFactionTemplateId()) + " " + std::to_string(mine.size()));
+    }
