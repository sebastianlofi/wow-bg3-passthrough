+bool SuppressesSightAggro(Creature const* creature, Unit const* moving)
+{
+    if (!g_sightCount.load(std::memory_order_relaxed) || !creature || !moving || creature->IsInCombat())
+        return false;
+    Player const* p = moving->GetCharmerOrOwnerPlayerOrPlayerItself();
+    if (!p || !p->IsAlive())
+        return false;
+    {
+        ReadLock lock(g_lock);
+        auto it = g_fighters.find(p->GetObjectGuid());
+        if (it == g_fighters.end() || !it->second.sight)
+            return false;
+    }
+    return creature->IsHostileTo(moving);
+}
