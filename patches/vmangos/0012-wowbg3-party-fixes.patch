+    // give MEMBER ITEMGUID TOMEMBER [COUNT]: an item from one party member's bags or body to
+    // another's bags (BG3's one party inventory; dragging onto another member). Whole stack, or COUNT
+    // of a stack (a new stack for the receiver). Both are saved at once, as a trade does.
+    void Give(Player* owner, Player* m, std::string const& member, std::vector<std::string> const& a, Out& out)
+    {
+        std::string const head = "WOWBG3 give " + member + " ";
+        ObjectGuid g;
+        uint32 count = 0;
+        if (!ParseGuid(a[3], g) || (a.size() == 6 && (!ParseUInt(a[5], count, 10000) || count == 0)))
+            return out.Add(head + "refused usage");
+        char const* why = nullptr;
+        Player* to = FindMember(owner, a[4], why);
+        if (!to)
+            return out.Add(head + "refused " + std::string(why) + " " + a[4]);
+        if (to == m)
+            return out.Add(head + "refused same");
+        Item* it = FindCarried(m, g);
+        if (!it)
+            return out.Add(head + "refused noitem");
+        if (it->IsBag() && !static_cast<Bag*>(it)->IsEmpty())
+            return out.Add(head + "refused notempty");
+        if (it->IsEquipped())
+        {
+            InventoryResult r = m->CanUnequipItem(it->GetPos(), false);
+            if (r != EQUIP_ERR_OK)
+                return out.Add(head + "refused inv " + std::to_string(uint32(r)));
+        }
+        auto const beforeFrom = Snapshot(m);
+        auto const beforeTo = Snapshot(to);
+        uint32 const moneyFrom = m->GetMoney(), moneyTo = to->GetMoney();
+        ItemPosCountVec dest;
+        if (count && count < it->GetCount())
+        {
+            InventoryResult r = to->CanStoreNewItem(NULL_BAG, NULL_SLOT, dest, it->GetEntry(), count);
+            if (r != EQUIP_ERR_OK)
+                return out.Add(head + "refused inv " + std::to_string(uint32(r)));
+            Item* made = to->StoreNewItem(dest, it->GetEntry(), true, it->GetItemRandomPropertyId());
+            if (!made)
+                return out.Add(head + "failed");
+            m->DestroyItemCount(it, count, true);
+        }
+        else
+        {
+            uint8 bagSlot = 0;
+            InventoryResult r = to->CanStoreItem(NULL_BAG, NULL_SLOT, dest, it, bagSlot, false);
+            if (r != EQUIP_ERR_OK)
+                return out.Add(head + "refused inv " + std::to_string(uint32(r)));
+            m->MoveItemFromInventory(it->GetBagSlot(), it->GetSlot(), true);
+            to->MoveItemToInventory(dest, it, true, true);
+        }
+        m->SaveInventoryAndGoldToDB();
+        to->SaveInventoryAndGoldToDB();
+        std::vector<std::string> lines;
+        Out d{ lines };
+        Diff(member, m, beforeFrom, moneyFrom, d);
+        Diff(a[4], to, beforeTo, moneyTo, d);
+        out.Add(head + "ok " + std::to_string(lines.size()));
+        for (std::string const& l : lines)
+            out.Add(l);
+    }
