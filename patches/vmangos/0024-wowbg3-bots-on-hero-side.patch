+void OnPartyBotLogin(Player* bot)
+{
+    if (!bot || !IsPartyBot(bot->GetSession()))
+        return;
+    {
+        std::lock_guard<std::mutex> lock(g_sideLock);       // a new Player: nothing borrowed yet
+        g_side.erase(bot->GetObjectGuid().GetRawValue());
+    }
+    ObjectGuid const og = BotOwner(bot);
