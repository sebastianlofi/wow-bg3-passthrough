+    // ---- the party's side (0024) ----
+    //
+    // A party is one WoW side, its owner's (seen in play: Horde guards attacked an orc hero's party
+    // for its Human Shadowheart; "keep race, take the faction of the main character"). A bot of another side
+    // keeps its race, class and quests and, while it is the owner's bot, borrows the owner's side: vmangos'
+    // own Player::SetFactionForRace with the owner's race (team: PvP areas, rest), the owner's faction
+    // template (it differs after `faction`, 0009), the owner's standing and flags (at war, ...) with every
+    // reputation faction (in memory, as vmangos' race change moves them, ChangeReputationsForRace), and the
+    // owner's forced reactions. Guards, towns, attackability and the per-member feed then treat it as the
+    // owner. Its own reputation is kept aside and never saved over (Player::SaveToDB skips the reputation of
+    // a bot that borrows: BorrowsSide); a login starts from its own side, and on the owner's side again it
+    // gets its own back. Forced reactions alone are not enough: a forced neutral rank makes a neutral
+    // faction's NPCs attackable (WorldObject::IsValidAttackTarget skips the at-war check for a forced rank).
+    struct Borrowed
+    {
+        std::map<RepListID, std::pair<int32, uint32>> own;  // the bot's own standing and flags per reputation
+        std::set<uint32> forced;                            // faction ids forced as the owner's are
+    };
+    std::mutex g_sideLock;
+    std::unordered_map<uint64, Borrowed> g_side;            // bot guid -> what it borrowed
+
+    bool OtherSide(Player* owner, Player* bot)
+    {
+        return Player::TeamForRace(bot->GetRace()) != owner->GetTeam() ||
+            owner->GetFactionTemplateId() != Player::GetFactionForRace(owner->GetRace());  // the owner's `faction`
+    }
+
+    void TakeOwnerSide(Player* owner, Player* bot)
+    {
+        uint64 const key = bot->GetObjectGuid().GetRawValue();
+        ReputationMgr& rep = bot->GetReputationMgr();
+        ReputationMgr const& theirs = owner->GetReputationMgr();
+        bool forcedChanged = false, newTeam = false;
+        {
+            std::lock_guard<std::mutex> lock(g_sideLock);
+            auto it = g_side.find(key);
+            if (!OtherSide(owner, bot))
+            {
+                if (it == g_side.end())
+                    return;
+                // Its own side again: its own standings, flags and faction.
+                for (auto const& o : it->second.own)
+                    if (FactionState* st = const_cast<FactionState*>(rep.GetState(o.first)))
+                    {
+                        st->Standing = o.second.first;
+                        st->Flags = o.second.second;
+                        st->needSend = true;
+                    }
+                for (uint32 id : it->second.forced)
+                    rep.ApplyForceReaction(id, REP_NEUTRAL, false);
+                forcedChanged = !it->second.forced.empty();
+                g_side.erase(it);
+                newTeam = bot->GetTeam() != Player::TeamForRace(bot->GetRace());
+                bot->SetFactionForRace(bot->GetRace());
+            }
+            else
+            {
+                if (it == g_side.end())
+                {
+                    it = g_side.emplace(key, Borrowed()).first;
+                    for (auto const& kv : rep.GetStateList())
+                        it->second.own[kv.first] = { kv.second.Standing, kv.second.Flags };
+                }
+                newTeam = bot->GetTeam() != owner->GetTeam();
+                if (newTeam)
+                    bot->SetFactionForRace(owner->GetRace());
+                if (bot->GetFactionTemplateId() != owner->GetFactionTemplateId())
+                    bot->SetFactionTemplateId(owner->GetFactionTemplateId());
+                for (auto const& kv : rep.GetStateList())
+                {
+                    FactionEntry const* f = sObjectMgr.GetFactionEntry(kv.second.ID);
+                    FactionState const* o = f ? theirs.GetState(f) : nullptr;
+                    if (!o)
+                        continue;
+                    // The owner's reputation value: the bot's Standing is counted from its own race's base.
+                    int32 const standing = theirs.GetReputation(f) - rep.GetBaseReputation(f);
+                    if (kv.second.Standing != standing || kv.second.Flags != o->Flags)
+                    {
+                        FactionState* st = const_cast<FactionState*>(&kv.second);
+                        st->Standing = standing;
+                        st->Flags = o->Flags;
+                        st->needSend = true;
+                    }
+                }
+                for (auto const& kv : sObjectMgr.GetFactionMap())
+                {
+                    FactionEntry const& f = kv.second;
+                    if (f.reputationListID < 0)
+                        continue;
+                    ReputationRank const* want = theirs.GetForcedRankIfAny(f.ID);
+                    ReputationRank const* mine = rep.GetForcedRankIfAny(f.ID);
+                    bool const had = it->second.forced.count(f.ID) != 0;
+                    if (want && (!had || !mine || *mine != *want))
+                    {
+                        rep.ApplyForceReaction(f.ID, *want, true);
+                        it->second.forced.insert(f.ID);
+                        forcedChanged = true;
+                    }
+                    else if (!want && had)
+                    {
+                        rep.ApplyForceReaction(f.ID, REP_NEUTRAL, false);
+                        it->second.forced.erase(f.ID);
+                        forcedChanged = true;
+                    }
+                }
+            }
+        }
+        if (forcedChanged)
+            rep.SendForceReactions();
+        if (newTeam && bot->IsInWorld())
+            bot->UpdateZone(bot->GetZoneId(), bot->GetAreaId());    // PvP area and rest by its team now
+    }
