+    // give CHAR GUID TOCHAR [COUNT] (console: TOCHAR any online character; chat: a party member)
+    void ShapeGive(Player* owner, Player* m, std::string const& name, std::vector<std::string> const& a, Out& out)
+    {
+        std::string const head = "WOWBG3 inv " + name + " give " + (a.size() > 4 ? a[4] : std::string("-")) + " ";
+        if (a.size() < 6 || a.size() > 7)
+            return out.Add(head + "refused usage");
+        Player* to = nullptr;
+        if (owner)
+        {
+            char const* why = nullptr;
+            to = FindMember(owner, a[5], why);
+        }
+        else
+        {
+            std::string n = a[5];
+            normalizePlayerName(n);
+            to = ObjectAccessor::FindPlayerByName(n.c_str());
+        }
+        if (!to || !to->IsInWorld())
+            return out.Add(head + "refused offline");
+        std::vector<std::string> v = { a[0], "give", name, a[4], a[5] };
+        if (a.size() == 7)
+            v.push_back(a[6]);
+        std::vector<std::string> lines;
+        Out tmp{ lines };
+        Give(owner ? owner : m, m, name, v, tmp, to);
+        if (lines.empty() || lines[0].find(" ok ") == std::string::npos)
+            return out.Add(head + "refused " + (lines.empty() ? std::string("failed") : lines[0].substr(lines[0].find("refused ") == std::string::npos ? 0 : lines[0].find("refused ") + 8)));
+        // The receiver's new or grown stack: its last `item` line.
+        std::string guid = "-";
+        for (std::string const& l : lines)
+            if (l.compare(0, 12 + a[5].size(), "WOWBG3 item " + a[5]) == 0)
+            {
+                std::vector<std::string> w;
+                std::string cur;
+                for (char ch : l) { if (ch == ' ') { w.push_back(cur); cur.clear(); } else cur += ch; }
+                w.push_back(cur);
+                if (w.size() > 5)
+                    guid = w[5];
+            }
+        out.Add(head + "ok " + a[5] + " " + guid);
+    }
+
+    void ShapeLoot(Player* m, std::string const& name, std::vector<std::string> const& a, Out& out)
+    {
+        std::string const sub = a[2];
+        std::string const head = "WOWBG3 loot " + name + " " + (a.size() > 4 ? a[4] : std::string("-")) + " ";
+        ObjectGuid g;
+        if (a.size() < 5 || !ParseGuid(a[4], g) || !g.IsAnyTypeCreature())
+            return out.Add(head + "refused usage");
+        Creature* c = m->GetMap()->GetAnyTypeCreature(g);
+        if (!c)
+            return out.Add(head + "refused missing");
+        if (c->IsAlive())
+            return out.Add(head + "refused notlootable");
+        if (!m->IsWithinDistInMap(c, INTERACTION_DISTANCE))
+            return out.Add(head + "refused far");
+        WorldSession* s = m->GetSession();
+        if (m->GetLootGuid() != g)
+        {
+            WorldPackets::Loot::LootUnit lu;
+            lu.guid = g;
+            s->HandleLootOpcode(lu);
+            if (m->GetLootGuid() != g)
+                return out.Add(head + "refused notyours");
+        }
+        Loot& loot = c->loot;
+        uint32 const low = m->GetGUIDLow();
+        if (sub == "list")
+        {
+            std::vector<std::string> items;
+            uint32 const max = loot.GetMaxSlotInLootFor(low);
+            for (uint32 i = 0; i < max; ++i)
+            {
+                QuestItem* q = nullptr; QuestItem* ffa = nullptr; QuestItem* cond = nullptr;
+                LootItem* li = loot.LootItemInSlot(i, low, &q, &ffa, &cond);
+                if (!li || li->is_looted || (q && q->is_looted) || (ffa && ffa->is_looted) || (cond && cond->is_looted))
+                    continue;
+                if (!li->AllowedForPlayer(m, c))
+                    continue;
+                items.push_back(head + "item " + std::to_string(i) + " " + std::to_string(li->itemid) + " " + std::to_string(uint32(li->count)));
+            }
+            out.Add(head + "begin " + std::to_string(loot.gold) + " " + std::to_string(items.size()));
+            for (std::string const& l : items)
+                out.Add(l);
+            return out.Add(head + "end " + std::to_string(items.size()));
+        }
+        // take IDX|money|all
+        if (a.size() != 6)
+            return out.Add(head + "refused usage");
+        std::string const what = a[5];
+        auto const before = Snapshot(m);
+        uint32 const money = m->GetMoney();
+        if (what == "money" || what == "all")
+        {
+            NullClientPacket none(CMSG_LOOT_MONEY);
+            s->HandleLootMoneyOpcode(none);
+        }
+        uint32 idx = 0;
+        if (what == "all")
+        {
+            uint32 const max = loot.GetMaxSlotInLootFor(low);
+            for (uint32 i = 0; i < max && i < 64; ++i)
+            {
+                WorldPackets::Loot::AutoStoreLootItem p;
+                p.lootSlot = uint8(i);
+                s->HandleAutostoreLootItemOpcode(p);
+            }
+        }
+        else if (what != "money")
+        {
+            if (!ParseUInt(what, idx, 255))
+                return out.Add(head + "refused usage");
+            WorldPackets::Loot::AutoStoreLootItem p;
+            p.lootSlot = uint8(idx);
+            s->HandleAutostoreLootItemOpcode(p);
+        }
+        // New or grown stacks.
+        std::string guid;
+        for (Held const& h : Carried(m))
+        {
+            auto o = before.find(h.item->GetObjectGuid().GetRawValue());
+            if (o == before.end() || o->second.count != h.item->GetCount())
+                guid = Hex(h.item->GetObjectGuid());
+        }
+        bool const done = loot.isLooted();
+        if (done)
+        {
+            WorldPackets::Loot::LootRelease rel;
+            rel.guid = g;
+            s->HandleLootReleaseOpcode(rel);
+        }
+        if (what == "money")
+            return out.Add(head + "take money " + (m->GetMoney() != money ? "ok " : "refused nothing ") + std::to_string(m->GetMoney() - money));
+        if (guid.empty() && m->GetMoney() == money)
+            return out.Add(head + "take " + what + " refused full");
+        out.Add(head + "take " + what + " ok " + (guid.empty() ? std::string("-") : guid) + " " + std::to_string(m->GetMoney()));
+    }
+
+    void ShapeVendor(Player* m, std::string const& name, std::vector<std::string> const& a, Out& out)
+    {
+        std::string const sub = a[2];
+        std::string const head = "WOWBG3 vendor " + name + " " + (a.size() > 4 ? a[4] : std::string("-")) + " ";
+        char const* why = nullptr;
+        Creature* v = a.size() > 4 ? Vendor(m, a[4], why) : nullptr;
+        if (!v)
+            return out.Add(head + "refused " + (why ? why : "usage"));
+        if (sub == "list")
+        {
+            std::vector<std::string> wares;
+            uint32 idx = 0;
+            for (VendorItemData const* data : { v->GetVendorItems(), v->GetVendorTemplateItems() })
+            {
+                if (!data)
+                    continue;
+                for (VendorItem const* vi : data->m_items)
+                {
+                    ItemPrototype const* p = sObjectMgr.GetItemPrototype(vi->item);
+                    if (!p)
+                        continue;
+                    uint32 const price = uint32(std::floor(p->BuyPrice * m->GetReputationPriceDiscount(v)));
+                    int32 const stock = vi->maxcount ? int32(v->GetVendorItemCurrentCount(vi)) : -1;
+                    wares.push_back(head + "item " + std::to_string(idx++) + " " + std::to_string(vi->item) + " " +
+                        std::to_string(price) + " " + std::to_string(stock) + " " + std::to_string(p->BuyCount ? p->BuyCount : 1));
+                }
+            }
+            out.Add(head + "begin " + std::to_string(wares.size()));
+            for (std::string const& w : wares)
+                out.Add(w);
+            return out.Add(head + "end " + std::to_string(wares.size()));
+        }
+        if (sub == "buy")
+        {
+            uint32 entry = 0, lots = 1;
+            if (a.size() < 6 || !ParseUInt(a[5], entry) || (a.size() > 6 && (!ParseUInt(a[6], lots, 255) || lots == 0)))
+                return out.Add(head + "buy refused usage");
+            auto const before = Snapshot(m);
+            uint32 const money = m->GetMoney();
+            m->BuyItemFromVendor(v->GetObjectGuid(), entry, uint8(lots), NULL_BAG, NULL_SLOT);
+            if (m->GetMoney() == money)
+                return out.Add(head + "buy " + std::to_string(entry) + " refused failed");
+            std::string guid = "-";
+            for (Held const& h : Carried(m))
+            {
+                auto o = before.find(h.item->GetObjectGuid().GetRawValue());
+                if (h.item->GetEntry() == entry && (o == before.end() || o->second.count != h.item->GetCount()))
+                    guid = Hex(h.item->GetObjectGuid());
+            }
+            return out.Add(head + "buy " + std::to_string(entry) + " ok " + guid + " " + std::to_string(m->GetMoney()));
+        }
+        if (sub == "sell")
+        {
+            ObjectGuid g;
+            uint32 count = 0;
+            if (a.size() < 6 || !ParseGuid(a[5], g) || (a.size() > 6 && !ParseUInt(a[6], count, 255)))
+                return out.Add(head + "sell refused usage");
+            if (!FindCarried(m, g))
+                return out.Add(head + "sell " + a[5] + " refused noitem");
+            uint32 const money = m->GetMoney();
+            WorldPackets::Item::SellItem p;
+            p.vendorGuid = v->GetObjectGuid();
+            p.itemGuid = g;
+            p.count = uint8(count);
+            m->GetSession()->HandleSellItemOpcode(p);
+            if (m->GetMoney() == money)
+                return out.Add(head + "sell " + a[5] + " refused failed");
+            return out.Add(head + "sell " + a[5] + " ok " + std::to_string(m->GetMoney()));
+        }
+        out.Add(head + "refused usage");
+    }
+}
