+    // ---- the inventory bridge's console shape (link/tools/inventory_bridge.py, class Server) ----
+    // `inv list|equip|unequip|move|add|del|money|give CHAR ...`, `loot list|take CHAR NPC ...`,
+    // `vendor list|buy|sell CHAR NPC ...`; replies `WOWBG3 inv|loot|vendor CHAR ... ok|refused WHY`.
+
+    std::string Code(InventoryResult r)
+    {
+        return "inv_" + std::to_string(uint32(r));
+    }
+
+    // The item's place after an action, or nothing.
+    std::string Place(Player* m, ObjectGuid g)
+    {
+        for (Held const& h : Carried(m))
+            if (h.item->GetObjectGuid() == g)
+                return std::to_string(uint32(h.bag)) + " " + std::to_string(uint32(h.slot));
+        return "";
+    }
