+bool ExecuteItemsShape(Player* owner, std::vector<std::string> const& a, std::vector<std::string>& lines)
+{
+    // owner: the hero whose party CHAR must belong to (chat), or nullptr (console: any online CHAR).
+    Out out{ lines };
+    std::string const verb = a.size() > 1 ? a[1] : "";
+    std::string const sub = a.size() > 2 ? a[2] : "";
+    bool const inv = verb == "inv" && (sub == "list" || sub == "equip" || sub == "unequip" || sub == "move" ||
+        sub == "add" || sub == "del" || sub == "money" || sub == "give");
+    bool const loot = verb == "loot" && (sub == "list" || sub == "take");
+    bool const vendor = verb == "vendor" && (sub == "list" || sub == "buy" || sub == "sell");
+    if (!inv && !loot && !vendor)
+        return false;
+    if (a.size() < 4 || a.size() > 8)
+    {
+        out.Add("WOWBG3 " + verb + " - " + sub + " refused usage");
+        return true;
+    }
+    std::string name = a[3];
+    Player* m = nullptr;
+    if (owner)
+    {
+        char const* why = nullptr;
+        m = FindMember(owner, name, why);
+    }
+    else
+    {
+        normalizePlayerName(name);
+        m = ObjectAccessor::FindPlayerByName(name.c_str());
+    }
+    if (!m || !m->IsInWorld())
+    {
+        out.Add("WOWBG3 " + verb + " " + a[3] + " refused offline");
+        return true;
+    }
+    // From here the CHAR token is out of the way: a[2] is the sub verb, a[4]... its arguments.
+    std::vector<std::string> b = a;
+    b.erase(b.begin() + 3);
+    // b: [.wowbg3, verb, sub, args...]; the Shape functions read a[4]... so put a placeholder back.
+    b.insert(b.begin() + 3, name);
+    if (inv && sub == "give")
+        ShapeGive(owner, m, name, b, out);
+    else if (inv)
+        ShapeInv(m, name, b, out);
+    else if (loot)
+        ShapeLoot(m, name, b, out);
+    else
+        ShapeVendor(m, name, b, out);
+    return true;
 }
 
