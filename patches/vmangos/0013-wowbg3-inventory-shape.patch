+    void ShapeInv(Player* m, std::string const& name, std::vector<std::string> const& a, Out& out)
+    {
+        std::string const sub = a[2];
+        std::string const head = "WOWBG3 inv " + name + " " + sub + " ";
+        if (sub == "list")
+        {
+            std::vector<Held> list = Carried(m);
+            out.Add("WOWBG3 inv " + name + " begin " + std::to_string(m->GetMoney()) + " " + std::to_string(list.size()));
+            for (Held const& h : list)
+            {
+                char buf[200];
+                snprintf(buf, sizeof(buf), "WOWBG3 inv %s item %u %u %s %u %u %u %u %d", name.c_str(), uint32(h.bag),
+                    uint32(h.slot), Hex(h.item->GetObjectGuid()).c_str(), h.item->GetEntry(), h.item->GetCount(),
+                    h.item->GetUInt32Value(ITEM_FIELD_DURABILITY), h.item->GetUInt32Value(ITEM_FIELD_MAXDURABILITY),
+                    h.item->GetItemRandomPropertyId());
+                out.Add(buf);
+            }
+            return out.Add("WOWBG3 inv " + name + " end " + std::to_string(list.size()));
+        }
+        if (sub == "add")
+        {
+            uint32 entry = 0, count = 1;
+            if (a.size() < 5 || !ParseUInt(a[4], entry) || (a.size() > 5 && (!ParseUInt(a[5], count, 10000) || count == 0)))
+                return out.Add(head + "refused usage");
+            if (!sObjectMgr.GetItemPrototype(entry))
+                return out.Add(head + std::to_string(entry) + " refused unknown");
+            ItemPosCountVec dest;
+            uint32 noSpace = 0;
+            InventoryResult r = m->CanStoreNewItem(NULL_BAG, NULL_SLOT, dest, entry, count, &noSpace);
+            if (r != EQUIP_ERR_OK && (dest.empty() || count == noSpace))
+                return out.Add(head + std::to_string(entry) + " refused " + Code(r));
+            Item* it = m->StoreNewItem(dest, entry, true, Item::GenerateItemRandomPropertyId(entry));
+            if (!it)
+                return out.Add(head + std::to_string(entry) + " refused failed");
+            m->SendNewItem(it, count - noSpace, true, false);
+            return out.Add(head + std::to_string(entry) + " ok " + Hex(it->GetObjectGuid()) + " " + std::to_string(count - noSpace));
+        }
+        if (sub == "money")
+        {
+            int32 delta = 0;
+            if (a.size() != 5 || !ParseInt(a[4], delta))
+                return out.Add(head + "refused usage");
+            if (delta < 0 && uint32(-int64(delta)) > m->GetMoney())
+                return out.Add(head + "refused notenough");
+            if (delta > 0 && uint64(m->GetMoney()) + uint64(delta) > MAX_MONEY_AMOUNT)
+                return out.Add(head + "refused toomuch");
+            m->ModifyMoney(delta);
+            return out.Add(head + "ok " + std::to_string(m->GetMoney()));
+        }
+        // The rest name an item the character carries.
+        ObjectGuid g;
+        if (a.size() < 5 || !ParseGuid(a[4], g))
+            return out.Add(head + "refused usage");
+        std::string const ihead = head + a[4] + " ";
+        Item* it = FindCarried(m, g);
+        if (!it)
+            return out.Add(ihead + "refused noitem");
+        if (sub == "del")
+        {
+            uint32 count = 0;
+            if (a.size() > 5 && (!ParseUInt(a[5], count, 10000) || count == 0))
+                return out.Add(ihead + "refused usage");
+            uint32 left = 0;
+            if (count == 0 || count >= it->GetCount())
+            {
+                if (it->IsEquipped())
+                {
+                    InventoryResult r = m->CanUnequipItem(it->GetPos(), false);
+                    if (r != EQUIP_ERR_OK)
+                        return out.Add(ihead + "refused " + Code(r));
+                }
+                if (it->IsBag() && !static_cast<Bag*>(it)->IsEmpty())
+                    return out.Add(ihead + "refused notempty");
+                m->DestroyItem(it->GetBagSlot(), it->GetSlot(), true);
+            }
+            else
+            {
+                left = it->GetCount() - count;
+                m->DestroyItemCount(it, count, true);
+            }
+            return out.Add(ihead + "ok " + std::to_string(left));
+        }
+        if (sub == "equip" || sub == "move")
+        {
+            uint32 bag = INVENTORY_SLOT_BAG_0, slot = NULL_SLOT;
+            if (sub == "move" && (a.size() < 7 || !ParseUInt(a[5], bag, 255) || !ParseUInt(a[6], slot, 255)))
+                return out.Add(ihead + "refused usage");
+            uint16 src = it->GetPos();
+            uint16 dst = 0;
+            if (sub == "equip" || (bag == INVENTORY_SLOT_BAG_0 && slot < EQUIPMENT_SLOT_END))
+            {
+                InventoryResult r = m->CanEquipItem(sub == "equip" ? uint8(NULL_SLOT) : uint8(slot), dst, it, !it->IsBag());
+                if (r != EQUIP_ERR_OK)
+                    return out.Add(ihead + "refused " + Code(r));
+            }
+            else
+                dst = uint16(bag << 8 | slot);
+            if (dst == src)
+                return out.Add(ihead + "ok " + Place(m, g));
+            uint32 count = 0;
+            if (sub == "move" && a.size() > 7 && (!ParseUInt(a[7], count, 255) || count == 0))
+                return out.Add(ihead + "refused usage");
+            if (count && count < it->GetCount())
+            {
+                WorldPackets::Item::SplitItem p;
+                p.srcbag = uint8(src >> 8);
+                p.srcslot = uint8(src & 255);
+                p.dstbag = uint8(dst >> 8);
+                p.dstslot = uint8(dst & 255);
+                p.count = uint8(count);
+                m->GetSession()->HandleSplitItemOpcode(p);
+                Item* moved = m->GetItemByPos(uint8(dst >> 8), uint8(dst & 255));
+                if (!moved || moved == it)
+                    return out.Add(ihead + "refused failed");
+                return out.Add(ihead + "ok " + Place(m, moved->GetObjectGuid()));
+            }
+            m->SwapItem(src, dst);
+            std::string const now = Place(m, g);
+            if (now.empty() || it->GetPos() == src)
+                return out.Add(ihead + "refused failed");
+            return out.Add(ihead + "ok " + now);
+        }
+        if (sub == "unequip")
+        {
+            if (!it->IsEquipped())
+                return out.Add(ihead + "refused notequipped");
+            InventoryResult r = m->CanUnequipItem(it->GetPos(), false);
+            if (r != EQUIP_ERR_OK)
+                return out.Add(ihead + "refused " + Code(r));
+            ItemPosCountVec dest;
+            uint8 bagSlot = 0;
+            r = m->CanStoreItem(NULL_BAG, NULL_SLOT, dest, it, bagSlot, false);
+            if (r != EQUIP_ERR_OK)
+                return out.Add(ihead + "refused " + Code(r));
+            m->RemoveItem(it->GetBagSlot(), it->GetSlot(), true);
+            m->StoreItem(dest, it, true);
+            return out.Add(ihead + "ok " + Place(m, g));
+        }
+        out.Add(head + "refused usage");
+    }
