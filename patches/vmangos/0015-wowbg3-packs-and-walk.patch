+    // 0015: walk NAME X Y Z MAP SECONDS. A party bot on that
+    // map within WALK_RANGE of the point runs there in a straight line (a server spline, no path
+    // finding) at the speed that takes SECONDS, facing its way, so it moves smoothly with its BG3
+    // member instead of jumping with `move` (a teleport): `WOWBG3 walk NAME ok MAP X Y Z SPEED`.
+    // Farther, another map or a busy bot: `refused far|map|...`, and the client falls back to `move`.
+    float const WALK_RANGE = 40.0f;
+
+    void Walk(Player* owner, std::vector<std::string> const& a, Out& out)
+    {
+        std::string const head = "WOWBG3 walk " + a[2] + " ";
+        char const* why = nullptr;
+        Player* m = Member(owner, a[2], why);
+        if (!m)
+            return out.Add(head + "refused " + why);
+        if (m == owner)
+            return out.Add(head + "refused self");
+        float x, y, z, secs;
+        uint32 map;
+        if (!ParseFloat(a[3], x) || !ParseFloat(a[4], y) || !ParseFloat(a[5], z) || !ParseUInt(a[6], map, 10000) ||
+            !ParseFloat(a[7], secs) || !(secs > 0.0f) || secs > 60.0f || !MapManager::IsValidMapCoord(map, x, y, z))
+            return out.Add(head + "refused badpos");
+        if (m->GetMapId() != map)
+            return out.Add(head + "refused map");
+        if (!m->IsAlive())
+            return out.Add(head + "refused dead");
+        if (m->IsTaxiFlying())
+            return out.Add(head + "refused taxi");
+        if (m->IsBeingTeleported())
+            return out.Add(head + "refused busy");
+        float const dx = x - m->GetPositionX(), dy = y - m->GetPositionY();
+        float const dist = std::sqrt(dx * dx + dy * dy + (z - m->GetPositionZ()) * (z - m->GetPositionZ()));
+        if (dist > WALK_RANGE)
+            return out.Add(Fmt("WOWBG3 walk %s refused far %.1f", a[2].c_str(), dist));
+        float const o = (dx * dx + dy * dy > 0.0025f) ? std::atan2(dy, dx) : m->GetOrientation();
+        float const speed = std::min(std::max(dist / secs, 0.5f), 50.0f);
+        m->MonsterMoveWithSpeed(x, y, z, o, speed, MOVE_RUN_MODE);
+        out.Add(Fmt("WOWBG3 walk %s ok %u %.2f %.2f %.2f %.2f", a[2].c_str(), map, x, y, z, speed));
+    }
