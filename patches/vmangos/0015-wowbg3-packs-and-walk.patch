+    // ---- 0015: pack aggro ----
+    // Goal: mobs of the same pack join a fight when they see an ally in it, not
+    // only when they see the party. WoW's own assistance runs when a mob starts its attack
+    // (Unit::Attack -> Creature::CallAssistance), which a mob held for a BG3 fight never does, so
+    // its pack stood by. Each tick (world thread, no map updates) every creature that WoW would let
+    // answer a call for help (Creature::CanAssistTo: same faction template, the faction's
+    // respond-to-call-for-help flag, alive, not in combat, not stunned, not evading, ...), within
+    // PACK_RANGE of a living mob of a running encounter and with that mob in its line of sight
+    // (MaNGOS::AnyAssistCreatureInRangeCheck), attacks the living party member nearest to it. Its
+    // combat start (OnCreatureEnterCombat) holds it at once as an add of the encounter
+    // (`WOWBG3 mob ENC GUID ... aggro`), which the client joins to the BG3 fight. Creatures friendly
+    // to that member never come (a provoked town NPC's neighbours, 0006), nor do held ones.
+    void PackAssist()
+    {
+        struct Want
+        {
+            ObjectGuid player;
+            std::string enc;
+            uint32 map;
+            uint32 instance;
+            std::vector<ObjectGuid> mobs;
+        };
+        std::vector<Want> wants;
+        {
+            ReadLock lock(g_lock);
+            for (auto const& kv : g_fighters)
+            {
+                Encounter const* e = kv.second.active.get();
+                if (!e || !e->Alive() || e->mobs.size() >= MAX_MOBS)
+                    continue;
+                Want w{ kv.first, e->id, e->map, e->instance, {} };
+                for (Mob const& m : e->mobs)
+                    if (!m.killed)
+                        w.mobs.push_back(m.guid);
+                wants.push_back(std::move(w));
+            }
+        }
+        for (Want const& w : wants)
+        {
+            Player* p = ObjectAccessor::FindPlayer(w.player);
+            if (!p || !p->IsInWorld() || p->GetMapId() != w.map || p->GetInstanceId() != w.instance)
+                continue;
+            std::vector<Player*> party;
+            LivingMembers(p, party);
+            if (party.empty())
+                continue;
+            for (ObjectGuid g : w.mobs)
+            {
+                Creature* held = FindMob(w.map, w.instance, g, p);
+                if (!held || !held->IsAlive() || !held->IsInWorld())
+                    continue;
+                Player* near = nullptr;                     // the member the held mob fights (nearest)
+                for (Player* m : party)
+                    if (!near || held->GetDistance(m) < held->GetDistance(near))
+                        near = m;
+                std::list<Creature*> found;
+                MaNGOS::AnyAssistCreatureInRangeCheck check(held, near, PACK_RANGE);
+                MaNGOS::CreatureListSearcher<MaNGOS::AnyAssistCreatureInRangeCheck> searcher(found, check);
+                Cell::VisitGridObjects(held, searcher, PACK_RANGE);
+                for (Creature* c : found)
+                {
+                    if (!c->AI() || c->IsInCombat() || IsHeld(c))
+                        continue;
+                    Player* victim = nullptr;
+                    for (Player* m : party)
+                        if (!victim || c->GetDistance(m) < c->GetDistance(victim))
+                            victim = m;
+                    if (!victim || c->IsFriendlyTo(victim) || !victim->IsTargetableBy(c))
+                        continue;
+                    sLog.Out(LOG_BASIC, LOG_LVL_DETAIL, "WOWBG3: %s pack: %s joins %s's fight %s (sees %s)",
+                        p->GetName(), Hex(c->GetObjectGuid()).c_str(), victim->GetName(), w.enc.c_str(),
+                        Hex(g).c_str());
+                    c->AI()->AttackStart(victim);
+                    if (IsHeld(c))
+                        Say(p, "WOWBG3 pack " + w.enc + " " + Hex(c->GetObjectGuid()) + " sees " + Hex(g));
+                }
+            }
+        }
+    }
