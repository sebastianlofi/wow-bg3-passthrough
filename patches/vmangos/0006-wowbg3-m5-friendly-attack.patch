+    // `creature` is provoked by `other`'s player (lock-free, see g_provCreature).
+    bool ProvokedBy(WorldObject const* creature, WorldObject const* other)
+    {
+        if (creature->GetTypeId() != TYPEID_UNIT)
+            return false;
+        Player const* player = other->GetAffectingPlayer();
+        if (!player)
+            return false;
+        uint64 const c = creature->GetObjectGuid().GetRawValue();
+        uint64 const pl = player->GetObjectGuid().GetRawValue();
+        for (size_t i = 0; i < MAX_PROVOKED; ++i)
+            if (g_provCreature[i].load(std::memory_order_acquire) == c)
+                return g_provPlayer[i].load(std::memory_order_relaxed) == pl;
+        return false;
+    }
+}
+
+bool IsProvokedPair(WorldObject const* self, WorldObject const* target)
+{
+    if (!g_provokedCount.load(std::memory_order_relaxed) || !self || !target)
+        return false;
+    return ProvokedBy(self, target) || ProvokedBy(target, self);
+}
+
+uint32 ShownFaction(Object const* object, Player const* target, uint32 faction)
+{
+    if (!g_provokedCount.load(std::memory_order_relaxed) || !object || !target || object->GetTypeId() != TYPEID_UNIT)
+        return faction;
+    return ProvokedBy(static_cast<WorldObject const*>(object), target) ? SHOWN_HOSTILE : faction;
+}
