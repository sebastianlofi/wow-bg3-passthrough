+    // corpse <guid> hold (0031): someone in BG3 carries this body (BG3's own pick-up of a corpse).
+    // It lies nowhere, so it must not decay and the mob must not respawn under the carrier's
+    // hands: kept for HOLD_SECS from now; the bridge says so again while the body is carried, and
+    // `corpse <guid> x y z` gives it its own corpse time again where it is put down.
+    void CorpseHold(Player* p, std::string const& guidText, Out& out)
+    {
+        uint32 const HOLD_SECS = 1800;
+        ObjectGuid g;
+        if (!ParseGuid(guidText, g))
+            return out.Add("WOWBG3 corpse " + guidText + " refused badguid");
+        std::string const head = "WOWBG3 corpse " + Hex(g) + " ";
+        if (!p || !p->IsInWorld())
+            return out.Add(head + "refused offline");
+        Creature* c = FindMob(p->GetMapId(), p->GetInstanceId(), g, p);
+        if (!c)
+            return out.Add(head + "gone");
+        if (c->IsAlive())
+            return out.Add(head + "refused alive");
+        if (!c->HasLootRecipient() || !c->IsTappedBy(p))
+            return out.Add(head + "refused notyours");
+        c->WowBg3KeepCorpse(HOLD_SECS);
+        out.Add(head + "held");
+    }
