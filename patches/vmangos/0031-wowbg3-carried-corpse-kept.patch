@@ -148,6 +148,16 @@ class Creature : public Unit
         bool IsCorpse() const override { return GetDeathState() ==  CORPSE; }
         bool IsDespawned() const { return GetDeathState() ==  DEAD; }
         void SetCorpseDelay(uint32 delay) { m_corpseDelay = delay; }
+        // WOW-BG3 0031: this corpse lies for `secs` from now: neither its decay nor its respawn
+        // (which removes a corpse too) comes before. 0: its own full corpse time, from now.
+        void WowBg3KeepCorpse(uint32 secs)
+        {
+            if (!secs)
+                secs = m_corpseDelay;
+            m_corpseDecayTimer = secs * IN_MILLISECONDS;
+            if (m_respawnTime < time(nullptr) + time_t(secs))
+                m_respawnTime = time(nullptr) + time_t(secs);
+        }
         bool IsRacialLeader() const { return GetCreatureInfo()->racial_leader; }
         bool IsCivilian() const { return GetCreatureInfo()->civilian; }
         bool IsTrigger() const { return HasExtraFlag(CREATURE_FLAG_EXTRA_INVISIBLE); }
