+bool InLootReach(Player const* looter, Creature const* c)
+{
+    float const reach = looter->GetMaxLootDistance(c);
+    ReachFrom const* f = tReachFrom;
+    if (f && f->looter == looter->GetObjectGuid() && f->loot == c->GetObjectGuid())
+        return c->IsWithinDist3d(f->x, f->y, f->z, reach, SizeFactor::None);
+    return c->IsWithinDistInMap(looter, reach, true, SizeFactor::None);
+}
 }
