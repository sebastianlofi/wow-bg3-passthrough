+    // 0026: hold HID guids G1,G2,... holds exactly those creatures (BG3's turn-based mode froze their
+    // stand-ins), on the sender's map, under HID: the same hold as the radius form (renewed by every
+    // `hold HID`, let go by `unhold HID`, logout or an hour without a renewal). Already held ones stay.
+    // hold HID drop G1,G2,... lets those go again (BG3 let their stand-ins go), unless a fight or
+    // another of this player's holds has them. A line takes as many guids as fit in a chat line.
+    bool ParseGuidList(std::string const& list, std::vector<ObjectGuid>& out)
+    {
+        for (std::string const& item : Split(list, ','))
+        {
+            ObjectGuid g;
+            if (!ParseGuid(item, g))
+                return false;
+            out.push_back(g);
+        }
+        return !out.empty();
+    }
+
+    void HoldGuids(Player* p, std::vector<std::string> const& a, Out& out)
+    {
+        std::string const hid = a[2];
+        std::string const head = "WOWBG3 hold " + hid + " ";
+        std::vector<ObjectGuid> guids;
+        if (!ValidId(hid) || a.size() != 5 || !ParseGuidList(a[4], guids))
+            return out.Add(head + "refused usage");
+        if (guids.size() > AREA_MAX_MOBS)
+            return out.Add(head + "refused toomany");
+        std::vector<Creature*> found;
+        uint32 gone = 0;
+        for (ObjectGuid g : guids)
+        {
+            Creature* c = p->GetMap()->GetAnyTypeCreature(g);
+            if (c)
+                found.push_back(c);
+            else
+                ++gone;                                     // not on this map (any more)
+        }
+        Out held;
+        HoldCreatures(p, hid, found, head, held);
+        for (std::string& l : held.lines)
+            out.Add(l + " " + std::to_string(gone));
+    }
+
+    void DropGuids(Player* p, std::vector<std::string> const& a, Out& out)
+    {
+        std::string const hid = a[2];
+        std::string const head = "WOWBG3 hold " + hid + " ";
+        std::vector<ObjectGuid> guids;
+        if (!ValidId(hid) || a.size() != 5 || !ParseGuidList(a[4], guids))
+            return out.Add(head + "refused usage");
+        std::vector<Release> releases;
+        bool known = false;
+        {
+            WriteLock lock(g_lock);
+            auto fit = g_fighters.find(p->GetObjectGuid());
+            if (fit != g_fighters.end())
+            {
+                Fighter& f = fit->second;
+                for (Area& x : f.areas)
+                {
+                    if (x.id != hid)
+                        continue;
+                    known = true;
+                    x.last = WorldTimer::getMSTime();
+                    Area dropped;                           // taken out first, so ReleaseArea sees no other hold
+                    for (auto it = x.mobs.begin(); it != x.mobs.end();)
+                    {
+                        if (std::find(guids.begin(), guids.end(), it->guid) != guids.end())
+                        {
+                            dropped.mobs.push_back(*it);
+                            it = x.mobs.erase(it);
+                        }
+                        else
+                            ++it;
+                    }
+                    ReleaseArea(p->GetObjectGuid(), f, dropped, releases);
+                }
+            }
+        }
+        ApplyReleases(releases);
+        if (!known)
+            return out.Add(head + "unknown");
+        out.Add(head + "dropped " + std::to_string(releases.size()));
+    }
+
