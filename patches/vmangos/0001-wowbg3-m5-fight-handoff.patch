+
+// WOW-BG3 (local patch, not upstream VMaNGOS): hand a WoW fight to a hidden
+// Baldur's Gate 3. While BG3 runs the fight turn by turn, the mobs in it are
+// held here: stunned with the GM freeze aura, no AI (attacks, casts, scripts),
+// no leash or evade, no regeneration, aura timers stopped, and no damage or
+// healing except what the fight's owner applies through `.wowbg3 hp`. That
+// damage comes from the player, so a kill gives normal XP, loot and quest
+// credit, once. The player's own client drives it with `.wowbg3` chat
+// commands; see `bridge/src/handoff.rs` in the WOW-BG3 project.
+
+#ifndef MANGOS_WOWBG3_FIGHTS_H
+#define MANGOS_WOWBG3_FIGHTS_H
+
+#include "Common.h"
+#include <string>
+
+class Creature;
+class Player;
+class Unit;
+class WorldSession;
+
+namespace WowBg3
+{
+    // True while a WOW-BG3 fight holds this unit. Cheap when nothing is held.
+    bool IsHeld(Unit const* unit);
+
+    // Unit::DealDamage and SpellCaster::DealHeal: true drops damage or healing
+    // to a held mob unless it comes from `.wowbg3 hp`.
+    bool BlocksDamage(Unit const* victim);
+
+    // Creature::Update (map thread): keeps a held mob frozen. True means skip
+    // its AI, leash, evade and regeneration this update.
+    bool UpdateHeld(Creature* creature);
+
+    // Creature::OnEnterCombat (map thread): a mob entering combat with an armed
+    // player, or with a player whose BG3 fight is running, is held at once,
+    // before its AI can swing or cast.
+    void OnCreatureEnterCombat(Creature* creature, Unit* enemy);
+
+    // WorldSession::HandleChatMessageOpcode: true if `text` was a `.wowbg3`
+    // command. It is then queued for the world thread and never said aloud.
+    bool HandleChat(WorldSession* session, std::string const& text);
+
+    // WorldSession::LogoutPlayer: lets the player's mobs go (they evade).
+    void OnLogout(Player* player);
+
+    // World::Update, in the exclusive session phase: timeouts and cleanup.
+    void Update(uint32 diff);
+}
+
+#endif
