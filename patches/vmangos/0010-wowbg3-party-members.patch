+// WOW-BG3 (local patch 0010, not upstream VMaNGOS): every BG3 party member is a
+// WoW character. The member a human plays is that human's own character; every
+// other member is a server-side bot (a real Player with no client, through
+// PlayerBotMgr) owned by the hero's character. `.wowbg3` verbs (see
+// WowBg3Fights.h) create, log in, move, group, level and log out those bots,
+// report the creatures around any member (the per-member feed), point the
+// hero's camera at a member (Far Sight), kill and revive members in place
+// (BG3 death rules: no release, no graveyard) and load movement map tiles
+// written while the server runs. Protocol: `AI Context/m5-server-handoff.md`
+// in the WOW-BG3 project.
+
+#ifndef MANGOS_WOWBG3_PARTY_H
+#define MANGOS_WOWBG3_PARTY_H
+
+#include "Common.h"
+#include "ObjectGuid.h"
+#include <string>
+#include <vector>
+
+class ChatHandler;
+class Player;
+class WorldObject;
+class WorldSession;
+
+namespace WowBg3
+{
+    // Verbs this module knows (world thread, no map updates). False: not ours.
+    bool ExecuteParty(Player* p, std::vector<std::string> const& a, std::vector<std::string>& out);
+
+    // Verbs that need no character (`wowbg3 - VERB` on the console): mmtile.
+    bool ExecuteGlobal(std::vector<std::string> const& a, std::vector<std::string>& out);
+
+    // World::Update tick (world thread): bot logins, arrivals, level follow, feeds.
+    void UpdateParty(uint32 diff);
+
+    // The owner's character leaves: its bots are saved and logged out.
+    void OnOwnerLogout(Player* owner);
+
+    // The owner of this party bot, or an empty guid when `player` is not one. Any thread.
+    ObjectGuid BotOwner(Player const* player);
+    bool AnyBots();
