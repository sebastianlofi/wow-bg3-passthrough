+        s.set = true;
+        s.map = owner->GetMapId();
+        float const a = owner->GetOrientation() + float(M_PI);   // a step behind the owner
+        s.x = owner->GetPositionX() + 1.5f * std::cos(a);
+        s.y = owner->GetPositionY() + 1.5f * std::sin(a);
+        s.z = owner->GetPositionZ();
+        s.o = owner->GetOrientation();
+        return s;
+    }
+
+    bool ParseSpot(std::vector<std::string> const& a, size_t i, Player* owner, Spot& s)
+    {
+        // X Y Z [MAP [O]]
+        if (a.size() < i + 3)
+            return false;
+        if (!ParseFloat(a[i], s.x) || !ParseFloat(a[i + 1], s.y) || !ParseFloat(a[i + 2], s.z))
+            return false;
+        s.map = owner->GetMapId();
+        s.o = owner->GetOrientation();
+        if (a.size() > i + 3 && !ParseUInt(a[i + 3], s.map, 10000))
+            return false;
+        if (a.size() > i + 4 && !ParseFloat(a[i + 4], s.o))
+            return false;
+        if (a.size() > i + 5)
+            return false;
+        if (!MapManager::IsValidMapCoord(s.map, s.x, s.y, s.z, s.o))
+            return false;
+        s.set = true;
+        return true;
+    }
+
