+    Player* Member(Player* owner, std::string const& name, char const*& why)
+    {
+        why = nullptr;
+        std::string const lname = Lower(name);
+        if (lname == "self" || lname == Lower(owner->GetName()))
+            return owner;
+        ObjectGuid guid;
+        BotState state = BotState::Account;
+        {
+            ReadLock lock(g_botLock);
+            for (Bot const& b : g_bots)
+            {
+                if (Lower(b.name) == lname && b.owner == owner->GetObjectGuid())
+                {
+                    guid = b.guid;
+                    state = b.state;
+                    break;
+                }
+            }
+        }
+        if (guid.IsEmpty() && state == BotState::Account)
+        {
+            why = "unknown";
+            return nullptr;
+        }
+        Player* m = guid.IsEmpty() ? nullptr : ObjectAccessor::FindPlayer(guid);
+        if (!m || !m->IsInWorld() || state == BotState::Removing)
+        {
+            why = "offline";
+            return nullptr;
+        }
+        return m;
+    }
