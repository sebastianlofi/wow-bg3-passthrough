+                return;
+            }
+            size_t mine = 0;
+            for (Bot const& b : g_bots)
+                if (b.owner == og)
+                    ++mine;
+            if (mine >= MAX_BOTS)
+                return out.Add(head + "refused toomany");
+        }
+
+        Bot b;
+        b.name = name;
+        b.owner = og;
+        b.race = uint8(race);
+        b.cls = uint8(cls);
+        b.gender = uint8(gender);
+        b.spot = spot;
+        b.since = now;
+        char const* how = "created";
+        if (!existing.IsEmpty())
+        {
+            // An existing character: ours only if it lives on a bot account.
+            uint32 const acc = sObjectMgr.GetPlayerAccountIdByGUID(existing);
+            if (!acc || !IsBotAccount(acc))
+                return out.Add(head + "refused taken");
+            if (Player* online = ObjectAccessor::FindPlayer(existing))
+            {
+                (void)online;
+                return out.Add(head + "refused online");
+            }
+            b.guid = existing;
+            b.account = acc;
+            if (PlayerCacheData const* d = sObjectMgr.GetPlayerDataByGUID(existing.GetCounter()))
+            {
+                b.race = d->uiRace;
+                b.cls = d->uiClass;
+                b.gender = d->uiGender;
+            }
+            b.state = BotState::Create;
+            b.since = now - CREATE_WAIT_MS;                 // nothing to wait for
+            how = "existing";
+        }
+        else
+        {
+            b.account = BotAccount(name, true);
+            b.state = BotState::Account;
+        }
+        {
+            WriteLock lock(g_botLock);
+            g_bots.push_back(b);
+            IndexBot(b);
+        }
+        out.Add(head + "loading " + (b.guid.IsEmpty() ? std::string("-") : Hex(b.guid)) + " " + how +
+            Fmt(" %u %u %u", uint32(b.race), uint32(b.cls), uint32(b.gender)));
+    }
+
+    // Saved now, logged out by PlayerBotMgr within its update interval.
+    bool StartRemoval(Bot& b, Player* m)
+    {
+        b.state = BotState::Removing;
+        b.since = WorldTimer::getMSTime();
+        if (!m)
+            return false;
+        // PlayerBotMgr logs it out within its update interval; the logout saves it (0010 hook).
+        if (PlayerBotEntry* e = m->GetSession()->GetBot())
+            e->requestRemoval = true;
+        return true;
+    }
+
+    void BotRemove(Player* owner, std::string const& name, Out& out)
+    {
+        std::string const head = "WOWBG3 bot " + name + " ";
+        ObjectGuid g;
+        {
+            ReadLock lock(g_botLock);
+            for (Bot const& b : g_bots)
+                if (Lower(b.name) == Lower(name) && b.owner == owner->GetObjectGuid())
+                    g = b.guid;
+        }
+        Player* m = g.IsEmpty() ? nullptr : ObjectAccessor::FindPlayerNotInWorld(g);
+        WriteLock lock(g_botLock);
+        for (auto it = g_bots.begin(); it != g_bots.end(); ++it)
+        {
+            if (Lower(it->name) != Lower(name) || it->owner != owner->GetObjectGuid())
+                continue;
+            if (it->state == BotState::Removing)
+                return out.Add(head + "removing " + Hex(it->guid));
+            if (it->state == BotState::Account || (it->state == BotState::Create && !m))
+            {
+                // Not logged in yet: just forget the request.
+                std::string const gs = it->guid.IsEmpty() ? std::string("-") : Hex(it->guid);
+                UnindexBot(it->guid);
+                g_bots.erase(it);
+                return out.Add(head + "offline " + gs);
+            }
+            if (!StartRemoval(*it, m) && it->state != BotState::Loading)
+            {
+                std::string const gs = Hex(it->guid);
+                UnindexBot(it->guid);
+                g_bots.erase(it);
+                return out.Add(head + "offline " + gs);
+            }
+            return out.Add(head + "removing " + Hex(it->guid));
+        }
+        out.Add(head + "refused unknown");
+    }
+
+    void BotList(Player* owner, Out& out)
+    {
+        std::vector<std::pair<Bot, Player*>> mine;
+        {
+            ReadLock lock(g_botLock);
+            for (Bot const& b : g_bots)
+                if (b.owner == owner->GetObjectGuid())
+                    mine.push_back({ b, nullptr });
+        }
+        for (auto& bp : mine)
+        {
+            bp.second = bp.first.guid.IsEmpty() ? nullptr : ObjectAccessor::FindPlayer(bp.first.guid);
+            out.Add(BotLine(bp.first, bp.second));
+        }
+        out.Add("WOWBG3 bots " + std::to_string(mine.size()));
+    }
+
+    // move MEMBER X Y Z [MAP [O]]: the owner or a bot, anywhere (near or far teleport).
+    void Move(Player* owner, std::vector<std::string> const& a, Out& out)
+    {
+        std::string const head = "WOWBG3 move " + a[2] + " ";
+        char const* why = nullptr;
+        Player* m = Member(owner, a[2], why);
+        if (!m)
+            return out.Add(head + "refused " + why);
+        Spot s;
+        if (!ParseSpot(a, 3, owner, s))
+            return out.Add(head + "refused badpos");
+        if (m->IsTaxiFlying())
+            return out.Add(head + "refused taxi");
+        if (m->IsBeingTeleported())
+            return out.Add(head + "refused busy");
+        bool const near = m->GetMapId() == s.map;
+        if (m != owner)
+        {
+            WriteLock lock(g_botLock);
+            for (Bot& b : g_bots)
+            {
+                if (b.guid == m->GetObjectGuid())
+                {
+                    b.spot = s;
+                    b.teleported = true;
+                    b.refresh = true;
+                }
+            }
+        }
+        if (!m->TeleportTo(s.map, s.x, s.y, s.z, s.o, TELE_TO_NOT_LEAVE_COMBAT | TELE_TO_NOT_UNSUMMON_PET))
+            return out.Add(head + "refused failed");
+        out.Add(Fmt("WOWBG3 move %s ok %u %.2f %.2f %.2f %s", a[2].c_str(), s.map, s.x, s.y, s.z, near ? "near" : "far"));
+    }
+
+    // ---- Far Sight ----
+
+    std::mutex g_viewLock;
+    std::unordered_map<uint64, uint64> g_views;             // owner -> member it views (not itself)
+
+    void View(Player* owner, std::string const& name, Out& out)
+    {
+        std::string const head = "WOWBG3 view " + name + " ";
+        char const* why = nullptr;
+        Player* m = Member(owner, name, why);
+        if (!m)
+            return out.Add(head + "refused " + why);
+        Camera& cam = owner->GetCamera();
+        if (m == owner)
+        {
+            cam.ResetView();
+            std::lock_guard<std::mutex> lock(g_viewLock);
+            g_views.erase(owner->GetObjectGuid().GetRawValue());
+            return out.Add(head + "ok " + Hex(owner->GetObjectGuid()));
+        }
+        if (!owner->IsInMap(m))
+            return out.Add(head + "refused map");
+        cam.SetView(m);
+        if (cam.GetBody() != m)
+            return out.Add(head + "refused failed");
+        {
+            std::lock_guard<std::mutex> lock(g_viewLock);
+            g_views[owner->GetObjectGuid().GetRawValue()] = m->GetObjectGuid().GetRawValue();
+        }
+        out.Add(head + "ok " + Hex(m->GetObjectGuid()));
+    }
+
+    // ---- per-member creature feed ----
+
+    struct Seen
+    {
+        uint32 entry = 0, level = 0, hp = 0, maxhp = 0, faction = 0, display = 0, npcflags = 0;
+        uint8 react = 0;
+        float x = 0, y = 0, z = 0, o = 0;
+        std::string flags;
+    };
+
+    struct Feed
+    {
+        ObjectGuid owner;
+        ObjectGuid member;
+        std::string memberName;
+        float range = 100.0f;
+        uint32 interval = 500;
+        uint32 elapsed = 0;
+        uint32 seq = 0;
+        std::unordered_map<uint64, Seen> seen;
+    };
+
+    std::vector<Feed> g_feeds;                              // world thread only
+
+    std::string Flags(Creature* c, Player* m)
+    {
+        std::string f;
+        if (!c->IsAlive()) f += 'd';
+        if (c->IsInCombat()) f += 'c';
+        if (IsHeld(c)) f += 'h';
+        if (c->IsInEvadeMode()) f += 'e';
+        if (c->IsAlive() && (c->IsMoving() || !c->movespline->Finalized())) f += 'm';
+        if (c->IsAlive() && m->IsValidAttackTarget(c)) f += 'a';
+        if (c->HasLootRecipient() && !c->IsTappedBy(m)) f += 't';
+        if (c->HasFlag(UNIT_DYNAMIC_FLAGS, UNIT_DYNFLAG_LOOTABLE)) f += 'l';
+        if (c->IsPet() || c->IsTotem() || c->GetCharmerOrOwnerGuid().IsPlayer()) f += 'p';
+        if (c->GetCreatureType() == CREATURE_TYPE_CRITTER) f += 'k';
+        return f.empty() ? "-" : f;
+    }
+
+    Seen Look(Creature* c, Player* m)
+    {
+        Seen s;
+        s.entry = c->GetEntry();
+        s.level = c->GetLevel();
+        s.hp = c->GetHealth();
+        s.maxhp = c->GetMaxHealth();
+        s.faction = c->GetFactionTemplateId();
+        s.display = c->GetDisplayId();
+        s.npcflags = c->GetUInt32Value(UNIT_NPC_FLAGS);
+        s.react = uint8(c->GetReactionTo(m));
+        s.x = c->GetPositionX();
+        s.y = c->GetPositionY();
+        s.z = c->GetPositionZ();
+        s.o = c->GetOrientation();
+        s.flags = Flags(c, m);
+        return s;
+    }
+
+    // `WOWBG3 cr MEMBER GUID ENTRY LEVEL HP MAXHP REACT FACTION GROUP X Y Z O DISPLAY NPCFLAGS FLAGS NAME`
+    std::string CreatureLine(std::string const& member, Creature* c, Seen const& s)
+    {
+        FactionTemplateEntry const* ft = c->GetFactionTemplateEntry();
+        return Fmt("WOWBG3 cr %s %s %u %u %u %u %u %u %u %.2f %.2f %.2f %.3f %u %X %s %s",
+            member.c_str(), Hex(c->GetObjectGuid()).c_str(), s.entry, s.level, s.hp, s.maxhp, uint32(s.react),
+            s.faction, ft ? ft->ourMask : 0u, s.x, s.y, s.z, s.o, s.display, s.npcflags, s.flags.c_str(), c->GetName());
+    }
+
+    // What the member's client would see: its visible list (WoW's own visibility, grid
+    // and phase rules, from the member's own view point), creatures only, within range.
+    std::vector<Creature*> Around(Player* m, float range)
+    {
+        std::vector<Creature*> list;
+        Map* map = m->GetMap();
+        std::vector<ObjectGuid> guids;
+        {
+            std::shared_lock<std::shared_timed_mutex> lock(m->m_visibleGUIDs_lock);
+            for (ObjectGuid const& g : m->m_visibleGUIDs)
+                if (g.IsCreatureOrPet())
+                    guids.push_back(g);
+        }
+        for (ObjectGuid const& g : guids)
+        {
+            Creature* c = map->GetAnyTypeCreature(g);
+            if (c && c->IsInWorld() && (range <= 0.0f || m->IsWithinDist(c, range, false)))
+                list.push_back(c);
+        }
+        return list;
+    }
+
+    // near MEMBER [RANGE]
+    void Near(Player* owner, std::vector<std::string> const& a, Out& out)
+    {
+        std::string const head = "WOWBG3 near " + a[2] + " ";
+        char const* why = nullptr;
+        Player* m = Member(owner, a[2], why);
+        if (!m)
+            return out.Add(head + "refused " + why);
+        // RANGE `all`: the whole visible list, wherever its view point is (Far Sight).
+        float range = 100.0f;
+        if (a.size() > 3 && a[3] == "all")
+            range = 0.0f;
+        else if (a.size() > 3 && (!ParseFloat(a[3], range) || range <= 0 || range > FEED_MAX_RANGE))
+            return out.Add(head + "refused usage");
+        std::vector<Creature*> list = Around(m, range);
+        out.Add(Fmt("WOWBG3 near %s %s %u %.2f %.2f %.2f %u", a[2].c_str(), Hex(m->GetObjectGuid()).c_str(), m->GetMapId(),
+            m->GetPositionX(), m->GetPositionY(), m->GetPositionZ(), uint32(list.size())));
+        for (Creature* c : list)
+            out.Add(CreatureLine(a[2], c, Look(c, m)));
+    }
+
+    // feed MEMBER on [RANGE [MS]] | feed MEMBER off | feed off
+    void FeedVerb(Player* owner, std::vector<std::string> const& a, Out& out)
+    {
+        ObjectGuid const og = owner->GetObjectGuid();
+        if (a.size() == 3 && a[2] == "off")
+        {
+            size_t n = 0;
+            for (auto it = g_feeds.begin(); it != g_feeds.end();)
+            {
+                if (it->owner == og)
+                {
+                    it = g_feeds.erase(it);
+                    ++n;
+                }
+                else
+                    ++it;
+            }
+            return out.Add("WOWBG3 feed all off " + std::to_string(n));
+        }
+        std::string const head = "WOWBG3 feed " + a[2] + " ";
+        if (a.size() < 4 || (a[3] != "on" && a[3] != "off"))
+            return out.Add(head + "refused usage");
+        char const* why = nullptr;
+        Player* m = Member(owner, a[2], why);
+        if (a[3] == "off")
+        {
+            for (auto it = g_feeds.begin(); it != g_feeds.end(); ++it)
+            {
+                if (it->owner == og && Lower(it->memberName) == Lower(a[2]))
+                {
+                    g_feeds.erase(it);
+                    return out.Add(head + "off");
+                }
+            }
+            return out.Add(head + "off");
+        }
+        if (!m)
+            return out.Add(head + "refused " + why);
+        float range = 100.0f;
+        uint32 interval = 500;
+        if (a.size() > 4 && (!ParseFloat(a[4], range) || range <= 0 || range > FEED_MAX_RANGE))
+            return out.Add(head + "refused usage");
+        if (a.size() > 5 && (!ParseUInt(a[5], interval, 60000) || interval < FEED_MIN_MS))
+            return out.Add(head + "refused usage");
+        if (a.size() > 6)
+            return out.Add(head + "refused usage");
+        Feed* f = nullptr;
+        for (Feed& x : g_feeds)
+            if (x.owner == og && x.member == m->GetObjectGuid())
+                f = &x;
+        if (!f)
+        {
+            g_feeds.emplace_back();
+            f = &g_feeds.back();
+            f->owner = og;
+            f->member = m->GetObjectGuid();
+        }
+        f->memberName = a[2];
+        f->range = range;
+        f->interval = interval;
+        f->elapsed = interval;                              // first full snapshot at the next tick
+        f->seen.clear();
+        out.Add(Fmt("WOWBG3 feed %s on %s %.0f %u", a[2].c_str(), Hex(m->GetObjectGuid()).c_str(), range, interval));
+    }
+
+    bool Changed(Seen const& a, Seen const& b)
+    {
+        return a.entry != b.entry || a.level != b.level || a.hp != b.hp || a.maxhp != b.maxhp || a.faction != b.faction ||
+            a.display != b.display || a.npcflags != b.npcflags || a.react != b.react || a.flags != b.flags ||
+            std::fabs(a.x - b.x) > 0.3f || std::fabs(a.y - b.y) > 0.3f || std::fabs(a.z - b.z) > 0.3f ||
+            std::fabs(a.o - b.o) > 0.1f;
+    }
+
+    // Every interval: the creatures that changed (`cr`), left (`crgone`), then `tick`.
+    void UpdateFeeds(uint32 diff)
+    {
+        for (auto it = g_feeds.begin(); it != g_feeds.end();)
+        {
+            Feed& f = *it;
+            Player* owner = ObjectAccessor::FindPlayer(f.owner);
+            Player* m = ObjectAccessor::FindPlayer(f.member);
+            if (!owner)
+            {
+                it = g_feeds.erase(it);
+                continue;
+            }
+            if (!m || !m->IsInWorld())
+            {
+                SayTo(owner, "WOWBG3 feed " + f.memberName + " off gone");
+                it = g_feeds.erase(it);
+                continue;
+            }
+            f.elapsed += diff;
+            if (f.elapsed < f.interval)
+            {
+                ++it;
+                continue;
+            }
+            f.elapsed = 0;
+            ++f.seq;
+            std::unordered_map<uint64, Seen> now;
+            std::vector<std::string> lines;
+            for (Creature* c : Around(m, f.range))
+            {
+                uint64 const key = c->GetObjectGuid().GetRawValue();
+                Seen s = Look(c, m);
+                auto old = f.seen.find(key);
+                if (old == f.seen.end() || Changed(old->second, s))
+                    lines.push_back(CreatureLine(f.memberName, c, s));
+                else
+                    s = old->second;                        // keep the last sent values as the reference
+                now.emplace(key, s);
+            }
+            for (auto const& kv : f.seen)
+                if (now.find(kv.first) == now.end())
+                    lines.push_back("WOWBG3 crgone " + f.memberName + " " + Hex(ObjectGuid(kv.first)));
+            f.seen.swap(now);
+            lines.push_back(Fmt("WOWBG3 tick %s %u %u %u %.2f %.2f %.2f", f.memberName.c_str(), f.seq, uint32(f.seen.size()),
+                m->GetMapId(), m->GetPositionX(), m->GetPositionY(), m->GetPositionZ()));
+            for (std::string const& l : lines)
+                SayTo(owner, l);
+            ++it;
+        }
+    }
+
+    // ---- death (BG3 rules) ----
+
+    // health MEMBER HP MAX: the member's WoW HP as a fraction of its max; 0 kills it in place
+    // (an environmental-style death: no killer, the usual durability loss, body kept).
+    void Health(Player* owner, std::vector<std::string> const& a, Out& out)
+    {
+        std::string const head = "WOWBG3 health " + a[2] + " ";
+        char const* why = nullptr;
+        Player* m = Member(owner, a[2], why);
+        if (!m)
+            return out.Add(head + "refused " + why);
+        uint32 hp = 0, max = 0;
+        if (!ParseUInt(a[3], hp) || !ParseUInt(a[4], max) || max == 0 || hp > max)
+            return out.Add(head + "refused badhp");
+        uint32 const maxHealth = m->GetMaxHealth();
+        if (!m->IsAlive())
+            return out.Add(head + "dead 0 " + std::to_string(maxHealth));
+        uint64 target = (uint64(maxHealth) * hp * 2 + max) / (uint64(max) * 2);
+        if (hp > 0 && target == 0)
+            target = 1;
+        if (target > maxHealth)
+            target = maxHealth;
+        if (target > 0)
+        {
+            if (m->GetHealth() != uint32(target))
+                m->SetHealth(uint32(target));
+            return out.Add(head + "ok " + std::to_string(m->GetHealth()) + " " + std::to_string(maxHealth));
+        }
+        KeepBody(m, true);
+        m->DealDamage(m, m->GetHealth(), nullptr, SELF_DAMAGE, SPELL_SCHOOL_MASK_NORMAL, nullptr, false);
+        if (m->IsAlive())
+            return out.Add(head + "ok " + std::to_string(m->GetHealth()) + " " + std::to_string(maxHealth));
+        m->DurabilityLossAll(0.10f, false);
+        out.Add(head + "died 0 " + std::to_string(maxHealth));
+    }
+
+    // revive MEMBER [HP MAX]: back to life where the body lies (BG3's revive), at that
+    // fraction of max HP (default full). A ghost (released before this rule) is brought
+    // back to its corpse first when it is on the same map.
+    void Revive(Player* owner, std::vector<std::string> const& a, Out& out)
+    {
+        std::string const head = "WOWBG3 revive " + a[2] + " ";
+        char const* why = nullptr;
+        Player* m = Member(owner, a[2], why);
+        if (!m)
+            return out.Add(head + "refused " + why);
+        uint32 hp = 1, max = 1;
+        if (a.size() == 5 && (!ParseUInt(a[3], hp) || !ParseUInt(a[4], max) || max == 0 || hp == 0 || hp > max))
+            return out.Add(head + "refused badhp");
+        if (a.size() != 3 && a.size() != 5)
+            return out.Add(head + "refused usage");
+        if (m->IsAlive())
+            return out.Add(head + "alive " + std::to_string(m->GetHealth()) + " " + std::to_string(m->GetMaxHealth()));
+        if (m->HasFlag(PLAYER_FLAGS, PLAYER_FLAGS_GHOST))
+        {
+            if (Corpse* corpse = m->GetCorpse())
+                if (corpse->GetMapId() == m->GetMapId())
+                    m->NearTeleportTo(corpse->GetPositionX(), corpse->GetPositionY(), corpse->GetPositionZ(), corpse->GetOrientation());
+        }
+        m->ResurrectPlayer(1.0f, false);
+        m->SpawnCorpseBones();
+        uint32 const maxHealth = m->GetMaxHealth();
+        uint64 target = (uint64(maxHealth) * hp * 2 + max) / (uint64(max) * 2);
+        if (target == 0)
+            target = 1;
+        if (target > maxHealth)
+            target = maxHealth;
+        m->SetHealth(uint32(target));
+        KeepBody(m, false);
+        out.Add(head + "ok " + std::to_string(m->GetHealth()) + " " + std::to_string(maxHealth));
+    }
+
+    // ---- levels (console) ----
+
+    // level NAME: `WOWBG3 level NAME LEVEL XP online|offline` (offline: the stored level).
+    // level NAME N: an online party bot to level N (1-60, also down), XP 0; it stops following
+    // the hero's level until `level NAME follow`.
+    void Level(std::vector<std::string> const& a, Out& out)
+    {
+        std::string name = a[2];
+        normalizePlayerName(name);
+        std::string const head = "WOWBG3 level " + name + " ";
+        ObjectGuid const g = sObjectMgr.GetPlayerGuidByName(name);
+        if (g.IsEmpty())
+            return out.Add(head + "refused unknown");
+        Player* m = ObjectAccessor::FindPlayer(g);
+        if (a.size() == 3)
+        {
+            if (m)
+                return out.Add(head + std::to_string(m->GetLevel()) + " " + std::to_string(m->GetUInt32Value(PLAYER_XP)) + " online");
+            PlayerCacheData const* d = sObjectMgr.GetPlayerDataByGUID(g.GetCounter());
+            return out.Add(head + std::to_string(d ? d->uiLevel : 0) + " - offline");
+        }
+        uint32 level = 0;
+        bool const follow = a[3] == "follow";
+        if (!follow && (!ParseUInt(a[3], level, 255) || level < 1 || level > sWorld.getConfig(CONFIG_UINT32_MAX_PLAYER_LEVEL)))
+            return out.Add(head + "refused badlevel");
+        ObjectGuid owner;
+        {
+            WriteLock lock(g_botLock);
+            for (Bot& b : g_bots)
+            {
+                if (b.guid == g)
+                {
+                    owner = b.owner;
+                    b.follow = follow;
+                }
+            }
+        }
+        if (owner.IsEmpty())
+            return out.Add(head + "refused notbot");
+        if (!m)
+            return out.Add(head + "refused offline");
+        if (follow)
+        {
+            FollowLevel(ObjectAccessor::FindPlayer(owner), m);
+            return out.Add(head + "follow " + std::to_string(m->GetLevel()));
+        }
+        if (m->GetLevel() != level)
+        {
+            m->GiveLevel(level);
+            m->InitTalentForLevel();
+        }
+        m->SetUInt32Value(PLAYER_XP, 0);
+        out.Add(head + "ok " + std::to_string(m->GetLevel()));
+    }
+
+    // ---- movement map tiles written while the server runs ----
+
+    // mmtile MAP X Y [reload]: the tile file mmaps/MMMYYXX.mmtile (X, Y as MoveMapGenerator's
+    // --tile X,Y) into the running server's navigation mesh. Runs while no map updates, so no
+    // path query reads the mesh meanwhile.
+    void MmTile(std::vector<std::string> const& a, size_t i, Out& out)
+    {
+        uint32 map = 0, x = 0, y = 0;
+        if (a.size() < i + 3 || a.size() > i + 4 || !ParseUInt(a[i], map, 10000) || !ParseUInt(a[i + 1], x, 63) ||
+            !ParseUInt(a[i + 2], y, 63) || (a.size() == i + 4 && a[i + 3] != "reload"))
+            return out.Add("WOWBG3 mmtile refused usage");
+        std::string const head = Fmt("WOWBG3 mmtile %u %u %u ", map, x, y);
+        if (!sMapStorage.LookupEntry<MapEntry>(map))
+            return out.Add(head + "refused badmap");
+        char file[64];
+        snprintf(file, sizeof(file), "mmaps/%03u%02u%02u.mmtile", map, y, x);
+        std::string const path = sWorld.GetDataPath() + file;
+        if (FILE* fh = fopen(path.c_str(), "rb"))
+            fclose(fh);
+        else
+            return out.Add(head + "missing");
+        MMAP::MMapManager* mgr = MMAP::MMapFactory::createOrGetMMapManager();
+        bool const reload = a.size() == i + 4;
+        uint32 const before = mgr->getLoadedTilesCount();
+        if (reload)
+            mgr->unloadMap(map, int32(x), int32(y));
+        bool const loaded = mgr->loadMap(map, int32(x), int32(y));
+        if (loaded)
+            return out.Add(head + (reload ? "reloaded " : "loaded ") + std::to_string(mgr->getLoadedTilesCount()));
+        // false: already in the mesh, or the file is not a valid tile (the server log says which)
+        if (mgr->getLoadedTilesCount() == before && !reload)
+            return out.Add(head + "already " + std::to_string(before));
+        out.Add(head + "failed");
+    }
+}
+
+// ---- hooks ----
+
+Player* LivingMember(Player const* owner)
+{
+    if (!owner || !AnyBots())
+        return nullptr;
+    std::vector<ObjectGuid> mine;
+    {
+        ReadLock lock(g_botLock);
+        for (Bot const& b : g_bots)
+            if (b.owner == owner->GetObjectGuid() && b.state == BotState::Online)
+                mine.push_back(b.guid);
+    }
+    for (ObjectGuid g : mine)
+    {
+        Player* m = ObjectAccessor::FindPlayer(g);
+        if (m && m->IsInWorld() && m->IsAlive() && m->GetMapId() == owner->GetMapId() &&
+            m->GetInstanceId() == owner->GetInstanceId())
+            return m;
+    }
+    return nullptr;
+}
+
+Player* FindMember(Player* owner, std::string const& name, char const*& why)
+{
+    return Member(owner, name, why);
+}
+
+ObjectGuid BotOwner(Player const* player)
+{
+    if (!player || !g_botCount.load(std::memory_order_relaxed))
+        return ObjectGuid();
+    ReadLock lock(g_botLock);
+    auto it = g_botOwner.find(player->GetObjectGuid().GetRawValue());
+    return it == g_botOwner.end() ? ObjectGuid() : ObjectGuid(it->second);
+}
+
+bool AnyBots()
+{
+    return g_botCount.load(std::memory_order_relaxed) != 0;
+}
+
+bool IsPartyBot(WorldSession const* session)
+{
+    PlayerBotEntry* e = session ? session->GetBot() : nullptr;
+    return e && e->ai && dynamic_cast<PartyBotPuppetAI*>(e->ai.get()) != nullptr;
+}
+
+bool NearParty(Player* p, WorldObject const* target, float range)
+{
+    if (p->IsWithinDistInMap(target, range))
+        return true;
+    if (!AnyBots())
+        return false;
+    std::vector<ObjectGuid> mine;
+    {
+        ReadLock lock(g_botLock);
+        for (Bot const& b : g_bots)
+            if (b.owner == p->GetObjectGuid() && b.state == BotState::Online)
+                mine.push_back(b.guid);
+    }
+    for (ObjectGuid g : mine)
+    {
+        Player* m = ObjectAccessor::FindPlayer(g);
+        if (m && m->IsInWorld() && m->IsWithinDistInMap(target, range))
+            return true;
+    }
+    return false;
+}
+
+void SayTo(Player* player, std::string const& line)
+{
+    if (!player || !player->GetSession())
+        return;
+    if (player->GetSession()->GetBot())
+    {
+        // Nobody reads a bot's chat: the console tests read the server log.
+        sLog.Out(LOG_BASIC, LOG_LVL_MINIMAL, "WOWBG3 to %s: %s", player->GetName(), line.c_str());
+        return;
+    }
+    ChatHandler(player->GetSession()).SendSysMessage(line.c_str());
+}
+
+bool ExecuteParty(Player* p, std::vector<std::string> const& a, std::vector<std::string>& lines)
+{
+    Out out{ lines };
+    std::string const verb = a.size() > 1 ? a[1] : "";
+    std::string const sub = a.size() > 2 ? a[2] : "";
+    if (verb == "bot" && sub == "add" && a.size() >= 7 && a.size() <= 12)
+        BotAdd(p, a, out);
+    else if (verb == "bot" && sub == "remove" && a.size() == 4)
+        BotRemove(p, a[3], out);
+    else if (verb == "bot" && sub == "list" && a.size() == 3)
+        BotList(p, out);
+    else if (verb == "move" && a.size() >= 6 && a.size() <= 8)
+        Move(p, a, out);
+    else if (verb == "view" && a.size() == 3)
+        View(p, a[2], out);
+    else if (verb == "near" && (a.size() == 3 || a.size() == 4))
+        Near(p, a, out);
+    else if (verb == "feed" && a.size() >= 3 && a.size() <= 6)
+        FeedVerb(p, a, out);
+    else if (verb == "health" && a.size() == 5)
+        Health(p, a, out);
+    else if (verb == "revive" && (a.size() == 3 || a.size() == 5))
+        Revive(p, a, out);
+    else if (verb == "mmtile")
+        MmTile(a, 2, out);
+    else
+        return false;
+    return true;
+}
+
+bool ExecuteGlobal(std::vector<std::string> const& a, std::vector<std::string>& lines)
+{
+    Out out{ lines };
+    std::string const verb = a.size() > 1 ? a[1] : "";
+    if (verb == "mmtile")
+        MmTile(a, 2, out);
+    else if (verb == "level" && (a.size() == 3 || a.size() == 4))
+        Level(a, out);
+    else if ((verb == "login" || verb == "logout") && a.size() == 3)
+    {
+        // Console test tool: an offline character (any account not online) logged in or out
+        // as a puppet with no client, to stand in for a hero in server tests.
+        std::string name = a[2];
+        normalizePlayerName(name);
+        ObjectGuid const g = sObjectMgr.GetPlayerGuidByName(name);
+        if (g.IsEmpty())
+            out.Add("WOWBG3 " + verb + " " + name + " refused unknown");
+        else if (verb == "login")
+        {
+            if (ObjectAccessor::FindPlayer(g))
+                out.Add("WOWBG3 login " + name + " online " + Hex(g));
+            else if (sPlayerBotMgr.AddBot(g.GetCounter(), false, new PartyBotPuppetAI()))
+            {
+                g_puppets.push_back(g);
+                out.Add("WOWBG3 login " + name + " loading " + Hex(g));
+            }
+            else
+                out.Add("WOWBG3 login " + name + " refused busy");
+        }
+        else
+        {
+            Player* p = ObjectAccessor::FindPlayerNotInWorld(g);
+            PlayerBotEntry* e = p ? p->GetSession()->GetBot() : nullptr;
+            if (!e || !BotOwner(p).IsEmpty())
+                out.Add("WOWBG3 logout " + name + " refused notpuppet");
+            else
+            {
+                e->requestRemoval = true;
+                out.Add("WOWBG3 logout " + name + " ok " + Hex(g));
+            }
+        }
+    }
+    else
+        return false;
+    return true;
+}
+
+void OnOwnerLogout(Player* owner)
+{
+    if (!owner)
+        return;
+    ObjectGuid const og = owner->GetObjectGuid();
+    {
+        std::lock_guard<std::mutex> lock(g_viewLock);
+        g_views.erase(og.GetRawValue());
+    }
+    for (auto it = g_feeds.begin(); it != g_feeds.end();)
+        it = it->owner == og ? g_feeds.erase(it) : it + 1;
+    if (!AnyBots() && g_bots.empty())
+        return;
+    std::vector<ObjectGuid> mine;
+    {
+        ReadLock lock(g_botLock);
+        for (Bot const& b : g_bots)
+            if (b.owner == og && !b.guid.IsEmpty())
+                mine.push_back(b.guid);
+    }
+    std::vector<std::pair<ObjectGuid, Player*>> found;
+    for (ObjectGuid g : mine)
+        found.push_back({ g, ObjectAccessor::FindPlayerNotInWorld(g) });
+    WriteLock lock(g_botLock);
+    for (auto it = g_bots.begin(); it != g_bots.end();)
+    {
+        if (it->owner != og)
+        {
+            ++it;
+            continue;
+        }
+        Player* m = nullptr;
+        for (auto const& f : found)
+            if (f.first == it->guid)
+                m = f.second;
+        if (it->state == BotState::Removing || (it->state == BotState::Loading && !m))
+        {
+            ++it;                                           // the tick finishes these
+            continue;
+        }
+        if (m && StartRemoval(*it, m))
+        {
+            ++it;
+            continue;
+        }
+        UnindexBot(it->guid);
+        it = g_bots.erase(it);
+    }
+}
+
+void UpdateParty(uint32 diff)
+{
+    static uint32 timer = 0;
+    timer += diff;
+    if (timer < TICK_MS)
+        return;
+    uint32 const elapsed = timer;
+    timer = 0;
+
+    UpdateFeeds(elapsed);
+
+    // Far Sight ended by itself (the member logged out or changed map): tell the owner.
+    {
+        std::vector<std::pair<uint64, uint64>> views;
+        {
+            std::lock_guard<std::mutex> lock(g_viewLock);
+            views.assign(g_views.begin(), g_views.end());
+        }
+        for (auto const& v : views)
+        {
+            Player* owner = ObjectAccessor::FindPlayer(ObjectGuid(v.first));
+            if (owner && owner->IsInWorld() && owner->GetCamera().GetBody() &&
+                owner->GetCamera().GetBody()->GetObjectGuid().GetRawValue() == v.second)
+                continue;
+            {
+                std::lock_guard<std::mutex> lock(g_viewLock);
+                g_views.erase(v.first);
+            }
+            if (owner)
+                SayTo(owner, "WOWBG3 view self reset");
+        }
+    }
+
+    // A far teleport waits for the client's MSG_MOVE_WORLDPORT_ACK, and a bot has no client
+    // (PlayerBotAI acks only while in a map, which a far teleport has just left): ack it here.
+    {
+        std::vector<ObjectGuid> all = g_puppets;
+        {
+            ReadLock lock(g_botLock);
+            for (Bot const& b : g_bots)
+                if (!b.guid.IsEmpty())
+                    all.push_back(b.guid);
+        }
+        for (ObjectGuid g : all)
+        {
+            Player* m = ObjectAccessor::FindPlayerNotInWorld(g);
+            if (m && m->IsBeingTeleportedFar() && m->GetSession() && m->GetSession()->GetBot() &&
+                !m->GetSession()->PlayerLoading())
+                m->GetSession()->HandleMoveWorldportAck();
+        }
+        g_puppets.erase(std::remove_if(g_puppets.begin(), g_puppets.end(),
+            [](ObjectGuid g) { return !ObjectAccessor::FindPlayerNotInWorld(g); }), g_puppets.end());
+    }
+
+    if (g_bots.empty())
+        return;
+
+    uint32 const now = WorldTimer::getMSTime();
+    std::vector<Bot> snapshot;
+    {
+        ReadLock lock(g_botLock);
+        snapshot = g_bots;
+    }
+
+    struct Change
+    {
+        std::string name;
+        BotState state;
+        ObjectGuid guid;
+        uint32 account;
+        bool erase;
+        bool teleported;
+        bool refreshed = false;
+    };
+    std::vector<Change> changes;
+    std::vector<std::pair<ObjectGuid, std::string>> says;  // owner, line
+
+    for (Bot const& b : snapshot)
+    {
+        Player* owner = ObjectAccessor::FindPlayer(b.owner);
+        uint32 const age = WorldTimer::getMSTimeDiff(b.since, now);
+        // Not-in-world too: a bot in a far teleport is between maps for a moment.
+        Player* m = b.guid.IsEmpty() ? nullptr : ObjectAccessor::FindPlayerNotInWorld(b.guid);
+        switch (b.state)
+        {
+            case BotState::Account:
+            {
+                uint32 const acc = BotAccount(b.name, false);
+                if (acc)
+                {
+                    Bot nb = b;
+                    nb.account = acc;
+                    ObjectGuid const g = CreateCharacter(nb);
+                    if (g.IsEmpty())
+                    {
+                        says.push_back({ b.owner, "WOWBG3 bot " + b.name + " failed create" });
+                        changes.push_back({ b.name, b.state, b.guid, acc, true, false });
+                    }
+                    else
+                        changes.push_back({ b.name, BotState::Create, g, acc, false, false });
+                }
+                else if (age > ACCOUNT_WAIT_MS)
+                {
+                    says.push_back({ b.owner, "WOWBG3 bot " + b.name + " failed account" });
+                    changes.push_back({ b.name, b.state, b.guid, 0, true, false });
+                }
+                break;
+            }
+            case BotState::Create:
+            {
+                if (age < CREATE_WAIT_MS)
+                    break;
+                if (!owner)
+                {
+                    changes.push_back({ b.name, b.state, b.guid, b.account, true, false });
+                    break;
+                }
+                if (sPlayerBotMgr.AddBot(b.guid.GetCounter(), false, new PartyBotPuppetAI()))
+                    changes.push_back({ b.name, BotState::Loading, b.guid, b.account, false, false });
+                else if (age > LOGIN_WAIT_MS)
+                {
+                    says.push_back({ b.owner, "WOWBG3 bot " + b.name + " failed login" });
+                    changes.push_back({ b.name, b.state, b.guid, b.account, true, false });
+                }
+                break;
+            }
+            case BotState::Loading:
+            {
+                if (m && m->IsInWorld())
+                {
+                    changes.push_back({ b.name, BotState::Arriving, b.guid, b.account, false, false });
+                    break;
+                }
+                if (age > LOGIN_WAIT_MS)
+                {
+                    says.push_back({ b.owner, "WOWBG3 bot " + b.name + " failed login" });
+                    if (m)
+                        if (PlayerBotEntry* e = m->GetSession()->GetBot())
+                            e->requestRemoval = true;
+                    changes.push_back({ b.name, b.state, b.guid, b.account, true, false });
+                }
+                break;
+            }
+            case BotState::Arriving:
+            {
+                if (!m || !m->IsInWorld())
+                {
+                    if (age > LOGIN_WAIT_MS)
+                        changes.push_back({ b.name, BotState::Online, b.guid, b.account, false, b.teleported });
+                    break;
+                }
+                if (!b.teleported && b.spot.set)
+                {
+                    if (!m->TeleportTo(b.spot.map, b.spot.x, b.spot.y, b.spot.z, b.spot.o, TELE_TO_NOT_LEAVE_COMBAT | TELE_TO_NOT_UNSUMMON_PET))
+                        says.push_back({ b.owner, "WOWBG3 bot " + b.name + " teleport failed" });
+                    changes.push_back({ b.name, BotState::Arriving, b.guid, b.account, false, true });
+                    break;
+                }
+                bool const there = !b.spot.set || (m->GetMapId() == b.spot.map &&
+                    m->GetDistance(b.spot.x, b.spot.y, b.spot.z) < ARRIVED_YARDS);
+                if (m->IsBeingTeleported() || (!there && age < LOGIN_WAIT_MS))
+                    break;
+                // Arrived: one of the owner's party, at the owner's level.
+                JoinParty(owner, m);
+                if (b.follow)
+                    FollowLevel(owner, m);
+                Refresh(m);
+                changes.push_back({ b.name, BotState::Online, b.guid, b.account, false, true });
+                Bot shown = b;
+                shown.state = BotState::Online;
+                says.push_back({ b.owner, BotLine(shown, m) });
+                break;
+            }
+            case BotState::Online:
+            {
+                if (m && b.refresh && m->IsInWorld() && !m->IsBeingTeleported())
+                {
+                    // A bot's first teleports can leave its visible list stale (no client moves it
+                    // again): what it sees, and who sees it, from where it stands now.
+                    Refresh(m);
+                    changes.push_back({ b.name, b.state, b.guid, b.account, false, b.teleported, true });
+                }
+                if (!m)
+                {
+                    says.push_back({ b.owner, "WOWBG3 bot " + b.name + " offline " + Hex(b.guid) });
+                    changes.push_back({ b.name, b.state, b.guid, b.account, true, false });
+                    break;
+                }
+                if (owner && m && m->IsInWorld() && !m->IsBeingTeleported())
+                {
+                    if (b.follow)
+                        FollowLevel(owner, m);
+                    if (!m->GetGroup() || m->GetGroup() != owner->GetGroup())
+                        JoinParty(owner, m);
+                }
+                if (!owner && m)
+                {
+                    // The owner went without a logout hook (should not happen): log the bot out too.
+                    if (PlayerBotEntry* e = m->GetSession()->GetBot())
+                        e->requestRemoval = true;
+                    changes.push_back({ b.name, BotState::Removing, b.guid, b.account, false, false });
+                }
+                break;
+            }
+            case BotState::Removing:
+            {
+                if (!m)
+                {
+                    says.push_back({ b.owner, "WOWBG3 bot " + b.name + " offline " + Hex(b.guid) });
+                    changes.push_back({ b.name, b.state, b.guid, b.account, true, false });
+                }
+                else if (age > LOGIN_WAIT_MS)
+                {
+                    if (PlayerBotEntry* e = m->GetSession()->GetBot())
+                        e->requestRemoval = true;
+                }
+                break;
+            }
+        }
+    }
+
+    if (!changes.empty())
+    {
+        WriteLock lock(g_botLock);
+        for (Change const& c : changes)
+        {
+            for (auto it = g_bots.begin(); it != g_bots.end(); ++it)
+            {
+                if (it->name != c.name)
+                    continue;
+                if (c.erase)
+                {
+                    // Only if nothing newer happened to it meanwhile (a verb on the world thread
+                    // cannot run during this tick, so the state is the one the snapshot saw).
+                    UnindexBot(it->guid);
+                    g_bots.erase(it);
+                    break;
+                }
+                if (it->state != c.state)
+                    it->since = now;
+                if (c.refreshed)
+                    it->refresh = false;
+                it->state = c.state;
+                it->guid = c.guid;
+                it->account = c.account;
+                it->teleported = c.teleported;
+                IndexBot(*it);
+                break;
+            }
+        }
+    }
+    for (auto const& s : says)
+        SayTo(ObjectAccessor::FindPlayer(s.first), s.second);
+}
+
+bool HandleConsole(ChatHandler* handler, char const* args)
+{
+    std::string text = args ? args : "";
+    std::vector<std::string> a;
+    {
+        std::string cur;
+        for (char c : text)
+        {
+            if (c == ' ' || c == '\t')
+            {
+                if (!cur.empty())
+                    a.push_back(cur);
+                cur.clear();
+            }
+            else
+                cur += c;
+        }
+        if (!cur.empty())
+            a.push_back(cur);
+    }
+    if (a.size() < 2)
+    {
+        handler->SendSysMessage("wowbg3 NAME VERB ... (as the online character NAME) or wowbg3 - VERB ...");
+        return true;
+    }
+    std::vector<std::string> lines;
+    std::string const name = a[0];
+    // The verb line as a client would send it: `.wowbg3 VERB ...`.
+    std::string line = ".wowbg3";
+    for (size_t i = 1; i < a.size(); ++i)
+        line += " " + a[i];
+    if (name == "-")
+    {
+        std::vector<std::string> v = a;
+        v[0] = ".wowbg3";
+        if (!ExecuteGlobal(v, lines))
+            lines.push_back("WOWBG3 refused usage " + a[1]);
+    }
+    else
+    {
+        std::string n = name;
+        normalizePlayerName(n);
+        Player* p = ObjectAccessor::FindPlayerByName(n.c_str());
+        if (!p || !p->IsInWorld())
+            lines.push_back("WOWBG3 refused offline " + name);
+        else
+            Run(p, line, lines);
+    }
+    for (std::string const& l : lines)
+        handler->SendSysMessage(l.c_str());
+    return true;
+}
+}
+
+bool ChatHandler::HandleWowBg3Command(char* args)
+{
+    return WowBg3::HandleConsole(this, args);
+}
