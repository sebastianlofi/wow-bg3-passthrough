+        if (!raceEntry || raceEntry->HasFlag(CHRRACES_FLAGS_NOT_PLAYABLE) || !sChrClassesStore.LookupEntry(cls) ||
+            !sObjectMgr.GetPlayerInfo(race, cls))
+            return out.Add(head + "refused badrace");
+        if (!spot.set)
+            spot = NextTo(owner);
+
+        ObjectGuid const og = owner->GetObjectGuid();
+        uint32 const now = WorldTimer::getMSTime();
