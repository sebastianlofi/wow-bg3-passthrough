+    std::string Fmt(char const* format, ...)
+    {
+        char buf[512];
+        va_list ap;
+        va_start(ap, format);
+        vsnprintf(buf, sizeof(buf), format, ap);
+        va_end(ap);
+        return buf;
+    }
+
+    bool ParseFloat(std::string const& s, float& out)
+    {
+        if (s.empty() || s.size() > 24)
+            return false;
+        char* end = nullptr;
+        double v = strtod(s.c_str(), &end);
+        if (!end || *end || !std::isfinite(v) || std::fabs(v) > 100000.0)
+            return false;
+        out = float(v);
+        return true;
+    }
+
+    bool ParseUInt(std::string const& s, uint32& out, uint32 max = 0xFFFFFFFFu)
+    {
+        if (s.empty() || s.size() > 10)
+            return false;
+        for (char c : s)
+            if (!isdigit((unsigned char)c))
+                return false;
+        unsigned long long v = strtoull(s.c_str(), nullptr, 10);
+        if (v > max)
+            return false;
+        out = uint32(v);
+        return true;
+    }
+
+    std::string Lower(std::string s)
+    {
+        for (char& c : s)
+            c = char(tolower((unsigned char)c));
+        return s;
+    }
+
+    std::string Upper(std::string s)
+    {
+        for (char& c : s)
+            c = char(toupper((unsigned char)c));
+        return s;
+    }
+
+    // ---- bots ----
+
+    enum class BotState
+    {
+        Account,                                            // waiting for its account row
+        Create,                                             // character rows written, waiting to log in
+        Loading,                                            // PlayerBotMgr is logging it in
+        Arriving,                                           // in world, teleported to its spot
+        Online,
+        Removing                                            // saved, logging out
+    };
+
+    char const* StateName(BotState s)
+    {
+        switch (s)
+        {
+            case BotState::Account:  return "loading";
+            case BotState::Create:   return "loading";
+            case BotState::Loading:  return "loading";
+            case BotState::Arriving: return "loading";
+            case BotState::Online:   return "online";
+            case BotState::Removing: return "removing";
+        }
+        return "?";
+    }
+
+    struct Spot
