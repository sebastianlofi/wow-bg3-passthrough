+            g_botOwner[b.guid.GetRawValue()] = b.owner.GetRawValue();
+        g_botCount.store(uint32(g_botOwner.size()), std::memory_order_relaxed);
+    }
+
+    void UnindexBot(ObjectGuid guid)
+    {
+        g_botOwner.erase(guid.GetRawValue());
+        g_botCount.store(uint32(g_botOwner.size()), std::memory_order_relaxed);
