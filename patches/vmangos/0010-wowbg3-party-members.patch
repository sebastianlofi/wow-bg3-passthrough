+    void JoinParty(Player* owner, Player* bot)
+    {
+        if (!owner || !bot || owner == bot)
+            return;
+        ::Group* group = owner->GetGroup();
+        if (!group)
+        {
+            group = new ::Group;
+            if (!group->Create(owner->GetObjectGuid(), owner->GetName()))
+            {
+                delete group;
+                return;
+            }
+            sObjectMgr.AddGroup(group);
+        }
+        if (bot->GetGroup() == group)
+            return;
+        if (bot->GetGroup())
+            bot->RemoveFromGroup();
+        if (group->IsFull())
+            return;
+        group->AddMember(bot->GetObjectGuid(), bot->GetName());
+    }
