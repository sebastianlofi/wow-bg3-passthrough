+            if (r != AOR_OK && r != AOR_NAME_ALREDY_EXIST)
+                sLog.Out(LOG_BASIC, LOG_LVL_ERROR, "WOWBG3: could not create bot account %s (%u)", acc.c_str(), uint32(r));
+        }
+        return 0;
+    }
