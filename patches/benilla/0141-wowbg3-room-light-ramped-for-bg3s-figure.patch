+/// WOW-BG3 patch 0141: each frame, the room light of a shade-only root as WoW holds it (its ramps part way), after the
+/// ramps stepped (`update_ground_shade`). WoW lights a unit in a room through the fold of these words at every step of
+/// its chase (`interior.rs`); the figure BG3 draws there takes the same.
+fn ramp_shade_only_rooms(mut roots: Query<(&GroundShade, &mut ShadeOnlyRoot)>) {
+    for (shade, mut root) in &mut roots {
+        let ramped = root.room.as_ref().map(|(_, lobes)| {
+            let k = shade.intensity();
+            let mut l = lobes.clone();
+            if let Some(first) = l.first_mut() {
+                first.1 = [first.1[0] * k, first.1[1] * k, first.1[2] * k];
+            }
+            (shade.ambient.to_array(), l)
+        });
+        if root.ramped != ramped {
+            root.ramped = ramped;
+        }
+    }
+}
