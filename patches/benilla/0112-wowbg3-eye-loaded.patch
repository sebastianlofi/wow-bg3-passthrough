+/// Patch 0112: the eye this far (yd, flat) from the body still has the body's world round it.
+const EYE_NEAR_BODY_YD: f32 = 100.0;
+
+/// The ADT tile of a WoW point, as `benilla_wdt::world_to_tile` gives it (tile x from world y).
+fn wow_tile(wow: [f32; 3]) -> (i32, i32) {
+    const TILE_YARDS: f32 = 533.333_3;
+    let offset = 32.0 * TILE_YARDS;
+    let t = |v: f32| (((offset - v) / TILE_YARDS) as i32).clamp(0, 63);
+    (t(wow[1]), t(wow[0]))
+}
+
+/// Patch 0112: the world round the eye is loaded. The stream's focus is the eye while the view is
+/// out (patch 0040 streams detached, round the camera), else the body, which counts only within
+/// [`EYE_NEAR_BODY_YD`] of the eye. The load facts must be about that focus's tile (they lag the
+/// focus by a frame after a jump) and say its tile, the 8 round it and their placements are up and
+/// drawable: what benilla's own loading cover waits for.
+fn eye_ready(
+    eye: [f32; 3],
+    body: Option<[f32; 3]>,
+    view_out: bool,
+    progress: &benilla_world::terrain_stream::WorldLoadProgress,
+) -> bool {
+    let focus = if view_out {
+        eye
+    } else {
+        match body {
+            Some(b) if (b[0] - eye[0]).hypot(b[1] - eye[1]) <= EYE_NEAR_BODY_YD => b,
+            _ => return false,
+        }
+    };
+    progress.focus_tile == Some(wow_tile(focus))
+        && progress.focus_resident
+        && progress.scene_ready
+        && progress.presentable()
+}
