+    #[test]
+    fn eye_ready_is_about_the_eye() {
+        use benilla_world::terrain_stream::WorldLoadProgress;
+        // Goldshire, and a point 760 yd east of it on another tile (t58's far switch).
+        let gold = [-9460.0, 60.0, 56.0];
+        let far = [-9460.0, -700.0, 56.0];
+        assert_ne!(wow_tile(gold), wow_tile(far));
+        let loaded = |at: [f32; 3]| WorldLoadProgress {
+            focus_tile: Some(wow_tile(at)),
+            focus_resident: true,
+            scene_ready: true,
+            ..Default::default()
+        };
+        // At home: the body's world is the eye's.
+        assert!(eye_ready([-9455.0, 65.0, 70.0], Some(gold), false, &loaded(gold)));
+        // Switched 760 yd away, Far Sight not out yet: the body's world says nothing of the eye.
+        assert!(!eye_ready(far, Some(gold), false, &loaded(gold)));
+        // The view out, the stream still about the body's tile (a frame behind): not yet.
+        assert!(!eye_ready(far, Some(gold), true, &loaded(gold)));
+        // The eye's tile loaded but its neighbours' placements still coming: not yet.
+        let mut part = loaded(far);
+        part.scene_ready = false;
+        assert!(!eye_ready(far, Some(gold), true, &part));
+        // Loaded round the eye: ready.
+        assert!(eye_ready(far, Some(gold), true, &loaded(far)));
+        // Drawable too: spawned geometry the retained pass cannot draw yet is a hole.
+        let mut gx = loaded(far);
+        gx.gx_pending = 3;
+        assert!(!eye_ready(far, Some(gold), true, &gx));
+    }
