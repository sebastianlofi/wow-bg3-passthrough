+/// Where a lift is in its cycle `age_ms` after BG3 said `cycle` at `rate` (0 to 1000): it runs on at
+/// that rate for a tenth of a second at most (BG3 writes thirty times a second).
+fn kept_cycle(cycle: u32, rate: u32, age_ms: u64, period: u32) -> u32 {
+    let on = age_ms.min(100) * u64::from(rate.min(1000)) / 1000;
+    ((u64::from(cycle) + on) % u64::from(period.max(1))) as u32
+}
+
+fn keep_bg3s_time(
+    mut clock: ResMut<LiftClock>,
+    mut lifts: Query<(&Guid, &Transport, &mut TransportAnchor)>,
+) {
+    let now = Instant::now();
+    if let Some((seq, rows)) = std::fs::read(&clock.path).ok().and_then(|raw| parse_clock(&raw)) {
+        if seq != clock.seq {
+            clock.seq = seq;
+            clock.at = Some(now);
+            clock.rows = rows.into_iter().map(|(guid, cycle, rate)| (guid, (cycle, rate))).collect();
+        }
+    }
+    let Some(at) = clock.at else {
+        return;
+    };
+    let age = now.duration_since(at).as_millis() as u64;
+    if age > 1000 {
+        return;
+    }
+    let mut n = 0u64;
+    for (guid, transport, mut anchor) in &mut lifts {
+        let Some(&(cycle, rate)) = clock.rows.get(&guid.0) else {
+            continue;
+        };
+        if transport.lift_now(&anchor).is_none() {
+            continue;
+        }
+        anchor.progress_ms = kept_cycle(cycle, rate, age, transport.period_ms());
+        anchor.at = now;
+        n += 1;
+    }
+    if n > 0 {
+        clock.kept += 1;
+        if clock.kept % 3000 == 1 {
+            info!("wowbg3 lifts: {n} lifts keep BG3's time ({} frames so far)", clock.kept);
+        }
+    }
+}
