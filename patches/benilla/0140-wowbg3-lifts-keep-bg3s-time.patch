+/// `liftclock.bin` whole: its seq and rows (guid, cycle ms, rate), or `None` for a file caught
+/// between two writes.
+fn parse_clock(raw: &[u8]) -> Option<(u32, Vec<(u64, u32, u32)>)> {
+    if raw.len() < 16 || &raw[0..4] != b"WLC1" {
+        return None;
+    }
+    let u32_at = |o: usize| u32::from_le_bytes(raw[o..o + 4].try_into().unwrap());
+    let (seq, n) = (u32_at(4), u32_at(8) as usize);
+    if n > 4096 || raw.len() != 16 + 16 * n || u32_at(12 + 16 * n) != seq {
+        return None;
+    }
+    let rows = (0..n)
+        .map(|i| {
+            let o = 12 + 16 * i;
+            (u64::from_le_bytes(raw[o..o + 8].try_into().unwrap()), u32_at(o + 8), u32_at(o + 12))
+        })
+        .collect();
+    Some((seq, rows))
+}
