+    /// Patch 0036: [`mesh_file`] with a u8x4 colour (green bytes `g`) before uv0 in the stream-0 vertex, as
+    /// BG3's VertexColor_MSK meshes have it.
+    fn mesh_file_coloured(g: [u8; 3]) -> Vec<u8> {
+        let b = mesh_file();
+        let mut out = b[..48].to_vec();
+        let mut u: Vec<u32> = (0..12).map(|k| u32::from_le_bytes(b[48 + 4 * k..52 + 4 * k].try_into().unwrap())).collect();
+        (u[5], u[6], u[10]) = (8, 4, 24); // vertex size, uv0 offset, vertex bytes
+        for v in &u {
+            out.extend_from_slice(&v.to_le_bytes());
+        }
+        out.extend_from_slice(&b[96..188]); // figure, LOD, source, skin
+        for (k, g) in g.iter().enumerate() {
+            out.extend_from_slice(&[7, *g, 9, 255]);
+            out.extend_from_slice(&b[188 + 4 * k..192 + 4 * k]);
+        }
+        out.extend_from_slice(&b[200..]); // indices
+        out
+    }
