+/// Patch 0036: a `tavtex.txt` line's mesh key and its `cut:` token (BG3's vertex-colour mask bytes for the
+/// mesh, sorted; none: no cut). `key:value` tokens follow the positional columns and are read independently
+/// of each other; the `TAVTEX` head line has no key.
+pub(crate) fn cut_token(line: &str) -> Option<(u64, Vec<u8>)> {
+    let mut f = line.split_whitespace();
+    let key = u64::from_str_radix(f.next()?, 16).ok()?;
+    let mut cut: Vec<u8> = f
+        .skip(2)
+        .find_map(|t| t.strip_prefix("cut:"))
+        .map_or_else(Vec::new, |c| c.split(',').filter_map(|b| b.trim().parse().ok()).collect());
+    cut.sort_unstable();
+    cut.dedup();
+    Some((key, cut))
+}
+
+/// Patch 0036: a mesh's triangles under BG3's vertex-colour cut. BG3's vertex shader moves every vertex whose
+/// colour G byte names a set texel of the figure's mask (`cut`, sorted; texel `g`, 255 wrapping to 0) to the
+/// object's origin, so a triangle with all three vertices cut has no area: those are left out. A triangle with
+/// only some of them cut is kept whole (BG3 stretches it to the origin; none in the meshes seen). Returns the
+/// kept indices, the triangles left out and those kept across a cut's edge. No colours or no cut: all of them.
+pub(crate) fn cut_triangles(idx: &[u32], green: Option<&[u8]>, cut: &[u8]) -> (Vec<u32>, usize, usize) {
+    let Some(green) = green.filter(|_| !cut.is_empty()) else { return (idx.to_vec(), 0, 0) };
+    let gone = |i: u32| green.get(i as usize).is_some_and(|g| cut.binary_search(&if *g == 255 { 0 } else { *g }).is_ok());
+    let (mut kept, mut out, mut edge) = (Vec::with_capacity(idx.len()), 0, 0);
+    for t in idx.chunks_exact(3) {
+        match t.iter().filter(|i| gone(**i)).count() {
+            3 => out += 1,
+            n => {
+                edge += usize::from(n > 0);
+                kept.extend_from_slice(t);
+            }
+        }
+    }
+    (kept, out, edge)
+}
+
+/// Patch 0036: a built mesh with the index buffer of its cut (re-wound for the mirrored mapping, as built).
+fn with_cut(mut mesh: Mesh, m: &TavMesh, cut: &[u8], det: f32) -> Mesh {
+    if !cut.is_empty() {
+        let idx = cut_triangles(&m.idx, m.green.as_deref(), cut).0;
+        mesh.insert_indices(Indices::U32(if det < 0.0 { rewind(&idx) } else { idx }));
+    }
+    mesh
+}
+
+/// Patch 0036: BG3's vertex-colour cuts from `tavtex.txt`'s `cut:` tokens, read whenever the file or the plan
+/// changes (`tavtex.py` writes the plan's tokens with its first lines): a part whose cut changed gets its index
+/// buffer rebuilt ([`cut_triangles`]). Runs before the maps are applied, so a mesh shows with its cut.
+fn apply_cuts(mut d: ResMut<TavDraw>, mut meshes: ResMut<Assets<Mesh>>) {
+    if !d.cuts_on || d.root.is_none() {
+        return;
+    }
+    let path = d.dir.join("tavtex.txt");
+    let Ok(mtime) = std::fs::metadata(&path).and_then(|m| m.modified()) else { return };
+    let Some(seq) = d.file.as_ref().map(|f| f.seq) else { return };
+    if d.cut_stamp == Some((mtime, seq)) {
+        return;
+    }
+    let Ok(text) = std::fs::read_to_string(&path) else { return };
+    let mut lines = text.lines();
+    let head: Vec<&str> = lines.next().unwrap_or("").split_whitespace().collect();
+    if head.len() < 3 || head[0] != "TAVTEX" || head[2].parse::<u32>().ok() != Some(seq) {
+        return; // the baker has not caught up with this plan yet
+    }
+    d.cut_stamp = Some((mtime, seq));
+    let TavDraw { file, parts, cuts, det_sign, .. } = &mut *d;
+    let Some(file) = file.as_ref() else { return };
+    let (mut changed, mut edge, mut colourless) = (0, 0, 0);
+    for (key, cut) in lines.filter_map(cut_token) {
+        let Some(part) = parts.iter_mut().find(|p| p.key == key) else { continue };
+        let Some(m) = file.meshes.iter().find(|m| m.key == key) else { continue };
+        cuts.insert(key, cut.clone());
+        if part.cut == cut {
+            continue;
+        }
+        if !cut.is_empty() && m.green.is_none() {
+            colourless += 1;
+        }
+        let (idx, out, e) = cut_triangles(&m.idx, m.green.as_deref(), &cut);
+        let idx = if *det_sign < 0.0 { rewind(&idx) } else { idx };
+        if let Some(c) = part.rig.as_ref().and_then(|r| r.cpu_mesh.as_ref()).and_then(|h| meshes.get_mut(h)) {
+            c.insert_indices(Indices::U32(idx.clone()));
+        }
+        if let Some(mesh) = meshes.get_mut(&part.mesh) {
+            mesh.insert_indices(Indices::U32(idx));
+        }
+        part.cut = cut;
+        part.cut_out = out;
+        edge += e;
+        changed += 1;
+    }
+    if changed > 0 {
+        let cut_parts: Vec<&Part> = parts.iter().filter(|p| !p.cut.is_empty()).collect();
+        let tris = |p: &Part| file.meshes.iter().find(|m| m.key == p.key).map_or(0, |m| m.idx.len() / 3);
+        info!(
+            "wowbg3 tav: cuts for plan {seq}: {changed} meshes changed; {} meshes cut, {} of their {} triangles left out              (BG3's vertex-colour cuts){}{}",
+            cut_parts.len(),
+            cut_parts.iter().map(|p| p.cut_out).sum::<usize>(),
+            cut_parts.iter().map(|p| tris(p)).sum::<usize>(),
+            if edge > 0 { format!(", {edge} triangles across a cut's edge kept whole") } else { String::new() },
+            if colourless > 0 { format!(", {colourless} cut meshes without vertex colours drawn whole") } else { String::new() },
+        );
+    }
+}
