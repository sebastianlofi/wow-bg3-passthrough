+/// Whether the fight's own narration goes into WoW's chat as well as benilla's log. BG3's turn order
+/// and combat banners already tell the player what the fight is doing, so by default these lines stay
+/// out of WoW's chat, which keeps WoW's own messages. `WOW_BG3_FIGHT_CHAT=show` prints them there
+/// again, as before. Read once per process.
+fn fight_chat_in_wow() -> bool {
+    static SHOW: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *SHOW.get_or_init(|| {
+        std::env::var("WOW_BG3_FIGHT_CHAT")
+            .map(|v| v.trim().eq_ignore_ascii_case("show"))
+            .unwrap_or(false)
+    })
+}
+
+/// A line that only says what the fight is doing: WoW's chat with the switch on, benilla's log
+/// otherwise. Errors and answers to the player ("Not your turn", the bridge not answering) never come
+/// through here, so they always reach the player.
+fn narrate(chat: &mut Option<ResMut<ChatLog>>, line: String) {
+    if fight_chat_in_wow() {
+        say(chat, line);
+    } else {
+        info!("wowbg3 fight: {line}");
+    }
+}
+
 fn write_atomic(path: &Path, text: &str) -> std::io::Result<()> {
     let tmp = path.with_extension("tmp");
     std::fs::write(&tmp, text)?;
