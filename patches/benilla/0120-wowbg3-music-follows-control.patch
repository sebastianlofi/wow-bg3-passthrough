 }
 
+/// Patch 0120: BG3's music plays for the character the player controls, so WoW's zone music yields
+/// to it (`sound::SoundConfig::music_yield`). False with no record for 5 s.
+pub(crate) fn bg3_music_fight() -> bool {
+    let seen = TAV_SEEN_MS.load(Ordering::Relaxed);
+    seen != 0
+        && clock_ms().saturating_sub(seen) <= COMBAT_FRESH_MS
+        && TAV_MUSIC_FIGHT.load(Ordering::Relaxed)
+}
+
+/// Patch 0120: BG3's fight music is shut, so nothing of BG3's has to finish before WoW's track.
+pub(crate) fn bg3_music_shut() -> bool {
+    TAV_MUSIC_SHUT.load(Ordering::Relaxed)
+}
