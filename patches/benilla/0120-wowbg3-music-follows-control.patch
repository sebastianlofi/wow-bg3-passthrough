 fn feed_music_yield(mut config: ResMut<SoundConfig>) {
-    // Patch 0102: the fight too, from its pull: BG3's flag is the hero's and goes off while the fight
-    // and its music go on.
-    let fight = crate::wowbg3_lead::hide_self()
-        && (crate::wowbg3_lead::bg3_combat() || crate::wowbg3_fight::in_fight());
+    // Patch 0120: the character the player controls, not the hero and not any fight of the party's.
+    let fight = crate::wowbg3_lead::hide_self() && crate::wowbg3_lead::bg3_music_fight();
     if config.music_yield != fight {
         config.music_yield = fight;
     }
