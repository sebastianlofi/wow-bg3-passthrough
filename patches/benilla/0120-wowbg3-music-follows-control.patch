 /// BG3 sets it when its window loses focus (its MuteSoundWhenNotFocused option) or its master
 /// volume is 0.
 static TAV_MUTED: AtomicBool = AtomicBool::new(false);
+/// Patch 0120: the character the player controls is in a BG3 fight (`tav.bin` flags bit 4).
+static TAV_MUSIC_FIGHT: AtomicBool = AtomicBool::new(false);
+/// Patch 0120: BG3's fight music is shut (`tav.bin` flags bit 8): a fight goes on, not the controlled one's.
+static TAV_MUSIC_SHUT: AtomicBool = AtomicBool::new(false);
 
 /// Patch 0030: how old the last `tav.bin` record may be for its combat bit to count.
 const COMBAT_FRESH_MS: u64 = 5000;
@@ -208,6 +212,20 @@ pub(crate) fn bg3_combat() -> bool {
