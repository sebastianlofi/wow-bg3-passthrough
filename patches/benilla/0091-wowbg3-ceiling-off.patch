+/// that room's footprint: her own floor and the stairs reach down to her, so they stay; a tower
+/// across the city is not over her room. An earlier version also asked that the group cross the
+/// line from the eye to her, which left half the upstairs standing round her (the bed, the far
+/// walls); BG3 takes the whole storey. The first version without the height test took the floor
+/// and the far walls with the roof and left her standing on a scrap of plank in open sky
+/// (a test shot kept as the counter-example).
+fn above_her(anchor: Vec3, room: (Vec3, Vec3), origin: Vec3, aabb: &bevy::camera::primitives::Aabb) -> bool {
+    let centre = origin + Vec3::from(aabb.center);
+    let half = Vec3::from(aabb.half_extents);
+    let (lo, hi) = (centre - half, centre + half);
+    // `HEAD` is her head above the chest the anchor sits at.
+    const HEAD: f32 = 0.7;
+    // How far beyond her room's footprint a storey above still counts as over it (yd): the floor
+    // upstairs is often wider than the room below.
+    const REACH: f32 = 2.0;
+    if lo.y < anchor.y + HEAD {
+        return false;
+    }
+    let (rlo, rhi) = room;
+    lo.x <= rhi.x + REACH && hi.x >= rlo.x - REACH && lo.z <= rhi.z + REACH && hi.z >= rlo.z - REACH
+}
+
+/// WOW-BG3 patch 0091: how fast a storey fades, in fractions of the whole fade a second: BG3's own
+/// `FadeOutSpeed`, 5.0 on most of the objects that set one (23 of 36 in Shared and Gustav's root
+/// templates and scenery; `FadeOutDelay` is 0.0 on 1554 of 1569), so a fade takes a fifth of a second.
+const FADE_SPEED: f32 = 5.0;
+
+/// One group's fade this frame: toward 1 while it is above her, back toward 0 once it is not.
+fn step_fade(
+    fades: &mut bevy::platform::collections::HashMap<(Entity, u16), f32>,
+    key: (Entity, u16),
+    gone: bool,
+    dt: f32,
+) -> f32 {
+    let f = fades.get(&key).copied().unwrap_or(0.0);
+    let f = if gone { (f + dt * FADE_SPEED).min(1.0) } else { (f - dt * FADE_SPEED).max(0.0) };
+    if f > 0.0 {
+        fades.insert(key, f);
+    } else {
+        fades.remove(&key);
+    }
+    f
+}
+
+/// A fade as BG3's sixteen dissolve steps (`static_gx.wgsl`'s `wow_fade_discard`).
+fn fade_level(f: f32) -> u8 {
+    (f * 16.0).round().clamp(0.0, 16.0) as u8
+}
