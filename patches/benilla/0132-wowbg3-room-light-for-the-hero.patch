+/// Patch 0132: the light WoW gives the hero's figure in a room, for BG3's own drawing of the party (the render plugin
+/// lights BG3's pixels with it as WoW lights a unit indoors): `$WOW_BG3_LINK_DIR/wowunitlight.txt`, "WUL1 <count>"
+/// then a line a lobe, "<toward the light x y z, WoW axes> <r g b>": the floor's baked light on WoW's fixed axis, then
+/// the room's lights as they reach the figure. The ambient that goes with them is wowsky.txt's unit ambient.
+/// Count 0 outdoors, or where WoW has no room light for it. Written whole (rename) when a value moved.
+fn unit_light_export(rooms: &Query<(&Name, &GlobalTransform, &benilla_world::entity_shade::ShadeOnlyRoot)>) {
+    static LAST: std::sync::Mutex<Option<Vec<[f32; 6]>>> = std::sync::Mutex::new(None);
+    let Some(dir) = std::env::var_os("WOW_BG3_LINK_DIR") else { return };
+    let Some((_, _, root)) = rooms.iter().find(|(name, _, _)| name.as_str() == "wowbg3 Tav") else { return };
+    let now: Vec<[f32; 6]> = root
+        .room_light()
+        .map(|(_, lobes)| {
+            lobes
+                .iter()
+                .filter(|(_, c)| c.iter().any(|v| *v > 0.001))
+                .take(8)
+                .map(|(d, c)| {
+                    let w = benilla_assets::coords::bevy_to_wow(*d);
+                    [w[0], w[1], w[2], c[0], c[1], c[2]]
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    let Ok(mut last) = LAST.lock() else { return };
+    if last.as_ref().is_some_and(|p| p.len() == now.len() && p.iter().zip(now.iter()).all(|(a, b)| a.iter().zip(b.iter()).all(|(x, y)| (x - y).abs() < 0.004))) {
+        return;
+    }
+    let mut text = format!("WUL1 {}\n", now.len());
+    for l in &now {
+        text.push_str(&format!("{:.4} {:.4} {:.4} {:.4} {:.4} {:.4}\n", l[0], l[1], l[2], l[3], l[4], l[5]));
+    }
+    let path = std::path::Path::new(&dir).join("wowunitlight.txt");
+    let tmp = path.with_extension("tmp");
+    if std::fs::write(&tmp, text).is_ok() && std::fs::rename(&tmp, &path).is_ok() {
+        *last = Some(now);
+    }
+}
