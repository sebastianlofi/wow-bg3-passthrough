+    /// `standins.bin` (world mode, every frame): the newest record per stand-in, with its velocity.
+    fn read_live(&mut self, now: f64) {
+        let Ok(raw) = std::fs::read(self.dir.join("standins.bin")) else {
+            return;
+        };
+        let Some((seq, t, recs)) = decode_standins(&raw) else {
+            return;
+        };
+        if self.live_seq == Some(seq) {
+            return;
+        }
+        self.live_seq = Some(seq);
+        if self.live_clock.is_none() {
+            let shared = (-50.0..5000.0).contains(&(now - t));
+            info!(
+                "wowbg3 live: standins.bin {} (record {:.0} ms old by this host's CLOCK_MONOTONIC)",
+                if shared { "ages by BG3's clock" } else { "ages from arrival: BG3's clock differs" },
+                now - t
+            );
+            self.live_clock = Some(shared);
+        }
+        for (guid, rec) in recs {
+            let at = wow_to_bevy(rec.pos);
+            let vel = match self.live.get(&guid) {
+                Some(prev) if rec.moving && !rec.dead => {
+                    let dt = ((t - prev.t) / 1000.0) as f32;
+                    if (0.004..0.5).contains(&dt) {
+                        prev.vel.lerp((at - wow_to_bevy(prev.rec.pos)) / dt, 0.5)
+                    } else {
+                        prev.vel
+                    }
+                }
+                _ => Vec3::ZERO,
+            };
+            self.live.insert(guid, Live { rec, t, seen: now, vel });
+        }
+        self.live.retain(|_, l| now - l.seen < 10_000.0);
+    }
+    /// `strikes.bin` (world mode, every frame): the strikes not taken yet.
+    fn read_strikes(&mut self) -> Vec<EarlyStrike> {
+        let Ok(raw) = std::fs::read(self.dir.join("strikes.bin")) else {
+            return Vec::new();
+        };
+        let Some((epoch, list)) = decode_strikes(&raw) else {
+            return Vec::new();
+        };
+        let newest = list.iter().map(|s| s.id).max().unwrap_or(0);
+        let Some((was, seen)) = self.early_seen else {
+            // Whatever BG3 wrote before this session is old news.
+            self.early_seen = Some((epoch, newest));
+            return Vec::new();
+        };
+        // A new BG3 run starts its ids over.
+        let seen = if was == epoch { seen } else { 0 };
+        self.early_seen = Some((epoch, newest.max(seen)));
+        list.into_iter().filter(|s| s.id > seen).collect()
+    }
 }
 
