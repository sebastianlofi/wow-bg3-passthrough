+/// One stand-in in `standins.bin`: where BG3 draws it.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct StandInRec {
+    /// WoW yards.
+    pub(crate) pos: [f32; 3],
+    /// WoW orientation, radians.
+    pub(crate) orient: f32,
+    pub(crate) dead: bool,
+    pub(crate) moving: bool,
+}
+
+/// `standins.bin`: "SIN1", seq u32, n u32, BG3's clock f64 ms, n x (guid hi u32, guid lo u32,
+/// x, y, z, orientation f32, flags u32: 1 dead, 2 moving), seq again. Returns (seq, BG3 ms,
+/// records), None for a torn or foreign file.
+pub(crate) fn decode_standins(b: &[u8]) -> Option<(u32, f64, Vec<(u64, StandInRec)>)> {
+    if b.len() < 24 || &b[0..4] != b"SIN1" {
+        return None;
+    }
+    let u = |o: usize| u32::from_le_bytes(b[o..o + 4].try_into().unwrap());
+    let f = |o: usize| f32::from_le_bytes(b[o..o + 4].try_into().unwrap());
+    let (seq, n) = (u(4), u(8) as usize);
+    if n > 256 || b.len() != 24 + 28 * n || u(20 + 28 * n) != seq {
+        return None;
+    }
+    let t = f64::from_le_bytes(b[12..20].try_into().unwrap());
+    let mut out = Vec::with_capacity(n);
+    for i in 0..n {
+        let o = 20 + 28 * i;
+        let rec = StandInRec {
+            pos: [f(o + 8), f(o + 12), f(o + 16)],
+            orient: f(o + 20),
+            dead: u(o + 24) & 1 != 0,
+            moving: u(o + 24) & 2 != 0,
+        };
+        if rec.pos.iter().all(|v| v.is_finite()) && rec.orient.is_finite() {
+            out.push(((u64::from(u(o)) << 32) | u64::from(u(o + 4)), rec));
+        }
+    }
+    t.is_finite().then_some((seq, t, out))
+}
+
+/// One record of `strikes.bin`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct EarlyStrike {
+    pub(crate) guid: u64,
+    pub(crate) id: u32,
+    pub(crate) flags: u32,
+    pub(crate) damage: u32,
+    /// BG3's clock at the strike (ms).
+    pub(crate) t: f64,
+}
+
+/// `strikes.bin`: "STK1", epoch u32, seq u32, n u32, n x (guid hi u32, guid lo u32, id u32,
+/// flags u32, damage u32, BG3 time f64 ms), seq again. Returns (epoch, strikes).
+pub(crate) fn decode_strikes(b: &[u8]) -> Option<(u32, Vec<EarlyStrike>)> {
+    if b.len() < 20 || &b[0..4] != b"STK1" {
+        return None;
+    }
+    let u = |o: usize| u32::from_le_bytes(b[o..o + 4].try_into().unwrap());
+    let (epoch, seq, n) = (u(4), u(8), u(12) as usize);
+    if n > 64 || b.len() != 20 + 28 * n || u(16 + 28 * n) != seq {
+        return None;
+    }
+    let out = (0..n)
+        .map(|i| {
+            let o = 16 + 28 * i;
+            EarlyStrike {
+                guid: (u64::from(u(o)) << 32) | u64::from(u(o + 4)),
+                id: u(o + 8),
+                flags: u(o + 12),
+                damage: u(o + 16),
+                t: f64::from_le_bytes(b[o + 20..o + 28].try_into().unwrap()),
+            }
+        })
+        .collect();
+    Some((epoch, out))
+}
+
+/// A stand-in's latest live record and what the model derives from the stream.
+#[derive(Clone, Copy, Debug)]
+struct Live {
+    rec: StandInRec,
+    /// BG3's clock at the record (ms) and when this side first read it (CLOCK_MONOTONIC ms).
+    t: f64,
+    seen: f64,
+    /// The stand-in's velocity (Bevy yards per second) from consecutive records.
+    vel: Vec3,
+}
+
+/// A live record's age in ms: by BG3's clock when it is this host's CLOCK_MONOTONIC (`shared`),
+/// else since this side first read it.
+fn live_age(l: &Live, now: f64, shared: bool) -> f64 {
+    if shared { now - l.t } else { now - l.seen }
+}
+
+/// Entities a flinch was written for (the animation driver logs whether the wound played).
+static FLINCHES: LazyLock<Mutex<HashSet<Entity>>> = LazyLock::new(Default::default);
+
+/// The animation driver asks this when a wound reaches a unit: true (once) when this module wrote
+/// it, so the driver logs it.
+pub(crate) fn took_flinch(entity: Entity) -> bool {
+    FLINCHES.lock().is_ok_and(|mut s| s.remove(&entity))
+}
+
+/// A flinch on `victim`: the impact of a landed swing, written directly. A `SwingMessage` from the
+/// own character (hidden in world mode) never reached its clip's impact key, so nothing played.
+fn flinch(attacker: Entity, victim: Entity, damage: u32, seq: u64) -> SwingImpact {
+    if let Ok(mut s) = FLINCHES.lock() {
+        if s.len() > 64 {
+            s.clear();
+        }
+        s.insert(victim);
+    }
+    SwingImpact {
+        swing: SwingMessage {
+            attacker,
+            victim: Some(victim),
+            hit_info: HIT_NORMAL,
+            victim_state: 1,
+            damage,
+            displayed: false,
+            seq,
+        },
+        text_only: false,
+        natural: None,
+        pos: None,
+    }
+}
+
+/// WoW orientation (Bevy yaw) of a horizontal Bevy direction: a unit at yaw `o` faces
+/// (-sin o, 0, -cos o).
+fn yaw_of(d: Vec3) -> f32 {
+    (-d.x).atan2(-d.z)
+}
+
+/// `a - b` wrapped into (-pi, pi].
+fn angle_diff(a: f32, b: f32) -> f32 {
+    let d = (a - b).rem_euclid(std::f32::consts::TAU);
+    if d > std::f32::consts::PI { d - std::f32::consts::TAU } else { d }
 }
 
