     #[test]
+    fn decodes_live_standins() {
+        let mut b = b"SIN1".to_vec();
+        b.extend(7u32.to_le_bytes());
+        b.extend(1u32.to_le_bytes());
+        b.extend(1234.5f64.to_le_bytes());
+        b.extend(0xf1300000u32.to_le_bytes());
+        b.extend(0x00012b01u32.to_le_bytes());
+        for v in [-8793.0f32, -116.0, 83.5, 1.5] {
+            b.extend(v.to_le_bytes());
+        }
+        b.extend(2u32.to_le_bytes());
+        b.extend(7u32.to_le_bytes());
+        let (seq, t, recs) = decode_standins(&b).unwrap();
+        assert_eq!((seq, t), (7, 1234.5));
+        assert_eq!(recs[0].0, 0xf130000000012b01);
+        assert_eq!(recs[0].1.pos, [-8793.0, -116.0, 83.5]);
+        assert!(recs[0].1.moving && !recs[0].1.dead);
+        // A torn file (trailing seq from another write) is refused.
+        let n = b.len();
+        b[n - 4] = 8;
+        assert!(decode_standins(&b).is_none());
+    }
+
+    #[test]
+    fn decodes_early_strikes() {
+        let mut b = b"STK1".to_vec();
+        for v in [99u32, 3, 1] {
+            b.extend(v.to_le_bytes());
+        }
+        for v in [0xf1300000u32, 0x00012b01, 5, STRIKE_HIT, 0] {
+            b.extend(v.to_le_bytes());
+        }
+        b.extend(10.0f64.to_le_bytes());
+        b.extend(3u32.to_le_bytes());
+        let (epoch, list) = decode_strikes(&b).unwrap();
+        assert_eq!(epoch, 99);
+        assert_eq!(list[0].guid, 0xf130000000012b01);
+        assert_eq!((list[0].id, list[0].flags, list[0].damage), (5, STRIKE_HIT, 0));
+        assert!(decode_strikes(&b[..b.len() - 1]).is_none());
+    }
+
+    #[test]
+    fn yaw_matches_look_to() {
+        for o in [-2.5f32, -1.0, 0.0, 0.7, 3.0] {
+            let d = Vec3::new(-o.sin(), 0.0, -o.cos());
+            assert!(angle_diff(yaw_of(d), o).abs() < 1e-5);
+            let t = Transform::default().looking_to(d, Vec3::Y);
+            assert!(angle_diff(t.rotation.to_euler(EulerRot::YXZ).0, o).abs() < 1e-4);
+        }
+        assert!((angle_diff(3.0, -3.0) - (6.0 - std::f32::consts::TAU)).abs() < 1e-5);
+    }
