+/// A dodge by `victim`, what WoW's client does with a dodged swing: the defense clip the swing's
+/// `$CPP` key plays and the impact its attack-hit key fires, both written directly, as the own
+/// character (hidden in world mode) plays no clip with those keys. BG3 shows its own miss text.
+fn dodge(attacker: Entity, victim: Entity, seq: u64) -> (DefenseAnim, SwingImpact) {
+    (
+        DefenseAnim {
+            victim,
+            victim_state: VICTIM_DODGE,
+        },
+        SwingImpact {
+            swing: SwingMessage {
+                attacker,
+                victim: Some(victim),
+                hit_info: HIT_MISS,
+                victim_state: VICTIM_DODGE,
+                damage: 0,
+                displayed: false,
+                seq,
+            },
+            text_only: false,
+            natural: None,
+            pos: None,
+        },
+    )
+}
