+/// `CreatureType.dbc` names by id.
+fn type_name(id: u32) -> &'static str {
+    match id {
+        1 => "Beast",
+        2 => "Dragonkin",
+        3 => "Demon",
+        4 => "Elemental",
+        5 => "Giant",
+        6 => "Undead",
+        7 => "Humanoid",
+        8 => "Critter",
+        9 => "Mechanical",
+        _ => "Creature",
+    }
+}
+
+/// `CreatureFamily.dbc` names by id (1.12's rows).
+fn family_name(id: u32) -> Option<&'static str> {
+    Some(match id {
+        1 => "Wolf",
+        2 => "Cat",
+        3 => "Spider",
+        4 => "Bear",
+        5 => "Boar",
+        6 => "Crocolisk",
+        7 => "Carrion Bird",
+        8 => "Crab",
+        9 => "Gorilla",
+        11 => "Raptor",
+        12 => "Tallstrider",
+        15 => "Felhunter",
+        16 => "Voidwalker",
+        17 => "Succubus",
+        19 => "Doomguard",
+        20 => "Scorpid",
+        21 => "Turtle",
+        23 => "Imp",
+        24 => "Bat",
+        25 => "Hyena",
+        26 => "Owl",
+        27 => "Wind Serpent",
+        _ => return None,
+    })
+}
+
+/// A creature's WoW race (its model's, for a player-race model; else its beast family; else its
+/// creature type) and its creature type, once its template record is in.
+fn kind_names(
+    names: &crate::names::NameCache,
+    creatures: Option<&crate::entities::Creatures>,
+    guid: u64,
+    display: u32,
+) -> Option<(&'static str, &'static str)> {
+    // A creature guid carries its entry in bits 24..48.
+    let record = names.creature_record(((guid >> 24) & 0xff_ffff) as u32)?;
+    let kind = type_name(record.creature_type);
+    let race = creatures
+        .and_then(|c| c.display_race_sex(display))
+        .and_then(|(race, _)| crate::ui_unit::race_names(race))
+        .map(|(name, _)| name)
+        .or_else(|| family_name(record.pet_family))
+        .unwrap_or(kind);
+    Some((race, kind))
+}
+
+/// The booth's readback (Rgba16Float, linear) as sRGB RGBA8 (coverage stays linear), with the box of
+/// covered pixels (exclusive ends) if any.
+fn encode_body(shot: &Image) -> Option<(u32, u32, Vec<u8>, Option<[u32; 4]>)> {
+    use bevy::render::render_resource::TextureFormat;
+    use std::sync::OnceLock;
+    if shot.texture_descriptor.format != TextureFormat::Rgba16Float {
+        return None;
+    }
+    let (w, h) = (shot.texture_descriptor.size.width, shot.texture_descriptor.size.height);
+    let src = shot.data.as_ref()?;
+    let n = (w * h) as usize;
+    if src.len() < n * 8 {
+        return None;
+    }
+    // Every half's sRGB byte and linear byte, made once (a powf per channel per pixel per frame was
+    // the alternative).
+    static LUT: OnceLock<(Vec<u8>, Vec<u8>)> = OnceLock::new();
+    let (srgb, lin) = LUT.get_or_init(|| {
+        let mut srgb = vec![0u8; 65536];
+        let mut lin = vec![0u8; 65536];
+        for bits in 0..65536usize {
+            let v = half::f16::from_bits(bits as u16).to_f32();
+            let v = if v.is_finite() { v.clamp(0.0, 1.0) } else { 0.0 };
+            let e = if v <= 0.003_130_8 { v * 12.92 } else { 1.055 * v.powf(1.0 / 2.4) - 0.055 };
+            srgb[bits] = (e.clamp(0.0, 1.0) * 255.0).round() as u8;
+            lin[bits] = (v * 255.0).round() as u8;
+        }
+        (srgb, lin)
+    });
+    let mut out = vec![0u8; n * 4];
+    let mut bb = NO_BOX;
+    for i in 0..n {
+        for c in 0..4 {
+            let bits = u16::from_le_bytes([src[i * 8 + c * 2], src[i * 8 + c * 2 + 1]]) as usize;
+            out[i * 4 + c] = if c == 3 { lin[bits] } else { srgb[bits] };
+        }
+        if out[i * 4 + 3] > 8 {
+            let (x, y) = ((i as u32) % w, (i as u32) / w);
+            bb = [bb[0].min(x), bb[1].min(y), bb[2].max(x + 1), bb[3].max(y + 1)];
+        }
+    }
+    Some((w, h, out, (bb[2] > bb[0]).then_some(bb)))
+}
+
+impl Stream {
+    /// One frame into the slot not read last, then the header (the sequence moves last).
+    fn write(&mut self, dir: &Path, w: u32, h: u32, display: u32, px: &[u8], bb: Option<[u32; 4]>) -> std::io::Result<()> {
+        use std::os::unix::fs::FileExt;
+        let frame = (w * h * 4) as u64;
+        if self.file.is_none() {
+            // One name per link folder, so a new run reuses it rather than adding another.
+            let key = dir
+                .to_string_lossy()
+                .bytes()
+                .fold(0xcbf2_9ce4_8422_2325u64, |h, b| (h ^ b as u64).wrapping_mul(0x100_0000_01b3));
+            let shm = std::env::var_os("WOWBG3_SHM").map(std::path::PathBuf::from); // the install's own tmpfs folder
+            let path = if let Some(shm) = shm.filter(|s| s.is_dir()) {
+                shm.join(format!("wowbg3-body-{key:016x}.bin"))
+            } else {
+                dir.join("wowbody").join("live.bin")
+            };
+            let file = std::fs::OpenOptions::new().read(true).write(true).create(true).truncate(true).open(&path)?;
+            file.set_len(64 + 2 * frame)?;
+            write_atomic(&dir.join("wowbody").join("live.path"), path.to_string_lossy().as_bytes())?;
+            self.file = Some(file);
+        }
+        if let Some(b) = bb {
+            self.bbox = [self.bbox[0].min(b[0]), self.bbox[1].min(b[1]), self.bbox[2].max(b[2]), self.bbox[3].max(b[3])];
+        }
+        let file = self.file.as_ref().expect("opened above");
+        let slot = 1 - self.slot;
+        file.write_at(px, 64 + slot as u64 * frame)?;
+        self.slot = slot;
+        self.seq = self.seq.wrapping_add(1);
+        let bbox = if self.bbox[2] > self.bbox[0] { self.bbox } else { [0, 0, 0, 0] };
+        let mut hdr = Vec::with_capacity(64);
+        hdr.extend_from_slice(b"WBL1");
+        for v in [w, h, slot, self.seq, 0] {
+            hdr.extend_from_slice(&v.to_le_bytes());
+        }
+        hdr.extend_from_slice(&self.guid.to_le_bytes());
+        for v in bbox.into_iter().chain([display, 0, 0, 0]) {
+            hdr.extend_from_slice(&v.to_le_bytes());
+        }
+        file.write_at(&hdr, 0)?;
+        self.written += 1;
+        Ok(())
+    }
+}
