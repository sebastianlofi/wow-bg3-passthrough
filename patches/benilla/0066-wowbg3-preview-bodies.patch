+/// Patch 0066, after [`super::gate_booth_cameras`]: the live body of the stand-in `wowpreview.txt`
+/// names, and in between the stills and the race files of the mirrored mobs.
+pub(super) fn drive_body(
+    mut commands: Commands,
+    mut state: ResMut<WowBg3Body>,
+    mut booths: ResMut<Booths>,
+    index: Res<crate::net::GuidIndex>,
+    ents: Query<&crate::net::NetEntity>,
+    names: Res<crate::names::NameCache>,
+    creatures: Option<Res<crate::entities::Creatures>>,
+    stores: Query<&crate::net::ObjectStore>,
+    time: Res<Time<bevy::time::Real>>,
+) {
+    let Some(dir) = state.dir.clone() else {
+        return;
+    };
+    state.frame += 1;
+    let now = time.elapsed_secs_f64();
+    let finished: Vec<_> = state.shots.lock().map(|mut s| std::mem::take(&mut *s)).unwrap_or_default();
+    for (disp, result) in finished {
+        match result {
+            Ok(bytes) => {
+                info!("wowbg3 preview: still of display {disp} written ({bytes} bytes)");
+                state.stills.insert(disp);
+                state.failed.remove(&disp);
+            }
+            Err(why) => {
+                warn!("wowbg3 preview: still of display {disp} not written: {why}");
+                state.failed.insert(disp, now);
+            }
+        }
+        if state.job.as_ref().is_some_and(|j| j.display == disp) {
+            state.job = None;
+            state.subject = None;
+        }
+    }
+    if state.frame % 2 == 0 {
+        state.want = preview_request(&dir);
+    }
+    let display_of = |guid: u64| -> Option<(Entity, u32)> {
+        let e = *index.0.get(&guid)?;
+        Some((e, ents.get(e).ok()?.display_id?))
+    };
+    // The mirrored mobs and their race files.
+    if state.frame % 30 == 7 {
+        let text = std::fs::read_to_string(dir.join("mirrored.txt")).unwrap_or_default();
+        state.mirrored = text
+            .lines()
+            .filter_map(|l| l.strip_prefix("m "))
+            .filter_map(|g| u64::from_str_radix(g.trim(), 16).ok())
+            .collect();
+        let guids: Vec<u64> = state.mirrored.iter().copied().chain(state.want.map(|w| w.0)).collect();
+        for guid in guids {
+            if state.infos.contains(&guid) {
+                continue;
+            }
+            let Some((_, display)) = display_of(guid) else { continue };
+            let Some((race, kind)) = kind_names(&names, creatures.as_deref(), guid, display) else { continue };
+            let npc = index.0.get(&guid).and_then(|e| stores.get(*e).ok()).map_or(0, |s| s.0.unit_npc_flags());
+            let text = format!("display {display}\nrace {race}\ntype {kind}\nnpcflags {npc}\n");
+            match write_atomic(&dir.join("wowbody").join(format!("{guid:016x}.txt")), text.as_bytes()) {
+                Ok(()) => {
+                    state.infos.insert(guid);
+                }
+                Err(e) => warn!("wowbg3 preview: cannot write {guid:016x}.txt: {e}"),
+            }
+        }
+    }
+    let Some(booth) = booths.0.get_mut(BODY_SLOT) else {
+        return;
+    };
+    // The stream follows the request.
+    match state.want {
+        Some((guid, turn)) => {
+            if state.live.as_ref().map(|l| l.guid) != Some(guid) {
+                if let Some((entity, disp)) = display_of(guid) {
+                    info!("wowbg3 preview: streaming {guid:016x} (display {disp})");
+                    // A background still gives way; its display is picked again later.
+                    state.job = None;
+                    state.live = Some(Live { guid, display: disp, entity, frames: 0 });
+                    state.subject = Some(entity);
+                    if let Ok(mut s) = state.stream.lock() {
+                        s.guid = guid;
+                        s.stream = s.stream.wrapping_add(1);
+                        s.bbox = NO_BOX;
+                        s.written = 0;
+                    }
+                }
+            }
+            state.yaw = booth_yaw(turn);
+        }
+        None => {
+            if let Some(live) = state.live.take() {
+                let written = state.stream.lock().map(|s| s.written).unwrap_or(0);
+                info!("wowbg3 preview: {:016x} streamed ({written} frames)", live.guid);
+                state.subject = None;
+                state.yaw = BODY_YAW;
+                if let Ok(mut s) = state.stream.lock() {
+                    s.guid = 0;
+                }
+            }
+        }
+    }
+    let stream = state.stream.clone();
+    if let Some(live) = state.live.as_mut() {
+        if ents.get(live.entity).is_err() {
+            state.live = None;
+            state.subject = None;
+            return;
+        }
+        live.frames += 1;
+        // Rendered every frame while a preview shows it: the model animates, the turn follows. Not
+        // while a fresh bake's pipelines settle: the settle ends only once the wake has drained (the
+        // gate keeps the camera up meanwhile), and a wake held up kept it 15 s (harness).
+        if !booth.pipes_settling {
+            booth.wake = booth.wake.max(1);
+        }
+        let settled = live.frames > BOOTH_SETTLE_FRAMES + WAKE_LEAD
+            && booth.snap.is_some()
+            && booth.pending.is_empty()
+            && !booth.pipes_settling;
+        let idle = stream.lock().is_ok_and(|s| !s.in_flight);
+        if settled && idle {
+            let mut of = 0;
+            if let Ok(mut s) = stream.lock() {
+                s.in_flight = true;
+                of = s.stream;
+            }
+            let (guid, display) = (live.guid, live.display);
+            let dir = dir.clone();
+            commands
+                .spawn(Screenshot::image(booth.target.clone()))
+                .observe(move |shot: On<ScreenshotCaptured>| {
+                    let Ok(mut s) = stream.lock() else { return };
+                    s.in_flight = false;
+                    if s.guid != guid || s.stream != of {
+                        return; // the screen closed or moved on
+                    }
+                    let Some((w, h, px, bb)) = encode_body(&shot.image) else { return };
+                    match s.write(&dir, w, h, display, &px, bb) {
+                        Ok(()) => s.failed = false,
+                        Err(e) if !s.failed => {
+                            s.failed = true;
+                            warn!("wowbg3 preview: cannot write the live frame: {e}");
+                        }
+                        Err(_) => {}
+                    }
+                });
+        }
+        return;
+    }
+    // Background stills, one display at a time, now and then.
+    let Some(mut job) = state.job.take() else {
+        if state.frame % STILL_EVERY != 0 {
+            return;
+        }
+        let next = state.mirrored.iter().find_map(|&g| {
+            let (e, d) = display_of(g)?;
+            let blocked = state.stills.contains(&d) || state.failed.get(&d).is_some_and(|t| now - t < RETRY_AFTER);
+            (!blocked).then_some((g, e, d))
+        });
+        if let Some((guid, entity, display)) = next {
+            state.subject = Some(entity);
+            state.yaw = BODY_YAW;
+            state.job = Some(Job {
+                guid,
+                display,
+                entity,
+                since: now,
+                stage: Stage::Baking { armed: false },
+            });
+        } else {
+            state.subject = None;
+        }
+        return;
+    };
+    if ents.get(job.entity).is_err() {
+        state.subject = None;
+        return;
+    }
+    let timeout = match job.stage {
+        Stage::Shooting => BAKE_TIMEOUT + SHOT_TIMEOUT,
+        _ => BAKE_TIMEOUT,
+    };
+    if now - job.since > timeout {
+        warn!(
+            "wowbg3 preview: still of display {} (guid {:016x}) gave up after {timeout:.0} s",
+            job.display, job.guid
+        );
+        state.failed.insert(job.display, now);
+        state.subject = None;
+        return;
+    }
+    match job.stage {
+        Stage::Baking { armed } => {
+            let busy = booth.wake > 0 || !booth.pending.is_empty() || booth.pipes_settling;
+            if busy {
+                job.stage = Stage::Baking { armed: true };
+            } else if armed && booth.snap.is_some() {
+                job.stage = Stage::Waking(0);
+            }
+        }
+        Stage::Waking(n) => {
+            booth.wake = booth.wake.max(BOOTH_SETTLE_FRAMES);
+            if n + 1 < WAKE_LEAD {
+                job.stage = Stage::Waking(n + 1);
+            } else {
+                let path = dir.join("wowbody").join(format!("d{}.rgba", job.display));
+                let shots = state.shots.clone();
+                let display = job.display;
+                commands
+                    .spawn(Screenshot::image(booth.target.clone()))
+                    .observe(move |shot: On<ScreenshotCaptured>| {
+                        let result = (|| -> Result<usize, String> {
+                            let (w, h, px, bb) = encode_body(&shot.image).ok_or("unexpected target format")?;
+                            let bb = bb.unwrap_or([0, 0, 0, 0]);
+                            let mut out = Vec::with_capacity(32 + px.len());
+                            out.extend_from_slice(b"WBR2");
+                            for v in [w, h, display].into_iter().chain(bb) {
+                                out.extend_from_slice(&v.to_le_bytes());
+                            }
+                            out.extend_from_slice(&px);
+                            write_atomic(&path, &out).map_err(|e| e.to_string())?;
+                            Ok(out.len())
+                        })();
+                        if let Ok(mut s) = shots.lock() {
+                            s.push((display, result));
+                        }
+                    });
+                job.stage = Stage::Shooting;
+            }
+        }
+        Stage::Shooting => {
+            booth.wake = booth.wake.max(1);
+        }
+    }
     state.job = Some(job);
 }
