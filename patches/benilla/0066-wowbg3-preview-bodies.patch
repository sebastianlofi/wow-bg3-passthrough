+    /// stream (in flight when its screen closed, the same stand-in or not) is dropped.
+    guid: u64,
+    stream: u64,
+    /// The covered box over the stream so far (x0, y0, x1, y1), so the layer's framing holds still.
+    bbox: [u32; 4],
