+
+impl Default for WowBg3Body {
+    fn default() -> Self {
+        let dir = std::env::var_os("WOW_BG3_LINK_DIR").map(PathBuf::from);
+        if let Some(d) = &dir {
+            let _ = std::fs::create_dir_all(d.join("wowbody"));
+        }
+        Self {
+            dir,
+            subject: None,
+            yaw: BODY_YAW,
+            job: None,
+            live: None,
+            want: None,
+            stills: HashSet::new(),
+            failed: HashMap::new(),
+            infos: HashSet::new(),
+            mirrored: Vec::new(),
+            frame: 0,
+            shots: Arc::new(Mutex::new(Vec::new())),
+            stream: Arc::new(Mutex::new(Stream {
+                file: None,
+                seq: 0,
+                slot: 1,
+                guid: 0,
+                stream: 0,
+                bbox: NO_BOX,
+                in_flight: false,
+                written: 0,
+                failed: false,
+            })),
+        }
+    }
+}
+
+const NO_BOX: [u32; 4] = [u32::MAX, u32::MAX, 0, 0];
+/// BG3's preview yaw when its screen opens (its paperdoll's rotation, 25 degrees), and which way a
+/// BG3 turn turns the booth's model.
+const BG3_YAW0: f32 = 0.436_332;
+const YAW_SIGN: f32 = -1.0;
+/// Frames between two background stills: one booth bake now and then, never a stream of them.
+const STILL_EVERY: u64 = 20;
+
+/// `wowpreview.txt`: `1 <screen> <previews> <index> <guid hex> [<turn>]`; `None` for `0`.
+fn preview_request(dir: &Path) -> Option<(u64, Option<f32>)> {
+    let text = std::fs::read_to_string(dir.join("wowpreview.txt")).ok()?;
+    let mut words = text.split_whitespace();
+    if words.next()? != "1" {
+        return None;
+    }
+    let guid = u64::from_str_radix(words.nth(3)?, 16).ok()?;
+    Some((guid, words.next().and_then(|w| w.parse::<f32>().ok()).filter(|y| y.is_finite())))
+}
+
+/// BG3's preview turn as the booth's model turn.
+fn booth_yaw(bg3: Option<f32>) -> f32 {
+    bg3.map_or(BODY_YAW, |y| BODY_YAW + YAW_SIGN * (y - BG3_YAW0))
+}
