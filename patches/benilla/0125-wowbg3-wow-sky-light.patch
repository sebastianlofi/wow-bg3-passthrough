+/// Patch 0125: WoW's scene light for BG3's own lighting (the mod's WorldLight.lua sets BG3's sun and sky from it):
+/// `$WOW_BG3_LINK_DIR/wowsky.txt`, one line "WSK1 <to-sun x y z, WoW axes> <diffuse r g b> <ambient r g b>" (the
+/// `Light.dbc` colours as sampled for the time of day, sRGB 0..1), written whole (rename) when a value moved.
+fn sky_export(l: &benilla_world::lighting::WowLighting) {
+    static LAST: std::sync::Mutex<Option<[f32; 9]>> = std::sync::Mutex::new(None);
+    let Some(dir) = std::env::var_os("WOW_BG3_LINK_DIR") else { return };
+    let to_sun = benilla_assets::coords::bevy_to_wow(-l.sun_dir.normalize_or_zero());
+    let v = [to_sun[0], to_sun[1], to_sun[2], l.diffuse[0], l.diffuse[1], l.diffuse[2], l.ambient[0], l.ambient[1], l.ambient[2]];
+    let Ok(mut last) = LAST.lock() else { return };
+    if last.is_some_and(|p| p.iter().zip(v.iter()).all(|(a, b)| (a - b).abs() < 0.002)) {
+        return;
+    }
+    let text = format!(
+        "WSK1 {:.4} {:.4} {:.4} {:.4} {:.4} {:.4} {:.4} {:.4} {:.4}\n",
+        v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8]
+    );
+    let path = std::path::Path::new(&dir).join("wowsky.txt");
+    let tmp = path.with_extension("tmp");
+    if std::fs::write(&tmp, text).is_ok() && std::fs::rename(&tmp, &path).is_ok() {
+        *last = Some(v);
+    }
+}
