+/// WOW-BG3 patch 0038: the side `faction.txt` in the link folder names (`SEQ SIDE`,
+/// SIDE horde, alliance or own; link/tools/faction.sh, which also has the server count the player
+/// as that side, server patch 0009): 0 for own, else the race whose side we count as (2 Orc for
+/// horde, 1 Human for alliance). Read every 30 frames by `fight_tick`.
+static SIDE_RACE: AtomicU8 = AtomicU8::new(0);
+
+fn read_side(dir: &Path) {
+    let text = std::fs::read_to_string(dir.join("faction.txt")).unwrap_or_default();
+    let race = match text.split_whitespace().nth(1) {
+        Some("horde") => 2,
+        Some("alliance") => 1,
+        _ => 0,
+    };
+    SIDE_RACE.store(race, Ordering::Relaxed);
+}
+
+/// The rank (0 hated .. 6 revered, as `ring_reaction`) a player of the side's race would have
+/// toward this creature, as the server's forced reactions (patch 0009) give it: a reputation
+/// faction by that race's base standing, else the template comparator against that race's template.
+fn side_rank(store: &ObjectStore, me: &ObjectStore, factions: Option<&Factions>, race: u8) -> Option<u8> {
+    let catalog = factions?.catalog();
+    let tpl = catalog.template(store.0.unit_faction_template()?)?;
+    if let Some(info) = catalog.reputation_faction(tpl.faction).filter(|i| i.rep_index >= 0) {
+        let class = me.0.unit_class().unwrap_or(1);
+        return Some(benilla_formats::reputation_rank(info.base_for(race, class)).min(6));
+    }
+    let mine = catalog.race_template(race)?;
+    Some(tpl.reaction_toward(mine) as u8)
+}
