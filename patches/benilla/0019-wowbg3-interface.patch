+
+/// Writes the near plane over [`NEAR_RECT`] in a slot file's depth rows (at `at`, `dbpr` bytes a
+/// row, `len` bytes in all, `width` texels wide); true when there is nothing to do or it worked.
+#[cfg(unix)]
+fn write_near_rect(f: &std::fs::File, at: usize, dbpr: usize, len: usize, width: usize) -> bool {
+    use std::os::unix::fs::FileExt;
+    let Some([x, y, w, h]) = NEAR_RECT.lock().ok().and_then(|r| *r) else { return true };
+    if dbpr == 0 {
+        return true;
+    }
+    let rows = len / dbpr;
+    let width = width.min(dbpr / 4);
+    let px = |v: f32, n: usize| ((v.clamp(0.0, 1.0) * n as f32).round() as usize).min(n);
+    let (x0, x1) = (px(x, width), px(x + w, width));
+    let (y0, y1) = (px(y, rows), px(y + h, rows));
+    if x1 <= x0 || y1 <= y0 {
+        return true;
+    }
+    let row: Vec<u8> = std::iter::repeat_n(1.0f32.to_le_bytes(), x1 - x0).flatten().collect();
+    (y0..y1).all(|r| f.write_all_at(&row, (at + r * dbpr + x0 * 4) as u64).is_ok())
+}
