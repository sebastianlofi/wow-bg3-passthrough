+fn run_errands(
+    mut e: ResMut<Errands>,
+    mut approach: ResMut<crate::player::Approach>,
+    player: Res<crate::player::Player>,
+    index: Res<crate::net::GuidIndex>,
+    places: Query<(&Transform, Option<&crate::net::ObjectStore>)>,
+) {
+    let ask = ERRAND_ASK.lock().ok().and_then(|mut a| a.take());
+    if let Some(ask) = ask {
+        // A new errand replaces the one in flight; the click that asked for it is no cancel.
+        ERRAND_CANCEL.store(false, Ordering::Relaxed);
+        info!(
+            "wowbg3 errand: {:?} at {:#x}, {:.1} yd from the body (reach {:.2}): BG3's character runs there",
+            ask.verb,
+            ask.guid,
+            ask.at.distance(player.pos),
+            ask.reach
+        );
+        e.write(ERRAND_GO, ask.guid, ask.at, errand_stop(ask.reach));
+        e.live = Some(LiveErrand { ask, since: Instant::now(), sent: ask.at });
+        return;
+    }
+    if ERRAND_CANCEL.swap(false, Ordering::Relaxed) {
+        // BG3 ignores the player's own clicks while the errand's Osiris move runs, so she is
+        // stopped (WorldMode.lua already stops her at the press; this is the fallback).
+        e.end("a new BG3 click", true);
+        return;
+    }
+    let Some(live) = e.live else { return };
+    let ask = live.ask;
+    if TAV_COMBAT.load(Ordering::Relaxed) {
+        e.end("BG3 combat", true);
+        return;
+    }
+    if live.since.elapsed().as_secs_f32() > ERRAND_SECONDS {
+        e.end("not in reach after 15 s", true);
+        return;
+    }
+    let Some((tf, store)) = index.0.get(&ask.guid).and_then(|en| places.get(*en).ok()) else {
+        e.end("the target is gone", true);
+        return;
+    };
+    let talk = matches!(ask.verb, crate::player::ApproachVerb::Talk);
+    if talk && store.is_some_and(|s| s.0.unit_health().unwrap_or(1) == 0) {
+        e.end("the NPC died", true);
+        return;
+    }
+    let at = tf.translation;
+    let d = at.distance(player.pos);
+    if d <= (ask.reach - ERRAND_MARGIN).max(0.5) {
+        info!(
+            "wowbg3 errand: {:?} at {:#x}: the body is {d:.2} yd away, in reach after {:.1} s",
+            ask.verb,
+            ask.guid,
+            live.since.elapsed().as_secs_f32()
+        );
