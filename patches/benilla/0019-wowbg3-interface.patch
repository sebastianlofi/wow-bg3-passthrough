+static ERRAND_ASK: Mutex<Option<ErrandAsk>> = Mutex::new(None);
+/// A new BG3 click ends the errand in flight (BG3's own move, or a new errand, takes over).
+static ERRAND_CANCEL: AtomicBool = AtomicBool::new(false);
+/// BG3's character is in a BG3 combat (`tav.bin` flags bit 1).
+static TAV_COMBAT: AtomicBool = AtomicBool::new(false);
+/// When the last new `tav.bin` record came ([`clock_ms`]; 0: never).
+static TAV_SEEN_MS: AtomicU64 = AtomicU64::new(0);
+
+fn clock_ms() -> u64 {
+    static START: OnceLock<Instant> = OnceLock::new();
+    START.get_or_init(Instant::now).elapsed().as_millis() as u64 + 1
+}
+
+/// How long an errand may take before it is given up (s).
+const ERRAND_SECONDS: f32 = 15.0;
+/// The body counts as in reach this far inside the verb's range (yd): the server measures from
+/// where it last heard the body was.
+const ERRAND_MARGIN: f32 = 0.3;
