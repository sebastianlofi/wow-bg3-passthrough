+        e.live = None;
+        e.write(0, ask.guid, at, 0.0);
+        return;
+    }
+    if at.distance(live.sent) > 1.5 {
+        // The target walked on (a wandering NPC): send her after it.
+        e.write(ERRAND_GO, ask.guid, at, errand_stop(ask.reach));
+        if let Some(l) = e.live.as_mut() {
+            l.sent = at;
+        }
+    }
+}
