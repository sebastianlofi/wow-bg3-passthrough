+/// Decodes `bg3ui.bin`: (seq, mode, rect); `None` when torn, foreign or out of range.
+pub(crate) fn decode_ui(rec: &[u8]) -> Option<(u32, u32, [f32; 4])> {
+    if rec.len() < 32 || &rec[0..4] != b"BUI1" {
+        return None;
+    }
+    let u = |o: usize| u32::from_le_bytes(rec[o..o + 4].try_into().unwrap());
+    let f = |o: usize| f32::from_le_bytes(rec[o..o + 4].try_into().unwrap());
+    let (seq, mode) = (u(4), u(8));
+    let rect = [f(12), f(16), f(20), f(24)];
+    let fits = rect.iter().all(|v| v.is_finite() && (-0.01..=1.01).contains(v));
+    (seq != 0 && seq == u(28) && mode <= 2 && fits).then_some((seq, mode, rect))
+}
+
+fn forward_ui(mut u: ResMut<UiLink>, script: Option<NonSend<benilla_ui::script::UiScript>>) {
+    u.frame += 1;
+    if u.frame % 6 != 0 {
+        return;
+    }
+    let Some(script) = script else { return };
+    let Ok(raw) = std::fs::read(&u.path) else { return };
+    let Some((seq, mode, rect)) = decode_ui(&raw) else { return };
+    if seq == u.last_seq {
+        return;
+    }
+    u.last_seq = seq;
+    let want = (mode != 0).then_some((mode, rect));
+    let changed = match (u.shown, want) {
+        (None, None) => false,
+        (Some((m0, r0)), Some((m1, r1))) => {
+            m0 != m1 || r0.iter().zip(r1.iter()).any(|(a, b)| (a - b).abs() > 0.002)
+        }
+        _ => true,
+    };
+    if !changed {
+        return;
+    }
+    let [x, y, w, h] = if mode == 2 { [0.0, 0.0, 1.0, 1.0] } else { rect };
+    let chunk = format!(
+        "if WowBg3Layout_Map then WowBg3Layout_Map({mode}, {x:.4}, {y:.4}, {w:.4}, {h:.4}) end"
+    );
+    match script.run(&chunk) {
+        Ok(()) => info!("wowbg3 map: mode {mode}, rect {x:.3} {y:.3} {w:.3} {h:.3}"),
+        Err(e) => warn!("wowbg3 map: {e}"),
+    }
+    crate::wowbg3_frames::set_near_rect((mode != 0).then_some([x, y, w, h]));
+    u.shown = want;
