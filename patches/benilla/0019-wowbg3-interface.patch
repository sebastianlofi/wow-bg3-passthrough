+/// Patch 0019: a dispatcher's out-of-reach leg in world mode. BG3's character is asked to run to
+/// the target; the verb runs once the own body, following her, is within `reach`. False when
+/// there is nobody to ask (no `tav.bin` for 2 s: world mode not running) or she is in a BG3
+/// combat: the dispatcher then answers as with Click to Move off (nothing, or WoW's too far).
+pub(crate) fn request_errand(verb: crate::player::ApproachVerb, guid: u64, at: Vec3, reach: f32) -> bool {
+    let seen = TAV_SEEN_MS.load(Ordering::Relaxed);
+    let why = if seen == 0 || clock_ms().saturating_sub(seen) > 2000 {
+        Some("no BG3 character to send")
+    } else if TAV_COMBAT.load(Ordering::Relaxed) {
+        Some("BG3's character is in combat")
+    } else {
+        None
+    };
+    if let Some(why) = why {
+        info!("wowbg3 errand: {verb:?} at {guid:#x} refused: {why}");
+        return false;
+    }
+    if let Ok(mut a) = ERRAND_ASK.lock() {
+        *a = Some(ErrandAsk { verb, guid, at, reach });
+    }
+    true
