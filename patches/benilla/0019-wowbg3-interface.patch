+
+#[derive(Clone, Copy)]
+struct LiveErrand {
+    ask: ErrandAsk,
+    since: Instant,
+    /// Where `tavgo.bin` last sent her (the target then, Bevy).
+    sent: Vec3,
+}
+
+impl Errands {
+    fn write(&mut self, flags: u32, guid: u64, at: Vec3, stop: f32) {
+        self.seq = self.seq.wrapping_add(1).max(1);
+        let w = bevy_to_wow(at);
+        let mut rec = [0u8; 40];
+        rec[0..4].copy_from_slice(b"TGO1");
+        rec[4..8].copy_from_slice(&self.seq.to_le_bytes());
+        rec[8..12].copy_from_slice(&(guid as u32).to_le_bytes());
+        rec[12..16].copy_from_slice(&((guid >> 32) as u32).to_le_bytes());
+        for (i, v) in [w[0], w[1], w[2], stop].iter().enumerate() {
+            rec[16 + 4 * i..20 + 4 * i].copy_from_slice(&v.to_le_bytes());
+        }
+        rec[32..36].copy_from_slice(&flags.to_le_bytes());
+        rec[36..40].copy_from_slice(&self.seq.to_le_bytes());
+        let tmp = self.path.with_extension("tmp");
+        if std::fs::write(&tmp, rec).is_ok() {
+            let _ = std::fs::rename(&tmp, &self.path);
+        }
+    }
+
+    fn end(&mut self, why: &str, stop_tav: bool) {
+        if let Some(live) = self.live.take() {
+            info!("wowbg3 errand: {:?} at {:#x} ends: {why}", live.ask.verb, live.ask.guid);
+            let flags = if stop_tav { ERRAND_STOP_TAV } else { 0 };
+            self.write(flags, live.ask.guid, live.sent, 0.0);
+        }
+    }
+}
