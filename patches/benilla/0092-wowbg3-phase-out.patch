+/// WOW-BG3 patch 0092: the small placements among a bake's items, in the post-sort order the record
+/// table has: each one's drawn box in the world and its item indices.
+fn bake_pieces(
+    items: &[GxItem],
+    keys: &bevy::platform::collections::HashSet<crate::phase_out::PieceKey>,
+) -> Vec<super::GxPiece> {
+    let mut pieces: Vec<super::GxPiece> = Vec::new();
+    for (idx, item) in items.iter().enumerate() {
+        let key = crate::phase_out::piece_key(&item.transform);
+        if !keys.contains(&key) {
+            continue;
+        }
+        let (lo, hi) = match &item.local_aabb {
+            Some(a) => crate::phase_out::world_box(&GlobalTransform::from(item.transform), a),
+            None => (item.transform.translation, item.transform.translation),
+        };
+        let idx = u16::try_from(idx).expect("gx cell under u16 items");
+        match pieces.iter_mut().find(|p| p.key == key) {
+            Some(p) => {
+                p.lo = p.lo.min(lo);
+                p.hi = p.hi.max(hi);
+                p.items.push(idx);
+            }
+            None => pieces.push(super::GxPiece { key, lo, hi, items: vec![idx] }),
+        }
+    }
+    pieces
+}
