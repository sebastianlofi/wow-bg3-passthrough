+pub(crate) fn with_fade_level_slot(tag: u32, level: u8) -> u32 {
+    let rig = rig_of(tag);
+    if rig != 0 && usize::from(rig) < USABLE_RIG_SLOTS {
+        return tag;
+    }
+    if level == 0 {
+        return tag & !RIG_MASK;
+    }
+    (tag & !(ALPHA_MASK | RIG_MASK))
+        | carried_alpha(tag)
+        | rig_bits((USABLE_RIG_SLOTS + usize::from(level.min(16)) - 1) as u16)
+}
