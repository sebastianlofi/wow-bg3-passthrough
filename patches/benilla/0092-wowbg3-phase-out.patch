+// WOW-BG3 patch 0092: BG3's per-object fade (`FadePatternOnePass.bshd`, as in `static_gx.wgsl`): at level
+// `k` the cells of the 4x4 Bayer table under `k` are gone, so 16 is the whole piece and 0 none of it.
+fn wow_fade_discard(k: u32, frag: vec2<f32>) -> bool {
+    var m = array<u32, 16>(
+        0u, 8u, 2u, 10u,
+        12u, 4u, 14u, 6u,
+        3u, 11u, 1u, 9u,
+        15u, 7u, 13u, 5u
+    );
+    let ix = u32(i32(frag.x % 4.0));
+    let iy = u32(i32(frag.y % 4.0));
+    return m[ix * 4u + iy] < k;
+}
+
+// The noise's rows in the buffer's last regions: 512 x 512 floats, four a row. The unit fades follow.
+const WOW_SEE_NOISE_ROWS: u32 = 65536u;
+
+// A rig slot's fade level (`crate::phase_out::UnitFades`), 0 for slot 0 or while there is no noise
+// row to count from (no see-through in this run).
+fn wow_unit_fade(slot: u32) -> u32 {
+    let base = u32(wow_light.cut_params.x);
+    if (base == 0u || slot == 0u) {
+        return 0u;
+    }
+    return u32(wow_light.palettes[base - WOW_SEE_TAIL + WOW_SEE_NOISE_ROWS + slot / 4u][slot % 4u]);
+}
