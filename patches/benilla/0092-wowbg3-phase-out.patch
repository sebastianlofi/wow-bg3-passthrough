+/// WOW-BG3 patch 0092: the region a small placement's items are in.
+#[derive(Clone, Copy, PartialEq, Eq, Hash)]
+pub(super) enum PieceHome {
+    Cell((i32, i32)),
+    Prop(Entity),
+}
+
+/// WOW-BG3 patch 0092: walks every small placement's fade and publishes this frame's per-item levels.
+/// A placement fades while its drawn box crosses a sight line (`phase_out::Sight`), all its items
+/// together; the regions the sight lines' box misses are not walked.
+fn step_phase_fades(
+    see: &crate::see_through::SeeThrough,
+    cells: &bevy::platform::collections::HashMap<(i32, i32), super::GxCell>,
+    props: &bevy::platform::collections::HashMap<Entity, super::GxCell>,
+    world: &mut crate::static_gx::render::GxWorld,
+    fades: &mut bevy::platform::collections::HashMap<crate::phase_out::PieceKey, (f32, PieceHome)>,
+    dt: f32,
+) {
+    use crate::phase_out::{level, step, Sight};
+    world.phase_cells.clear();
+    world.phase_props.clear();
+    let sight = Sight::of(see);
+    let mut hit: Vec<crate::phase_out::PieceKey> = Vec::new();
+    if let Some(s) = &sight {
+        let (blo, bhi) = s.bounds();
+        let near = |draw: &crate::static_gx::render::GxCellDraw| {
+            let c = draw.origin + Vec3::from(draw.aabb.center);
+            let h = Vec3::from(draw.aabb.half_extents);
+            !((c - h).cmpgt(bhi).any() || (c + h).cmplt(blo).any())
+        };
+        for (&key, state) in cells {
+            if state.pieces.is_empty() || !world.cells.get(&key).is_some_and(|d| near(d)) {
+                continue;
+            }
+            for p in state.pieces.iter().filter(|p| s.blocked_by(p.lo, p.hi)) {
+                hit.push(p.key);
+                fades.entry(p.key).or_insert((0.0, PieceHome::Cell(key)));
+            }
+        }
+        for (&entity, state) in props {
+            if state.pieces.is_empty() || !world.props.get(&entity).is_some_and(|d| near(d)) {
+                continue;
+            }
+            for p in state.pieces.iter().filter(|p| s.blocked_by(p.lo, p.hi)) {
+                hit.push(p.key);
+                fades.entry(p.key).or_insert((0.0, PieceHome::Prop(entity)));
+            }
+        }
+    }
+    if fades.is_empty() {
+        return;
+    }
+    fades.retain(|key, (f, home)| {
+        let in_way = hit.contains(key);
+        *f = step(*f, in_way, dt);
+        if *f <= 0.0 && !in_way {
+            return false;
+        }
+        // A rebake moves the item indices, so they are read fresh; a placement gone is dropped.
+        let state = match home {
+            PieceHome::Cell(c) => cells.get(c),
+            PieceHome::Prop(e) => props.get(e),
+        };
+        let Some(piece) = state.and_then(|s| s.pieces.iter().find(|p| p.key == *key)) else {
+            return false;
+        };
+        let k = level(*f);
+        if k > 0 {
+            let list = match home {
+                PieceHome::Cell(c) => world.phase_cells.entry(*c).or_default(),
+                PieceHome::Prop(e) => world.phase_props.entry(*e).or_default(),
+            };
+            list.extend(piece.items.iter().map(|&i| (i, k)));
+        }
+        true
+    });
+    // The render side compares these lists: the same pieces must read the same every frame.
+    for list in world.phase_cells.values_mut().chain(world.phase_props.values_mut()) {
+        list.sort_unstable();
+    }
+}
