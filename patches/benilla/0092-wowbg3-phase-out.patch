@@ -0,0 +1,416 @@
+//! WOW-BG3 patch 0092: the small pieces between the camera and her phase out, whole.
+//!
+//! The design rule for what stands between the camera and the character: ceilings,
+//! bushes, skinny trees and posts **phase out**; walls get the see-through opening (patch 0090);
+//! mountains, rocks and big trees the camera **bumps into** (the plugin's eye clearance). 0091 took
+//! the ceilings; this patch takes the small doodads, with the same per-object fade BG3 gives a piece
+//! marked `Fadeable`: the sixteen-step ordered dissolve over the 4x4 Bayer table
+//! (`FadePatternOnePass.bshd`) at BG3's `FadeOutSpeed` 5.0, so a fifth of a second out and back.
+//!
+//! **Small or big.** BG3 marks each object by hand (`Fadeable`, `SeeThrough`, `CollideWithCamera`
+//! on its root templates); WoW has no such flag, so the line is drawn on WoW's own collision: a
+//! placement whose collision hull measures under [`SMALL_YD`] on the smallest side of its own box
+//! (the model's axes, times its scale, so how a piece is turned does not change what it is) phases
+//! out, a larger one is something the camera bumps into. The plugin draws the same line on the same
+//! hulls (the server's vmaps are cut from them; `wow_arena.py` tags a big M2 kind 5), so no piece both
+//! fades and pushes the camera, and none does neither. A model with no hull (most bushes, grass,
+//! flowers) is thin. A low wide piece (a planter 1.2 yd tall) is small: it is seen over, and pulling
+//! the camera in for it would be wrong.
+//!
+//! **Between.** A piece fades while its drawn box (the render bound, canopy and all, not the hull)
+//! crosses a sight line from the eye to her feet, chest or head, and comes back once none does.
+//! The target is the see-through's own ([`crate::see_through::SeeThrough`]): no capsule live, no
+//! fade, so outside world mode nothing changes.
+//!
+//! A big doodad keeps 0090's cut in `static_gx`: WoW's collision has a big tree's trunk and not its
+//! canopy, so the camera bumps the trunk and ends up under leaves, and BG3 marks most of its trees
+//! `SeeThrough` for that picture. A small one is never cut, only faded.
+//!
+//! Where it runs: `static_gx` (cells and prop regions, the record's fade bits 0091 added) and here,
+//! for the doodad parts left on the entity path (animated, billboarded, blended), through bits
+//! 14..=18 of the exterior `MeshTag` payload ([`crate::mesh_tag::with_phase`]). An interior prop has
+//! no such bits (they hold its probe slot, which props with the same light share), so it says its level
+//! through its rig field ([`crate::mesh_tag::with_fade_level_slot`]) and [`UnitFades`]. Units standing
+//! on a storey 0091 takes away fade the same way through [`UnitFades`], one level per rig slot.
+
+use std::sync::Arc;
+
+use bevy::camera::primitives::Aabb;
+use bevy::mesh::MeshTag;
+use bevy::platform::collections::{HashMap, HashSet};
+use bevy::prelude::*;
+use bevy::render::extract_resource::{ExtractResource, ExtractResourcePlugin};
+use bevy::render::renderer::RenderQueue;
+use bevy::render::{Render, RenderApp, RenderSystems};
+
+/// The line between small and big (yd): a collision hull under this on its own smallest side
+/// phases out; one this size or more the camera bumps into. `wow_arena.py`'s `BIG_M2_YD` is the same
+/// number.
+pub const SMALL_YD: f32 = 4.0;
+
+/// BG3's `FadeOutSpeed`, 5.0 on most objects that set one: a whole fade in a fifth of a second.
+pub const FADE_SPEED: f32 = 5.0;
+
+/// How far a piece's box is grown before the sight test (yd): her outline is wider than a line.
+const SIGHT_MARGIN: f32 = 0.25;
+
+/// Her feet and head from the see-through's target, which sits at her chest (yd).
+const FEET_BELOW: f32 = 0.9;
+const HEAD_ABOVE: f32 = 0.6;
+
+/// A placement's thickness: the smallest side of its collision hull's box in the model's own axes,
+/// times its scale (yd); `0` when it has no hull. Not the world box: a fence turned 45 degrees would
+/// read as wide as it is long.
+pub fn placement_thickness(hull: Option<&benilla_formats::CollisionMesh>, transform: &Transform) -> f32 {
+    let Some(hull) = hull.filter(|h| !h.is_empty() && !h.positions.is_empty()) else {
+        return 0.0;
+    };
+    let (mut lo, mut hi) = (Vec3::splat(f32::MAX), Vec3::splat(f32::MIN));
+    for p in &hull.positions {
+        let v = Vec3::from_array(*p);
+        lo = lo.min(v);
+        hi = hi.max(v);
+    }
+    (hi - lo).min_element() * transform.scale.abs().max_element()
+}
+
+/// Does a placement this thick phase out (rather than stop the camera)?
+pub fn phases(thick: f32) -> bool {
+    thick < SMALL_YD
+}
+
+/// A placement's identity for the fade: its translation's bits. Every batch of a placement shares
+/// its transform, and the `uniqueId` will not do: a WMO's props all carry their building's.
+pub type PieceKey = [u32; 3];
+
+/// The key of the placement at `t`.
+pub fn piece_key(t: &Transform) -> PieceKey {
+    t.translation.to_array().map(f32::to_bits)
+}
+
+/// Marks a small doodad's entity-path part: the placement it fades with.
+#[derive(Component, Clone, Copy)]
+pub struct PhasePiece {
+    pub key: PieceKey,
+    /// An interior prop's part, whose tag has no bits for the level (`with_fade_level_slot`).
+    pub interior: bool,
+}
+
+/// This frame's sight lines, from the eye to her feet, chest and head.
+#[derive(Clone, Copy)]
+pub struct Sight {
+    eye: Vec3,
+    to: [Vec3; 3],
+}
+
+impl Sight {
+    /// From the see-through's state; `None` while no capsule is live.
+    pub fn of(see: &crate::see_through::SeeThrough) -> Option<Self> {
+        if !see.live() {
+            return None;
+        }
+        let at = see.cuts[0].at;
+        Some(Self {
+            eye: see.eye,
+            to: [at - Vec3::Y * FEET_BELOW, at, at + Vec3::Y * HEAD_ABOVE],
+        })
+    }
+
+    /// The box all three lines lie in, grown by the margin: a cheap first reject.
+    pub fn bounds(&self) -> (Vec3, Vec3) {
+        let lo = self.to.iter().fold(self.eye, |a, b| a.min(*b));
+        let hi = self.to.iter().fold(self.eye, |a, b| a.max(*b));
+        (lo - Vec3::splat(SIGHT_MARGIN), hi + Vec3::splat(SIGHT_MARGIN))
+    }
+
+    /// Does a world box stand across a sight line?
+    pub fn blocked_by(&self, lo: Vec3, hi: Vec3) -> bool {
+        let (blo, bhi) = self.bounds();
+        if lo.cmpgt(bhi).any() || hi.cmplt(blo).any() {
+            return false;
+        }
+        let (lo, hi) = (lo - Vec3::splat(SIGHT_MARGIN), hi + Vec3::splat(SIGHT_MARGIN));
+        self.to.iter().any(|t| segment_hits_box(self.eye, *t, lo, hi))
+    }
+}
+
+/// The slab test: does the segment `a`..`b` touch the box?
+pub fn segment_hits_box(a: Vec3, b: Vec3, lo: Vec3, hi: Vec3) -> bool {
+    let d = b - a;
+    let (mut t0, mut t1) = (0.0f32, 1.0f32);
+    for i in 0..3 {
+        if d[i].abs() < 1e-6 {
+            if a[i] < lo[i] || a[i] > hi[i] {
+                return false;
+            }
+            continue;
+        }
+        let (mut n, mut f) = ((lo[i] - a[i]) / d[i], (hi[i] - a[i]) / d[i]);
+        if n > f {
+            std::mem::swap(&mut n, &mut f);
+        }
+        t0 = t0.max(n);
+        t1 = t1.min(f);
+        if t0 > t1 {
+            return false;
+        }
+    }
+    true
+}
+
+/// A box under a transform, as a world box.
+pub fn world_box(gt: &GlobalTransform, aabb: &Aabb) -> (Vec3, Vec3) {
+    let a = gt.affine();
+    let c = a.transform_point3(Vec3::from(aabb.center));
+    let h = Vec3::from(aabb.half_extents);
+    let m = a.matrix3;
+    let e = m.x_axis.abs() * h.x + m.y_axis.abs() * h.y + m.z_axis.abs() * h.z;
+    (c - Vec3::from(e), c + Vec3::from(e))
+}
+
+/// One piece's fade this frame: toward 1 while it stands in the way, back toward 0 once it does not.
+pub fn step(f: f32, gone: bool, dt: f32) -> f32 {
+    if gone {
+        (f + dt * FADE_SPEED).min(1.0)
+    } else {
+        (f - dt * FADE_SPEED).max(0.0)
+    }
+}
+
+/// A fade as BG3's sixteen dissolve steps.
+pub fn level(f: f32) -> u8 {
+    (f * 16.0).round().clamp(0.0, 16.0) as u8
+}
+
+/// An emitter of a small doodad: its flames go with the piece, by the alpha every particle of an
+/// emitter already carries. Its own box is the owner's bounds, so a piece drawn on `static_gx`,
+/// which has no part on the entity path, still has something here to test.
+#[derive(Component, Clone, Copy)]
+pub struct PhaseEmitter {
+    key: PieceKey,
+    lo: Vec3,
+    hi: Vec3,
+    pub alpha: f32,
+}
+
+impl PhaseEmitter {
+    pub(crate) fn new(key: PieceKey, fade: &crate::particles::EmitterFade) -> Self {
+        // The box inside the owner's bounding sphere, as the sphere's corners stand far off the model.
+        let half = Vec3::splat(fade.radius * 0.577);
+        Self { key, lo: fade.center - half, hi: fade.center + half, alpha: 1.0 }
+    }
+}
+
+/// The entity-path half: every small doodad part whose placement stands in the way fades, all its
+/// parts and emitters together.
+pub(crate) fn phase_entity_doodads(
+    see: Res<crate::see_through::SeeThrough>,
+    time: Res<Time>,
+    mut parts: Query<(&PhasePiece, &GlobalTransform, &Aabb, &mut MeshTag)>,
+    mut emitters: Query<&mut PhaseEmitter>,
+    mut table: ResMut<UnitFades>,
+    mut fades: Local<HashMap<PieceKey, f32>>,
+    mut hit: Local<HashSet<PieceKey>>,
+) {
+    let _t = crate::static_gx::gx_perf_guard(1);
+    hit.clear();
+    if let Some(sight) = Sight::of(&see) {
+        for (piece, gt, aabb, _) in &parts {
+            if hit.contains(&piece.key) {
+                continue;
+            }
+            let (lo, hi) = world_box(gt, aabb);
+            if sight.blocked_by(lo, hi) {
+                hit.insert(piece.key);
+            }
+        }
+        for em in &emitters {
+            if sight.blocked_by(em.lo, em.hi) {
+                hit.insert(em.key);
+            }
+        }
+    }
+    table.bypass_change_detection().parts.clear();
+    if hit.is_empty() && fades.is_empty() {
+        return;
+    }
+    let dt = time.delta_secs();
+    for &key in hit.iter() {
+        fades.entry(key).or_insert(0.0);
+    }
+    fades.retain(|key, f| {
+        *f = step(*f, hit.contains(key), dt);
+        *f > 0.0 || hit.contains(key)
+    });
+    for (piece, _, _, mut tag) in &mut parts {
+        let k = fades.get(&piece.key).map_or(0, |f| level(*f));
+        let t = if piece.interior {
+            let rig = crate::mesh_tag::rig_of(tag.0);
+            if k > 0 && rig != 0 && usize::from(rig) < crate::mesh_tag::USABLE_RIG_SLOTS {
+                table.bypass_change_detection().parts.push((rig, k));
+            }
+            crate::mesh_tag::with_fade_level_slot(tag.0, k)
+        } else {
+            crate::mesh_tag::with_phase(tag.0, k)
+        };
+        if t != tag.0 {
+            tag.0 = t;
+        }
+    }
+    for mut em in &mut emitters {
+        let alpha = 1.0 - fades.get(&em.key).copied().unwrap_or(0.0);
+        if em.alpha != alpha {
+            em.alpha = alpha;
+        }
+    }
+}
+
+/// The fade level (0 to 16) of every rig slot, for the units standing on a storey 0091 takes away
+/// (`wmo_portal`'s `fade_units_above_her`). Slot-keyed like [`crate::instance_tint`], so a unit's
+/// gear, on rider slots of its own, fades with it.
+#[derive(Resource, Clone, ExtractResource)]
+pub struct UnitFades {
+    slots: Arc<Vec<f32>>,
+    generation: u64,
+    /// This frame's animated interior props: their own rig slot and level.
+    parts: Vec<(u16, u8)>,
+}
+
+impl Default for UnitFades {
+    fn default() -> Self {
+        Self {
+            slots: Arc::new(vec![0.0; crate::mesh_tag::MAX_RIG_SLOTS]),
+            generation: 0,
+            parts: Vec::new(),
+        }
+    }
+}
+
+impl UnitFades {
+    /// Replaces the whole table from the units' levels, the animated props' and the sixteen slots
+    /// that stand for a level; uploads only when it changed.
+    pub fn publish(&mut self, levels: &[u8]) {
+        let mut v = vec![0.0; crate::mesh_tag::MAX_RIG_SLOTS];
+        for (d, s) in v.iter_mut().zip(levels) {
+            *d = f32::from(*s);
+        }
+        for &(slot, k) in &self.parts {
+            if let Some(d) = v.get_mut(usize::from(slot)) {
+                *d = d.max(f32::from(k));
+            }
+        }
+        for k in 0..crate::mesh_tag::FADE_LEVEL_SLOTS {
+            v[crate::mesh_tag::USABLE_RIG_SLOTS + k] = (k + 1) as f32;
+        }
+        if *self.slots != v {
+            self.slots = Arc::new(v);
+            self.generation += 1;
+        }
+    }
+}
+
+/// Where the unit fades sit in the shared light buffer: right after 0090's noise, so nothing
+/// already mirrored moves. One f32 a slot (a plain value survives a float load, a bit pattern
+/// need not); `wow_model.wgsl` reaches it from the noise's row.
+pub fn unit_fade_offset() -> u64 {
+    crate::lighting::see_noise_offset() + crate::lighting::see_noise_bytes()
+}
+
+/// The region's size: one f32 per rig slot.
+pub fn unit_fade_bytes() -> u64 {
+    crate::mesh_tag::MAX_RIG_SLOTS as u64 * 4
+}
+
+/// Render world: the whole region on a change.
+fn upload_unit_fades(
+    queue: Res<RenderQueue>,
+    shared: Option<Res<crate::lighting::SharedLightBuffer>>,
+    fades: Option<Res<UnitFades>>,
+    mut last: Local<Option<u64>>,
+) {
+    let (Some(shared), Some(fades)) = (shared, fades) else {
+        return;
+    };
+    if *last == Some(fades.generation) {
+        return;
+    }
+    *last = Some(fades.generation);
+    queue.write_buffer(&shared.0, unit_fade_offset(), bytemuck::cast_slice(fades.slots.as_slice()));
+}
+
+pub fn plugin(app: &mut App) {
+    app.init_resource::<UnitFades>()
+        .add_plugins(ExtractResourcePlugin::<UnitFades>::default())
+        .add_systems(PostUpdate, phase_entity_doodads);
+    if let Some(render) = app.get_sub_app_mut(RenderApp) {
+        render.add_systems(Render, upload_unit_fades.in_set(RenderSystems::PrepareResources));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_post_on_the_line_blocks_and_one_beside_it_does_not() {
+        let see = crate::see_through::SeeThrough {
+            cuts: [
+                crate::see_through::Cut { at: Vec3::new(0.0, 1.0, 0.0), radius: 4.4 },
+                Default::default(),
+            ],
+            eye: Vec3::new(0.0, 6.0, 10.0),
+            ..Default::default()
+        };
+        let s = Sight::of(&see).expect("live");
+        // A post half way along, 0.4 yd thick.
+        assert!(s.blocked_by(Vec3::new(-0.2, 0.0, 4.8), Vec3::new(0.2, 4.0, 5.2)));
+        // The same post 3 yd to the side.
+        assert!(!s.blocked_by(Vec3::new(2.8, 0.0, 4.8), Vec3::new(3.2, 4.0, 5.2)));
+        // Behind her, the far side from the camera.
+        assert!(!s.blocked_by(Vec3::new(-0.2, 0.0, -3.2), Vec3::new(0.2, 4.0, -2.8)));
+        // Nothing live, nothing fades.
+        assert!(Sight::of(&crate::see_through::SeeThrough::default()).is_none());
+    }
+
+    #[test]
+    fn the_cutoff_is_the_hulls_smallest_side() {
+        let hull = benilla_formats::CollisionMesh {
+            // 1 yd by 6 yd in WoW's model plane, 3 yd tall.
+            positions: vec![[0.0, 0.0, 0.0], [1.0, 6.0, 3.0], [1.0, 0.0, 0.0]],
+            indices: vec![0, 1, 2],
+        };
+        let t = placement_thickness(Some(&hull), &Transform::IDENTITY);
+        assert!((t - 1.0).abs() < 1e-4, "{t}");
+        assert!(phases(t));
+        // Turned 45 degrees, or any way at all, it is the same piece.
+        let turned = Transform::from_rotation(Quat::from_euler(EulerRot::YXZ, 0.785, 0.4, 0.2));
+        assert!((placement_thickness(Some(&hull), &turned) - 1.0).abs() < 1e-4);
+        assert!(phases(placement_thickness(None, &Transform::IDENTITY)));
+        let big = Transform::from_scale(Vec3::splat(5.0));
+        assert!(!phases(placement_thickness(Some(&hull), &big)));
+        // The table holds a level at each slot standing for one, whatever the units do.
+        let mut table = UnitFades::default();
+        table.publish(&[]);
+        assert_eq!(table.slots[crate::mesh_tag::USABLE_RIG_SLOTS], 1.0);
+        assert_eq!(table.slots[crate::mesh_tag::MAX_RIG_SLOTS - 1], 16.0);
+        // Wide and low, a planter: small whatever its footprint.
+        let planter = benilla_formats::CollisionMesh {
+            positions: vec![[0.0, 0.0, 0.0], [6.0, 6.0, 1.2], [6.0, 0.0, 0.0]],
+            indices: vec![0, 1, 2],
+        };
+        assert!(phases(placement_thickness(Some(&planter), &Transform::IDENTITY)));
+    }
+
+    #[test]
+    fn a_fade_takes_a_fifth_of_a_second() {
+        let mut f = 0.0;
+        for _ in 0..12 {
+            f = step(f, true, 1.0 / 60.0);
+        }
+        assert_eq!(level(f), 16);
+        for _ in 0..12 {
+            f = step(f, false, 1.0 / 60.0);
+        }
+        assert_eq!(level(f), 0);
+    }
+}
