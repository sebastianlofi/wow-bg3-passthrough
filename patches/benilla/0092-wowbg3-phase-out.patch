+pub(crate) fn with_phase(tag: u32, level: u8) -> u32 {
+    if level == 0 {
+        return tag & !PHASE_MASK;
+    }
+    (tag & !(ALPHA_MASK | PHASE_MASK)) | carried_alpha(tag) | (u32::from(level.min(16)) << PHASE_SHIFT)
