+/// Patch 0103: a placement wider than [`CLIP_HOUSE_YD`]: a city, a keep, a big cave.
+fn wider_than_a_house(model: &WmoModel) -> bool {
+    let (mut lo, mut hi) = (Vec3::INFINITY, Vec3::NEG_INFINITY);
+    for n in &model.group_nav {
+        let (a, b) = (wow_to_bevy(n.bbox_min), wow_to_bevy(n.bbox_max));
+        lo = lo.min(a.min(b));
+        hi = hi.max(a.max(b));
+    }
+    (hi.x - lo.x).max(hi.z - lo.z) > CLIP_HOUSE_YD
+}
