+/// Patch 0131: a corpse someone in BG3 has picked up lies nowhere in the world: BG3 keeps it in an inventory, and
+/// WoW's body, which stayed on the ground (or lay at the carrier's feet), is not drawn while the bridge lists it as
+/// carried (`mirrored.txt` `x`). Dropped again, it is shown where BG3 dropped it (the server moves it there).
+fn carried_corpses(mut units: Query<(&Guid, &mut Visibility), Without<SelfPlayer>>, mut hidden: Local<HashSet<u64>>) {
+    let carried = SHARED.lock().map(|s| s.carried.clone()).unwrap_or_default();
+    if carried.is_empty() && hidden.is_empty() {
+        return;
+    }
+    for (g, mut vis) in &mut units {
+        if carried.contains(&g.0) {
+            if *vis != Visibility::Hidden {
+                *vis = Visibility::Hidden;
+            }
+            hidden.insert(g.0);
+        } else if hidden.remove(&g.0) && *vis == Visibility::Hidden {
+            // Put down again: nothing else shows it, the election writes a verdict only when it flips.
+            *vis = Visibility::Inherited;
+        }
+    }
+    hidden.retain(|g| carried.contains(g));
+}
