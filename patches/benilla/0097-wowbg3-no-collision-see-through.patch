+/// WOW-BG3 patch 0097: under this tall (yd) a piece is seen over, and stays whole: a fence, a crate, a meat rack.
+pub const LITTLE_TALL_YD: f32 = 3.0;
+/// And one no wider than this (yd) stays whole however tall: a lamp post, a pole. A thick post is wider.
+pub const LITTLE_WIDE_YD: f32 = 0.75;
+
+/// Patch 0097: does the see-through leave this placement whole? Playtest feedback: walls, ceilings, roofs and thick
+/// things (thick posts, trees, a tent's cloth) go; little fences, meat, decor and lamp posts do not. On its
+/// collision hull in the model's own axes (raw M2 space, Z up), times its scale; no hull is little.
+pub fn is_little(hull: Option<&benilla_formats::CollisionMesh>, transform: &Transform) -> bool {
+    let Some(hull) = hull.filter(|h| !h.is_empty() && !h.positions.is_empty()) else {
+        return true;
+    };
+    let (mut lo, mut hi) = (Vec3::splat(f32::MAX), Vec3::splat(f32::MIN));
+    for p in &hull.positions {
+        let v = Vec3::from_array(*p);
+        lo = lo.min(v);
+        hi = hi.max(v);
+    }
+    let size = (hi - lo) * transform.scale.abs().max_element();
+    size.z < LITTLE_TALL_YD || size.x.max(size.y) < LITTLE_WIDE_YD
+}
