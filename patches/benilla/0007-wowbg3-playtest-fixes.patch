+pub(crate) fn blend_pose(a: &PoseFile, b: &PoseFile, t: f32) -> Vec<PoseRec> {
+    let lerp = |x: f32, y: f32| x + (y - x) * t;
+    b.recs
+        .iter()
+        .map(|rb| {
+            let Some(ra) = a.recs.iter().find(|r| r.key == rb.key && r.flags & 1 == rb.flags & 1) else {
+                return PoseRec { key: rb.key, flags: rb.flags, world: rb.world, palette: rb.palette.clone() };
+            };
+            let mut world = rb.world;
+            let (qa, qb) = (Vec4::from_slice(&ra.world[0..4]), Vec4::from_slice(&rb.world[0..4]));
+            let qa = if qa.dot(qb) < 0.0 { -qa } else { qa };
+            let q = (qa + (qb - qa) * t).normalize_or_zero();
+            world[0..4].copy_from_slice(&q.to_array());
+            for k in 4..10 {
+                world[k] = lerp(ra.world[k], rb.world[k]);
+            }
+            let palette = if ra.palette.len() == rb.palette.len() {
+                ra.palette
+                    .iter()
+                    .zip(&rb.palette)
+                    .map(|(ma, mb)| std::array::from_fn(|k| lerp(ma[k], mb[k])))
+                    .collect()
+            } else {
+                rb.palette.clone()
+            };
+            PoseRec { key: rb.key, flags: rb.flags, world, palette }
+        })
+        .collect()
+}
