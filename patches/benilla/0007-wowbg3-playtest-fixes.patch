+/// Where between the last two records to draw at `now` (BG3's clock: seconds since the epoch):
+/// one smoothed BG3 frame back, as a fraction of the pair's span, extrapolating at most
+/// [`MAX_EXTRAPOLATION`].
+pub(crate) fn blend_at(prev_time: f64, last_time: f64, now: f64, interval: f64) -> f32 {
+    let span = last_time - prev_time;
+    if !(span > 1e-4) {
+        return 1.0;
+    }
+    (((now - interval) - prev_time) / span).clamp(0.0, 1.0 + MAX_EXTRAPOLATION) as f32
+}
