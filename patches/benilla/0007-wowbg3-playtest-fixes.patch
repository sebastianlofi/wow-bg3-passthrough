+        assert!((mid[0].world[4] - 0.5).abs() < 1e-6, "translation halfway");
+        assert!((mid[0].palette[0][3] - 1.0).abs() < 1e-6, "bone halfway");
+        let q = Quat::from_slice(&mid[0].world[0..4]);
+        assert!(q.angle_between(Quat::from_rotation_y(0.2)) < 1e-3, "rotation halfway");
