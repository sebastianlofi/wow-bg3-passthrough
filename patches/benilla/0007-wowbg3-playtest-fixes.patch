-        auto.walk_to_ground_bg3(at);
+/// How far BG3's character may get from the own body before an interaction walk or an open NPC
+/// window stops holding the body there (yd).
+const INTERACT_LEASH: f32 = 20.0;
+
+fn walk_after_tav(
+    mut t: ResMut<TavFollow>,
+    mut auto: crate::player::AutoMove,
+    open: Option<Res<crate::ui_session::InteractNpc>>,
+    player: Res<crate::player::Player>,
+) {
+    // World mode (patch 0007): BG3's character is what the player steers, so the own (hidden) body
+    // walks to the NPC, body or object a BG3 click interacts with, as Click to Move would.
+    if !auto.approach.enabled {
+        auto.approach.enabled = true;
     }
+    let Some(at) = t.walk_to.take() else { return };
+    // That walk, and the window it opens, hold the body there until Tav has gone on.
+    let away = Vec2::new(at.x - player.pos.x, at.z - player.pos.z).length();
+    let window_open = open.is_some_and(|o| o.0.is_some());
+    if (auto.approach.toward_object() || window_open) && away < INTERACT_LEASH {
+        return;
+    }
+    auto.walk_to_ground_bg3(at);
 }
 
