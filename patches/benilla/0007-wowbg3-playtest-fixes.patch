+}
+
+impl PoseTrack {
+    fn new() -> Self {
+        Self { prev: None, last: None, interval: START_INTERVAL, drawn: None }
+    }
+
+    /// Takes a record (newer than the last one).
+    fn push(&mut self, p: PoseFile) {
+        if let Some(last) = &self.last {
+            let dt = p.time - last.time;
+            if dt > INTERVAL_RANGE.0 && dt < INTERVAL_RANGE.1 {
+                self.interval += (dt - self.interval) * 0.1;
+            }
+        }
+        self.prev = self.last.replace(p);
+        // A record from before the previous one (BG3's clock went back) blends nothing.
+        if self.prev.as_ref().zip(self.last.as_ref()).is_some_and(|(a, b)| b.time <= a.time) {
+            self.prev = None;
+        }
+    }
