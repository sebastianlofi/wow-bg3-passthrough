+/// The smallest alpha byte the GPU's alpha test at `cutoff` keeps (`alpha < cutoff` discards).
+fn alpha_key(cutoff: f32) -> u8 {
+    (cutoff * 255.0 - 1e-3).ceil().clamp(0.0, 255.0) as u8
+}
+
+/// The share of texels whose alpha passes the cut at `cutoff`.
+fn coverage(px: &[u8], cutoff: f32) -> f32 {
+    let n = px.len() / 4;
+    if n == 0 {
+        return 0.0;
+    }
+    let key = alpha_key(cutoff);
+    px.chunks_exact(4).filter(|t| t[3] >= key).count() as f32 / n as f32
+}
+
+/// A mip level's alpha scaled up so the cut-out keeps `target` coverage (Castaño's
+/// coverage-preserving mips): box-filtered alpha thins a cut-out at every level, so hair and lace
+/// would fade into holes at a distance. A level that keeps enough already is left alone.
+pub(crate) fn keep_coverage(level: &mut [u8], target: f32, cutoff: f32) {
+    let key = alpha_key(cutoff);
+    let scaled = |a: u8, k: f32| (f32::from(a) * k).round().clamp(0.0, 255.0) as u8;
+    let want = (target * (level.len() / 4) as f32).round() as usize;
+    let passing = |level: &[u8], k: f32| level.chunks_exact(4).filter(|t| scaled(t[3], k) >= key).count();
+    if passing(level, 1.0) >= want {
+        return;
+    }
+    let (mut lo, mut hi) = (1.0f32, 8.0f32);
+    for _ in 0..16 {
+        let mid = 0.5 * (lo + hi);
+        if passing(level, mid) < want {
+            lo = mid;
+        } else {
+            hi = mid;
+        }
+    }
+    for t in level.chunks_exact_mut(4) {
+        t[3] = scaled(t[3], hi);
+    }
+}
