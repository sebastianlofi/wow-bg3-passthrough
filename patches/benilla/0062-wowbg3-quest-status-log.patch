WOW-BG3 benilla patch 0062: the quest giver's status and the talk ladder's refusal, in the log.

- target/click.rs talk: when the service ladder matches nothing (a quest giver whose status never came, or
  one with nothing to offer) the line is info, with the NPC flags and the quest status it saw.
- ui_quest/net.rs: each change of a quest giver's status (SMSG_QUESTGIVER_STATUS), at info.
- quest_markers/query.rs: a unit's own status query, and a quest giver dropped as hostile, at info.
  (the 0.1.0 playtest: quest givers that would not talk, and nothing in the log said why.)

--- a/crates/benilla-app/src/target/click.rs
+++ b/crates/benilla-app/src/target/click.rs
@@ -616,7 +616,12 @@
         let ghost = self_store.is_some_and(|s| s.0.player_is_ghost());
         let Some(arm) = service_arm(npc_flags, self.service.quest.status(guid)) else {
             // `0x5f05ca`: no consulted bit does nothing, gesture included.
-            debug!("right-click interact: {guid:#x} matches no service bit — nothing sent");
+            // WOW-BG3 (patch 0062): at info, with what it saw: a quest giver whose status never came
+            // (none) or says nothing to offer declines here, and nothing else on the path says so.
+            info!(
+                "right-click interact: {guid:#x} matches no service bit — nothing sent (npc flags {npc_flags:#x}, quest status {:?})",
+                self.service.quest.status(guid)
+            );
             return;
         };
         match service_action(arm, guid, ghost, cursor_sale) {
--- a/crates/benilla-app/src/ui_quest/net.rs
+++ b/crates/benilla-app/src/ui_quest/net.rs
@@ -170,6 +170,10 @@
         quest.refuse_status(npc, status);
         return;
     }
+    // WOW-BG3 (patch 0062): each change of a giver's status, at info (one line per change).
+    if quest.status(npc) != Some(status) {
+        info!("net: questgiver status {npc:#x} → {status}");
+    }
     quest.set_status(npc, status);
 }
 
