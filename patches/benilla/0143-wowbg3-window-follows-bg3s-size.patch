+/// Patch 0143: when `bg3size.txt` was last read, and its time then.
+#[derive(Resource, Default)]
+struct Bg3Size {
+    next: Option<Instant>,
+    modified: Option<std::time::SystemTime>,
+}
+
+/// Patch 0143: the window takes BG3's picture size from `$WOW_BG3_LINK_DIR/bg3size.txt` ("W H", the render plugin's,
+/// written when BG3 makes its swapchain); [`retarget`] then makes the image the cameras draw into of that size.
+fn follow_bg3_size(mut state: ResMut<Bg3Size>, mut windows: Query<&mut Window, With<PrimaryWindow>>) {
+    let now = Instant::now();
+    if state.next.is_some_and(|n| now < n) {
+        return;
+    }
+    state.next = Some(now + Duration::from_millis(250));
+    let Some(dir) = std::env::var_os("WOW_BG3_LINK_DIR") else { return };
+    let path = std::path::PathBuf::from(dir).join("bg3size.txt");
+    let Ok(modified) = std::fs::metadata(&path).and_then(|m| m.modified()) else { return };
+    if state.modified == Some(modified) {
+        return;
+    }
+    state.modified = Some(modified);
+    let Ok(text) = std::fs::read_to_string(&path) else { return };
+    let mut it = text.split_whitespace().filter_map(|v| v.parse::<u32>().ok());
+    let (Some(w), Some(h)) = (it.next(), it.next()) else { return };
+    if w == 0 || h == 0 || w > 16384 || h > 16384 {
+        return;
+    }
+    let Ok(mut window) = windows.single_mut() else { return };
+    if window.physical_width() == w && window.physical_height() == h {
+        return;
+    }
+    info!(
+        "wowbg3 offscreen: BG3's picture is {w}x{h}: the window follows (was {}x{})",
+        window.physical_width(),
+        window.physical_height()
+    );
+    window.resolution.set_physical_resolution(w, h);
+}
