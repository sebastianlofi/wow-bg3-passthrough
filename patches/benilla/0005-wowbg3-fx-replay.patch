+#[derive(Clone, Debug, PartialEq)]
+#[allow(dead_code)]
+pub(crate) struct Recipe {
+    pub(crate) topology: u32,
+    pub(crate) restart: u32,
+    pub(crate) polygon: u32,
+    pub(crate) cull: u32,
+    /// 0 counter-clockwise, 1 clockwise.
+    pub(crate) front: u32,
+    pub(crate) bias_enable: u32,
+    pub(crate) bias_constant: f32,
+    pub(crate) bias_clamp: f32,
+    pub(crate) bias_slope: f32,
+    pub(crate) depth_test: u32,
+    pub(crate) depth_write: u32,
+    pub(crate) depth_compare: u32,
+    pub(crate) color: Vec<ColorAtt>,
+    pub(crate) depth_format: u32,
+    pub(crate) stages: Vec<Stage>,
+    pub(crate) bindings: Vec<VbBinding>,
+    pub(crate) attributes: Vec<VbAttr>,
+    /// Descriptor sets, set index = position.
+    pub(crate) sets: Vec<Vec<SetSlot>>,
+    /// (stages, offset, size).
+    pub(crate) push: Vec<(u32, u32, u32)>,
+    pub(crate) dynamic: Vec<u32>,
+}
+
+pub(crate) fn parse_recipe(b: &[u8]) -> Option<Recipe> {
+    let mut r = Rd::new(b, 0);
+    if r.take(4)? != b"FXP1" || r.u32()? != 1 {
+        return None;
+    }
+    let (topology, restart) = (r.u32()?, r.u32()?);
+    let (polygon, cull, front) = (r.u32()?, r.u32()?, r.u32()?);
+    let (bias_enable, bias_constant, bias_clamp, bias_slope) = (r.u32()?, r.f32()?, r.f32()?, r.f32()?);
+    let (depth_test, depth_write, depth_compare) = (r.u32()?, r.u32()?, r.u32()?);
+    let mut color = Vec::new();
+    for _ in 0..r.n(8)? {
+        let v: Vec<u32> = (0..9).map(|_| r.u32()).collect::<Option<_>>()?;
+        color.push(ColorAtt {
+            blend: v[0] != 0,
+            src_c: v[1],
+            dst_c: v[2],
+            op_c: v[3],
+            src_a: v[4],
+            dst_a: v[5],
+            op_a: v[6],
+            mask: v[7],
+            format: v[8],
+        });
+    }
+    let depth_format = r.u32()?;
+    let mut stages = Vec::new();
+    for _ in 0..r.n(8)? {
+        let stage = r.u32()?;
+        let spv = r.u64()?;
+        let raw = r.take(64)?;
+        let end = raw.iter().position(|c| *c == 0).unwrap_or(64);
+        let entry = String::from_utf8_lossy(&raw[..end]).into_owned();
+        let n_spec = r.n(4096)?;
+        r.take(n_spec * 12)?;
+        let size = r.n(1 << 20)?;
+        r.take(size)?;
+        r.pad4();
+        stages.push(Stage { stage, spv, entry, n_spec });
+    }
+    let mut bindings = Vec::new();
+    for _ in 0..r.n(32)? {
+        bindings.push(VbBinding { binding: r.u32()?, stride: r.u32()?, rate: r.u32()? });
+    }
+    let mut attributes = Vec::new();
+    for _ in 0..r.n(64)? {
+        attributes.push(VbAttr { location: r.u32()?, binding: r.u32()?, format: r.u32()?, offset: r.u32()? });
+    }
+    let mut sets = Vec::new();
+    for _ in 0..r.n(32)? {
+        let mut slots = Vec::new();
+        for _ in 0..r.n(1024)? {
+            let (binding, ty, count, st) = (r.u32()?, r.u32()?, r.u32()?, r.u32()?);
+            let n_immutable = r.n(1024)?;
+            r.take(n_immutable * 8)?;
+            slots.push(SetSlot { binding, ty, count, stages: st, n_immutable });
+        }
+        sets.push(slots);
+    }
+    let mut push = Vec::new();
+    for _ in 0..r.n(32)? {
+        push.push((r.u32()?, r.u32()?, r.u32()?));
+    }
+    let mut dynamic = Vec::new();
+    if r.o + 4 <= b.len() {
+        for _ in 0..r.n(64)? {
+            dynamic.push(r.u32()?);
+        }
+    }
+    Some(Recipe {
+        topology,
+        restart,
+        polygon,
+        cull,
+        front,
+        bias_enable,
+        bias_constant,
+        bias_clamp,
+        bias_slope,
+        depth_test,
+        depth_write,
+        depth_compare,
+        color,
+        depth_format,
+        stages,
+        bindings,
+        attributes,
+        sets,
+        push,
+        dynamic,
+    })
+}
