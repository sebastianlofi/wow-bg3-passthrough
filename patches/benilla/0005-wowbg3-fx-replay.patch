+    params: wgpu::Buffer,
+    table: wgpu::TextureView,
+    chain_bgl: wgpu::BindGroupLayout,
+    table_bgl: wgpu::BindGroupLayout,
+    prep_bgl: wgpu::BindGroupLayout,
+    comp_bgl: wgpu::BindGroupLayout,
+    table_pipeline: wgpu::RenderPipeline,
+    prep_pipeline: wgpu::RenderPipeline,
+    comp_layout: wgpu::PipelineLayout,
+    comp_module: wgpu::ShaderModule,
+}
+
+/// What the node needs for one frame.
+struct Ready {
+    arena: wgpu::Buffer,
+    draws: Vec<PreparedDraw>,
+    chain_bg: wgpu::BindGroup,
+    table_bg: wgpu::BindGroup,
+    table_view: wgpu::TextureView,
+    table_pipeline: wgpu::RenderPipeline,
