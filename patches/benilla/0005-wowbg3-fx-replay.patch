+/// BG3's post-processing after the effects (format doc, "Post block").
+#[derive(Clone, Copy, Debug, PartialEq)]
+#[allow(dead_code)]
+pub(crate) struct FxPost {
+    /// Bits: 1 exposure, 2 bloom_in, 4 bloom_up, 8 grade, 16 display.
+    pub(crate) have: u32,
+    pub(crate) exposure: [f32; 2],
+    pub(crate) bloom_in: [f32; 4],
+    pub(crate) bloom_up: [f32; 4],
+    pub(crate) grade: [f32; 4],
+    pub(crate) grade_lut: u64,
+    pub(crate) grade_sampler: u64,
+    pub(crate) fade: f32,
+    pub(crate) display_lut: u64,
+    pub(crate) display_sampler: u64,
+    /// The sequence of the camera record (`bg3cam.bin`) BG3 drew this frame with; 0 unknown.
+    pub(crate) cam_seq: u32,
+}
+
+pub(crate) fn parse_post(b: &[u8], at: usize) -> Option<FxPost> {
+    let mut r = Rd::new(b, at);
+    if r.take(4)? != b"FXQ1" {
+        return None;
+    }
+    let have = r.u32()?;
+    let exposure = [r.f32()?, r.f32()?];
+    let mut f4 = || -> Option<[f32; 4]> { Some([r.f32()?, r.f32()?, r.f32()?, r.f32()?]) };
+    let (bloom_in, bloom_up, grade) = (f4()?, f4()?, f4()?);
+    let (grade_lut, grade_sampler) = (r.u64()?, r.u64()?);
+    let display = r.take(32)?;
+    let fade = f32::from_le_bytes(display[0..4].try_into().ok()?);
+    let (display_lut, display_sampler) = (r.u64()?, r.u64()?);
+    // Older captures end here.
+    let cam_seq = r.u32().unwrap_or(0);
+    Some(FxPost {
+        have,
+        exposure,
+        bloom_in,
+        bloom_up,
+        grade,
+        grade_lut,
+        grade_sampler,
+        fade,
+        display_lut,
+        display_sampler,
+        cam_seq,
+    })
+}
+
+/// BG3's per-view block (set 0: view, projection, view-projection as column-major 4x4, then
+/// near and far): the projection's depth terms, and the TAA jitter taken out of it.
+#[derive(Clone, Copy, Debug, PartialEq)]
+#[allow(dead_code)]
+pub(crate) struct ViewBlock {
+    /// depth = p22 + p32 / view_z (metres), BG3's reverse-Z.
+    pub(crate) p22: f32,
+    pub(crate) p32: f32,
+    pub(crate) near: f32,
+    pub(crate) far: f32,
+    /// The sub-pixel jitter (clip units) that was removed.
+    pub(crate) jitter: [f32; 2],
+}
+
+/// BG3 runs TAA, so its projection carries a sub-pixel jitter each frame; replayed as is, the
+/// effects would shimmer. BG3's per-view block (set 0 binding 2: view V (+0), projection P (+64)
+/// and camera-relative VP = P·V (+128) as column-major matrices, near and far (+192)), checked
+/// to really be that (P a perspective projection, VP equal to P·V), gets the jitter out of P
+/// and of VP. Each blob is fixed once (`strip` false only finds the block). Returns the block's
+/// terms.
+pub(crate) fn strip_jitter(frame: &mut FxFrame, strip: bool) -> Option<ViewBlock> {
+    let mut seen = HashSet::new();
+    let mut found = None;
+    for d in &frame.draws {
+        for s in d.sets.iter().filter(|s| s.set == 0) {
+            for slot in s.slots.iter().filter(|slot| slot.binding == 2) {
+                let SlotRes::Buffer { blob, size } = slot.res else { continue };
+                if size < 200 || !seen.insert(blob) {
+                    continue;
+                }
+                let Some(bytes) = frame.blob.get_mut(blob as usize..blob as usize + 200) else { continue };
+                if let Some(v) = strip_block(bytes, strip) {
+                    found = Some(v);
+                }
+            }
+        }
+    }
+    found
+}
+
+fn strip_block(b: &mut [u8], strip: bool) -> Option<ViewBlock> {
+    let f = |b: &[u8], i: usize| f32::from_le_bytes(b[i * 4..i * 4 + 4].try_into().unwrap());
+    // m[col][row] at float index base + col * 4 + row
+    let at = |base: usize, c: usize, r: usize| base + c * 4 + r;
+    let (v, p, vp) = (0, 16, 32);
+    let all: Vec<f32> = (0..50).map(|i| f(b, i)).collect();
+    if all.iter().any(|x| !x.is_finite()) {
+        return None;
+    }
+    let pm = |c, r| all[at(p, c, r)];
+    let zero = [(0, 1), (0, 2), (0, 3), (1, 0), (1, 2), (1, 3), (3, 0), (3, 1), (3, 3)];
+    let perspective = zero.iter().all(|&(c, r)| pm(c, r) == 0.0)
+        && pm(2, 3) == 1.0
+        && pm(0, 0) > 0.0
+        && pm(1, 1) > 0.0
+        && pm(3, 2) > 0.0
+        && pm(2, 0).abs() < 0.01
+        && pm(2, 1).abs() < 0.01;
+    if !perspective {
+        return None;
+    }
+    for c in 0..4 {
+        for r in 0..4 {
+            let want: f32 = (0..4).map(|k| pm(k, r) * all[at(v, c, k)]).sum();
+            let got = all[at(vp, c, r)];
+            if (want - got).abs() > 1e-4 * (1.0 + want.abs()) {
+                return None;
+            }
+        }
+    }
+    let (jx, jy) = (pm(2, 0), pm(2, 1));
+    let block = ViewBlock { p22: pm(2, 2), p32: pm(3, 2), near: all[48], far: all[49], jitter: [jx, jy] };
+    if !strip {
+        return Some(block);
+    }
+    let mut put = |i: usize, x: f32| b[i * 4..i * 4 + 4].copy_from_slice(&x.to_le_bytes());
+    put(at(p, 2, 0), 0.0);
+    put(at(p, 2, 1), 0.0);
+    for c in 0..4 {
+        put(at(vp, c, 0), all[at(vp, c, 0)] - jx * all[at(v, c, 2)]);
+        put(at(vp, c, 1), all[at(vp, c, 1)] - jy * all[at(v, c, 2)]);
+    }
+    Some(block)
+}
+
+const BUFFER_TYPES: [u32; 4] = [6, 7, 8, 9];
+
+pub(crate) fn parse_frame(b: &[u8]) -> Option<FxFrame> {
+    let mut r = Rd::new(b, 0);
+    if r.take(4)? != b"FXF1" || r.u32()? != 1 {
+        return None;
+    }
+    let frame = r.u32()?;
+    let n = r.n(1 << 16)?;
+    let wall = r.f64()?;
+    let eye = [r.f32()?, r.f32()?, r.f32()?];
+    let post_offset = r.u32()? as usize;
+    let (width, height, data_off, data_size) = (r.u32()?, r.u32()?, r.u32()? as usize, r.u32()? as usize);
+    if width == 0 || height == 0 || width > 16384 || height > 16384 {
+        return None;
+    }
+    let blob = b.get(data_off..data_off.checked_add(data_size)?)?.to_vec();
+    let mut draws = Vec::with_capacity(n);
+    for _ in 0..n {
+        let pipe = r.u64()?;
+        let (indexed, count, instances, first) = (r.u32()? != 0, r.u32()?, r.u32()?, r.u32()?);
+        let (vertex_offset, first_instance) = (r.i32()?, r.u32()?);
+        let (index_type, index_blob, index_size) = (r.u32()?, r.u32()?, r.u32()?);
+        let mut vbs = Vec::new();
+        for _ in 0..r.n(32)? {
+            vbs.push(FxVb { binding: r.u32()?, blob: r.u32()?, size: r.u32()? });
+        }
+        let mut sets = Vec::new();
+        for _ in 0..r.n(32)? {
+            let set = r.u32()?;
+            let mut slots = Vec::new();
+            for _ in 0..r.n(1024)? {
+                let (binding, ty) = (r.u32()?, r.u32()?);
+                let res = if BUFFER_TYPES.contains(&ty) {
+                    SlotRes::Buffer { blob: r.u32()?, size: r.u32()? }
+                } else if ty == 0 {
+                    SlotRes::Sampler(r.u64()?)
+                } else if ty == 1 {
+                    SlotRes::Combined(r.u64()?, r.u64()?)
+                } else {
+                    SlotRes::Image(r.u64()?)
+                };
+                slots.push(FxSlot { binding, ty, res });
+            }
+            sets.push(FxSet { set, slots });
+        }
+        let push_size = r.n(4096)?;
+        let push = r.take(push_size)?.to_vec();
+        r.pad4();
+        draws.push(FxDraw {
+            pipe,
+            indexed,
+            count,
+            instances,
+            first,
+            vertex_offset,
+            first_instance,
+            index_type,
+            index_blob,
+            index_size,
+            vbs,
+            sets,
+            push,
+        });
+    }
+    let post = if post_offset == 0 { None } else { Some(parse_post(b, post_offset)?) };
+    Some(FxFrame { frame, wall, eye, width, height, draws, blob, post, view: None })
+}
