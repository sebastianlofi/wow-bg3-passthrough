+impl FxLoader {
+    fn log_once(&mut self, msg: String) {
+        if self.logged.len() < 4096 && self.logged.insert(msg.clone()) {
+            warn!("wowbg3 fx: {msg}");
+        }
+    }
+}
+
+/// Reads one keyed file into a slot; `None` when it must wait (missing for now).
+fn load_slot<T>(
+    slot: Option<&Slot<T>>,
+    path: PathBuf,
+    parse: impl FnOnce(Vec<u8>) -> Result<T, String>,
+    logged: &mut Vec<String>,
+) -> Slot<T> {
+    if let Some(Slot::Missing(at)) = slot {
+        if at.elapsed() < RETRY {
+            return Slot::Missing(*at);
+        }
+    }
+    match std::fs::metadata(&path) {
+        Ok(m) if m.len() > MAX_FILE => {
+            logged.push(format!("{path:?} is too large ({} bytes)", m.len()));
+            return Slot::Failed;
+        }
+        Ok(_) => {}
+        Err(_) => {
+            logged.push(format!("{path:?} is missing (looked again every {}s)", RETRY.as_secs()));
+            return Slot::Missing(Instant::now());
+        }
+    }
+    match std::fs::read(&path) {
+        Ok(b) => match parse(b) {
+            Ok(v) => Slot::Ready(Arc::new(v)),
+            Err(e) => {
+                logged.push(format!("{path:?}: {e}"));
+                Slot::Failed
+            }
+        },
+        Err(e) => {
+            logged.push(format!("{path:?}: {e}"));
+            Slot::Missing(Instant::now())
+        }
+    }
+}
+
+fn load_spv(b: Vec<u8>) -> Result<SpvModule, String> {
+    let words = spv_words(&b).ok_or("not SPIR-V")?;
+    let info = reflect(&words).ok_or("malformed SPIR-V")?;
+    let flipped = flip_position_y(&words);
+    Ok(SpvModule { words, info, flipped })
+}
+
+/// Resolves one keyed item through its cache: `Some` when ready, and whether it is still pending.
+fn resolve<T>(
+    cache: &mut HashMap<u64, Slot<T>>,
+    key: u64,
+    path: impl FnOnce() -> PathBuf,
+    parse: impl FnOnce(Vec<u8>) -> Result<T, String>,
+    logged: &mut Vec<String>,
+) -> (Option<Arc<T>>, bool) {
+    match cache.get(&key) {
+        Some(Slot::Ready(v)) => return (Some(v.clone()), false),
+        Some(Slot::Failed) => return (None, false),
+        Some(Slot::Missing(at)) if at.elapsed() < RETRY => return (None, true),
+        _ => {}
+    }
+    let slot = load_slot(cache.get(&key), path(), parse, logged);
+    let out = match &slot {
+        Slot::Ready(v) => (Some(v.clone()), false),
+        Slot::Missing(_) => (None, true),
+        Slot::Failed => (None, false),
+    };
+    cache.insert(key, slot);
+    out
+}
