+    /// BG3's per-view block as captured (frame 5106): V, jittered P, VP = P·V, near, far.
+    fn view_block() -> Vec<u8> {
+        let v = [
+            [0.422619f32, -0.476457, -0.770962, 0.0],
+            [0.0, 0.850662, -0.525712, 0.0],
+            [0.906308, 0.222176, 0.359506, 0.0],
+            [459.544, 23.2904, 71.4366, 1.0],
+        ];
+        let p = [[1.08055f32, 0.0, 0.0, 0.0], [0.0, 1.92098, 0.0, 0.0], [0.000390622, -0.000462936, -1.00001e-05, 1.0], [0.0, 0.0, 0.100001, 0.0]];
+        let mut vp = [[0.0f32; 4]; 4];
+        for c in 0..4 {
+            for r in 0..4 {
+                vp[c][r] = (0..4).map(|k| p[k][r] * v[c][k]).sum();
+            }
+        }
+        let mut b = Vec::new();
+        for m in [v, p, vp] {
+            for col in m {
+                for x in col {
+                    b.extend_from_slice(&x.to_le_bytes());
+                }
+            }
+        }
+        for x in [0.1f32, 10000.0, 0.0, 0.0, -128.04, 17.74, -447.3, 0.0] {
+            b.extend_from_slice(&x.to_le_bytes());
+        }
+        b
+    }
+
+    #[test]
+    fn strips_taa_jitter() {
+        let mut b = view_block();
+        let mut kept = b.clone();
+        assert_eq!(strip_block(&mut kept, false).expect("found").jitter[0], 0.000390622);
+        assert_eq!(kept, b, "found without stripping");
+        let vb = strip_block(&mut b, true).expect("recognised");
+        assert!((vb.jitter[0] - 0.000390622).abs() < 1e-9 && (vb.jitter[1] + 0.000462936).abs() < 1e-9);
+        assert_eq!((vb.near, vb.far), (0.1, 10000.0));
+        let f = |i: usize| f32::from_le_bytes(b[i * 4..i * 4 + 4].try_into().unwrap());
+        assert_eq!((f(16 + 8), f(16 + 9)), (0.0, 0.0));
+        // VP col 0 row 0 without jitter: 1.08055 * 0.422619
+        assert!((f(32) - 1.08055 * 0.422619).abs() < 1e-5);
+        // a second pass finds no jitter left and changes nothing
+        let again = b.clone();
+        assert_eq!(strip_block(&mut b, true).expect("still recognised").jitter, [0.0, 0.0]);
+        assert_eq!(b, again);
+        // not a view block: untouched
+        let mut junk = vec![0u8; 224];
+        assert!(strip_block(&mut junk, true).is_none());
+    }
+
+    #[test]
+    fn reflects_bindings() {
+        let mut w = vec![SPV_MAGIC, 0x0001_0300, 14, 40, 0];
+        w.extend_from_slice(&[(4 << 16) | 71, 10, 34, 2]); // %10 DescriptorSet 2
+        w.extend_from_slice(&[(4 << 16) | 71, 10, 33, 31]); // %10 Binding 31
+        w.extend_from_slice(&[(4 << 16) | 71, 11, 34, 0]);
+        w.extend_from_slice(&[(4 << 16) | 71, 11, 33, 7]);
+        w.extend_from_slice(&[(3 << 16) | 22, 2, 32]); // float
+        w.extend_from_slice(&[(9 << 16) | 25, 5, 2, 1, 2, 0, 0, 2, 3]); // image 2D storage R32f
+        w.extend_from_slice(&[(4 << 16) | 32, 6, 0, 5]); // ptr UniformConstant image
+        w.extend_from_slice(&[(2 << 16) | 26, 7]); // sampler
+        w.extend_from_slice(&[(4 << 16) | 32, 8, 0, 7]);
+        w.extend_from_slice(&[(4 << 16) | 59, 6, 10, 0]);
+        w.extend_from_slice(&[(4 << 16) | 59, 8, 11, 0]);
+        let info = reflect(&w).expect("reflects");
+        assert_eq!(
+            info.bindings[&(2, 31)],
+            SpvBind::Image { dim: 1, arrayed: false, ms: false, storage: true, format: 3, scalar: Scalar::Float }
+        );
+        assert_eq!(info.bindings[&(0, 7)], SpvBind::Sampler);
+        assert!(!info.image_write);
+    }
+}
