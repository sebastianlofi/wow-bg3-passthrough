+pub(crate) fn parse_tex(bytes: Vec<u8>) -> Option<TexFile> {
+    let mut r = Rd::new(&bytes, 0);
+    if r.take(4)? != b"FXT1" {
+        return None;
+    }
+    let v: Vec<u32> = (0..7).map(|_| r.u32()).collect::<Option<_>>()?;
+    let ok = v[1] > 0 && v[2] > 0 && v[3] > 0 && v[4] > 0 && v[4] <= 16 && v[5] > 0 && v[5] <= 2048;
+    ok.then_some(TexFile {
+        format: v[0],
+        width: v[1],
+        height: v[2],
+        depth: v[3],
+        mips: v[4],
+        layers: v[5],
+        view_type: v[6],
+        bytes,
+    })
+}
