+// Main world: loading, caching, extraction
+
+/// The frame to replay among the last few (oldest first): the newest one BG3 drew with camera
+/// record `cam` (the one the world camera follows; 0 none), else the newest drawn with an
+/// earlier record, else the newest.
+pub(crate) fn pick_frame(history: &VecDeque<Arc<FxFrame>>, cam: u32) -> Option<Arc<FxFrame>> {
+    let seq = |f: &Arc<FxFrame>| f.post.map_or(0, |p| p.cam_seq);
+    let newest = history.back()?;
+    if cam == 0 || seq(newest) == 0 {
+        return Some(newest.clone());
+    }
+    let matching = history.iter().rev().find(|f| seq(*f) == cam);
+    let earlier = || history.iter().rev().find(|f| seq(*f) != 0 && seq(*f) < cam);
+    Some(matching.or_else(earlier).unwrap_or(newest).clone())
+}
