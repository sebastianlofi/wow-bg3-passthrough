+        let found = strip_jitter(&mut f, true).expect("found at binding 2");
+        assert!((found.jitter[0] - 0.000390622).abs() < 1e-9);
+        assert_eq!(&f.blob[..vb.len()], &vb[..], "binding 1 left alone");
