+    /// A vertex module fragment: `Position` output, a constant, a store.
+    fn vertex_words() -> Vec<u32> {
+        let mut w = vec![SPV_MAGIC, 0x0001_0300, 14, 20, 0];
+        w.extend_from_slice(&[(4 << 16) | 71, 8, 11, 0]); // OpDecorate %8 BuiltIn Position
+        w.extend_from_slice(&[(3 << 16) | 22, 2, 32]); // %2 = OpTypeFloat 32
+        w.extend_from_slice(&[(4 << 16) | 23, 3, 2, 4]); // %3 = OpTypeVector %2 4
+        w.extend_from_slice(&[(4 << 16) | 32, 4, 3, 3]); // %4 = OpTypePointer Output %3
+        w.extend_from_slice(&[(4 << 16) | 59, 4, 8, 3]); // %8 = OpVariable %4 Output
+        w.extend_from_slice(&[(4 << 16) | 59, 4, 9, 3]); // %9 = OpVariable %4 Output (not Position)
+        w.extend_from_slice(&[(3 << 16) | 62, 9, 12]); // OpStore %9 %12
+        w.extend_from_slice(&[(3 << 16) | 62, 8, 12]); // OpStore %8 %12
+        w
+    }
