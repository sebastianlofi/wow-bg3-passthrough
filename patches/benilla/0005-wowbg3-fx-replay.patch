+fn unix_now() -> f64 {
+    SystemTime::now().duration_since(UNIX_EPOCH).map_or(0.0, |t| t.as_secs_f64())
+}
+
+fn read_fx(mut l: ResMut<FxLoader>, mut ext: ResMut<FxExtract>) {
+    let path = l.tav_dir.join("fxframe.bin");
+    let stamp = std::fs::metadata(&path).ok().and_then(|m| Some((m.modified().ok()?, m.len())));
+    if stamp != l.stamp {
+        l.stamp = stamp;
+        if stamp.is_some() {
+            match std::fs::read(&path).ok().and_then(|b| parse_frame(&b)) {
+                Some(mut f) => {
+                    f.view = strip_jitter(&mut f, l.strip);
+                    if l.history.len() >= HISTORY {
+                        l.history.pop_front();
+                    }
+                    l.history.push_back(Arc::new(f));
+                }
+                None => l.log_once(format!("{path:?} did not decode (skipped)")),
+            }
+        }
+    }
+    // BG3's effects belong in WoW's view only while the world camera follows BG3's camera (BG3's
+    // loading screen and menus draw effects too).
+    let cam = crate::wowbg3_lead::camera_seq();
+    let picked = if cam == 0 { None } else { pick_frame(&l.history, cam) };
+    if picked.as_ref().map(Arc::as_ptr) != l.frame.as_ref().map(Arc::as_ptr) {
+        l.frame = picked;
+        l.dirty = true;
+    }
+    let now = unix_now();
+    let live = l
+        .frame
+        .as_ref()
+        .filter(|f| !f.draws.is_empty() && now - f.wall < STALE_SECS && f.wall - now < 5.0)
+        .cloned();
+    let Some(frame) = live else {
+        if ext.set.is_some() {
+            ext.set = None;
+        }
+        return;
+    };
+    if !l.dirty && !l.pending && ext.set.is_some() {
+        return;
+    }
+    let mut logged = Vec::new();
+    let mut set = FxFrameSet {
+        frame: frame.clone(),
+        recipes: HashMap::new(),
+        spv: HashMap::new(),
+        samplers: HashMap::new(),
+        textures: HashMap::new(),
+        exposure: l
+            .exposure
+            .or_else(|| frame.post.filter(|p| p.have & 1 != 0).map(|p| p.exposure[0] * p.exposure[1]))
+            .filter(|e| e.is_finite() && *e > 0.0)
+            .unwrap_or(1.0),
+    };
+    let mut pending = false;
+    let mut budget = TEX_BUDGET;
+    let fx = l.fx_dir.clone();
+    let FxLoader { recipes, spv, samplers, textures, .. } = &mut *l;
+    for d in &frame.draws {
+        if !set.recipes.contains_key(&d.pipe) {
+            let (rec, wait) = resolve(
+                recipes,
+                d.pipe,
+                || fx.join("pipe").join(format!("{:016x}.bin", d.pipe)),
+                |b| parse_recipe(&b).ok_or_else(|| "recipe did not decode".to_string()),
+                &mut logged,
+            );
+            pending |= wait;
+            let Some(rec) = rec else { continue };
+            for st in &rec.stages {
+                let (m, wait) = resolve(
+                    spv,
+                    st.spv,
+                    || fx.join("spv").join(format!("{:016x}.spv", st.spv)),
+                    load_spv,
+                    &mut logged,
+                );
+                pending |= wait;
+                if let Some(m) = m {
+                    set.spv.insert(st.spv, m);
+                }
+            }
+            set.recipes.insert(d.pipe, rec);
+        }
+        for s in &d.sets {
+            for slot in &s.slots {
+                let (tex, smp) = match slot.res {
+                    SlotRes::Image(t) => (Some(t), None),
+                    SlotRes::Sampler(k) => (None, Some(k)),
+                    SlotRes::Combined(t, k) => (Some(t), Some(k)),
+                    SlotRes::Buffer { .. } => (None, None),
+                };
+                if let Some(k) = smp.filter(|k| !set.samplers.contains_key(k)) {
+                    let (v, wait) = resolve(
+                        samplers,
+                        k,
+                        || fx.join("sampler").join(format!("{k:016x}.bin")),
+                        |b| parse_sampler(&b).ok_or_else(|| "sampler did not decode".to_string()),
+                        &mut logged,
+                    );
+                    pending |= wait;
+                    if let Some(v) = v {
+                        set.samplers.insert(k, v);
+                    }
+                }
+                if let Some(k) = tex.filter(|k| *k > SPECIAL_KEYS && !set.textures.contains_key(k)) {
+                    let ready = matches!(textures.get(&k), Some(Slot::Ready(_)));
+                    if !ready && budget == 0 {
+                        pending = true;
+                        continue;
+                    }
+                    let path = fx.join("tex").join(format!("{k:016x}.bin"));
+                    if !ready {
+                        let size = std::fs::metadata(&path).map_or(0, |m| m.len() as usize);
+                        budget = budget.saturating_sub(size.max(1));
+                    }
+                    let (v, wait) = resolve(
+                        textures,
+                        k,
+                        || path,
+                        |b| parse_tex(b).ok_or_else(|| "texture did not decode".to_string()),
+                        &mut logged,
+                    );
+                    pending |= wait;
+                    if let Some(v) = v {
+                        set.textures.insert(k, v);
+                    }
+                }
+            }
+        }
+    }
+    // BG3's grading and display LUTs (3D textures), for the composite.
+    for k in frame.post.iter().flat_map(|p| [p.grade_lut, p.display_lut]).filter(|k| *k > SPECIAL_KEYS) {
+        let (v, wait) = resolve(
+            textures,
+            k,
+            || fx.join("tex").join(format!("{k:016x}.bin")),
+            |b| parse_tex(b).ok_or_else(|| "texture did not decode".to_string()),
+            &mut logged,
+        );
+        pending |= wait;
+        if let Some(v) = v {
+            set.textures.insert(k, v);
+        }
+    }
+    for m in logged {
+        l.log_once(m);
+    }
+    l.dirty = false;
+    l.pending = pending;
+    ext.set = Some(Arc::new(set));
+}
+
+/// Marks the world camera and lets its depth be sampled (the depth conversion reads it). The
+/// frames export may overwrite the depth usages once at start; this puts the binding back.
+fn arm_fx(mut cam: Query<(Entity, &mut Camera3d, Has<FxView>), With<WorldCamera>>, mut commands: Commands) {
+    let Ok((entity, mut camera, marked)) = cam.single_mut() else { return };
+    let usages = TextureUsages::from_bits_truncate(camera.depth_texture_usages.0);
+    if !usages.contains(TextureUsages::TEXTURE_BINDING) {
+        camera.depth_texture_usages = (usages | TextureUsages::TEXTURE_BINDING | TextureUsages::RENDER_ATTACHMENT).into();
+    }
+    if !marked {
+        commands.entity(entity).insert(FxView);
+    }
+}
+
+pub(crate) fn build(app: &mut App) {
+    if std::env::var_os("WOW_BG3_LEAD").is_none() {
+        return;
+    }
+    let tav_dir = std::env::var_os("WOW_BG3_TAV_DIR").map_or_else(|| PathBuf::from("/tmp/wowbg3/tav"), PathBuf::from);
+    let fx_dir = std::env::var_os("WOW_BG3_FX_DIR")
+        .map_or_else(|| PathBuf::from("/logs/capture/fx"), PathBuf::from);
+    let exposure = std::env::var("WOW_BG3_FX_EXPOSURE")
+        .ok()
+        .and_then(|v| v.trim().parse::<f32>().ok())
+        .filter(|v| v.is_finite() && *v > 0.0);
+    let strip = std::env::var("WOW_BG3_FX_JITTER").map_or(true, |v| v != "keep");
+    info!(
+        "wowbg3 fx: replaying BG3's effects from {tav_dir:?} with {fx_dir:?}, exposure {}, TAA jitter {}",
+        exposure.map_or("from BG3".to_string(), |e| e.to_string()),
+        if strip { "stripped" } else { "kept" }
+    );
+    app.insert_resource(FxLoader {
+        tav_dir,
+        fx_dir,
+        exposure,
+        strip,
+        stamp: None,
+        history: VecDeque::new(),
+        frame: None,
+        dirty: true,
+        pending: false,
+        recipes: HashMap::new(),
+        spv: HashMap::new(),
+        samplers: HashMap::new(),
+        textures: HashMap::new(),
+        logged: HashSet::new(),
+    })
+    .init_resource::<FxExtract>()
+    .add_plugins((ExtractResourcePlugin::<FxExtract>::default(), ExtractComponentPlugin::<FxView>::default()))
+    .add_systems(Update, arm_fx)
+    // After the world camera took BG3's pose (`wowbg3_lead`), so the frame pairs with it.
+    .add_systems(PostUpdate, read_fx.after(bevy::transform::TransformSystems::Propagate));
+    crate::wowbg3_fx_render::build(app);
+}
