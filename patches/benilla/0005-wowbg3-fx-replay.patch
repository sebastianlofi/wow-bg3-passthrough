+// SPIR-V: reflection of the descriptor bindings, and the Y flip of vertex modules
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub(crate) enum Scalar {
+    Float,
+    Uint,
+    Sint,
+}
+
+/// What a module declares at one (set, binding).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum SpvBind {
+    Uniform,
+    Storage,
+    Sampler,
+    /// `dim`: SPIR-V Dim (0 1D, 1 2D, 2 3D, 3 Cube); `storage`: a storage image (Sampled 2);
+    /// `format`: SPIR-V ImageFormat.
+    Image { dim: u32, arrayed: bool, ms: bool, storage: bool, format: u32, scalar: Scalar },
+    Combined,
+    Array,
+    Other,
+}
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub(crate) struct SpvInfo {
+    pub(crate) bindings: HashMap<(u32, u32), SpvBind>,
+    /// Some `OpImageWrite`.
+    pub(crate) image_write: bool,
+}
+
+/// A module as loaded: its words, reflection, and (for vertex modules) the Y-flipped words.
+pub(crate) struct SpvModule {
+    pub(crate) words: Vec<u32>,
+    pub(crate) info: SpvInfo,
+    pub(crate) flipped: Result<Vec<u32>, &'static str>,
+}
+
+const SPV_MAGIC: u32 = 0x0723_0203;
+
+/// The instructions as (start word, word count); `None` when the stream is malformed.
+fn spv_insts(w: &[u32]) -> Option<Vec<(usize, usize)>> {
+    if w.len() < 5 || w[0] != SPV_MAGIC {
+        return None;
+    }
+    let mut out = Vec::new();
+    let mut i = 5;
+    while i < w.len() {
+        let n = (w[i] >> 16) as usize;
+        if n == 0 || i + n > w.len() {
+            return None;
+        }
+        out.push((i, n));
+        i += n;
+    }
+    Some(out)
+}
+
+pub(crate) fn spv_words(b: &[u8]) -> Option<Vec<u32>> {
+    if b.len() % 4 != 0 || b.len() < 20 {
+        return None;
+    }
+    let w: Vec<u32> = b.chunks_exact(4).map(|c| u32::from_le_bytes([c[0], c[1], c[2], c[3]])).collect();
+    (w[0] == SPV_MAGIC).then_some(w)
+}
+
+enum Ty {
+    Int(bool),
+    Image { sampled_type: u32, dim: u32, arrayed: bool, ms: bool, sampled: u32, format: u32 },
+    Sampler,
+    SampledImage,
+    Array,
+    Struct,
+    Pointer(u32),
+    Other,
+}
+
+pub(crate) fn reflect(w: &[u32]) -> Option<SpvInfo> {
+    let insts = spv_insts(w)?;
+    let (mut set, mut binding) = (HashMap::new(), HashMap::new());
+    let mut buffer_block = HashSet::new();
+    let mut types: HashMap<u32, Ty> = HashMap::new();
+    let mut vars = Vec::new();
+    let mut image_write = false;
+    for &(s, n) in &insts {
+        let op = w[s] & 0xffff;
+        let a = &w[s + 1..s + n];
+        match op {
+            // OpDecorate: DescriptorSet 34, Binding 33, BufferBlock 3
+            71 if a.len() >= 3 && a[1] == 34 => {
+                set.insert(a[0], a[2]);
+            }
+            71 if a.len() >= 3 && a[1] == 33 => {
+                binding.insert(a[0], a[2]);
+            }
+            71 if a.len() >= 2 && a[1] == 3 => {
+                buffer_block.insert(a[0]);
+            }
+            21 if a.len() >= 3 => {
+                types.insert(a[0], Ty::Int(a[2] != 0));
+            }
+            25 if a.len() >= 8 => {
+                types.insert(
+                    a[0],
+                    Ty::Image {
+                        sampled_type: a[1],
+                        dim: a[2],
+                        arrayed: a[4] != 0,
+                        ms: a[5] != 0,
+                        sampled: a[6],
+                        format: a[7],
+                    },
+                );
+            }
+            26 if !a.is_empty() => {
+                types.insert(a[0], Ty::Sampler);
+            }
+            27 if !a.is_empty() => {
+                types.insert(a[0], Ty::SampledImage);
+            }
+            28 | 29 if !a.is_empty() => {
+                types.insert(a[0], Ty::Array);
+            }
+            30 if !a.is_empty() => {
+                types.insert(a[0], Ty::Struct);
+            }
+            32 if a.len() >= 3 => {
+                types.insert(a[0], Ty::Pointer(a[2]));
+            }
+            22 | 23 if !a.is_empty() => {
+                types.insert(a[0], Ty::Other);
+            }
+            59 if a.len() >= 3 => vars.push((a[1], a[0], a[2])),
+            99 => image_write = true,
+            _ => {}
+        }
+    }
+    let mut bindings = HashMap::new();
+    for (id, ty, sc) in vars {
+        let (Some(&s), Some(&b)) = (set.get(&id), binding.get(&id)) else { continue };
+        let Some(Ty::Pointer(pointee)) = types.get(&ty) else { continue };
+        let kind = match types.get(pointee) {
+            Some(Ty::Image { sampled_type, dim, arrayed, ms, sampled, format }) => SpvBind::Image {
+                dim: *dim,
+                arrayed: *arrayed,
+                ms: *ms,
+                storage: *sampled == 2,
+                format: *format,
+                scalar: match types.get(sampled_type) {
+                    Some(Ty::Int(true)) => Scalar::Sint,
+                    Some(Ty::Int(false)) => Scalar::Uint,
+                    _ => Scalar::Float,
+                },
+            },
+            Some(Ty::Sampler) => SpvBind::Sampler,
+            Some(Ty::SampledImage) => SpvBind::Combined,
+            Some(Ty::Array) => SpvBind::Array,
+            // StorageBuffer class (12), or Uniform with BufferBlock (DXC's structured buffers)
+            Some(Ty::Struct) if sc == 12 || buffer_block.contains(pointee) => SpvBind::Storage,
+            Some(Ty::Struct) => SpvBind::Uniform,
+            _ => SpvBind::Other,
+        };
+        bindings.insert((s, b), kind);
+    }
+    Some(SpvInfo { bindings, image_write })
+}
+
+/// Negates `Position.y` before every store to it: BG3 (positive Vulkan viewport) writes clip
+/// space with +Y down, wgpu's Vulkan backend always flips the viewport (+Y up). Handles a plain
+/// `BuiltIn Position` output (what DXC emits) and a `gl_PerVertex` block member, whole-vector
+/// stores and stores of the y component through an access chain.
+pub(crate) fn flip_position_y(w: &[u32]) -> Result<Vec<u32>, &'static str> {
+    let insts = spv_insts(w).ok_or("not SPIR-V")?;
+    let mut pos_vars = HashSet::new();
+    let mut pos_member: HashMap<u32, u32> = HashMap::new();
+    let mut vectors: HashMap<u32, (u32, u32)> = HashMap::new();
+    let mut pointers: HashMap<u32, u32> = HashMap::new();
+    let mut structs: HashMap<u32, Vec<u32>> = HashMap::new();
+    let mut consts: HashMap<u32, u32> = HashMap::new();
+    let mut outputs: Vec<(u32, u32)> = Vec::new();
+    for &(s, n) in &insts {
+        let op = w[s] & 0xffff;
+        let a = &w[s + 1..s + n];
+        match op {
+            71 if a.len() >= 3 && a[1] == 11 && a[2] == 0 => {
+                pos_vars.insert(a[0]);
+            }
+            72 if a.len() >= 4 && a[2] == 11 && a[3] == 0 => {
+                pos_member.insert(a[0], a[1]);
+            }
+            23 if a.len() >= 3 => {
+                vectors.insert(a[0], (a[1], a[2]));
+            }
+            30 if !a.is_empty() => {
+                structs.insert(a[0], a[1..].to_vec());
+            }
+            32 if a.len() >= 3 => {
+                pointers.insert(a[0], a[2]);
+            }
+            43 if a.len() >= 3 => {
+                consts.insert(a[1], a[2]);
+            }
+            59 if a.len() >= 3 && a[2] == 3 => outputs.push((a[1], a[0])),
+            _ => {}
+        }
+    }
+    // Pointers to the whole position (vec4 type, float type), and to its y component (float).
+    let mut whole: HashMap<u32, (u32, u32)> = HashMap::new();
+    let mut ycomp: HashMap<u32, u32> = HashMap::new();
+    let mut blocks: HashMap<u32, (u32, u32, u32)> = HashMap::new();
+    for &(var, ptr) in &outputs {
+        let Some(&pointee) = pointers.get(&ptr) else { continue };
+        if pos_vars.contains(&var) {
+            let &(f, n) = vectors.get(&pointee).ok_or("Position is not a vector")?;
+            if n != 4 {
+                return Err("Position is not a vec4");
+            }
+            whole.insert(var, (pointee, f));
+        } else if let Some(&m) = pos_member.get(&pointee) {
+            let vec = *structs.get(&pointee).and_then(|ms| ms.get(m as usize)).ok_or("bad gl_PerVertex")?;
+            let &(f, _) = vectors.get(&vec).ok_or("Position member is not a vector")?;
+            blocks.insert(var, (m, vec, f));
+        }
+    }
+    for &(s, n) in &insts {
+        let op = w[s] & 0xffff;
+        let a = &w[s + 1..s + n];
+        if (op == 65 || op == 66) && a.len() >= 4 {
+            let (rid, base, idx) = (a[1], a[2], &a[3..]);
+            if let Some(&(_, f)) = whole.get(&base) {
+                match idx.len() {
+                    1 => match consts.get(&idx[0]) {
+                        Some(1) => {
+                            ycomp.insert(rid, f);
+                        }
+                        Some(_) => {}
+                        None => return Err("dynamic index into Position"),
+                    },
+                    _ => return Err("deep access into Position"),
+                }
+            } else if let Some(&(m, vec, f)) = blocks.get(&base) {
+                if consts.get(&idx[0]) == Some(&m) {
+                    match idx.len() {
+                        1 => {
+                            whole.insert(rid, (vec, f));
+                        }
+                        2 => match consts.get(&idx[1]) {
+                            Some(1) => {
+                                ycomp.insert(rid, f);
+                            }
+                            Some(_) => {}
+                            None => return Err("dynamic index into Position"),
+                        },
+                        _ => return Err("deep access into Position"),
+                    }
+                } else if consts.get(&idx[0]).is_none() {
+                    return Err("dynamic index into gl_PerVertex");
+                }
+            }
+        } else if op == 63 && a.len() >= 2 && (whole.contains_key(&a[0]) || ycomp.contains_key(&a[0])) {
+            return Err("OpCopyMemory into Position");
+        } else if op == 57 && a.len() >= 3 && a[3..].iter().any(|x| whole.contains_key(x) || blocks.contains_key(x)) {
+            return Err("Position passed to a function");
+        }
+    }
+    let mut bound = w[3];
+    let mut out = Vec::with_capacity(w.len() + 32);
+    out.extend_from_slice(&w[..5]);
+    let mut patched = 0;
+    for &(s, n) in &insts {
+        let op = w[s] & 0xffff;
+        if op == 62 && n >= 3 {
+            let (ptr, val) = (w[s + 1], w[s + 2]);
+            if let Some(&(vec, f)) = whole.get(&ptr) {
+                let (e, neg, ins) = (bound, bound + 1, bound + 2);
+                bound += 3;
+                out.extend_from_slice(&[(5 << 16) | 81, f, e, val, 1]); // OpCompositeExtract
+                out.extend_from_slice(&[(4 << 16) | 127, f, neg, e]); // OpFNegate
+                out.extend_from_slice(&[(6 << 16) | 82, vec, ins, neg, val, 1]); // OpCompositeInsert
+                out.extend_from_slice(&[w[s], ptr, ins]);
+                out.extend_from_slice(&w[s + 3..s + n]);
+                patched += 1;
+                continue;
+            }
+            if let Some(&f) = ycomp.get(&ptr) {
+                let neg = bound;
+                bound += 1;
+                out.extend_from_slice(&[(4 << 16) | 127, f, neg, val]);
+                out.extend_from_slice(&[w[s], ptr, neg]);
+                out.extend_from_slice(&w[s + 3..s + n]);
+                patched += 1;
+                continue;
+            }
+        }
+        out.extend_from_slice(&w[s..s + n]);
+    }
+    if patched == 0 {
+        return Err("no store to Position");
+    }
+    out[3] = bound;
+    Ok(out)
+}
+
