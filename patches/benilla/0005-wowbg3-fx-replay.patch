+}
+
+/// SPIR-V ImageFormat of a storage image (0, unknown, taken as R32f: BG3's linear depth).
+fn spv_storage_format(f: u32) -> Option<wgpu::TextureFormat> {
+    use wgpu::TextureFormat as T;
+    Some(match f {
+        0 | 3 => T::R32Float,
+        1 => T::Rgba32Float,
+        2 => T::Rgba16Float,
+        4 => T::Rgba8Unorm,
+        24 => T::R32Sint,
+        33 => T::R32Uint,
+        _ => return None,
+    })
+}
+
+fn view_dim(dim: u32, arrayed: bool) -> Option<wgpu::TextureViewDimension> {
+    use wgpu::TextureViewDimension as D;
+    Some(match (dim, arrayed) {
+        (0, false) => D::D1,
+        (1, false) => D::D2,
+        (1, true) => D::D2Array,
+        (2, false) => D::D3,
+        (3, false) => D::Cube,
+        (3, true) => D::CubeArray,
+        _ => return None,
+    })
+}
+
+fn visibility(stages: u32) -> wgpu::ShaderStages {
+    let mut v = wgpu::ShaderStages::NONE;
+    if stages & 0x1 != 0 {
+        v |= wgpu::ShaderStages::VERTEX;
+    }
+    if stages & 0x10 != 0 {
+        v |= wgpu::ShaderStages::FRAGMENT;
+    }
+    if v.is_empty() {
+        v = wgpu::ShaderStages::FRAGMENT;
+    }
+    v
+}
+
+// ---------------------------------------------------------------------------------------------
+// Draw validation (mirrors wgpu-core's, so a bad range is a skipped draw and not a lost frame)
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct VbSlot {
+    pub(crate) binding: u32,
+    pub(crate) stride: u64,
+    /// The furthest byte one element reads (attribute offset + size).
+    pub(crate) last_stride: u64,
+    pub(crate) instance: bool,
+}
+
+/// (vertex limit, instance limit) for buffers of these sizes, as wgpu-core computes them.
+pub(crate) fn vertex_limits(slots: &[VbSlot], sizes: &[u64]) -> (u64, u64) {
+    let (mut vl, mut il) = (u64::MAX, u64::MAX);
+    for (s, &size) in slots.iter().zip(sizes) {
+        let limit = if size < s.last_stride {
+            0
+        } else if s.stride == 0 {
+            continue;
+        } else {
+            (size - s.last_stride) / s.stride + 1
+        };
+        if s.instance {
+            il = il.min(limit);
+        } else {
+            vl = vl.min(limit);
+        }
+    }
+    (vl, il)
+}
+
+// ---------------------------------------------------------------------------------------------
+// GPU state
+
