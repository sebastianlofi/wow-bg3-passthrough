+        assert_eq!(pick(&h, 11), Some(1), "the frame drawn with the camera's record");
+        assert_eq!(pick(&h, 12), Some(3), "the newest of those");
+        assert_eq!(pick(&h, 15), Some(4), "BG3 behind the camera: the newest earlier one");
+        assert_eq!(pick(&h, 9), Some(4), "nothing that old: the newest");
