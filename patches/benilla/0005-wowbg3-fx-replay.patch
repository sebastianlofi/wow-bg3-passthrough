+        assert_eq!(tail[9..15], [(6 << 16) | 82, 3, 22, 21, 12, 1]);
+        assert_eq!(tail[15..], [(3 << 16) | 62, 8, 22]);
+        // the other output's store is untouched
+        assert_eq!(out[out.len() - 21..out.len() - 18], [(3 << 16) | 62, 9, 12]);
