+/// The sequence of the `bg3cam.bin` record the world camera follows this frame (0: none):
+/// `wowbg3_fx` replays the effects BG3 drew with that same camera record (FXQ1 `bg3cam_seq`).
+static CAMERA_SEQ: AtomicU32 = AtomicU32::new(0);
+
+pub(crate) fn camera_seq() -> u32 {
+    CAMERA_SEQ.load(Ordering::Relaxed)
+}
+
+/// `WOW_BG3_LEAD_ZOOM` (debug, default 1): narrows WoW's field of view by this factor, so
+/// benilla's own frame shows the middle of BG3's view magnified, for close surface checks. The
+/// composite does not line up while it is on.
+fn debug_zoom_fov(fovy: f32) -> f32 {
+    static ZOOM: std::sync::OnceLock<f32> = std::sync::OnceLock::new();
+    let z = *ZOOM.get_or_init(|| {
+        std::env::var("WOW_BG3_LEAD_ZOOM")
+            .ok()
+            .and_then(|v| v.trim().parse::<f32>().ok())
+            .filter(|z| z.is_finite() && *z >= 1.0)
+            .unwrap_or(1.0)
+    });
+    if z == 1.0 {
+        fovy
+    } else {
+        2.0 * ((fovy * 0.5).tan() / z).atan()
+    }
+}
