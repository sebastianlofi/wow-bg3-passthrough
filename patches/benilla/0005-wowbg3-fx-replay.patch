+//! WOW-BG3 (local fork, patch 0005), render world: BG3's effect draws replayed with BG3's
+//! own SPIR-V (wgpu passthrough) and composited over the world camera's view. The main-world
+//! half (`wowbg3_fx`) decodes the capture and loads what it names.
+//!
+//! Per frame, in a command buffer of its own (a validation error there drops the replay, never
+//! the frame), between the main transparent pass and the end of the main pass:
+//! 1. table: BG3's display chain (grading LUT, ACEScc, display LUT) evaluated on grey into a
+//!    1D table, to invert it per channel;
+//! 2. prep: WoW's depth turned into BG3's convention at BG3's extent (reverse-Z, metres from
+//!    BG3's eye: `p22 + p32 / z`, with `z = (near / d + depth offset) * 0.9144` plus a small
+//!    slack for terrain that differs from BG3's floor), BG3's linear depth (special key 4: view z
+//!    over BG3's far plane, which is how BG3's effects read and write it; a sampled and a storage
+//!    copy) and WoW's colour taken back to BG3's scene-linear units (key 2);
+//! 3. the draws, twice with the same blend states: over black (C) and over white (W), so the
+//!    transmittance is T = W - C;
+//! 4. composite (Bevy's encoder, a post-process write of the view target): for WoW's
+//!    display-encoded pixel w, x_w = display⁻¹(w), x = x_w·T + C·exposure,
+//!    out = w + display(x) - display(x_w). Untouched pixels stay exactly WoW's. Without BG3's
+//!    post block the display chain falls back to plain sRGB.
+//!
+//! The draws keep BG3's pipelines: bind group layouts mirror BG3's set layouts with every gap
+//! filled by a dummy sampler (wgpu numbers Vulkan bindings 0..n-1), vertex buffers compacted to
+//! slots in the recipe's binding order, colour into Rgba16Float with alpha left at 1 (BG3's
+//! target has no alpha, so its DST_ALPHA reads 1), depth tested read-only against the converted
+//! depth. Anything wgpu cannot take (or a missing file) skips that draw, logged once. BG3's fog
+//! volume (special key 3) is bound empty, (0, 0, 0, 1); its froxel light grid (key 5) is one
+//! constant light, `WOW_BG3_FX_LIGHT` (default 32, which BG3's shaders scale to 1).
+
+use std::collections::{HashMap, HashSet};
+use std::num::NonZeroU64;
+use std::sync::{Arc, Mutex};
+use std::time::Instant;
+
+use bevy::core_pipeline::core_3d::graph::{Core3d, Node3d};
+use bevy::ecs::query::QueryItem;
+use bevy::prelude::*;
+use bevy::render::render_graph::{
+    NodeRunError, RenderGraphContext, RenderGraphExt, RenderLabel, ViewNode, ViewNodeRunner,
+};
+use bevy::render::render_resource::TextureUsages;
+use bevy::render::renderer::{RenderContext, RenderDevice, RenderQueue};
+use bevy::render::view::{ExtractedView, ViewDepthTexture, ViewTarget};
+use bevy::render::{Render, RenderApp, RenderSystems};
+
+use crate::wowbg3_fx::{
+    FxDraw, FxExtract, FxFrameSet, FxSampler, FxView, Recipe, Scalar, SlotRes, SpvBind, SpvModule, TexFile,
+};
+
+const COLOR_FMT: wgpu::TextureFormat = wgpu::TextureFormat::Rgba16Float;
+const DEPTH_FMT: wgpu::TextureFormat = wgpu::TextureFormat::Depth32Float;
+const TABLE_FMT: wgpu::TextureFormat = wgpu::TextureFormat::Rgba32Float;
+/// Entries of the display-chain table: x = 0, then 2^lo .. 2^hi.
+const TABLE_N: u32 = 1024;
+const TABLE_LO: f32 = -16.0;
+const TABLE_HI: f32 = 8.0;
+const YD: f32 = 0.9144;
+
+pub(crate) fn build(app: &mut App) {
+    let Some(render_app) = app.get_sub_app_mut(RenderApp) else {
+        warn!("wowbg3 fx: no render app");
+        return;
+    };
+    let env = |k: &str| std::env::var(k).ok().filter(|v| !v.trim().is_empty());
+    let keys = |v: Option<String>| -> HashSet<u64> {
+        v.map(|v| v.split(',').filter_map(|k| u64::from_str_radix(k.trim(), 16).ok()).collect()).unwrap_or_default()
+    };
+    let cfg = FxCfg {
+        // BG3's froxel light grid (special key 5) is replaced by one constant light; BG3's
+        // shaders scale the grid by 1/32, so 32 lights the effects with 1.
+        light: env("WOW_BG3_FX_LIGHT").and_then(|v| v.trim().parse().ok()).filter(|v: &f32| v.is_finite()).unwrap_or(32.0),
+        skip: keys(env("WOW_BG3_FX_SKIP")),
+        only: keys(env("WOW_BG3_FX_ONLY")),
+        show: match env("WOW_BG3_FX_SHOW").as_deref() {
+            Some("c") => 1.0,
+            Some("t") => 2.0,
+            Some("d") => 3.0,
+            Some("r") => 4.0,
+            _ => 0.0,
+        },
+        slack: env("WOW_BG3_FX_DEPTH_SLACK").and_then(|v| v.trim().parse().ok()).filter(|v: &f32| v.is_finite()).unwrap_or(0.1),
+    };
+    info!(
+        "wowbg3 fx: light grid {}, depth slack {} m, skip {:x?}, only {:x?}, show {}",
+        cfg.light, cfg.slack, cfg.skip, cfg.only, cfg.show
+    );
+    render_app
+        .insert_resource(FxGpu { cfg, ..Default::default() })
+        .add_systems(Render, prepare_fx.in_set(RenderSystems::PrepareBindGroups))
+        .add_render_graph_node::<ViewNodeRunner<FxNode>>(Core3d, FxLabel)
+        .add_render_graph_edges(Core3d, (Node3d::MainTransparentPass, FxLabel, Node3d::EndMainPass));
+}
+
+// ---------------------------------------------------------------------------------------------
+// Vulkan to wgpu
+
+fn vk_compare(op: u32) -> wgpu::CompareFunction {
+    use wgpu::CompareFunction as C;
+    match op {
+        0 => C::Never,
+        1 => C::Less,
+        2 => C::Equal,
+        3 => C::LessEqual,
+        4 => C::Greater,
+        5 => C::NotEqual,
+        6 => C::GreaterEqual,
+        _ => C::Always,
+    }
+}
+
+fn vk_blend_factor(f: u32) -> Option<wgpu::BlendFactor> {
+    use wgpu::BlendFactor as B;
+    Some(match f {
+        0 => B::Zero,
+        1 => B::One,
+        2 => B::Src,
+        3 => B::OneMinusSrc,
+        4 => B::Dst,
+        5 => B::OneMinusDst,
+        6 => B::SrcAlpha,
+        7 => B::OneMinusSrcAlpha,
+        8 => B::DstAlpha,
+        9 => B::OneMinusDstAlpha,
+        10 => B::Constant,
+        11 => B::OneMinusConstant,
+        14 => B::SrcAlphaSaturated,
+        15 => B::Src1,
+        16 => B::OneMinusSrc1,
+        17 => B::Src1Alpha,
+        18 => B::OneMinusSrc1Alpha,
+        _ => return None,
+    })
+}
+
+fn vk_blend_op(o: u32) -> Option<wgpu::BlendOperation> {
+    use wgpu::BlendOperation as O;
+    Some(match o {
+        0 => O::Add,
+        1 => O::Subtract,
+        2 => O::ReverseSubtract,
+        3 => O::Min,
+        4 => O::Max,
+        _ => return None,
+    })
+}
+
+fn vk_topology(t: u32) -> Option<wgpu::PrimitiveTopology> {
+    use wgpu::PrimitiveTopology as T;
+    Some(match t {
+        0 => T::PointList,
+        1 => T::LineList,
+        2 => T::LineStrip,
+        3 => T::TriangleList,
+        4 => T::TriangleStrip,
+        _ => return None,
+    })
+}
+
+pub(crate) fn vk_vertex_format(f: u32) -> Option<wgpu::VertexFormat> {
+    use wgpu::VertexFormat as V;
