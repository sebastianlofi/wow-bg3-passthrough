+    prep_bgl: wgpu::BindGroupLayout,
+    comp_bgl: wgpu::BindGroupLayout,
+    composite: wgpu::RenderPipeline,
+    composite_format: wgpu::TextureFormat,
+    depth: wgpu::TextureView,
+    lin_a: wgpu::TextureView,
+    lin_b: wgpu::TextureView,
+    scene: wgpu::TextureView,
+    c: wgpu::TextureView,
+    w: wgpu::TextureView,
+}
+
+struct PreparedDraw {
+    pipeline: wgpu::RenderPipeline,
+    groups: Vec<wgpu::BindGroup>,
+    vbs: Vec<(u64, u64)>,
+    index: Option<(u64, u64, wgpu::IndexFormat)>,
+    count: u32,
+    instances: u32,
