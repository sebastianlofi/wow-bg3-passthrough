+}
+
+enum Skip {
+    /// Logged once per distinct message.
+    Once(String),
+    /// Waiting on a file still loading; not logged.
+    Pending,
+    /// Nothing to draw (no instances, culled both faces, a pipeline that failed before).
+    Silent,
+}
+
+#[derive(Default)]
+struct Stats {
+    since: Option<Instant>,
+    frames: u32,
+    replayed: u64,
+    skipped: u64,
+}
+
+/// Knobs from the environment (`build`).
+#[derive(Default)]
+struct FxCfg {
+    /// The light grid's texel value (`WOW_BG3_FX_LIGHT`, special key 5).
+    light: f32,
+    /// Pipes not replayed (`WOW_BG3_FX_SKIP`, hex keys) or the only ones (`WOW_BG3_FX_ONLY`).
+    skip: HashSet<u64>,
+    only: HashSet<u64>,
+    /// Composite shows 1 the effects over black, 2 their transmittance, 3 a diagnosis: red
+    /// negative emission, green emission, blue transmittance off 1, magenta not finite
+    /// (`WOW_BG3_FX_SHOW=c|t|d`); 4 WoW's colour through BG3's display chain and back (`r`).
+    show: f32,
+    /// Metres WoW's surfaces are pushed back for the effects' depth test and soft fade
+    /// (`WOW_BG3_FX_DEPTH_SLACK`): WoW's ground only meets BG3's floor at Tav's feet.
+    slack: f32,
+}
+
+#[derive(Resource, Default)]
+pub(crate) struct FxGpu {
+    cfg: FxCfg,
+    base: Option<Base>,
+    base_failed: bool,
+    modules: HashMap<(u64, bool), Option<wgpu::ShaderModule>>,
+    bgls: HashMap<BglKey, Option<wgpu::BindGroupLayout>>,
+    pipes: HashMap<PipeKey, Option<Arc<Pipe>>>,
+    samplers: HashMap<u64, Option<wgpu::Sampler>>,
+    textures: HashMap<u64, Option<GpuTex>>,
+    targets: Option<Targets>,
+    composites: HashMap<wgpu::TextureFormat, Option<wgpu::RenderPipeline>>,
+    /// The set `ready` was built from (rebuilt only when the main world sends a new one).
+    last: Option<Arc<FxFrameSet>>,
+    ready: Option<Arc<Ready>>,
+    last_counts: (usize, usize),
+    mode: f32,
+    logged: HashSet<String>,
+    stats: Stats,
+    /// Errors met while recording (the node only reads the resource).
+    node_log: Mutex<HashSet<String>>,
+}
+
+/// Runs `f` inside validation and internal error scopes: wgpu's default handler panics.
+fn scoped<T>(dev: &wgpu::Device, f: impl FnOnce() -> T) -> Result<T, String> {
+    dev.push_error_scope(wgpu::ErrorFilter::Validation);
+    dev.push_error_scope(wgpu::ErrorFilter::Internal);
+    let v = f();
+    let internal = bevy::tasks::futures::now_or_never(dev.pop_error_scope()).flatten();
+    let validation = bevy::tasks::futures::now_or_never(dev.pop_error_scope()).flatten();
+    match internal.or(validation) {
+        Some(e) => Err(e.to_string()),
+        None => Ok(v),
+    }
+}
+
+fn tex_desc<'a>(
+    label: &'a str,
+    size: wgpu::Extent3d,
+    dim: wgpu::TextureDimension,
+    format: wgpu::TextureFormat,
+    usage: wgpu::TextureUsages,
+) -> wgpu::TextureDescriptor<'a> {
+    wgpu::TextureDescriptor {
+        label: Some(label),
+        size,
+        mip_level_count: 1,
+        sample_count: 1,
+        dimension: dim,
+        format,
+        usage,
+        view_formats: &[],
+    }
+}
+
+fn plain_view(t: &wgpu::Texture) -> wgpu::TextureView {
+    t.create_view(&wgpu::TextureViewDescriptor::default())
+}
+
+fn bgl_entry(binding: u32, ty: wgpu::BindingType, vis: wgpu::ShaderStages) -> wgpu::BindGroupLayoutEntry {
+    wgpu::BindGroupLayoutEntry { binding, visibility: vis, ty, count: None }
+}
+
+fn tex_ty(dim: wgpu::TextureViewDimension, sample_type: wgpu::TextureSampleType) -> wgpu::BindingType {
+    wgpu::BindingType::Texture { sample_type, view_dimension: dim, multisampled: false }
+}
+
+const UNFILTERABLE: wgpu::TextureSampleType = wgpu::TextureSampleType::Float { filterable: false };
+
+impl Base {
+    fn new(dev: &wgpu::Device, queue: &wgpu::Queue, light: f32) -> Result<Base, String> {
+        use wgpu::TextureViewDimension as D;
+        let frag = wgpu::ShaderStages::FRAGMENT;
+        let vf = wgpu::ShaderStages::VERTEX_FRAGMENT;
+        scoped(dev, || {
+            let arena = dev.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("wowbg3_fx_arena"),
+                size: 1 << 20,
+                usage: wgpu::BufferUsages::VERTEX
+                    | wgpu::BufferUsages::INDEX
+                    | wgpu::BufferUsages::UNIFORM
+                    | wgpu::BufferUsages::STORAGE
+                    | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            });
+            let dummy_buf = dev.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("wowbg3_fx_dummy"),
+                size: 256,
+                usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            });
+            let linear = wgpu::SamplerDescriptor {
+                label: Some("wowbg3_fx_linear"),
+                address_mode_u: wgpu::AddressMode::ClampToEdge,
+                address_mode_v: wgpu::AddressMode::ClampToEdge,
+                address_mode_w: wgpu::AddressMode::ClampToEdge,
+                mag_filter: wgpu::FilterMode::Linear,
+                min_filter: wgpu::FilterMode::Linear,
+                mipmap_filter: wgpu::FilterMode::Linear,
+                ..Default::default()
+            };
+            let dummy_sampler = dev.create_sampler(&linear);
+            let linear_clamp = dev.create_sampler(&linear);
+            // Neutral (0, 0, 0, 1) textures of every view dimension and scalar kind.
+            let mut neutral = HashMap::new();
+            for (scalar, format, texel) in [
+                (Scalar::Float, wgpu::TextureFormat::Rgba16Float, bytemuck::cast_slice::<u16, u8>(&[0, 0, 0, 0x3c00]).to_vec()),
+                (Scalar::Uint, wgpu::TextureFormat::Rgba32Uint, bytemuck::cast_slice::<u32, u8>(&[0, 0, 0, 1]).to_vec()),
+                (Scalar::Sint, wgpu::TextureFormat::Rgba32Sint, bytemuck::cast_slice::<i32, u8>(&[0, 0, 0, 1]).to_vec()),
+            ] {
+                for dim in [D::D1, D::D2, D::D2Array, D::D3, D::Cube, D::CubeArray] {
+                    let (tdim, layers) = match dim {
+                        D::D1 => (wgpu::TextureDimension::D1, 1),
+                        D::D3 => (wgpu::TextureDimension::D3, 1),
+                        D::Cube | D::CubeArray => (wgpu::TextureDimension::D2, 6),
+                        _ => (wgpu::TextureDimension::D2, 1),
+                    };
+                    let size = wgpu::Extent3d { width: 1, height: 1, depth_or_array_layers: layers };
+                    let t = dev.create_texture(&tex_desc(
+                        "wowbg3_fx_neutral",
+                        size,
+                        tdim,
+                        format,
+                        wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+                    ));
+                    for layer in 0..layers {
+                        queue.write_texture(
+                            wgpu::TexelCopyTextureInfo {
+                                texture: &t,
+                                mip_level: 0,
+                                origin: wgpu::Origin3d { x: 0, y: 0, z: layer },
+                                aspect: wgpu::TextureAspect::All,
+                            },
+                            &texel,
+                            wgpu::TexelCopyBufferLayout { offset: 0, bytes_per_row: Some(texel.len() as u32), rows_per_image: Some(1) },
+                            wgpu::Extent3d { width: 1, height: 1, depth_or_array_layers: 1 },
+                        );
+                    }
+                    let view = t.create_view(&wgpu::TextureViewDescriptor { dimension: Some(dim), ..Default::default() });
+                    neutral.insert((dim, scalar), view);
+                }
+            }
+            let light_tex = dev.create_texture(&tex_desc(
+                "wowbg3_fx_light",
+                wgpu::Extent3d { width: 1, height: 1, depth_or_array_layers: 1 },
+                wgpu::TextureDimension::D3,
+                wgpu::TextureFormat::Rgba16Float,
+                wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+            ));
+            let l = half::f16::from_f32(light).to_bits();
+            queue.write_texture(
+                light_tex.as_image_copy(),
+                bytemuck::cast_slice::<u16, u8>(&[l, l, l, half::f16::ONE.to_bits()]),
+                wgpu::TexelCopyBufferLayout { offset: 0, bytes_per_row: Some(8), rows_per_image: Some(1) },
+                wgpu::Extent3d { width: 1, height: 1, depth_or_array_layers: 1 },
+            );
+            let light3d = plain_view(&light_tex);
+            let params = dev.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("wowbg3_fx_params"),
+                size: PARAMS_BYTES,
+                usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            });
+            let table_tex = dev.create_texture(&tex_desc(
+                "wowbg3_fx_table",
+                wgpu::Extent3d { width: TABLE_N, height: 1, depth_or_array_layers: 1 },
+                wgpu::TextureDimension::D2,
+                TABLE_FMT,
+                wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::TEXTURE_BINDING,
+            ));
+            let table = plain_view(&table_tex);
+            let filterable = wgpu::TextureSampleType::Float { filterable: true };
+            let filtering = wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering);
+            let chain_bgl = dev.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+                label: Some("wowbg3_fx_chain"),
+                entries: &[
+                    bgl_entry(
+                        0,
+                        wgpu::BindingType::Buffer { ty: wgpu::BufferBindingType::Uniform, has_dynamic_offset: false, min_binding_size: None },
+                        vf,
+                    ),
+                    bgl_entry(1, tex_ty(D::D3, filterable), frag),
+                    bgl_entry(2, filtering, frag),
+                    bgl_entry(3, tex_ty(D::D3, filterable), frag),
+                    bgl_entry(4, filtering, frag),
+                ],
+            });
+            let table_bgl = dev.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+                label: Some("wowbg3_fx_table"),
+                entries: &[bgl_entry(0, tex_ty(D::D2, UNFILTERABLE), frag)],
+            });
+            let prep_bgl = dev.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+                label: Some("wowbg3_fx_prep"),
+                entries: &[
+                    bgl_entry(0, tex_ty(D::D2, wgpu::TextureSampleType::Depth), frag),
+                    bgl_entry(1, tex_ty(D::D2, UNFILTERABLE), frag),
+                ],
+            });
+            let comp_bgl = dev.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+                label: Some("wowbg3_fx_comp"),
+                entries: &[
+                    bgl_entry(0, tex_ty(D::D2, UNFILTERABLE), frag),
+                    bgl_entry(1, tex_ty(D::D2, UNFILTERABLE), frag),
+                    bgl_entry(2, tex_ty(D::D2, UNFILTERABLE), frag),
+                ],
+            });
+            let wgsl = |label: &str, body: &str| {
+                dev.create_shader_module(wgpu::ShaderModuleDescriptor {
+                    label: Some(label),
+                    source: wgpu::ShaderSource::Wgsl(format!("{WGSL_PRELUDE}\n{body}").into()),
+                })
+            };
+            let layout = |bgls: &[&wgpu::BindGroupLayout]| {
+                dev.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+                    label: Some("wowbg3_fx_own"),
+                    bind_group_layouts: bgls,
+                    push_constant_ranges: &[],
+                })
+            };
+            let table_module = wgsl("wowbg3_fx_table", WGSL_TABLE);
+            let table_pipeline = dev.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some("wowbg3_fx_table"),
+                layout: Some(&layout(&[&chain_bgl])),
+                vertex: wgpu::VertexState {
+                    module: &table_module,
+                    entry_point: Some("vs"),
+                    compilation_options: Default::default(),
+                    buffers: &[],
+                },
+                primitive: wgpu::PrimitiveState::default(),
+                depth_stencil: None,
+                multisample: wgpu::MultisampleState::default(),
+                fragment: Some(wgpu::FragmentState {
+                    module: &table_module,
+                    entry_point: Some("fs_table"),
+                    compilation_options: Default::default(),
+                    targets: &[Some(TABLE_FMT.into())],
+                }),
+                multiview: None,
+                cache: None,
+            });
+            let prep_module = wgsl("wowbg3_fx_prep", &format!("{WGSL_INVERSE}\n{WGSL_PREP}"));
+            let prep_pipeline = dev.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some("wowbg3_fx_prep"),
+                layout: Some(&layout(&[&chain_bgl, &table_bgl, &prep_bgl])),
+                vertex: wgpu::VertexState {
+                    module: &prep_module,
+                    entry_point: Some("vs"),
+                    compilation_options: Default::default(),
+                    buffers: &[],
+                },
+                primitive: wgpu::PrimitiveState::default(),
+                depth_stencil: Some(wgpu::DepthStencilState {
+                    format: DEPTH_FMT,
+                    depth_write_enabled: true,
+                    depth_compare: wgpu::CompareFunction::Always,
+                    stencil: wgpu::StencilState::default(),
+                    bias: wgpu::DepthBiasState::default(),
+                }),
+                multisample: wgpu::MultisampleState::default(),
+                fragment: Some(wgpu::FragmentState {
+                    module: &prep_module,
+                    entry_point: Some("fs_prep"),
+                    compilation_options: Default::default(),
+                    targets: &[
+                        Some(wgpu::TextureFormat::R32Float.into()),
+                        Some(wgpu::TextureFormat::R32Float.into()),
+                        Some(COLOR_FMT.into()),
+                    ],
+                }),
+                multiview: None,
+                cache: None,
+            });
+            let comp_module = wgsl("wowbg3_fx_comp", &format!("{WGSL_INVERSE}\n{WGSL_COMP}"));
+            let comp_layout = layout(&[&chain_bgl, &table_bgl, &comp_bgl]);
+            Base {
+                arena,
+                dummy_buf,
+                dummy_sampler,
+                linear_clamp,
+                neutral,
+                light3d,
+                storage_dummy: HashMap::new(),
+                params,
+                table,
+                chain_bgl,
+                table_bgl,
+                prep_bgl,
+                comp_bgl,
+                table_pipeline,
+                prep_pipeline,
+                comp_layout,
+                comp_module,
+            }
+        })
+    }
+}
+
+const PARAMS_BYTES: u64 = 96;
+
+impl FxGpu {
+    fn log_once(&mut self, msg: String) {
+        if self.logged.len() < 4096 && self.logged.insert(msg.clone()) {
+            warn!("wowbg3 fx: {msg}");
+        }
+    }
+
+    fn module(&mut self, dev: &wgpu::Device, key: u64, m: &SpvModule, flip: bool) -> Result<wgpu::ShaderModule, String> {
+        if let Some(slot) = self.modules.get(&(key, flip)) {
+            return slot.clone().ok_or_else(|| format!("module {key:016x} failed before"));
+        }
+        let words: &[u32] = if flip {
+            match &m.flipped {
+                Ok(w) => w,
+                Err(e) => {
+                    self.modules.insert((key, flip), None);
+                    return Err(format!("module {key:016x}: cannot flip Y ({e})"));
+                }
+            }
+        } else {
+            &m.words
+        };
+        let label = format!("bg3 {key:016x}");
+        // SAFETY: BG3's own SPIR-V, as BG3 hands it to Vulkan (Y flip aside); the pipeline
+        // layout mirrors BG3's set layouts binding for binding.
+        let made = scoped(dev, || unsafe {
+            dev.create_shader_module_passthrough(wgpu::ShaderModuleDescriptorPassthrough {
+                label: Some(&label),
+                spirv: Some(std::borrow::Cow::Borrowed(words)),
+                ..Default::default()
+            })
+        });
+        match made {
+            Ok(module) => {
+                self.modules.insert((key, flip), Some(module.clone()));
+                Ok(module)
+            }
+            Err(e) => {
+                self.modules.insert((key, flip), None);
+                Err(format!("module {key:016x}: {e}"))
+            }
+        }
+    }
+
+    fn bgl(&mut self, dev: &wgpu::Device, key: &BglKey) -> Result<wgpu::BindGroupLayout, String> {
+        if let Some(slot) = self.bgls.get(key) {
+            return slot.clone().ok_or_else(|| "bind group layout failed before".to_string());
+        }
+        let entries: Vec<wgpu::BindGroupLayoutEntry> = key
+            .iter()
+            .map(|&(binding, kind, vis)| {
+                let ty = match kind {
+                    Kind::Ubo => wgpu::BindingType::Buffer {
+                        ty: wgpu::BufferBindingType::Uniform,
+                        has_dynamic_offset: false,
+                        min_binding_size: None,
+                    },
+                    // Read-only for wgpu's usage tracking (one arena buffer serves every use);
+                    // Vulkan sees a plain STORAGE_BUFFER either way.
+                    Kind::Ssbo => wgpu::BindingType::Buffer {
+                        ty: wgpu::BufferBindingType::Storage { read_only: true },
+                        has_dynamic_offset: false,
+                        min_binding_size: None,
+                    },
+                    Kind::Sampler(true) => wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Comparison),
+                    Kind::Sampler(false) | Kind::Dummy => wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                    Kind::Tex { dim, scalar } => tex_ty(
+                        dim,
+                        match scalar {
+                            // Unfilterable takes every float format and depth; passthrough
+                            // pipelines are not checked for sampler pairing.
+                            Scalar::Float => UNFILTERABLE,
+                            Scalar::Uint => wgpu::TextureSampleType::Uint,
+                            Scalar::Sint => wgpu::TextureSampleType::Sint,
+                        },
+                    ),
+                    Kind::Storage { format, dim } => wgpu::BindingType::StorageTexture {
+                        access: wgpu::StorageTextureAccess::ReadOnly,
+                        format,
+                        view_dimension: dim,
+                    },
+                };
+                bgl_entry(binding, ty, vis)
+            })
+            .collect();
+        let made = scoped(dev, || {
+            dev.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor { label: Some("bg3 set"), entries: &entries })
+        });
+        self.bgls.insert(key.clone(), made.as_ref().ok().cloned());
+        made
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn build_pipe(
+        &mut self,
+        dev: &wgpu::Device,
+        key: PipeKey,
+        r: &Recipe,
+        vs: (u64, &SpvModule, &str),
+        fs: (u64, &SpvModule, &str),
+    ) -> Result<Pipe, String> {
+        let features = dev.features();
+        let limits = dev.limits();
+        // Bind group layouts: BG3's set layouts, dense (gaps get a dummy sampler).
+        let refl = [&vs.1.info, &fs.1.info];
+        let mut sampler_i = 0u32;
+        let mut keys = Vec::new();
+        for (si, slots) in r.sets.iter().enumerate() {
+            let max = slots.iter().map(|s| s.binding).max();
+            if max.is_some_and(|m| m >= 1000) {
+                return Err(format!("set {si}: binding {} too high", max.unwrap_or(0)));
+            }
+            let mut key_set: BglKey = Vec::new();
+            for b in 0..max.map_or(0, |m| m + 1) {
+                let found: Vec<_> = slots.iter().filter(|s| s.binding == b).collect();
+                let Some(slot) = found.first() else {
+                    key_set.push((b, Kind::Dummy, wgpu::ShaderStages::VERTEX_FRAGMENT));
+                    continue;
+                };
+                if found.len() > 1 {
+                    return Err(format!("set {si} binding {b} declared twice"));
+                }
+                if slot.count != 1 {
+                    return Err(format!("set {si} binding {b}: descriptor array of {}", slot.count));
+                }
+                let sb = refl.iter().find_map(|i| i.bindings.get(&(si as u32, b)).copied());
+                let kind = match slot.ty {
+                    6 | 8 => Kind::Ubo,
+                    7 | 9 => Kind::Ssbo,
+                    0 => {
+                        let cmp = sampler_i < 64 && key.1 & (1u64 << sampler_i) != 0;
+                        sampler_i += 1;
+                        Kind::Sampler(cmp)
+                    }
+                    2 => match sb {
+                        Some(SpvBind::Image { dim, arrayed, ms: false, storage: false, scalar, .. }) => Kind::Tex {
+                            dim: view_dim(dim, arrayed).ok_or_else(|| format!("set {si} binding {b}: image dim {dim}"))?,
+                            scalar,
+                        },
+                        None => Kind::Tex { dim: wgpu::TextureViewDimension::D2, scalar: Scalar::Float },
+                        Some(other) => return Err(format!("set {si} binding {b}: sampled image declared as {other:?}")),
+                    },
+                    3 => match sb {
+                        Some(SpvBind::Image { dim, arrayed, ms: false, format, .. }) => Kind::Storage {
+                            format: spv_storage_format(format)
+                                .ok_or_else(|| format!("set {si} binding {b}: storage format {format}"))?,
+                            dim: view_dim(dim, arrayed).ok_or_else(|| format!("set {si} binding {b}: image dim {dim}"))?,
+                        },
+                        None => Kind::Storage {
+                            format: wgpu::TextureFormat::R32Float,
+                            dim: wgpu::TextureViewDimension::D2,
+                        },
+                        Some(other) => return Err(format!("set {si} binding {b}: storage image declared as {other:?}")),
+                    },
+                    t => return Err(format!("set {si} binding {b}: descriptor type {t} not supported")),
+                };
+                key_set.push((b, kind, visibility(slot.stages)));
+            }
+            keys.push(key_set);
+        }
+        let mut bgls = Vec::new();
+        for k in &keys {
+            bgls.push((self.bgl(dev, k)?, k.clone()));
+        }
+        // Push constants: one range over the union of the stages.
+        let push = if r.push.is_empty() {
+            None
+        } else {
+            let end = r.push.iter().map(|p| p.1 + p.2).max().unwrap_or(0).next_multiple_of(4);
+            let stages = r.push.iter().fold(wgpu::ShaderStages::NONE, |v, p| v | visibility(p.0));
+            if !features.contains(wgpu::Features::PUSH_CONSTANTS) || end > limits.max_push_constant_size {
+                return Err(format!("push constants of {end} bytes not available"));
+            }
+            Some((stages, end))
+        };
+        let layout = {
+            let refs: Vec<&wgpu::BindGroupLayout> = bgls.iter().map(|b| &b.0).collect();
+            let ranges: Vec<wgpu::PushConstantRange> =
+                push.iter().map(|&(stages, end)| wgpu::PushConstantRange { stages, range: 0..end }).collect();
+            scoped(dev, || {
+                dev.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+                    label: Some("bg3 layout"),
+                    bind_group_layouts: &refs,
+                    push_constant_ranges: &ranges,
+                })
+            })?
+        };
+        // Vertex input, compacted: slots in the recipe's binding order, bindings without
+        // attributes dropped (wgpu would drop them and shift the rest).
+        let mut slots = Vec::new();
+        let mut attrs: Vec<Vec<wgpu::VertexAttribute>> = Vec::new();
+        for a in &r.attributes {
+            if !r.bindings.iter().any(|b| b.binding == a.binding) {
+                return Err(format!("attribute {} on undeclared binding {}", a.location, a.binding));
+            }
+        }
+        for b in &r.bindings {
+            let mut list = Vec::new();
+            let mut last = 0u64;
+            for a in r.attributes.iter().filter(|a| a.binding == b.binding) {
+                let format = vk_vertex_format(a.format).ok_or_else(|| format!("vertex format {}", a.format))?;
+                last = last.max(a.offset as u64 + format.size());
+                list.push(wgpu::VertexAttribute { format, offset: a.offset as u64, shader_location: a.location });
+            }
+            if list.is_empty() {
+                continue;
+            }
+            if b.stride % 4 != 0 || b.stride > limits.max_vertex_buffer_array_stride {
+                return Err(format!("vertex stride {}", b.stride));
+            }
+            slots.push(VbSlot { binding: b.binding, stride: b.stride as u64, last_stride: last, instance: b.rate == 1 });
+            attrs.push(list);
+        }
+        if slots.len() > limits.max_vertex_buffers as usize {
+            return Err(format!("{} vertex buffers", slots.len()));
+        }
+        let layouts: Vec<wgpu::VertexBufferLayout> = slots
+            .iter()
+            .zip(&attrs)
+            .map(|(s, a)| wgpu::VertexBufferLayout {
+                array_stride: s.stride,
+                step_mode: if s.instance { wgpu::VertexStepMode::Instance } else { wgpu::VertexStepMode::Vertex },
+                attributes: a,
+            })
+            .collect();
+        // Fixed function.
+        let c = r.color.first().ok_or("no colour attachment")?;
+        let blend = if c.blend {
+            let comp = |src: u32, dst: u32, op: u32| -> Result<wgpu::BlendComponent, String> {
+                let operation = vk_blend_op(op).ok_or_else(|| format!("blend op {op}"))?;
+                let (mut s, mut d) = (
+                    vk_blend_factor(src).ok_or_else(|| format!("blend factor {src}"))?,
+                    vk_blend_factor(dst).ok_or_else(|| format!("blend factor {dst}"))?,
+                );
+                if matches!(operation, wgpu::BlendOperation::Min | wgpu::BlendOperation::Max) {
+                    (s, d) = (wgpu::BlendFactor::One, wgpu::BlendFactor::One);
+                }
+                if (s.ref_second_blend_source() || d.ref_second_blend_source())
+                    && !features.contains(wgpu::Features::DUAL_SOURCE_BLENDING)
+                {
+                    return Err("dual-source blending not available".into());
+                }
+                Ok(wgpu::BlendComponent { src_factor: s, dst_factor: d, operation })
+            };
+            Some(wgpu::BlendState { color: comp(c.src_c, c.dst_c, c.op_c)?, alpha: comp(c.src_a, c.dst_a, c.op_a)? })
+        } else {
+            None
+        };
+        // BG3's target has no alpha: ours stays at 1, so DST_ALPHA reads 1 as in BG3.
+        let write_mask = wgpu::ColorWrites::from_bits_truncate(c.mask & 7);
+        let topology = vk_topology(r.topology).ok_or_else(|| format!("topology {}", r.topology))?;
+        if r.polygon != 0 {
+            return Err(format!("polygon mode {}", r.polygon));
+        }
+        let cull_mode = match r.cull {
+            0 => None,
+            1 => Some(wgpu::Face::Front),
+            2 => Some(wgpu::Face::Back),
+            m => return Err(format!("cull mode {m}")),
+        };
+        // The Y flip keeps framebuffer positions, so BG3's winding holds.
+        let front_face = if r.front == 1 { wgpu::FrontFace::Cw } else { wgpu::FrontFace::Ccw };
+        let depth_stencil = wgpu::DepthStencilState {
+            format: DEPTH_FMT,
+            depth_write_enabled: false,
+            depth_compare: if r.depth_test != 0 { vk_compare(r.depth_compare) } else { wgpu::CompareFunction::Always },
+            stencil: wgpu::StencilState::default(),
+            bias: if r.bias_enable != 0 {
+                wgpu::DepthBiasState {
+                    constant: r.bias_constant.round() as i32,
+                    slope_scale: r.bias_slope,
+                    clamp: r.bias_clamp,
+                }
+            } else {
+                wgpu::DepthBiasState::default()
+            },
+        };
+        let vs_mod = self.module(dev, vs.0, vs.1, true)?;
+        let fs_mod = self.module(dev, fs.0, fs.1, false)?;
+        let targets = [Some(wgpu::ColorTargetState { format: COLOR_FMT, blend, write_mask })];
+        let label = format!("bg3 pipe {:016x}", key.0);
+        let pipeline = scoped(dev, || {
+            dev.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some(&label),
+                layout: Some(&layout),
+                vertex: wgpu::VertexState {
+                    module: &vs_mod,
+                    entry_point: Some(vs.2),
+                    compilation_options: Default::default(),
+                    buffers: &layouts,
+                },
+                primitive: wgpu::PrimitiveState {
+                    topology,
+                    strip_index_format: key.2,
+                    front_face,
+                    cull_mode,
+                    unclipped_depth: false,
+                    polygon_mode: wgpu::PolygonMode::Fill,
+                    conservative: false,
+                },
+                depth_stencil: Some(depth_stencil),
+                multisample: wgpu::MultisampleState::default(),
+                fragment: Some(wgpu::FragmentState {
+                    module: &fs_mod,
+                    entry_point: Some(fs.2),
+                    compilation_options: Default::default(),
+                    targets: &targets,
+                }),
+                multiview: None,
+                cache: None,
+            })
+        })?;
+        Ok(Pipe { pipeline, bgls, slots, push })
+    }
+
+    fn sampler(&mut self, dev: &wgpu::Device, key: u64, s: &FxSampler) -> Option<wgpu::Sampler> {
+        if let Some(slot) = self.samplers.get(&key) {
+            return slot.clone();
+        }
+        let border_ok = dev.features().contains(wgpu::Features::ADDRESS_MODE_CLAMP_TO_BORDER);
+        let address = |m: u32| match m {
+            0 => wgpu::AddressMode::Repeat,
+            1 => wgpu::AddressMode::MirrorRepeat,
+            3 if border_ok => wgpu::AddressMode::ClampToBorder,
+            _ => wgpu::AddressMode::ClampToEdge,
+        };
+        let filter = |f: u32| if f == 0 { wgpu::FilterMode::Nearest } else { wgpu::FilterMode::Linear };
+        let (mag, min, mip) = (filter(s.mag), filter(s.min), filter(s.mip));
+        let all_linear = [mag, min, mip].iter().all(|f| *f == wgpu::FilterMode::Linear);
+        let lod_min = if s.min_lod.is_finite() { s.min_lod.max(0.0) } else { 0.0 };
+        let lod_max = if s.max_lod.is_finite() { s.max_lod.max(lod_min) } else { 32.0 };
+        let modes = [address(s.address[0]), address(s.address[1]), address(s.address[2])];
+        let desc = wgpu::SamplerDescriptor {
+            label: Some("bg3 sampler"),
+            address_mode_u: modes[0],
+            address_mode_v: modes[1],
+            address_mode_w: modes[2],
+            mag_filter: mag,
+            min_filter: min,
+            mipmap_filter: mip,
+            lod_min_clamp: lod_min,
+            lod_max_clamp: lod_max,
+            compare: s.compare.then(|| vk_compare(s.compare_op)),
+            anisotropy_clamp: if s.aniso && all_linear { (s.max_aniso.round() as u16).clamp(1, 16) } else { 1 },
+            border_color: modes.contains(&wgpu::AddressMode::ClampToBorder).then_some(match s.border {
+                2 | 3 => wgpu::SamplerBorderColor::OpaqueBlack,
+                4 | 5 => wgpu::SamplerBorderColor::OpaqueWhite,
+                _ => wgpu::SamplerBorderColor::TransparentBlack,
+            }),
+        };
+        let made = scoped(dev, || dev.create_sampler(&desc));
+        if let Err(e) = &made {
+            self.log_once(format!("sampler {key:016x}: {e}"));
+        }
+        let out = made.ok();
+        self.samplers.insert(key, out.clone());
+        out
+    }
+
+    fn texture(&mut self, dev: &wgpu::Device, queue: &wgpu::Queue, key: u64, t: &TexFile) -> bool {
+        if let Some(slot) = self.textures.get(&key) {
+            return slot.is_some();
+        }
+        let made = upload_texture(dev, queue, key, t);
+        if let Err(e) = &made {
+            self.log_once(format!("texture {key:016x}: {e}"));
+        }
+        let ok = made.is_ok();
+        self.textures.insert(key, made.ok());
+        ok
+    }
+
+    /// A view of a loaded texture in the dimension a binding wants; `None` when it cannot be.
+    fn texture_view(&mut self, dev: &wgpu::Device, key: u64, dim: wgpu::TextureViewDimension) -> Option<wgpu::TextureView> {
+        use wgpu::TextureViewDimension as D;
+        let g = self.textures.get_mut(&key)?.as_mut()?;
+        if let Some(v) = g.views.get(&dim) {
+            return v.clone();
+        }
+        let square = g.width == g.height;
+        let (fits, layers) = match dim {
+            D::D2 => (g.dim == wgpu::TextureDimension::D2, Some(1)),
+            D::D2Array => (g.dim == wgpu::TextureDimension::D2, None),
+            D::Cube => (g.dim == wgpu::TextureDimension::D2 && g.layers >= 6 && square, Some(6)),
+            D::CubeArray => (g.dim == wgpu::TextureDimension::D2 && g.layers >= 6 && g.layers % 6 == 0 && square, None),
+            D::D3 => (g.dim == wgpu::TextureDimension::D3, None),
+            D::D1 => (false, None),
+        };
+        let view = if fits {
+            let tex = &g.tex;
+            scoped(dev, || {
+                tex.create_view(&wgpu::TextureViewDescriptor {
+                    dimension: Some(dim),
+                    array_layer_count: layers,
+                    ..Default::default()
+                })
+            })
+            .ok()
+        } else {
+            None
+        };
+        g.views.insert(dim, view.clone());
+        view
+    }
+
+    fn storage_dummy(&mut self, dev: &wgpu::Device, format: wgpu::TextureFormat, dim: wgpu::TextureViewDimension) -> Option<wgpu::TextureView> {
+        let base = self.base.as_mut()?;
+        if let Some(v) = base.storage_dummy.get(&(format, dim)) {
+            return v.clone();
+        }
+        let tdim = match dim {
+            wgpu::TextureViewDimension::D3 => wgpu::TextureDimension::D3,
+            wgpu::TextureViewDimension::D1 => wgpu::TextureDimension::D1,
+            _ => wgpu::TextureDimension::D2,
+        };
+        let made = scoped(dev, || {
+            let t = dev.create_texture(&tex_desc(
+                "wowbg3_fx_storage_dummy",
+                wgpu::Extent3d { width: 1, height: 1, depth_or_array_layers: 1 },
+                tdim,
+                format,
+                wgpu::TextureUsages::STORAGE_BINDING | wgpu::TextureUsages::TEXTURE_BINDING,
+            ));
+            t.create_view(&wgpu::TextureViewDescriptor { dimension: Some(dim), ..Default::default() })
+        })
+        .ok();
+        base.storage_dummy.insert((format, dim), made.clone());
+        made
+    }
+
+    /// The view a texture binding gets for a key (specials 1 to 5 included).
+    fn image_for(
+        &mut self,
+        dev: &wgpu::Device,
+        queue: &wgpu::Queue,
+        set: &FxFrameSet,
+        key: u64,
+        kind: Kind,
+    ) -> Result<wgpu::TextureView, Skip> {
+        let (Some(base), Some(t)) = (self.base.as_ref(), self.targets.as_ref()) else { return Err(Skip::Silent) };
+        match kind {
+            Kind::Tex { dim, scalar } => {
+                let neutral = base.neutral.get(&(dim, scalar)).cloned().ok_or(Skip::Silent)?;
+                let plain = dim == wgpu::TextureViewDimension::D2 && scalar == Scalar::Float;
+                let grid = dim == wgpu::TextureViewDimension::D3 && scalar == Scalar::Float;
+                match key {
+                    // 3: BG3's fog volume, none (no in-scattering, full transmittance).
+                    0 | 3 => Ok(neutral),
+                    1 if plain => Ok(t.depth.clone()),
+                    2 if plain => Ok(t.scene.clone()),
+                    4 if plain => Ok(t.lin_a.clone()),
+                    5 if grid => Ok(base.light3d.clone()),
+                    1..=5 => Ok(neutral),
+                    k => {
+                        let Some(file) = set.textures.get(&k) else { return Err(Skip::Pending) };
+                        if !self.texture(dev, queue, k, file) {
+                            return Err(Skip::Once(format!("texture {k:016x} unusable (drawn without it)")));
+                        }
+                        let fmt = self.textures.get(&k).and_then(|g| g.as_ref()).map(|g| g.format);
+                        let kind_ok = match (fmt.and_then(|f| f.sample_type(None, Some(dev.features()))), scalar) {
+                            (Some(wgpu::TextureSampleType::Float { .. } | wgpu::TextureSampleType::Depth), Scalar::Float) => true,
+                            (Some(wgpu::TextureSampleType::Uint), Scalar::Uint) => true,
+                            (Some(wgpu::TextureSampleType::Sint), Scalar::Sint) => true,
+                            _ => false,
+                        };
+                        match self.texture_view(dev, k, dim).filter(|_| kind_ok) {
+                            Some(v) => Ok(v),
+                            None => {
+                                self.log_once(format!("texture {k:016x} does not fit a {dim:?} {scalar:?} binding: neutral"));
+                                Ok(self.base.as_ref().and_then(|b| b.neutral.get(&(dim, scalar)).cloned()).ok_or(Skip::Silent)?)
+                            }
+                        }
+                    }
+                }
+            }
+            Kind::Storage { format, dim } => {
+                if key == 4 && format == wgpu::TextureFormat::R32Float && dim == wgpu::TextureViewDimension::D2 {
+                    return Ok(t.lin_b.clone());
+                }
+                self.storage_dummy(dev, format, dim)
+                    .ok_or_else(|| Skip::Once(format!("no storage image of {format:?} {dim:?}")))
+            }
+            _ => Err(Skip::Silent),
+        }
+    }
+
+    fn prepare_draw(
+        &mut self,
+        dev: &wgpu::Device,
+        queue: &wgpu::Queue,
+        set: &FxFrameSet,
+        d: &FxDraw,
+        arena_len: u64,
+    ) -> Result<PreparedDraw, Skip> {
+        let pipe_name = format!("pipe {:016x}", d.pipe);
+        let Some(r) = set.recipes.get(&d.pipe) else { return Err(Skip::Once(format!("{pipe_name}: no recipe"))) };
+        if d.count == 0 || d.instances == 0 || r.cull == 3 {
+            return Err(Skip::Silent);
+        }
+        if self.cfg.skip.contains(&d.pipe) || (!self.cfg.only.is_empty() && !self.cfg.only.contains(&d.pipe)) {
+            return Err(Skip::Silent);
+        }
+        let stage = |bit: u32| r.stages.iter().find(|s| s.stage == bit);
+        if r.stages.iter().any(|s| s.stage != 1 && s.stage != 0x10) {
+            return Err(Skip::Once(format!("{pipe_name}: stages other than vertex and fragment")));
+        }
+        let (Some(vs), Some(fs)) = (stage(1), stage(0x10)) else {
+            return Err(Skip::Once(format!("{pipe_name}: needs a vertex and a fragment stage")));
+        };
+        let (Some(vm), Some(fm)) = (set.spv.get(&vs.spv), set.spv.get(&fs.spv)) else {
+            return Err(Skip::Once(format!("{pipe_name}: SPIR-V missing")));
+        };
+        let blob_len = set.frame.blob.len() as u64;
+        let slot_of = |s: u32, b: u32| {
+            d.sets.iter().find(|x| x.set == s).and_then(|x| x.slots.iter().find(|y| y.binding == b)).map(|y| y.res)
+        };
+        // Comparison samplers (by the bound sampler) decide the pipeline variant.
+        let mut mask = 0u64;
+        let mut i = 0u32;
+        for (si, slots) in r.sets.iter().enumerate() {
+            for b in 0..slots.iter().map(|s| s.binding + 1).max().unwrap_or(0) {
+                let Some(slot) = slots.iter().find(|s| s.binding == b) else { continue };
+                if slot.ty != 0 {
+                    continue;
+                }
+                let Some(SlotRes::Sampler(k)) = slot_of(si as u32, b) else {
+                    return Err(Skip::Once(format!("{pipe_name}: set {si} binding {b} has no sampler")));
+                };
+                let Some(s) = set.samplers.get(&k) else { return Err(Skip::Pending) };
+                if s.compare && i < 64 {
+                    mask |= 1u64 << i;
+                }
+                i += 1;
+            }
+        }
+        let index_fmt = match d.index_type {
+            1 => Some(wgpu::IndexFormat::Uint16),
+            2 => Some(wgpu::IndexFormat::Uint32),
+            _ => None,
+        };
+        let strip = (matches!(r.topology, 2 | 4) && r.restart != 0).then_some(index_fmt).flatten();
+        let key: PipeKey = (d.pipe, mask, strip);
+        let pipe = match self.pipes.get(&key) {
+            Some(Some(p)) => p.clone(),
+            Some(None) => return Err(Skip::Silent),
+            None => {
+                let built = self.build_pipe(dev, key, r, (vs.spv, &**vm, vs.entry.as_str()), (fs.spv, &**fm, fs.entry.as_str()));
+                match built {
+                    Ok(p) => {
+                        let p = Arc::new(p);
+                        self.pipes.insert(key, Some(p.clone()));
+                        info!("wowbg3 fx: built {pipe_name} ({} sets, {} vertex buffers)", p.bgls.len(), p.slots.len());
+                        p
+                    }
+                    Err(e) => {
+                        self.pipes.insert(key, None);
+                        return Err(Skip::Once(format!("{pipe_name}: {e} (skipped from now on)")));
+                    }
+                }
+            }
+        };
+        // Bind groups, one per set, every binding filled.
+        let limits = dev.limits();
+        let mut groups = Vec::with_capacity(pipe.bgls.len());
+        for (si, (layout, keys)) in pipe.bgls.iter().enumerate() {
+            enum Bound {
+                Buf(wgpu::Buffer, u64, u64),
+                Sampler(wgpu::Sampler),
+                View(wgpu::TextureView),
+            }
+            let mut bound = Vec::with_capacity(keys.len());
+            for &(b, kind, _) in keys {
+                let res = if kind == Kind::Dummy { None } else { slot_of(si as u32, b) };
+                let base = self.base.as_ref().ok_or(Skip::Silent)?;
+                let entry = match (kind, res) {
+                    (Kind::Dummy, _) => Bound::Sampler(base.dummy_sampler.clone()),
+                    (Kind::Ubo | Kind::Ssbo, Some(SlotRes::Buffer { blob, size })) => {
+                        let (blob, size) = (blob as u64, size as u64);
+                        if size == 0 {
+                            Bound::Buf(base.dummy_buf.clone(), 0, 256)
+                        } else {
+                            let (align, max) = if kind == Kind::Ubo {
+                                (limits.min_uniform_buffer_offset_alignment, limits.max_uniform_buffer_binding_size)
+                            } else {
+                                (limits.min_storage_buffer_offset_alignment, limits.max_storage_buffer_binding_size)
+                            };
+                            if blob % align as u64 != 0 || blob + size > blob_len {
+                                return Err(Skip::Once(format!("{pipe_name}: set {si} binding {b} buffer range {blob}+{size}")));
+                            }
+                            let size = size.next_multiple_of(4).min(max as u64).min(arena_len - blob);
+                            Bound::Buf(base.arena.clone(), blob, size)
+                        }
+                    }
+                    (Kind::Sampler(_), Some(SlotRes::Sampler(k))) => {
+                        let Some(s) = set.samplers.get(&k) else { return Err(Skip::Pending) };
+                        let s = **s;
+                        match self.sampler(dev, k, &s) {
+                            Some(x) => Bound::Sampler(x),
+                            None => return Err(Skip::Once(format!("{pipe_name}: sampler {k:016x} unusable"))),
+                        }
+                    }
+                    (Kind::Tex { .. } | Kind::Storage { .. }, Some(SlotRes::Image(k))) => {
+                        Bound::View(self.image_for(dev, queue, set, k, kind)?)
+                    }
+                    (k, res) => {
+                        return Err(Skip::Once(format!("{pipe_name}: set {si} binding {b}: {k:?} bound to {res:?}")));
+                    }
+                };
+                bound.push((b, entry));
+            }
+            let entries: Vec<wgpu::BindGroupEntry> = bound
+                .iter()
+                .map(|(b, e)| wgpu::BindGroupEntry {
+                    binding: *b,
+                    resource: match e {
+                        Bound::Buf(buf, off, size) => wgpu::BindingResource::Buffer(wgpu::BufferBinding {
+                            buffer: buf,
+                            offset: *off,
+                            size: NonZeroU64::new(*size),
+                        }),
+                        Bound::Sampler(s) => wgpu::BindingResource::Sampler(s),
+                        Bound::View(v) => wgpu::BindingResource::TextureView(v),
+                    },
+                })
+                .collect();
+            let group = scoped(dev, || {
+                dev.create_bind_group(&wgpu::BindGroupDescriptor { label: Some("bg3 group"), layout, entries: &entries })
+            })
+            .map_err(|e| Skip::Once(format!("{pipe_name}: set {si}: {e}")))?;
+            groups.push(group);
+        }
+        // Vertex and index buffers, checked as wgpu checks them.
+        let mut vbs = Vec::with_capacity(pipe.slots.len());
+        for s in &pipe.slots {
+            let Some(vb) = d.vbs.iter().find(|v| v.binding == s.binding) else {
+                return Err(Skip::Once(format!("{pipe_name}: vertex binding {} not bound", s.binding)));
+            };
+            let (off, size) = (vb.blob as u64, vb.size as u64);
+            if size == 0 || off % 4 != 0 || off + size > blob_len {
+                return Err(Skip::Once(format!("{pipe_name}: vertex binding {} range {off}+{size}", s.binding)));
+            }
+            vbs.push((off, size));
+        }
+        let sizes: Vec<u64> = vbs.iter().map(|v| v.1).collect();
+        let (vlimit, ilimit) = vertex_limits(&pipe.slots, &sizes);
+        if d.first_instance as u64 + d.instances as u64 > ilimit {
+            return Err(Skip::Once(format!("{pipe_name}: instances past the instance buffers")));
+        }
+        let index = if d.indexed {
+            let Some(fmt) = index_fmt else { return Err(Skip::Once(format!("{pipe_name}: index type {}", d.index_type))) };
+            let isz = if fmt == wgpu::IndexFormat::Uint16 { 2 } else { 4 };
+            let (off, size) = (d.index_blob as u64, d.index_size as u64);
+            if size == 0 || off % isz != 0 || off + size > blob_len || (d.first as u64 + d.count as u64) * isz > size {
+                return Err(Skip::Once(format!("{pipe_name}: index range {off}+{size} for {}+{}", d.first, d.count)));
+            }
+            Some((off, size, fmt))
+        } else {
+            if d.first as u64 + d.count as u64 > vlimit {
+                return Err(Skip::Once(format!("{pipe_name}: vertices past the vertex buffers")));
+            }
+            None
+        };
+        let push = pipe.push.map(|(stages, size)| {
+            let mut data = d.push.clone();
+            data.resize(size as usize, 0);
+            (stages, data)
+        });
+        Ok(PreparedDraw {
+            pipeline: pipe.pipeline.clone(),
+            groups,
+            vbs,
+            index,
+            count: d.count,
+            instances: d.instances,
+            first: d.first,
+            base_vertex: d.vertex_offset,
+            first_instance: d.first_instance,
+            push,
+        })
+    }
+
+    fn ensure_targets(&mut self, dev: &wgpu::Device, w: u32, h: u32) -> bool {
+        if self.targets.as_ref().is_some_and(|t| t.size == (w, h)) {
+            return true;
+        }
+        let size = wgpu::Extent3d { width: w, height: h, depth_or_array_layers: 1 };
+        let ra = wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::TEXTURE_BINDING;
+        let d2 = wgpu::TextureDimension::D2;
+        let made = scoped(dev, || {
+            let mk = |label, format, usage| plain_view(&dev.create_texture(&tex_desc(label, size, d2, format, usage)));
+            Targets {
+                size: (w, h),
+                depth: mk("wowbg3_fx_depth", DEPTH_FMT, ra),
+                lin_a: mk("wowbg3_fx_lin", wgpu::TextureFormat::R32Float, ra),
+                lin_b: mk("wowbg3_fx_lin_storage", wgpu::TextureFormat::R32Float, ra | wgpu::TextureUsages::STORAGE_BINDING),
+                scene: mk("wowbg3_fx_scene", COLOR_FMT, ra),
+                c: mk("wowbg3_fx_over_black", COLOR_FMT, ra),
+                w: mk("wowbg3_fx_over_white", COLOR_FMT, ra),
+            }
+        });
+        match made {
+            Ok(t) => {
+                self.targets = Some(t);
+                true
+            }
+            Err(e) => {
+                self.log_once(format!("targets {w}x{h}: {e}"));
+                false
+            }
+        }
+    }
+
+    fn composite(&mut self, dev: &wgpu::Device, format: wgpu::TextureFormat) -> Option<wgpu::RenderPipeline> {
+        if let Some(p) = self.composites.get(&format) {
+            return p.clone();
+        }
+        let base = self.base.as_ref()?;
+        let made = scoped(dev, || {
+            dev.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+                label: Some("wowbg3_fx_composite"),
+                layout: Some(&base.comp_layout),
+                vertex: wgpu::VertexState {
+                    module: &base.comp_module,
+                    entry_point: Some("vs"),
+                    compilation_options: Default::default(),
+                    buffers: &[],
+                },
+                primitive: wgpu::PrimitiveState::default(),
+                depth_stencil: None,
+                multisample: wgpu::MultisampleState::default(),
+                fragment: Some(wgpu::FragmentState {
+                    module: &base.comp_module,
+                    entry_point: Some("fs_comp"),
+                    compilation_options: Default::default(),
+                    targets: &[Some(format.into())],
+                }),
+                multiview: None,
+                cache: None,
+            })
+        });
+        if let Err(e) = &made {
+            self.log_once(format!("composite for {format:?}: {e}"));
+        }
+        let p = made.ok();
+        self.composites.insert(format, p.clone());
+        p
+    }
+
+    /// BG3's grading and display LUTs as views, when the post block names usable ones.
+    fn luts(&mut self, dev: &wgpu::Device, queue: &wgpu::Queue, set: &FxFrameSet) -> Option<(wgpu::TextureView, wgpu::TextureView)> {
+        let post = set.frame.post.filter(|p| p.have & 24 == 24)?;
+        let mut one = |k: u64| -> Option<wgpu::TextureView> {
+            let file = set.textures.get(&k)?;
+            if !self.texture(dev, queue, k, file) {
+                return None;
+            }
+            let g = self.textures.get(&k)?.as_ref()?;
+            let filterable = g.format.guaranteed_format_features(dev.features()).flags.contains(wgpu::TextureFormatFeatureFlags::FILTERABLE);
+            if !filterable {
+                return None;
+            }
+            self.texture_view(dev, k, wgpu::TextureViewDimension::D3)
+        };
+        Some((one(post.grade_lut)?, one(post.display_lut)?))
+    }
+
+    /// Rebuilds the frame's GPU state: arena, targets, draws, the composite's bind groups.
+    fn rebuild(&mut self, dev: &wgpu::Device, queue: &wgpu::Queue, set: &FxFrameSet, format: wgpu::TextureFormat) -> Option<Ready> {
+        let (w, h) = (set.frame.width, set.frame.height);
+        if !self.ensure_targets(dev, w, h) {
+            return None;
+        }
+        // The blob area into the arena (grown as needed).
+        let blob = &set.frame.blob;
+        let need = (blob.len() as u64 + 256).next_multiple_of(256);
+        let max = dev.limits().max_buffer_size;
+        if need > max {
+            self.log_once(format!("frame blob of {} bytes too large", blob.len()));
+            return None;
+        }
+        {
+            let base = self.base.as_mut()?;
+            if base.arena.size() < need {
+                let size = need.next_power_of_two().min(max);
+                match scoped(dev, || {
+                    dev.create_buffer(&wgpu::BufferDescriptor {
+                        label: Some("wowbg3_fx_arena"),
+                        size,
+                        usage: wgpu::BufferUsages::VERTEX
+                            | wgpu::BufferUsages::INDEX
+                            | wgpu::BufferUsages::UNIFORM
+                            | wgpu::BufferUsages::STORAGE
+                            | wgpu::BufferUsages::COPY_DST,
+                        mapped_at_creation: false,
+                    })
+                }) {
+                    Ok(b) => base.arena = b,
+                    Err(e) => {
+                        warn!("wowbg3 fx: arena of {size} bytes: {e}");
+                        return None;
+                    }
+                }
+            }
+            let whole = blob.len() / 4 * 4;
+            if whole > 0 {
+                queue.write_buffer(&base.arena, 0, &blob[..whole]);
+            }
+            if whole < blob.len() {
+                let mut tail = [0u8; 4];
+                tail[..blob.len() - whole].copy_from_slice(&blob[whole..]);
+                queue.write_buffer(&base.arena, whole as u64, &tail);
+            }
+        }
+        let arena_len = self.base.as_ref()?.arena.size();
+        let mut draws = Vec::with_capacity(set.frame.draws.len());
+        let mut skipped = 0;
+        for d in &set.frame.draws {
+            match self.prepare_draw(dev, queue, set, d, arena_len) {
+                Ok(p) => draws.push(p),
+                Err(Skip::Once(m)) => {
+                    skipped += 1;
+                    self.log_once(m);
+                }
+                Err(Skip::Pending | Skip::Silent) => skipped += 1,
+            }
+        }
+        self.last_counts = (draws.len(), skipped);
+        let luts = self.luts(dev, queue, set);
+        self.mode = if luts.is_some() { 1.0 } else { 0.0 };
+        if luts.is_none() && set.frame.post.is_some() {
+            self.log_once("BG3's grading or display LUT unusable: plain sRGB composite".to_string());
+        }
+        let composite = self.composite(dev, format)?;
+        let base = self.base.as_ref()?;
+        let t = self.targets.as_ref()?;
+        let (glut, dlut) = luts.unwrap_or_else(|| {
+            let n = base.neutral[&(wgpu::TextureViewDimension::D3, Scalar::Float)].clone();
+            (n.clone(), n)
+        });
+        let groups = scoped(dev, || {
+            let chain_bg = dev.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("wowbg3_fx_chain"),
+                layout: &base.chain_bgl,
+                entries: &[
+                    wgpu::BindGroupEntry { binding: 0, resource: base.params.as_entire_binding() },
+                    wgpu::BindGroupEntry { binding: 1, resource: wgpu::BindingResource::TextureView(&glut) },
+                    wgpu::BindGroupEntry { binding: 2, resource: wgpu::BindingResource::Sampler(&base.linear_clamp) },
+                    wgpu::BindGroupEntry { binding: 3, resource: wgpu::BindingResource::TextureView(&dlut) },
+                    wgpu::BindGroupEntry { binding: 4, resource: wgpu::BindingResource::Sampler(&base.linear_clamp) },
+                ],
+            });
+            let table_bg = dev.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("wowbg3_fx_table"),
+                layout: &base.table_bgl,
+                entries: &[wgpu::BindGroupEntry { binding: 0, resource: wgpu::BindingResource::TextureView(&base.table) }],
+            });
+            (chain_bg, table_bg)
+        });
+        let (chain_bg, table_bg) = match groups {
+            Ok(g) => g,
+            Err(e) => {
+                warn!("wowbg3 fx: composite bind groups: {e}");
+                return None;
+            }
+        };
+        Some(Ready {
+            arena: base.arena.clone(),
+            draws,
+            chain_bg,
+            table_bg,
+            table_view: base.table.clone(),
+            table_pipeline: base.table_pipeline.clone(),
+            prep_pipeline: base.prep_pipeline.clone(),
+            prep_bgl: base.prep_bgl.clone(),
+            comp_bgl: base.comp_bgl.clone(),
+            composite,
+            composite_format: format,
+            depth: t.depth.clone(),
+            lin_a: t.lin_a.clone(),
+            lin_b: t.lin_b.clone(),
+            scene: t.scene.clone(),
+            c: t.c.clone(),
+            w: t.w.clone(),
+        })
+    }
+}
+
+fn upload_texture(dev: &wgpu::Device, queue: &wgpu::Queue, key: u64, t: &TexFile) -> Result<GpuTex, String> {
+    let format = vk_texture_format(t.format).ok_or_else(|| format!("VkFormat {}", t.format))?;
+    if !dev.features().contains(format.required_features()) {
+        return Err(format!("{format:?} needs {:?}", format.required_features()));
+    }
+    if matches!(t.view_type, 0 | 4) {
+        return Err("1D textures are not replayed".into());
+    }
+    let three_d = t.view_type == 2 || t.depth > 1;
+    if three_d && t.layers != 1 {
+        return Err("3D texture with layers".into());
+    }
+    let limits = dev.limits();
+    let maxd = if three_d { limits.max_texture_dimension_3d } else { limits.max_texture_dimension_2d };
+    if t.width > maxd || t.height > maxd || t.depth > maxd || t.layers > limits.max_texture_array_layers {
+        return Err(format!("{}x{}x{}x{} too large", t.width, t.height, t.depth, t.layers));
+    }
+    let (bw, bh) = format.block_dimensions();
+    let bsize = format.block_copy_size(None).ok_or("no block size")? as u64;
+    if t.width % bw != 0 || t.height % bh != 0 {
+        return Err(format!("{}x{} is not whole blocks of {format:?}", t.width, t.height));
+    }
+    let dim = if three_d { wgpu::TextureDimension::D3 } else { wgpu::TextureDimension::D2 };
+    let size = wgpu::Extent3d {
+        width: t.width,
+        height: t.height,
+        depth_or_array_layers: if three_d { t.depth } else { t.layers },
+    };
+    if t.mips > size.max_mips(dim) {
+        return Err(format!("{} mips", t.mips));
+    }
+    // (layer, mip, offset, physical extent, bytes per row, rows)
+    let mut parts = Vec::new();
+    let mut off = 0u64;
+    for layer in 0..t.layers {
+        for mip in 0..t.mips {
+            let mw = (t.width >> mip).max(1);
+            let mh = (t.height >> mip).max(1);
+            let md = if three_d { (t.depth >> mip).max(1) } else { 1 };
+            let (pw, ph) = (mw.next_multiple_of(bw), mh.next_multiple_of(bh));
+            let bpr = (pw / bw) as u64 * bsize;
+            let rows = (ph / bh) as u64;
+            let bytes = bpr * rows * md as u64;
+            parts.push((layer, mip, off, wgpu::Extent3d { width: pw, height: ph, depth_or_array_layers: md }, bpr, rows));
+            off += bytes;
+        }
+    }
+    let data = t.data();
+    if (data.len() as u64) < off {
+        return Err(format!("{} bytes of data, {off} needed", data.len()));
+    }
+    let label = format!("bg3 tex {key:016x}");
+    let tex = scoped(dev, || {
+        let tex = dev.create_texture(&wgpu::TextureDescriptor {
+            label: Some(&label),
+            size,
+            mip_level_count: t.mips,
+            sample_count: 1,
+            dimension: dim,
+            format,
+            usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+            view_formats: &[],
+        });
+        for &(layer, mip, o, extent, bpr, rows) in &parts {
+            let end = o + bpr * rows * extent.depth_or_array_layers as u64;
+            queue.write_texture(
+                wgpu::TexelCopyTextureInfo {
+                    texture: &tex,
+                    mip_level: mip,
+                    origin: wgpu::Origin3d { x: 0, y: 0, z: layer },
+                    aspect: wgpu::TextureAspect::All,
+                },
+                &data[o as usize..end as usize],
+                wgpu::TexelCopyBufferLayout { offset: 0, bytes_per_row: Some(bpr as u32), rows_per_image: Some(rows as u32) },
+                extent,
+            );
+        }
+        tex
+    })?;
+    Ok(GpuTex {
+        dim,
+        width: t.width,
+        height: t.height,
+        layers: t.layers,
+        format,
+        tex,
+        views: HashMap::new(),
+    })
+}
+
+fn prepare_fx(
+    mut gpu: ResMut<FxGpu>,
+    ext: Option<Res<FxExtract>>,
+    device: Res<RenderDevice>,
+    queue: Res<RenderQueue>,
+    views: Query<(&ExtractedView, &ViewTarget), With<FxView>>,
+) {
+    let gpu = &mut *gpu;
+    let set = ext.and_then(|e| e.set.clone());
+    let (Some(set), Ok((view, target))) = (set, views.single()) else {
+        gpu.ready = None;
+        gpu.last = None;
+        return;
+    };
+    let dev = device.wgpu_device();
+    if gpu.base.is_none() {
+        if gpu.base_failed {
+            return;
+        }
+        let f = dev.features();
+        info!(
+            "wowbg3 fx: device has SPIR-V passthrough {}, BC {}, push constants {}, {} bind groups, {} vertex buffers",
+            f.contains(wgpu::Features::EXPERIMENTAL_PASSTHROUGH_SHADERS),
+            f.contains(wgpu::Features::TEXTURE_COMPRESSION_BC),
+            f.contains(wgpu::Features::PUSH_CONSTANTS),
+            dev.limits().max_bind_groups,
+            dev.limits().max_vertex_buffers
+        );
+        if !f.contains(wgpu::Features::EXPERIMENTAL_PASSTHROUGH_SHADERS) {
+            error!("wowbg3 fx: no SPIR-V passthrough on this device; BG3's effects are not replayed");
+            gpu.base_failed = true;
+            return;
+        }
+        match Base::new(dev, &queue, gpu.cfg.light) {
+            Ok(b) => gpu.base = Some(b),
+            Err(e) => {
+                error!("wowbg3 fx: setup failed: {e}");
+                gpu.base_failed = true;
+                return;
+            }
+        }
+    }
+    let format = target.main_texture_format();
+    let fresh = !gpu.last.as_ref().is_some_and(|l| Arc::ptr_eq(l, &set));
+    if fresh {
+        gpu.ready = gpu.rebuild(dev, &queue, &set, format).map(Arc::new);
+        gpu.last = Some(set.clone());
+    }
+    // Per-frame constants (the near plane and depth offset move with WoW's camera).
+    let size = target.main_texture().size();
+    let near = view.clip_from_view.w_axis.z;
+    let (p22, p32, far) = set.frame.view.map_or((-1e-5, 0.1, 10_000.0), |v| (v.p22, v.p32, v.far));
+    let post = set.frame.post;
+    let grade = post.filter(|p| p.have & 8 != 0).map_or([1.0, 0.0, 0.0, 0.0], |p| p.grade);
+    let fade = post.filter(|p| p.have & 16 != 0).map_or(0.0, |p| p.fade);
+    let params: [f32; 24] = [
+        set.frame.width as f32,
+        set.frame.height as f32,
+        size.width as f32,
+        size.height as f32,
+        near,
+        crate::wowbg3_lead::depth_offset(),
+        far,
+        YD,
+        p22,
+        p32,
+        gpu.cfg.slack,
+        0.0,
+        set.exposure,
+        fade,
+        gpu.mode,
+        gpu.cfg.show,
+        grade[0],
+        grade[1],
+        grade[2],
+        grade[3],
+        TABLE_LO,
+        TABLE_HI,
+        TABLE_N as f32,
+        0.0,
+    ];
+    if let Some(base) = gpu.base.as_ref() {
+        queue.write_buffer(&base.params, 0, bytemuck::cast_slice(&params));
+    }
+    // Once a second: what was replayed.
+    let (replayed, skipped) = gpu.last_counts;
+    let st = &mut gpu.stats;
+    st.frames += 1;
+    st.replayed += replayed as u64;
+    st.skipped += skipped as u64;
+    let since = *st.since.get_or_insert_with(Instant::now);
+    if since.elapsed().as_secs_f32() >= 1.0 {
+        info!(
+            "wowbg3 fx: BG3 frame {}: {replayed} draws replayed, {skipped} skipped (last second: {} frames, {} replayed, {} skipped), {} colours, exposure {:.3}",
+            set.frame.frame,
+            st.frames,
+            st.replayed,
+            st.skipped,
+            if gpu.mode > 0.5 { "BG3's" } else { "sRGB" },
+            set.exposure
+        );
+        *st = Stats { since: Some(Instant::now()), ..Default::default() };
+    }
+}
