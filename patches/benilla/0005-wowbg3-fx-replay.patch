+impl FxGpu {
+    fn node_note(&self, msg: String) {
+        if let Ok(mut l) = self.node_log.lock() {
+            if l.len() < 256 && l.insert(msg.clone()) {
+                warn!("wowbg3 fx: {msg}");
+            }
+        }
+    }
+}
+
+fn color_pass<'e>(
+    enc: &'e mut wgpu::CommandEncoder,
+    label: &str,
+    views: &[&wgpu::TextureView],
+    clear: wgpu::Color,
+    depth: Option<(&wgpu::TextureView, bool)>,
+) -> wgpu::RenderPass<'e> {
+    let atts: Vec<Option<wgpu::RenderPassColorAttachment>> = views
+        .iter()
+        .map(|v| {
+            Some(wgpu::RenderPassColorAttachment {
+                view: v,
+                depth_slice: None,
+                resolve_target: None,
+                ops: wgpu::Operations { load: wgpu::LoadOp::Clear(clear), store: wgpu::StoreOp::Store },
+            })
+        })
+        .collect();
+    enc.begin_render_pass(&wgpu::RenderPassDescriptor {
+        label: Some(label),
+        color_attachments: &atts,
+        depth_stencil_attachment: depth.map(|(view, write)| wgpu::RenderPassDepthStencilAttachment {
+            view,
+            depth_ops: write.then_some(wgpu::Operations { load: wgpu::LoadOp::Clear(0.0), store: wgpu::StoreOp::Store }),
+            stencil_ops: None,
+        }),
+        timestamp_writes: None,
+        occlusion_query_set: None,
+    })
+}
+
+fn replay(pass: &mut wgpu::RenderPass, r: &Ready) {
+    for d in &r.draws {
+        pass.set_pipeline(&d.pipeline);
+        for (i, g) in d.groups.iter().enumerate() {
+            pass.set_bind_group(i as u32, g, &[]);
+        }
+        for (slot, &(off, size)) in d.vbs.iter().enumerate() {
+            pass.set_vertex_buffer(slot as u32, r.arena.slice(off..off + size));
+        }
+        if let Some((stages, data)) = &d.push {
+            pass.set_push_constants(*stages, 0, data);
+        }
+        let inst = d.first_instance..d.first_instance + d.instances;
+        match d.index {
+            Some((off, size, fmt)) => {
+                pass.set_index_buffer(r.arena.slice(off..off + size), fmt);
+                pass.draw_indexed(d.first..d.first + d.count, d.base_vertex, inst);
+            }
+            None => pass.draw(d.first..d.first + d.count, inst),
+        }
+    }
+}
+
+impl ViewNode for FxNode {
+    type ViewQuery = (&'static ViewTarget, &'static ViewDepthTexture, &'static FxView);
+
+    fn run(
+        &self,
+        _graph: &mut RenderGraphContext,
+        rc: &mut RenderContext,
+        (target, depth, _): QueryItem<Self::ViewQuery>,
+        world: &World,
+    ) -> Result<(), NodeRunError> {
+        let Some(gpu) = world.get_resource::<FxGpu>() else { return Ok(()) };
+        let Some(r) = gpu.ready.clone() else { return Ok(()) };
+        if r.draws.is_empty() {
+            return Ok(());
+        }
+        if target.main_texture_format() != r.composite_format {
+            return Ok(());
+        }
+        if !depth.texture.usage().contains(TextureUsages::TEXTURE_BINDING) || depth.texture.format() != DEPTH_FMT {
+            gpu.node_note(format!("the world depth ({:?}) cannot be sampled yet", depth.texture.format()));
+            return Ok(());
+        }
+        if !target.main_texture().usage().contains(TextureUsages::TEXTURE_BINDING) || target.main_texture().sample_count() != 1 {
+            gpu.node_note("the world colour cannot be sampled (MSAA on?)".to_string());
+            return Ok(());
+        }
+        let dev = rc.render_device().wgpu_device().clone();
+        let depth_view: &wgpu::TextureView = depth.view();
+        let main_view: &wgpu::TextureView = target.main_texture_view();
+        // Steps 1-3 in a command buffer of their own: an error there drops only the replay.
+        let recorded = scoped(&dev, || {
+            let prep_bg = dev.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("wowbg3_fx_prep"),
+                layout: &r.prep_bgl,
+                entries: &[
+                    wgpu::BindGroupEntry { binding: 0, resource: wgpu::BindingResource::TextureView(depth_view) },
+                    wgpu::BindGroupEntry { binding: 1, resource: wgpu::BindingResource::TextureView(main_view) },
+                ],
+            });
+            let mut enc = dev.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Some("wowbg3_fx") });
+            {
+                let mut pass = color_pass(&mut enc, "wowbg3_fx_table", &[&r.table_view], wgpu::Color::BLACK, None);
+                pass.set_pipeline(&r.table_pipeline);
+                pass.set_bind_group(0, &r.chain_bg, &[]);
+                pass.draw(0..3, 0..1);
+            }
+            {
+                let mut pass = color_pass(
+                    &mut enc,
+                    "wowbg3_fx_prep",
+                    &[&r.lin_a, &r.lin_b, &r.scene],
+                    wgpu::Color::BLACK,
+                    Some((&r.depth, true)),
+                );
+                pass.set_pipeline(&r.prep_pipeline);
+                pass.set_bind_group(0, &r.chain_bg, &[]);
+                pass.set_bind_group(1, &r.table_bg, &[]);
+                pass.set_bind_group(2, &prep_bg, &[]);
+                pass.draw(0..3, 0..1);
+            }
+            for (view, clear, label) in [
+                (&r.c, wgpu::Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }, "wowbg3_fx_over_black"),
+                (&r.w, wgpu::Color { r: 1.0, g: 1.0, b: 1.0, a: 1.0 }, "wowbg3_fx_over_white"),
+            ] {
+                let mut pass = color_pass(&mut enc, label, &[view], clear, Some((&r.depth, false)));
+                replay(&mut pass, &r);
+            }
+            enc.finish()
+        });
+        let cb = match recorded {
+            Ok(cb) => cb,
+            Err(e) => {
+                gpu.node_note(format!("replay dropped: {e}"));
+                return Ok(());
+            }
+        };
+        rc.add_command_buffer(cb);
+        // Step 4: composite into the view target (its bind group first, so nothing is swapped
+        // when it cannot be made).
+        let comp_bg = scoped(&dev, || {
+            dev.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("wowbg3_fx_comp"),
+                layout: &r.comp_bgl,
+                entries: &[
+                    wgpu::BindGroupEntry { binding: 0, resource: wgpu::BindingResource::TextureView(main_view) },
+                    wgpu::BindGroupEntry { binding: 1, resource: wgpu::BindingResource::TextureView(&r.c) },
+                    wgpu::BindGroupEntry { binding: 2, resource: wgpu::BindingResource::TextureView(&r.w) },
+                ],
+            })
+        });
+        let comp_bg = match comp_bg {
+            Ok(g) => g,
+            Err(e) => {
+                gpu.node_note(format!("composite skipped: {e}"));
+                return Ok(());
+            }
+        };
+        let post = target.post_process_write();
+        let dest: &wgpu::TextureView = post.destination;
+        let mut pass = color_pass(rc.command_encoder(), "wowbg3_fx_composite", &[dest], wgpu::Color::BLACK, None);
+        pass.set_pipeline(&r.composite);
+        pass.set_bind_group(0, &r.chain_bg, &[]);
+        pass.set_bind_group(1, &r.table_bg, &[]);
+        pass.set_bind_group(2, &comp_bg, &[]);
+        pass.draw(0..3, 0..1);
+        Ok(())
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// WGSL: the display chain, its inverse, the passes
+
+const WGSL_PRELUDE: &str = r#"
+struct Params {
+    sizes: vec4<f32>,   // BG3's extent (w, h), the view's (w, h)
+    depth: vec4<f32>,   // WoW near (yd), depth offset (yd), BG3's far (m), metres per yard
+    proj: vec4<f32>,    // BG3: depth = p22 + p32 / z; depth slack (m)
+    post: vec4<f32>,    // exposure, fade, mode (1: BG3's chain, 0: sRGB), show (1 C, 2 T)
+    grade: vec4<f32>,
+    table: vec4<f32>,   // log2 of the lowest and highest x, entries
+};
+@group(0) @binding(0) var<uniform> P: Params;
+@group(0) @binding(1) var grade_lut: texture_3d<f32>;
+@group(0) @binding(2) var grade_smp: sampler;
+@group(0) @binding(3) var display_lut: texture_3d<f32>;
+@group(0) @binding(4) var display_smp: sampler;
+
+struct VOut { @builtin(position) pos: vec4<f32> };
+
+@vertex
+fn vs(@builtin(vertex_index) i: u32) -> VOut {
+    let uv = vec2<f32>(f32((i << 1u) & 2u), f32(i & 2u));
+    var o: VOut;
+    o.pos = vec4<f32>(uv * 2.0 - 1.0, 0.0, 1.0);
+    return o;
+}
+
+fn srgb_to_linear(c: vec3<f32>) -> vec3<f32> {
+    let lo = c / 12.92;
+    let hi = pow((c + vec3<f32>(0.055)) / 1.055, vec3<f32>(2.4));
+    return select(hi, lo, c <= vec3<f32>(0.04045));
+}
+
+fn linear_to_srgb(c: vec3<f32>) -> vec3<f32> {
+    let lo = c * 12.92;
+    let hi = 1.055 * pow(c, vec3<f32>(1.0 / 2.4)) - vec3<f32>(0.055);
+    return select(hi, lo, c <= vec3<f32>(0.0031308));
+}
+
+fn rgb_hue(c: vec3<f32>) -> f32 {
+    let v = max(c.r, max(c.g, c.b));
+    let d = v - min(c.r, min(c.g, c.b));
+    if (d <= 0.0) {
+        return 0.0;
+    }
+    var h: f32;
+    if (v == c.r) {
+        h = (c.g - c.b) / d;
+    } else if (v == c.g) {
+        h = 2.0 + (c.b - c.r) / d;
+    } else {
+        h = 4.0 + (c.r - c.g) / d;
+    }
+    return fract(h / 6.0);
+}
+
+fn hue_rgb(h: f32) -> vec3<f32> {
+    return clamp(abs(fract(vec3<f32>(h) + vec3<f32>(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0, vec3<f32>(0.0), vec3<f32>(1.0));
+}
+
+// BG3's HSV grading (format doc, "Post block").
+fn grade(c: vec3<f32>) -> vec3<f32> {
+    let g = P.grade;
+    if (g.w == 0.0) {
+        return c;
+    }
+    let v = max(c.r, max(c.g, c.b));
+    let chroma = v - min(c.r, min(c.g, c.b));
+    let h = rgb_hue(c) + g.y;
+    let s = mix(0.0, chroma / (v + 1e-10), g.x);
+    let a = mix(vec3<f32>(1.0), hue_rgb(h), s) * v;
+    var b: vec3<f32>;
+    if (g.z < 0.0) {
+        b = a * (1.0 + g.z);
+    } else {
+        b = mix(a, vec3<f32>(1.0), g.z);
+    }
+    return mix(c, b, g.w);
+}
+
+fn pq(y: vec3<f32>) -> vec3<f32> {
+    let m1 = 0.1593017578125;
+    let m2 = 78.84375;
+    let c1 = 0.8359375;
+    let c2 = 18.8515625;
+    let c3 = 18.6875;
+    let ym = pow(clamp(y, vec3<f32>(0.0), vec3<f32>(1.0)), vec3<f32>(m1));
+    return pow((vec3<f32>(c1) + c2 * ym) / (vec3<f32>(1.0) + c3 * ym), vec3<f32>(m2));
+}
+
+fn acescc(x: vec3<f32>) -> vec3<f32> {
+    let xc = select(vec3<f32>(0.0), x, x > vec3<f32>(0.0));
+    let xp = select(xc, xc * 0.5 + vec3<f32>(exp2(-16.0)), xc <= vec3<f32>(exp2(-15.0)));
+    return clamp((log2(xp) + vec3<f32>(9.72)) / 17.52, vec3<f32>(0.0), vec3<f32>(1.0));
+}
+
+// Scene-linear (after exposure) to display-encoded, as BG3 does it after its effects pass
+// (bloom left out); plain sRGB without BG3's post block.
+fn display_chain(x: vec3<f32>) -> vec3<f32> {
+    if (P.post.z < 0.5) {
+        return linear_to_srgb(clamp(x, vec3<f32>(0.0), vec3<f32>(1.0)));
+    }
+    let g = grade(max(x, vec3<f32>(0.0)));
+    let p = pq(g / 222.0);
+    let l = textureSampleLevel(grade_lut, grade_smp, p, 0.0).rgb;
+    let d = textureSampleLevel(display_lut, display_smp, acescc(l), 0.0).rgb;
+    return mix(d, vec3<f32>(0.0), P.post.y);
+}
+
+fn table_x(i: i32) -> f32 {
+    if (i <= 0) {
+        return 0.0;
+    }
+    let t = f32(i - 1) / (P.table.z - 2.0);
+    return exp2(mix(P.table.x, P.table.y, t));
+}
+"#;
+
+const WGSL_TABLE: &str = r#"
+@fragment
+fn fs_table(in: VOut) -> @location(0) vec4<f32> {
+    let x = table_x(i32(in.pos.x));
+    return vec4<f32>(display_chain(vec3<f32>(x)), x);
+}
+"#;
+
+const WGSL_INVERSE: &str = r#"
+@group(1) @binding(0) var table: texture_2d<f32>;
+
+fn table_at(i: i32, ch: i32) -> f32 {
+    return textureLoad(table, vec2<i32>(i, 0), 0)[ch];
+}
+
+// The scene-linear value whose display value is w, along one channel of the grey table.
+fn inv1(w: f32, ch: i32) -> f32 {
+    let n = i32(P.table.z);
+    var lo = 0;
+    var hi = n - 1;
+    if (w <= table_at(lo, ch)) {
+        return 0.0;
+    }
+    if (w >= table_at(hi, ch)) {
+        return table_x(hi);
+    }
+    for (var k = 0; k < 16; k++) {
+        if (hi - lo <= 1) {
+            break;
+        }
+        let mid = (lo + hi) / 2;
+        if (table_at(mid, ch) <= w) {
+            lo = mid;
+        } else {
+            hi = mid;
+        }
+    }
+    let a = table_at(lo, ch);
+    let b = table_at(hi, ch);
+    let t = select(0.0, (w - a) / (b - a), b > a);
+    return mix(table_x(lo), table_x(hi), clamp(t, 0.0, 1.0));
+}
+
+fn inverse_chain(w: vec3<f32>) -> vec3<f32> {
+    if (P.post.z < 0.5) {
+        return srgb_to_linear(clamp(w, vec3<f32>(0.0), vec3<f32>(1.0)));
+    }
+    return vec3<f32>(inv1(w.r, 0), inv1(w.g, 1), inv1(w.b, 2));
+}
+"#;
+
+const WGSL_PREP: &str = r#"
+@group(2) @binding(0) var wow_depth: texture_depth_2d;
+@group(2) @binding(1) var wow_color: texture_2d<f32>;
+
+struct PrepOut {
+    @builtin(frag_depth) depth: f32,
+    @location(0) lin_a: f32,
+    @location(1) lin_b: f32,
+    @location(2) scene: vec4<f32>,
+};
+
+@fragment
+fn fs_prep(in: VOut) -> PrepOut {
+    let vsz = P.sizes.zw;
+    let q = vec2<i32>(clamp(floor(in.pos.xy * vsz / P.sizes.xy), vec2<f32>(0.0), vsz - 1.0));
+    let d = textureLoad(wow_depth, q, 0);
+    var o: PrepOut;
+    if (d > 0.0) {
+        // WoW: reverse infinite, view z = near / depth (yards); BG3's eye sits the depth
+        // offset behind WoW's. BG3's linear depth (key 4) is view z over its far plane.
+        let z = max((P.depth.x / d + P.depth.y) * P.depth.w + P.proj.z, 0.01);
+        o.depth = clamp(P.proj.x + P.proj.y / z, 0.0, 1.0);
+        o.lin_a = min(z / P.depth.z, 1.0);
+    } else {
+        o.depth = 0.0;
+        o.lin_a = 1.0;
+    }
+    o.lin_b = o.lin_a;
+    let w = textureLoad(wow_color, q, 0).rgb;
+    o.scene = vec4<f32>(inverse_chain(clamp(w, vec3<f32>(0.0), vec3<f32>(1.0))) / max(P.post.x, 1e-6), 1.0);
+    return o;
+}
+"#;
+
+const WGSL_COMP: &str = r#"
+@group(2) @binding(0) var src: texture_2d<f32>;
+@group(2) @binding(1) var fx_c: texture_2d<f32>;
+@group(2) @binding(2) var fx_w: texture_2d<f32>;
+
+fn finite3(v: vec3<f32>) -> bool {
+    let e = bitcast<vec3<u32>>(v) & vec3<u32>(0x7f800000u);
+    return all(e != vec3<u32>(0x7f800000u));
+}
+
+@fragment
+fn fs_comp(in: VOut) -> @location(0) vec4<f32> {
+    let s = textureLoad(src, vec2<i32>(in.pos.xy), 0);
+    let bs = P.sizes.xy;
+    let q = vec2<i32>(clamp(floor(in.pos.xy * bs / P.sizes.zw), vec2<f32>(0.0), bs - 1.0));
+    let c0 = textureLoad(fx_c, q, 0).rgb;
+    let w0 = textureLoad(fx_w, q, 0).rgb;
+    let ok = finite3(c0) && finite3(w0);
+    if (P.post.w > 3.5) {
+        // Round trip of WoW's colour through BG3's display chain and back.
+        return vec4<f32>(clamp(display_chain(inverse_chain(clamp(s.rgb, vec3<f32>(0.0), vec3<f32>(1.0)))), vec3<f32>(0.0), vec3<f32>(1.0)), s.a);
+    }
+    if (P.post.w > 2.5) {
+        if (!ok) {
+            return vec4<f32>(1.0, 0.0, 1.0, s.a);
+        }
+        let tt = w0 - c0;
+        let neg = clamp(-min(c0.r, min(c0.g, c0.b)) * 8.0, 0.0, 1.0);
+        let pos = clamp(max(c0.r, max(c0.g, c0.b)) * 8.0, 0.0, 1.0);
+        let dev = clamp(max(abs(tt.r - 1.0), max(abs(tt.g - 1.0), abs(tt.b - 1.0))) * 8.0, 0.0, 1.0);
+        return vec4<f32>(neg, pos, dev, s.a);
+    }
+    // A non-finite result (an effect shader's overflow or NaN) counts as no effect.
+    let c = select(vec3<f32>(0.0), c0, ok);
+    let t = select(vec3<f32>(1.0), max(w0 - c0, vec3<f32>(0.0)), ok);
+    if (P.post.w > 1.5) {
+        return vec4<f32>(clamp(t, vec3<f32>(0.0), vec3<f32>(1.0)), s.a);
+    }
+    if (P.post.w > 0.5) {
+        return vec4<f32>(linear_to_srgb(clamp(c * P.post.x, vec3<f32>(0.0), vec3<f32>(1.0))), s.a);
+    }
+    if (all(c == vec3<f32>(0.0)) && all(t == vec3<f32>(1.0))) {
+        return s;
+    }
+    let w = clamp(s.rgb, vec3<f32>(0.0), vec3<f32>(1.0));
+    let xw = inverse_chain(w);
+    let x = xw * t + c * P.post.x;
+    let res = w + display_chain(x) - display_chain(xw);
+    return vec4<f32>(clamp(res, vec3<f32>(0.0), vec3<f32>(1.0)), s.a);
+}
+"#;
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn vertex_limits_like_wgpu() {
+        let slots = [
+            VbSlot { binding: 0, stride: 64, last_stride: 64, instance: true },
+            VbSlot { binding: 1, stride: 8, last_stride: 8, instance: false },
+            VbSlot { binding: 2, stride: 28, last_stride: 28, instance: false },
+        ];
+        // 1 instance, 100 and 50 vertices
+        assert_eq!(vertex_limits(&slots, &[64, 800, 1400]), (50, 1));
+        // a buffer shorter than one element allows none
+        assert_eq!(vertex_limits(&slots, &[63, 800, 1400]).1, 0);
+        // the last element may end short of a whole stride
+        let s = [VbSlot { binding: 0, stride: 16, last_stride: 12, instance: false }];
+        assert_eq!(vertex_limits(&s, &[28]).0, 2);
+    }
+
+    #[test]
+    fn maps_bg3_formats() {
+        assert_eq!(vk_vertex_format(106), Some(wgpu::VertexFormat::Float32x3));
+        assert_eq!(vk_vertex_format(92), Some(wgpu::VertexFormat::Snorm16x4));
+        assert_eq!(vk_vertex_format(103), Some(wgpu::VertexFormat::Float32x2));
+        assert_eq!(vk_texture_format(145), Some(wgpu::TextureFormat::Bc7RgbaUnorm));
+        assert_eq!(vk_texture_format(64), Some(wgpu::TextureFormat::Rgb10a2Unorm));
+        assert_eq!(vk_texture_format(122), Some(wgpu::TextureFormat::Rg11b10Ufloat));
+        assert_eq!(view_dim(2, false), Some(wgpu::TextureViewDimension::D3));
+        assert_eq!(visibility(17), wgpu::ShaderStages::VERTEX_FRAGMENT);
+        assert_eq!(visibility(63), wgpu::ShaderStages::VERTEX_FRAGMENT);
+    }
+}
