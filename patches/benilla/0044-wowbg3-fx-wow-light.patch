+/// Patch 0044: the light grid's texel (BG3's scale, 32 = 1.0) from WoW's lighting, set by
+/// [`track_wow_light`]; `None` keeps the constant (`WOW_BG3_FX_LIGHT`).
+static WOW_LIGHT: std::sync::Mutex<Option<[f32; 3]>> = std::sync::Mutex::new(None);
+
+/// Patch 0044: WoW's light of this frame for the light grid: ambient plus half the diffuse (the
+/// sun's light averaged over a volume's directions), in BG3's grid scale.
+fn track_wow_light(lighting: Option<Res<benilla_world::lighting::WowLighting>>) {
+    let Some(l) = lighting else { return };
+    let rgb = [0, 1, 2].map(|i| 32.0 * (l.ambient[i] + 0.5 * l.diffuse[i]).clamp(0.0, 4.0));
+    if let Ok(mut w) = WOW_LIGHT.lock() {
+        *w = Some(rgb);
+    }
+}
+
