+/// WOW-BG3 (patch 0030): the two edges of [`SoundConfig::music_yield`]. Down (BG3's
+/// fight began, its combat music plays): the zone track fades out over the reference's own 4.0 s
+/// music fade, the one a zone change makes (`0x4602e0`), a Lua track pauses on the same fade, and
+/// the pump waits ([`start_music_stream`] refuses). Up (the fight is over): a Lua track resumes,
+/// else the pump starts the zone's track [`FIGHT_MUSIC_RESUME_SECS`] later, as after a cinematic,
+/// with the kit for the phase then.
+fn apply_music_yield(zone: &mut ZoneAudio, yielding: bool, now: f64) {
+    if yielding == zone.music_yielding {
+        return;
+    }
+    zone.music_yielding = yielding;
+    if yielding {
+        if let Some(h) = zone.lua_music.as_mut() {
+            h.pause(mixer::fade(MUSIC_FADE_OUT_MS));
+            info!("Lua music: paused for BG3's fight");
+        }
+        if let Some(mut h) = zone.music.take() {
+            h.stop(mixer::fade(MUSIC_FADE_OUT_MS));
+            info!("zone music: fades out, BG3's fight music plays");
+        }
+        // The next track starts at position 0, behind this one's baseline.
+        zone.music_watch.reset();
+        zone.next_track_at = None;
+        return;
+    }
+    if zone.lua_slot_live() {
+        if let Some(h) = zone.lua_music.as_mut() {
+            h.resume(mixer::declick());
+            info!("Lua music: resumed after BG3's fight");
+        }
+        return;
+    }
+    if zone.zone_music != 0 {
+        zone.next_track_at = Some(now + FIGHT_MUSIC_RESUME_SECS);
+        info!("zone music: BG3's fight is over, back in {FIGHT_MUSIC_RESUME_SECS:.1}s");
+    }
+}
