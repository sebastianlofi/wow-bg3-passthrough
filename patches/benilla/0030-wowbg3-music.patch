 static TAV_COMBAT: AtomicBool = AtomicBool::new(false);
 /// When the last new `tav.bin` record came ([`clock_ms`]; 0: never).
 static TAV_SEEN_MS: AtomicU64 = AtomicU64::new(0);
+/// Patch 0030: BG3's own sound is muted (`tav.bin` flags bit 2): BG3's master volume RTPC is 0, as
+/// BG3 sets it when its window loses focus (its MuteSoundWhenNotFocused option) or its master
+/// volume is 0.
+static TAV_MUTED: AtomicBool = AtomicBool::new(false);
+
+/// Patch 0030: how old the last `tav.bin` record may be for its combat bit to count.
+const COMBAT_FRESH_MS: u64 = 5000;
+
+/// Patch 0030: BG3 runs a fight for BG3's character (`tav.bin` flags bit 1, BG3's
+/// own `TurnBased.IsInCombat`, read by `read_tav`). BG3's combat music plays then, so WoW's zone
+/// music yields to it (`sound::SoundConfig::music_yield`). False with no record for 5 s (world
+/// mode not running, or stopped).
+pub(crate) fn bg3_combat() -> bool {
+    let seen = TAV_SEEN_MS.load(Ordering::Relaxed);
+    seen != 0
+        && clock_ms().saturating_sub(seen) <= COMBAT_FRESH_MS
+        && TAV_COMBAT.load(Ordering::Relaxed)
+}
+
+/// Patch 0030: BG3's own sound is muted (`tav.bin` flags bit 2). In world mode the
+/// window played in is BG3's, so WoW's sound goes quiet with BG3's, as the reference mutes when
+/// its own window is inactive. False with no record for 5 s.
+pub(crate) fn bg3_muted() -> bool {
+    let seen = TAV_SEEN_MS.load(Ordering::Relaxed);
+    seen != 0
+        && clock_ms().saturating_sub(seen) <= COMBAT_FRESH_MS
+        && TAV_MUTED.load(Ordering::Relaxed)
+}
 
