+/// 0123: the multisampled depth to the readback rows (`bpr` bytes each): per pixel the nearest sample (reverse-Z: the
+/// largest), one compute pass into a storage buffer laid out as the readback, then copied into the slot's buffer.
+const MS_DEPTH_WGSL: &str = r#"
+@group(0) @binding(0) var d: texture_depth_multisampled_2d;
+@group(0) @binding(1) var<storage, read_write> o: array<f32>;
+@compute @workgroup_size(8, 8)
+fn main(@builtin(global_invocation_id) g: vec3<u32>) {
+    let dim = textureDimensions(d);
+    if (g.x >= dim.x || g.y >= dim.y) { return; }
+    var m = 0.0;
+    let n = i32(textureNumSamples(d));
+    for (var s = 0; s < n; s++) { m = max(m, textureLoad(d, vec2<i32>(g.xy), s)); }
+    let stride = ((dim.x * 4u + 255u) / 256u) * 64u;
+    o[g.y * stride + g.x] = m;
+}
+"#;
+
+struct MsDepth {
+    pipe: wgpu::ComputePipeline,
+    buf: Buffer,
+    size: u64,
+}
+
+fn resolve_depth(s: &mut SinkState, rc: &mut RenderContext, device: &RenderDevice, depth: &ViewDepthTexture, dst: &Buffer, bpr: u32) -> bool {
+    let size = depth.texture.size();
+    if bpr != RenderDevice::align_copy_bytes_per_row(size.width as usize * 4) as u32 {
+        return false;
+    }
+    let bytes = u64::from(bpr) * u64::from(size.height);
+    let dev = device.wgpu_device();
+    if s.msd.as_ref().map_or(true, |m| m.size != bytes) {
+        let pipe = match s.msd.take() {
+            Some(m) => m.pipe,
+            None => {
+                let module = dev.create_shader_module(wgpu::ShaderModuleDescriptor {
+                    label: Some("wowbg3_ms_depth"),
+                    source: wgpu::ShaderSource::Wgsl(MS_DEPTH_WGSL.into()),
+                });
+                dev.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+                    label: Some("wowbg3_ms_depth"),
+                    layout: None,
+                    module: &module,
+                    entry_point: Some("main"),
+                    compilation_options: Default::default(),
+                    cache: None,
+                })
+            }
+        };
+        let buf = device.create_buffer(&BufferDescriptor {
+            label: Some("wowbg3_ms_depth"),
+            size: bytes,
+            usage: BufferUsages::STORAGE | BufferUsages::COPY_SRC,
+            mapped_at_creation: false,
+        });
+        s.msd = Some(MsDepth { pipe, buf, size: bytes });
+    }
+    let m = s.msd.as_ref().unwrap();
+    let bg = dev.create_bind_group(&wgpu::BindGroupDescriptor {
+        label: Some("wowbg3_ms_depth"),
+        layout: &m.pipe.get_bind_group_layout(0),
+        entries: &[
+            wgpu::BindGroupEntry { binding: 0, resource: wgpu::BindingResource::TextureView(depth.view()) },
+            wgpu::BindGroupEntry { binding: 1, resource: m.buf.as_entire_binding() },
+        ],
+    });
+    let enc = rc.command_encoder();
+    {
+        let mut p = enc.begin_compute_pass(&wgpu::ComputePassDescriptor { label: Some("wowbg3_ms_depth"), timestamp_writes: None });
+        p.set_pipeline(&m.pipe);
+        p.set_bind_group(0, &bg, &[]);
+        p.dispatch_workgroups(size.width.div_ceil(8), size.height.div_ceil(8), 1);
+    }
+    enc.copy_buffer_to_buffer(&m.buf, 0, dst, 0, bytes);
+    true
+}
