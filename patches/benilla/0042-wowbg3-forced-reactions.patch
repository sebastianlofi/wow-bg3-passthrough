+/// WOW-BG3 (patch 0042): the forced reactions (`SMSG_SET_FORCED_REACTIONS`), by
+/// `Faction.dbc` id, rank `0..=7`. One table for the local player, as the reference keeps it on the
+/// active player (`0x4d6490`); replaced whole by each packet, which vmangos sends at login too.
+static FORCED: std::sync::RwLock<Vec<(u32, u8)>> = std::sync::RwLock::new(Vec::new());
+
+/// Replaces the forced reactions.
+pub(crate) fn set_forced_reactions(reactions: &[(u32, u32)]) {
+    if let Ok(mut f) = FORCED.write() {
+        *f = reactions.iter().map(|&(id, rank)| (id, rank.min(7) as u8)).collect();
+    }
+}
