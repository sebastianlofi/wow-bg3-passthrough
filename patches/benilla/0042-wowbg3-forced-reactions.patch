+/// `SMSG_SET_FORCED_REACTIONS` (WOW-BG3 patch 0042): the server forces our
+/// reaction with whole factions (vmangos `ReputationMgr::ApplyForceReaction`: auras such as
+/// SPELL_AURA_FORCE_REACTION, and `.wowbg3 faction` of server patch 0009). Every reaction the
+/// client draws or acts on (nameplates, the cursor, right click, the target ring) reads it first,
+/// as the reference's forced-reaction table (`0x4d6490`).
+fn on_forced_reactions(In(ev): In<SessionEvent>) {
+    if let SessionEvent::ForcedReactions { reactions } = ev {
+        info!("net: {} forced faction reaction(s)", reactions.len());
+        crate::target::ring::set_forced_reactions(&reactions);
     }
 }
 
