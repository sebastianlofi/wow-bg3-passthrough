@@ -57,6 +62,29 @@ use benilla_world::view::WorldCamera;
 
 pub(crate) const HEADER: usize = 64;
 
+/// Patch 0093: the frames carry WoW's interface without the world (see the module notes).
+static INTERFACE_ONLY: AtomicBool = AtomicBool::new(false);
+
+pub(crate) fn interface_only() -> bool {
+    INTERFACE_ONLY.load(Ordering::Relaxed)
+}
+
+/// First in a frame, so the backdrop and the frame's tag agree. Every 6 frames: one `stat`.
+fn watch_camp(mut frame: Local<u32>, mut flag: Local<Option<std::path::PathBuf>>) {
+    *frame = frame.wrapping_add(1);
+    if *frame % 6 != 0 {
+        return;
+    }
+    if flag.is_none() {
+        *flag = std::env::var_os("WOW_BG3_LINK_DIR").map(|d| std::path::PathBuf::from(d).join("wowcamp.flag"));
+    }
+    let Some(path) = flag.as_ref() else { return };
+    let on = path.exists();
+    if INTERFACE_ONLY.swap(on, Ordering::Relaxed) != on {
+        info!("wowbg3 frames: {}", if on { "at camp: the interface alone" } else { "back from camp: the world again" });
+    }
+}
