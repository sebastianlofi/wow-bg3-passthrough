+// Patch 0068: the point lights' share (torches, braziers, `point_g` gamma) on top of WoW's light
+// `lit` at the normal, in the units of her other light. WoW's own models add them inside the clamp,
+// `tex × clamp(lit + point)`; taken to linear apart, `lin(lit) + lin(point)` gave a torch far less
+// than that on anything already lit (lit 0.3 and point 0.3: 0.42 shown, WoW 0.6), so at night she
+// stayed blue-grey beside the warm NPCs a brazier lights. With flag 128 her light at N plus the
+// point's share is exactly `lin(clamp(lit + point))`. `WOW_BG3_TAV_POINTS=linear` (or `<tav
+// dir>/tavpoint`) turns flag 128 off.
+fn tav_point(lit: vec3<f32>, point_g: vec3<f32>) -> vec3<f32> {
+    if ((u32(max(m.tav_a.w, 0.0)) & 128u) != 0u) {
+        return max(tav_light(lit + point_g) - tav_light(lit), vec3<f32>(0.0));
+    }
+    return tav_light(point_g);
+}
