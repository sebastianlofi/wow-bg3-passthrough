+/// A 3×4 affine's rows as a `Mat4` (bottom row `0 0 0 1`), as `wow_model.wgsl` builds its blends.
+fn affine_rows(r: [Vec4; 3]) -> Mat4 {
+    Mat4::from_cols(r[0], r[1], r[2], Vec4::W).transpose()
+}
