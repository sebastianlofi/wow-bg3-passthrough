+/// A mesh for the CPU path: positions, normals and tangents written by every pose.
+fn cpu_mesh(m: &TavMesh, det: f32) -> Mesh {
+    let mut mesh = Mesh::new(PrimitiveTopology::TriangleList, RenderAssetUsages::default());
