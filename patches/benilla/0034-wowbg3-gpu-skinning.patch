+/// Patch 0034: the rotation BG3's skinning turns a vertex's tangent frame by, for a blended bone matrix
+/// (rows of its 3×3 part). BG3's compute skinning (`Shaders/Vulkan/SkinningCompute.bshd` in
+/// EngineShaders.pak; per vertex: four palette rows `3×4` weighted by bytes / 255 and summed, the
+/// position `blend·[p, 1]`) normalises each row, converts the matrix to a quaternion (by the trace when
+/// positive, else by its largest diagonal element) and multiplies the vertex's qtangent by it
+/// (`q·q_vertex`), so each axis of the frame, normal and tangent, turns by it. Unit length here, as the
+/// qtangent's axes come from a normalised quaternion ([`quat_axes`]). Mirrored in `wow_model.wgsl`.
+pub(crate) fn bg3_bone_rotation(rows: [Vec3; 3]) -> Quat {
+    let [r0, r1, r2] = rows.map(Vec3::normalize_or_zero);
+    let t = r0.x + r1.y + r2.z;
+    let q = if t > 0.0 {
+        let s = (t + 1.0).sqrt();
+        let s2 = 2.0 * s;
+        Vec4::new((r2.y - r1.z) / s2, (r0.z - r2.x) / s2, (r1.x - r0.y) / s2, 0.5 * s)
+    } else if r0.x > r1.y && r0.x > r2.z {
+        let s = (1.0 + r0.x - r1.y - r2.z).sqrt();
+        let s2 = 2.0 * s;
+        Vec4::new(0.5 * s, (r0.y + r1.x) / s2, (r0.z + r2.x) / s2, (r2.y - r1.z) / s2)
+    } else if r1.y > r2.z {
+        let s = (1.0 + r1.y - r0.x - r2.z).sqrt();
+        let s2 = 2.0 * s;
+        Vec4::new((r0.y + r1.x) / s2, 0.5 * s, (r1.z + r2.y) / s2, (r0.z - r2.x) / s2)
+    } else {
+        let s = (1.0 + r2.z - r0.x - r1.y).sqrt();
+        let s2 = 2.0 * s;
+        Vec4::new((r0.z + r2.x) / s2, (r1.z + r2.y) / s2, 0.5 * s, (r1.x - r0.y) / s2)
+    };
+    Quat::from_vec4(q).normalize()
+}
