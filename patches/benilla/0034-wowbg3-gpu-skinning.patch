+// WOW-BG3 (local fork, patch 0034): the rotation BG3's own skinning turns a vertex's tangent frame by
+// (`Shaders/Vulkan/SkinningCompute.bshd` in EngineShaders.pak; mirrored by `wowbg3_tav.rs`
+// `bg3_bone_rotation`): the blended bone matrix's rows normalised, then a quaternion by the trace when
+// positive, else by the largest diagonal element; unit length.
+fn bg3_bone_rotation(m: mat4x4<f32>) -> vec4<f32> {
+    let r0 = normalize(vec3<f32>(m[0].x, m[1].x, m[2].x));
+    let r1 = normalize(vec3<f32>(m[0].y, m[1].y, m[2].y));
+    let r2 = normalize(vec3<f32>(m[0].z, m[1].z, m[2].z));
+    let t = r0.x + r1.y + r2.z;
+    var q: vec4<f32>;
+    if (t > 0.0) {
+        let s = sqrt(t + 1.0);
+        q = vec4<f32>((r2.y - r1.z) / (2.0 * s), (r0.z - r2.x) / (2.0 * s), (r1.x - r0.y) / (2.0 * s), 0.5 * s);
+    } else if (r0.x > r1.y && r0.x > r2.z) {
+        let s = sqrt(1.0 + r0.x - r1.y - r2.z);
+        q = vec4<f32>(0.5 * s, (r0.y + r1.x) / (2.0 * s), (r0.z + r2.x) / (2.0 * s), (r2.y - r1.z) / (2.0 * s));
+    } else if (r1.y > r2.z) {
+        let s = sqrt(1.0 + r1.y - r0.x - r2.z);
+        q = vec4<f32>((r0.y + r1.x) / (2.0 * s), 0.5 * s, (r1.z + r2.y) / (2.0 * s), (r0.z - r2.x) / (2.0 * s));
+    } else {
+        let s = sqrt(1.0 + r2.z - r0.x - r1.y);
+        q = vec4<f32>((r0.z + r2.x) / (2.0 * s), (r1.z + r2.y) / (2.0 * s), 0.5 * s, (r1.x - r0.y) / (2.0 * s));
+    }
+    return normalize(q);
+}
