+/// Patch 0034 (`WOW_BG3_TAV_SKIN_CHECK=<n>`): one figure's differences between the GPU path and the
+/// CPU path; distances in yards, angles in degrees.
+#[derive(Default, Clone, Copy)]
+struct SkinCheck {
+    verts: u64,
+    /// The vertex stage's position against the CPU path's.
+    gpu_cpu: f64,
+    /// Each against an f64 evaluation of the same skin.
+    gpu_exact: f64,
+    cpu_exact: f64,
+    /// The vertex stage's normal and tangent against the CPU path's.
+    normal: f64,
+    tangent: f64,
