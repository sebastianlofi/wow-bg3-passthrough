+/// World mode's mapping without its translation: BG3 metres to Bevy yards (a mirror, det < 0).
+fn mapping_linear() -> Mat3 {
+    Mat3::from_cols(bg3_dir_to_bevy(Vec3::X), bg3_dir_to_bevy(Vec3::Y), bg3_dir_to_bevy(Vec3::Z)) * (1.0 / YD)
+}
