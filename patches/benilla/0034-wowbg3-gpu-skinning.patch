+
+/// Patch 0034: every GPU-skinned mesh's vertices as the vertex stage computes them, from the rows just
+/// written (the palette's CPU mirror of what goes to the GPU: blocks blended row by row in f32 as
+/// `wow_model.wgsl` blends them, the figure frame, the slot's origin, [`bg3_bone_rotation`] for the
+/// tangent frame), against the CPU path ([`cpu_skin`]'s [`pose_mesh`] and mapping, plus the root) and
+/// an f64 evaluation of the position; per figure.
+fn skin_check(
+    file: &MeshFile,
+    parts: &[Part],
+    recs: &[PoseRec],
+    anchors: &[(u32, Vec3, Vec3)],
+    pal: &benilla_world::rig_palette::RigPalettes,
+) -> Vec<(u32, SkinCheck)> {
+    use bevy::math::DVec3;
+    let (centre, wow) = (file.centre, file.wow);
+    let l = mapping_linear().as_dmat3();
+    let angle =
+        |a: Vec3, b: Vec3| f64::from(a.normalize_or_zero().dot(b.normalize_or_zero()).clamp(-1.0, 1.0)).acos().to_degrees();
+    let mut out: Vec<(u32, SkinCheck)> = Vec::new();
+    let (mut cp, mut cn, mut ct) = (Vec::new(), Vec::new(), Vec::new());
+    for (m, part) in file.meshes.iter().zip(parts) {
+        let Some(rig) = part.rig.as_ref() else { continue };
+        let Some(&(fig, anchor, origin)) = anchors.iter().find(|a| a.0 == m.figure) else { continue };
+        let want = m.skin_from.unwrap_or(m.key);
+        let Some(rec) = recs.iter().find(|r| r.key == want && r.flags & 1 != 0) else { continue };
+        let skinned = !m.weights.is_empty();
+        if skinned && rec.palette.is_empty() {
+            continue;
+        }
+        let (Some(rows), Some(slot_origin)) = (pal.rig_rows(rig.slot, rig.bones as usize), pal.slot_origin(rig.slot)) else {
+            continue;
+        };
+        pose_mesh(m, rec, &mut cp, &mut cn, &mut ct);
+        let base = wow_to_bevy(bg3_to_wow(anchor, centre, wow));
+        let q = Quat::from_xyzw(rec.world[0], rec.world[1], rec.world[2], rec.world[3]).normalize().as_dquat();
+        let t = Vec3::new(rec.world[4], rec.world[5], rec.world[6]).as_dvec3();
+        let s = Vec3::new(rec.world[7], rec.world[8], rec.world[9]);
+        let s = if s.is_finite() && s.length_squared() > 1e-8 { s } else { Vec3::ONE }.as_dvec3();
+        let (a64, o64, so64) = (anchor.as_dvec3(), origin.as_dvec3(), slot_origin.as_dvec3());
+        let k = match out.iter().position(|o| o.0 == fig) {
+            Some(k) => k,
+            None => {
+                out.push((fig, SkinCheck::default()));
+                out.len() - 1
+            }
+        };
+        let c = &mut out[k].1;
+        let (frame, f3) = (rows[0], Mat3::from_mat4(rows[0]));
+        for v in 0..m.pos.len().min(cp.len()) {
+            let p = m.pos[v];
+            // The vertex stage: the weighted palette blocks blended (joint indices + 1), the figure
+            // frame after them, then the slot's origin; the tangent frame turned by the blend's rotation.
+            let blend = if skinned && rows.len() > 1 {
+                let r = (0..4).fold([Vec4::ZERO; 3], |mut acc, j| {
+                    let w = m.weights[v][j];
+                    let b = if w > 0.0 { usize::from(m.bones[v][j]) + 1 } else { 1 };
+                    let row = rows[b.min(rows.len() - 1)];
+                    for (i, a) in acc.iter_mut().enumerate() {
+                        *a += row.row(i) * w;
+                    }
+                    acc
+                });
+                affine_rows(r)
+            } else {
+                rows[rows.len().min(2) - 1]
+            };
+            let gp = so64 + (frame * blend).transform_point3(p).as_dvec3();
+            let b3 = Mat3::from_mat4(blend);
+            let turn = bg3_bone_rotation([b3.row(0), b3.row(1), b3.row(2)]);
+            let gn = f3 * (turn * m.nrm[v]);
+            let tv = m.tan.get(v).map_or(Vec3::X, |t| Vec3::new(t[0], t[1], t[2]));
+            let gt = f3 * (turn * tv);
+            let gold = f3 * (b3 * m.nrm[v]);
+            // The CPU path: mapped relative to the root, the root added by the vertex stage.
+            let pc = o64 + (wow_to_bevy(bg3_to_wow(cp[v], centre, wow)) - base).as_dvec3();
+            let nc = bg3_dir_to_bevy(cn[v]);
+            let tc = bg3_dir_to_bevy(ct[v]);
+            // In f64.
+            let p64 = p.as_dvec3();
+            let x = if skinned {
+                (0..4).fold(DVec3::ZERO, |acc, j| {
+                    let w = f64::from(m.weights[v][j]);
+                    if w <= 0.0 {
+                        return acc;
+                    }
+                    let r = rec.palette[usize::from(m.bones[v][j]).min(rec.palette.len() - 1)].map(f64::from);
+                    acc + w * DVec3::new(
+                        r[0] * p64.x + r[1] * p64.y + r[2] * p64.z + r[3],
+                        r[4] * p64.x + r[5] * p64.y + r[6] * p64.z + r[7],
+                        r[8] * p64.x + r[9] * p64.y + r[10] * p64.z + r[11],
+                    )
+                })
+            } else {
+                p64
+            };
+            let exact = o64 + l * (q * (x * s) + t - a64);
+            c.verts += 1;
+            c.gpu_cpu = c.gpu_cpu.max(gp.distance(pc));
+            c.gpu_exact = c.gpu_exact.max(gp.distance(exact));
+            c.cpu_exact = c.cpu_exact.max(pc.distance(exact));
+            c.normal = c.normal.max(angle(gn, nc));
+            c.normal_old = c.normal_old.max(angle(gold, gn));
+            c.tangent = c.tangent.max(angle(gt, tc));
         }
     }
+    out
 }
 
