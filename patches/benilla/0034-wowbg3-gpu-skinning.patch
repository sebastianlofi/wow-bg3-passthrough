+/// Patch 0034: the palette blocks a mesh takes: its highest weighted bone plus one (1 for a rigid
+/// mesh, an identity). Its rig slot holds one more, the figure frame ([`rig_rows`]).
+fn rig_bones(m: &TavMesh) -> u32 {
+    m.weights
+        .iter()
+        .zip(&m.bones)
+        .flat_map(|(w, b)| (0..4).filter_map(move |k| (w[k] > 0.0).then(|| u32::from(b[k]) + 1)))
+        .max()
+        .unwrap_or(1)
+}
+
+/// Patch 0034: a rig slot for each of a plan's meshes and the rows it takes; all or none, so a plan
+/// skins wholly on the GPU or wholly on the CPU (`WOW_BG3_TAV_SKIN=cpu`, or the palette full).
+fn alloc_rigs(
+    skin: SkinMode,
+    palettes: Option<&mut benilla_world::rig_palette::RigPalettes>,
+    file: &MeshFile,
+) -> (Vec<Option<(benilla_world::rig_palette::RigSkin, u32)>>, bool) {
+    let Some(pal) = palettes.filter(|_| skin != SkinMode::Cpu) else {
+        return (Vec::new(), false);
+    };
+    let mut rigs = Vec::with_capacity(file.meshes.len());
+    for m in &file.meshes {
+        let bones = rig_bones(m) + 1;
+        match benilla_world::rig_palette::RigSkin::allocate_bones(pal, bones, Handle::default()) {
+            Some(skin) => rigs.push(Some((skin, bones))),
+            None => {
+                for (skin, _) in rigs.into_iter().flatten() {
+                    pal.free(skin.slot);
+                }
+                warn!(
+                    "wowbg3 tav: the rig palette has no room for plan {}'s {} meshes: skinned on the CPU",
+                    file.seq,
+                    file.meshes.len()
+                );
+                return (Vec::new(), false);
+            }
+        }
+    }
+    (rigs, true)
+}
