+/// Patch 0034: whether a part's look lets it show: its maps applied, or the untextured fallback for a
+/// mesh whose maps never came (as `load_meshes` and `load_textures` set its visibility).
+fn look_shown(looks: &HashMap<u64, Look>, part: &Part, fallback_done: bool) -> bool {
+    match looks.get(&part.key) {
+        Some(Look::Shown(_)) => true,
+        Some(Look::Hidden) => false,
+        None => fallback_done,
+    }
+}
