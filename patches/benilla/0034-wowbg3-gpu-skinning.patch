+/// Patch 0034: a mesh for GPU skinning, uploaded once: BG3's bind pose (model space, metres), the
+/// tangents' handedness turned for the mirrored mapping as the CPU path turns it, and the skin as
+/// WoW's joint attributes (`WOW_RIG_SKIN`): BG3's four weights (bytes over 255) and bones, each bone + 1
+/// (block 0 of the slot is the figure frame, [`rig_rows`]), an unweighted influence on block 1; a rigid
+/// mesh as one identity block under its object's own transform.
+fn gpu_mesh(m: &TavMesh, det: f32) -> Mesh {
+    let n = m.pos.len();
+    let mut mesh = Mesh::new(PrimitiveTopology::TriangleList, RenderAssetUsages::default());
+    mesh.insert_attribute(Mesh::ATTRIBUTE_POSITION, m.pos.iter().map(|p| p.to_array()).collect::<Vec<_>>());
+    mesh.insert_attribute(Mesh::ATTRIBUTE_NORMAL, m.nrm.iter().map(|v| v.to_array()).collect::<Vec<_>>());
+    mesh.insert_attribute(Mesh::ATTRIBUTE_UV_0, m.uv.clone());
+    let tan: Vec<[f32; 4]> =
+        (0..n).map(|v| m.tan.get(v).map_or([1.0, 0.0, 0.0, det], |t| [t[0], t[1], t[2], t[3] * det])).collect();
+    mesh.insert_attribute(Mesh::ATTRIBUTE_TANGENT, tan);
+    let (joints, weights): (Vec<[u16; 4]>, Vec<[f32; 4]>) = if m.weights.len() == n && m.bones.len() == n {
+        m.weights
+            .iter()
+            .zip(&m.bones)
+            .map(|(w, b)| (std::array::from_fn(|k| if w[k] > 0.0 { u16::from(b[k]) + 1 } else { 1 }), *w))
+            .unzip()
+    } else {
+        (vec![[1; 4]; n], vec![[1.0, 0.0, 0.0, 0.0]; n])
+    };
+    mesh.insert_attribute(benilla_assets::ATTRIBUTE_WOW_JOINT_INDEX, VertexAttributeValues::Uint16x4(joints));
+    mesh.insert_attribute(benilla_assets::ATTRIBUTE_WOW_JOINT_WEIGHT, VertexAttributeValues::Float32x4(weights));
+    let idx = if det < 0.0 { rewind(&m.idx) } else { m.idx.clone() };
+    mesh.insert_indices(Indices::U32(idx));
+    mesh
+}
