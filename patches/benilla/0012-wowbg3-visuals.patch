+// ---------------------------------------------------------------------------------------------
+// Patch 0012: the effects drawn with WoW's camera
+//
+// BG3 draws the effects with its own camera, and the replay used to keep it. Whenever WoW's eye
+// is elsewhere they land beside WoW's world: during a cast BG3 renders through its action camera
+// while WoW keeps the camera record's pose (Fire Bolt's preparation and impact then fell
+// off-screen or behind WoW's ground), on hills the clearance dolly moves WoW's eye, and BG3's
+// frame trails WoW's camera by a frame or more. So each WoW frame BG3's camera blocks in the
+// arena are rewritten with WoW's camera mapped into BG3's coordinates (world mode's mapping,
+// `wowbg3_fx::bg3_map`, with the ground lock added back, as Tav is lowered with the camera):
+// - set 0 binding 2 (224 bytes, m[col][row] at col * 4 + row): V (rotation rows right, up,
+//   forward; translation -R·eye), P (WoW's focal lengths, BG3's reverse-Z depth terms, no TAA
+//   jitter), camera-relative VP = P·[R | R·(eye_bg3 - eye_wow)] (positions stay relative to the
+//   eye BG3 drew with, +208, which is kept);
+// - set 0 binding 1 (+48): the camera's right, up and forward rows (billboards, decals).
+// Projected decals rebuild their surface point from WoW's linear depth along WoW's rays, relative
+// to WoW's eye; they sit off by the eye shift (the dolly; none on level ground).
+
+/// WoW's camera in BG3's coordinates: eye, right, up, forward; WoW's focal lengths.
+pub(crate) struct CamPose {
+    pub(crate) eye: Vec3,
+    pub(crate) right: Vec3,
+    pub(crate) up: Vec3,
+    pub(crate) fwd: Vec3,
+    pub(crate) p00: f32,
+    pub(crate) p11: f32,
+}
+
+/// Bevy to BG3 (`bg3 = k + YD * (-x, y, z)`, BG3 mirrors X).
+fn mirror(v: Vec3) -> Vec3 {
+    Vec3::new(-v.x, v.y, v.z)
+}
+
+pub(crate) fn cam_pose(world_from_view: &bevy::transform::components::GlobalTransform, clip_from_view: &Mat4, k: [f32; 3], lock: f32) -> CamPose {
+    let a = world_from_view.affine();
+    let eye = Vec3::from(a.translation) + Vec3::Y * lock;
+    CamPose {
+        eye: Vec3::from(k) + mirror(eye) * YD,
+        right: mirror(Vec3::from(a.matrix3.x_axis)).normalize_or_zero(),
+        up: mirror(Vec3::from(a.matrix3.y_axis)).normalize_or_zero(),
+        fwd: mirror(-Vec3::from(a.matrix3.z_axis)).normalize_or_zero(),
+        p00: clip_from_view.x_axis.x,
+        p11: clip_from_view.y_axis.y,
+    }
+}
+
+/// BG3's per-view block (56 floats) for WoW's camera; `None` when it is not one.
+pub(crate) fn rebase_view(orig: &[f32], c: &CamPose) -> Option<[f32; 56]> {
+    if orig.len() < 56 || !orig.iter().take(55).all(|v| v.is_finite()) {
+        return None;
+    }
+    let at = |base: usize, col: usize, row: usize| base + col * 4 + row;
+    let (v, p, vp) = (0, 16, 32);
+    // a perspective projection (as `strip_block` checks)
+    if orig[at(p, 2, 3)] != 1.0 || orig[at(p, 3, 3)] != 0.0 || !(orig[at(p, 0, 0)] > 0.0) || !(orig[at(p, 1, 1)] > 0.0) {
+        return None;
+    }
+    if !(c.p00 > 0.0 && c.p11 > 0.0) || c.right == Vec3::ZERO || c.up == Vec3::ZERO || c.fwd == Vec3::ZERO {
+        return None;
+    }
+    let mut o = [0f32; 56];
+    o.copy_from_slice(&orig[..56]);
+    let eye_b = Vec3::new(orig[52], orig[53], orig[54]);
+    let rows = [c.right, c.up, c.fwd];
+    for col in 0..3 {
+        for (row, axis) in rows.iter().enumerate() {
+            o[at(v, col, row)] = axis[col];
+        }
+        o[at(v, col, 3)] = 0.0;
+    }
+    for (row, axis) in rows.iter().enumerate() {
+        o[at(v, 3, row)] = -axis.dot(c.eye);
+    }
+    o[at(v, 3, 3)] = 1.0;
+    o[at(p, 0, 0)] = c.p00;
+    o[at(p, 1, 1)] = c.p11;
+    o[at(p, 2, 0)] = 0.0;
+    o[at(p, 2, 1)] = 0.0;
+    let pm = |o: &[f32; 56], col: usize, row: usize| o[at(p, col, row)];
+    let d = eye_b - c.eye;
+    let t = [c.right.dot(d), c.up.dot(d), c.fwd.dot(d)];
+    for col in 0..4 {
+        for row in 0..4 {
+            o[at(vp, col, row)] = if col < 3 {
+                (0..3).map(|k| pm(&o, k, row) * o[at(v, col, k)]).sum()
+            } else {
+                (0..3).map(|k| pm(&o, k, row) * t[k]).sum::<f32>() + pm(&o, 3, row)
+            };
+        }
+    }
+    Some(o)
+}
+
+/// BG3's G-buffer normal encoding (its decals' decode: s = (x, y) * 3.5554 - 1.7777, z 1;
+/// n = (s.xy * 2 / |s|², 1 - 2 / |s|²)), for a view-space normal.
+pub(crate) fn encode_normal(n: Vec3) -> [f32; 2] {
+    let k = (1.0 - n.z).max(1e-4);
+    [(n.x / k + 1.7777) / 3.5554, (n.y / k + 1.7777) / 3.5554]
+}
+
+impl FxGpu {
+    /// Rewrites the frame's camera blocks in the arena for WoW's camera; false when it cannot
+    /// (no mapping yet, no blocks, nothing ready).
