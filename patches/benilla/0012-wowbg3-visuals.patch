+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A record of one segment from `from` to `to` (BG3 metres), radius 0.05, colours 0xff8000
+    /// and 0xffffff, distances 0 and 2.
+    fn record(seq: u32, consts: [f32; 8], from: [f32; 3], to: [f32; 3]) -> Vec<u8> {
+        let z = [to[0] - from[0], to[1] - from[1], to[2] - from[2]];
+        let mid = [(to[0] + from[0]) * 0.5, (to[1] + from[1]) * 0.5, (to[2] + from[2]) * 0.5];
+        // Columns: x the radius (across, BG3 +Z), y up, z the segment, then the middle.
+        let rows = [[0.0, 0.0, z[0], mid[0]], [0.0, 0.05, z[1], mid[1]], [0.05, 0.0, z[2], mid[2]]];
+        let mut a: Vec<f32> = rows.iter().flatten().copied().collect();
+        a.extend([1.0, 0.0, 0.0, 0xff8000 as f32, -1.0, 0.0, 0.0, 0xffffff as f32]);
+        a.extend([0.2, 0.2, 0.0, 1.0, 0.2, 0.2, 2.0, 1.0]);
+        let mut b = Vec::new();
+        b.extend_from_slice(b"RTE1");
+        b.extend_from_slice(&seq.to_le_bytes());
+        b.extend_from_slice(&1u32.to_le_bytes());
+        for v in consts.iter().chain(a.iter()) {
+            b.extend_from_slice(&v.to_le_bytes());
+        }
+        b.extend_from_slice(&seq.to_le_bytes());
+        b
+    }
+
+    const SOLID: [f32; 8] = [0.5, 0.5, 1.0, 2.0, 0.0, 0.1, 0.0, 0.0];
+
+    #[test]
+    fn decodes_bg3s_segments() {
+        let b = record(9, SOLID, [1.0, 0.0, 0.0], [3.0, 0.0, 0.0]);
+        let r = decode_route(&b).expect("decodes");
+        assert_eq!((r.seq, r.segments.len()), (9, 1));
+        let s = r.segments[0];
+        assert_eq!((s.start, s.end), ([1.0, 0.0, 0.0], [3.0, 0.0, 0.0]));
+        assert!((s.radius - 0.05).abs() < 1e-6);
+        assert_eq!(s.colour[0], [1.0, 128.0 / 255.0, 0.0]);
+        assert_eq!(s.colour[1], [1.0, 1.0, 1.0]);
+        assert_eq!((s.dash[0][2], s.dash[1][2]), (0.0, 2.0));
+        let mut torn = b.clone();
+        let n = torn.len();
+        torn[n - 4] = 10;
+        assert!(decode_route(&torn).is_none());
+        assert!(decode_route(&b[..b.len() - 1]).is_none());
+        // Count 0: the line goes.
+        let mut empty = b"RTE1".to_vec();
+        empty.extend_from_slice(&10u32.to_le_bytes());
+        empty.extend_from_slice(&0u32.to_le_bytes());
+        empty.extend_from_slice(&[0u8; 32]);
+        empty.extend_from_slice(&10u32.to_le_bytes());
+        assert!(decode_route(&empty).expect("decodes").segments.is_empty());
+    }
+
+    #[test]
+    fn weighs_the_line_as_bg3_does() {
+        let s = decode_route(&record(1, SOLID, [1.0, 0.0, 0.0], [3.0, 0.0, 0.0])).unwrap().segments[0];
+        // Solid: full in the middle, fading to nothing at both ends of the route.
+        assert_eq!(weight(&SOLID, &s, 0.6, 0.3), 1.0);
+        assert_eq!(weight(&SOLID, &s, 0.0, 0.0), 0.0);
+        assert!(weight(&SOLID, &s, 0.1, 0.05) < 0.5);
+        assert_eq!(weight(&SOLID, &s, 2.0, 1.0), 0.0);
+        // The gap at the threshold (1.0, half-width 0.1).
+        assert_eq!(weight(&SOLID, &s, 1.05, 0.5), 0.0);
+        // Dashed (weight 0): 0.2 on, 0.2 off.
+        let dashed = [0.5, 0.5, 0.0, 2.0, 0.0, 0.1, 0.0, 0.0];
+        assert!((dash_gap(&dashed, &s, 0.7, 0.35) - 0.0).abs() < 1e-6);
+        assert!((dash_gap(&dashed, &s, 0.5, 0.25) - 0.8).abs() < 1e-6);
+        assert!(piece_len(&dashed, &[s]) < 0.06 && piece_len(&SOLID, &[s]) == PIECE);
+        // Constants at zero: BG3's formula still draws the line (no fade, dash weight 0.8).
+        assert!((weight(&[0.0; 8], &s, 0.5, 0.25) - 0.8).abs() < 1e-6);
+    }
+
+    #[test]
+    fn maps_bg3_back_onto_wow() {
+        let (w, g) = ([-8840.0f32, -140.0, 85.0], [-1419.5f32, 116.1, -326.7]);
+        let mut rec = b"TAV1".to_vec();
+        rec.extend_from_slice(&5u32.to_le_bytes());
+        for v in w.iter().chain(g.iter()).chain([0.0f32, 0.0].iter()) {
+            rec.extend_from_slice(&v.to_le_bytes());
+        }
+        rec.extend_from_slice(&5u32.to_le_bytes());
+        let k = super::super::map_from_tav(&rec).expect("a mapping");
+        let b = bevy_from_bg3(k, g);
+        assert!((b - benilla_assets::coords::wow_to_bevy(w)).length() < 1e-2);
+        // A metre east in BG3 (+x) is a yard and a bit west in Bevy (mirrored).
+        let e = bevy_from_bg3(k, [g[0] + 1.0, g[1], g[2]]);
+        assert!(((e - b).x + 1.0 / YD).abs() < 1e-3);
+    }
+}
