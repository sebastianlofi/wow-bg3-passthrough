+        let (Some(k), Some(ready), Some(base)) = (crate::wowbg3_fx::bg3_map(), self.ready.as_ref(), self.base.as_ref()) else {
+            return false;
+        };
+        let f = &set.frame;
+        if f.cam_b2.is_empty() {
+            return false;
+        }
+        let c = cam_pose(&view.world_from_view, &view.clip_from_view, k, crate::wowbg3_lead::ground_lock());
+        let floats = |off: u32, n: usize| -> Option<Vec<f32>> {
+            let b = f.blob.get(off as usize..off as usize + n * 4)?;
+            Some(b.chunks_exact(4).map(|x| f32::from_le_bytes(x.try_into().unwrap())).collect())
+        };
+        let mut any = false;
+        for &off in &f.cam_b2 {
+            let Some(orig) = floats(off, 56) else { continue };
+            let Some(new) = rebase_view(&orig, &c) else { continue };
+            queue.write_buffer(&ready.arena, off as u64, bytemuck::cast_slice(&new));
+            any = true;
+        }
+        if !any {
+            return false;
+        }
+        for &off in &f.cam_b1 {
+            let Some(orig) = floats(off, 24) else { continue };
+            let mut rows = [0f32; 12];
+            for (i, axis) in [c.right, c.up, c.fwd].iter().enumerate() {
+                rows[i * 4..i * 4 + 3].copy_from_slice(&axis.to_array());
+                rows[i * 4 + 3] = orig[12 + i * 4 + 3];
+            }
+            queue.write_buffer(&ready.arena, off as u64 + 48, bytemuck::cast_slice(&rows));
+        }
+        // Special key 6: WoW's ground as level, its normal in the camera's axes.
+        let n = Vec3::new(c.right.y, c.up.y, c.fwd.y);
+        let e = encode_normal(n);
+        let h = |x: f32| half::f16::from_f32(x).to_bits();
+        queue.write_texture(
+            base.normal_tex.as_image_copy(),
+            bytemuck::cast_slice::<u16, u8>(&[h(e[0]), h(e[1]), 0, half::f16::ONE.to_bits()]),
+            wgpu::TexelCopyBufferLayout { offset: 0, bytes_per_row: Some(8), rows_per_image: Some(1) },
+            wgpu::Extent3d { width: 1, height: 1, depth_or_array_layers: 1 },
+        );
+        true
+    }
+}
