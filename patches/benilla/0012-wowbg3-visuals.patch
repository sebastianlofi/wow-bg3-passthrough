+//! WOW-BG3 (local fork, patch 0012): BG3's route line on WoW's ground.
+//! BG3's white path line (turn-based mode, sneaking) never showed in WoW. BG3 draws
+//! it as a tube per path segment into an offscreen target of its own and lays that over its
+//! scene, so the effects replay never sees it, and replayed it would run at BG3's floor heights.
+//! The capture layer sends the segments instead: `bg3route.bin` in `$WOW_BG3_TAV_DIR` ("RTE1",
+//! `link/benilla/fx-replay-format.md`) whenever the line BG3 draws changes, and an empty record
+//! once BG3 stops drawing it. Each segment, mapped from BG3's coordinates ([`super::bg3_map`],
+//! less the ground lock, as Tav is lowered), is cut into pieces projected onto WoW's receiving
+//! surfaces (terrain and WMO faces: the selection ring's ground-decal projector), so the line
+//! lies on WoW's ground whatever BG3's own floor heights. Colour, width, dashes, the gap at a
+//! threshold and the fades at the route's ends are BG3's, as its fragment shader computes them
+//! ([`fade`], [`dash_gap`]); unlit and unfogged like BG3's. Child of `wowbg3_fx`.
+
+use std::path::PathBuf;
+
+use benilla_world::decal::{DecalFrame, WorldDecal};
+use benilla_world::particles::buffer::{begin_effect_frame, EffectVertex, WorldEffectDraw};
+use benilla_world::view::WorldCamera;
+use benilla_world::world_point::WorldPoint;
+use bevy::asset::RenderAssetUsages;
+use bevy::prelude::*;
+use bevy::render::render_resource::{Extent3d, TextureDimension, TextureFormat};
+
+/// Metres per yard (BG3 to WoW).
+const YD: f32 = 0.9144;
+/// Longest piece (yards) a segment is cut into, each projected around WoW's ground at its middle.
+const PIECE: f32 = 1.0;
+/// Shortest piece (yards), where BG3 dashes the line (a quarter of its shortest dash or gap).
+const MIN_PIECE: f32 = 0.05;
+/// Pieces per route at most.
+const MAX_PIECES: usize = 4000;
+/// How far (yards) WoW's terrain may lie from a point's mapped height and still be its ground.
+const SNAP: f32 = 4.0;
+/// A shown line goes when Tav's record (`tav.bin`, rewritten while world mode runs) is this old.
+const GONE_SECS: f32 = 3.0;
+
+/// One segment of BG3's route, in BG3's world metres.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct Segment {
+    pub(crate) start: [f32; 3],
+    pub(crate) end: [f32; 3],
+    /// The tube's radius (metres).
+    pub(crate) radius: f32,
+    /// RGB at each end (0..1).
+    pub(crate) colour: [[f32; 3]; 2],
+    /// Each end's dash length, gap length, path distance (metres along the route) and threshold.
+    pub(crate) dash: [[f32; 4]; 2],
+}
+
+/// A record: its sequence, the line's constants (fade-in length, fade-out length, dash weight
+/// (1 solid), route length, dash offset, half-width of the gap at a threshold, two unused) and the
+/// segments (none: no line).
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct Route {
+    pub(crate) seq: u32,
+    pub(crate) consts: [f32; 8],
+    pub(crate) segments: Vec<Segment>,
+}
+
+/// Decodes `bg3route.bin`: "RTE1", seq u32, count u32, the constants (8 f32), count instances of
+/// 28 f32 (vertex locations 1..7 of BG3's route draw), seq again u32.
+pub(crate) fn decode_route(b: &[u8]) -> Option<Route> {
+    const HEAD: usize = 12 + 32;
+    const SEG: usize = 112;
+    if b.len() < HEAD + 4 || &b[0..4] != b"RTE1" {
+        return None;
+    }
+    let u = |o: usize| b.get(o..o + 4).map(|s| u32::from_le_bytes(s.try_into().unwrap()));
+    let f = |o: usize| b.get(o..o + 4).map(|s| f32::from_le_bytes(s.try_into().unwrap()));
+    let (seq, n) = (u(4)?, u(8)? as usize);
+    if n > 4096 || b.len() != HEAD + SEG * n + 4 || u(HEAD + SEG * n)? != seq {
+        return None;
+    }
+    let mut consts = [0.0; 8];
+    for (k, c) in consts.iter_mut().enumerate() {
+        *c = f(12 + 4 * k)?;
+    }
+    let mut segments = Vec::with_capacity(n);
+    for i in 0..n {
+        let mut a = [0.0f32; 28];
+        for (k, v) in a.iter_mut().enumerate() {
+            *v = f(HEAD + SEG * i + 4 * k)?;
+        }
+        if !a.iter().all(|v| v.is_finite()) {
+            return None;
+        }
+        segments.push(segment(&a));
+    }
+    Some(Route { seq, consts, segments })
+}
+
+/// A segment from its instance's attributes, as BG3's vertex shader (acc03298) reads them: rows
+/// 0..2 place a box from local z -0.5 to 0.5 whose x axis is the tube's radius; then each end's
+/// clipping plane with its colour packed in `.w` as 0xRRGGBB; then each end's dash, gap, distance
+/// and threshold.
+fn segment(a: &[f32; 28]) -> Segment {
+    let row = |r: usize, p: [f32; 3]| a[4 * r] * p[0] + a[4 * r + 1] * p[1] + a[4 * r + 2] * p[2] + a[4 * r + 3];
+    let at = |p: [f32; 3]| [row(0, p), row(1, p), row(2, p)];
+    let rgb = |c: f32| {
+        let c = c as i32;
+        [((c >> 16) & 255) as f32 / 255.0, ((c >> 8) & 255) as f32 / 255.0, (c & 255) as f32 / 255.0]
+    };
+    Segment {
+        start: at([0.0, 0.0, -0.5]),
+        end: at([0.0, 0.0, 0.5]),
+        radius: (a[0] * a[0] + a[4] * a[4] + a[8] * a[8]).sqrt(),
+        colour: [rgb(a[15]), rgb(a[19])],
+        dash: [[a[20], a[21], a[22], a[23]], [a[24], a[25], a[26], a[27]]],
+    }
+}
+
+/// BG3's fade at path distance `d` (metres): its fragment shader (5669d462) sums 8 samples
+/// across the tube, all at about the same distance, and squares the sum, so `min(1, 8 f²)`.
+pub(crate) fn fade(c: &[f32; 8], d: f32) -> f32 {
+    // As BG3's: NaN terms count as 1 (its NMin), and a negative product squares to positive.
+    let f = (d / c[0]).min(1.0) * ((c[3] - d) / c[1]).min(1.0);
+    (8.0 * f * f).min(1.0)
+}
+
+/// BG3's dash and gap factor at path distance `d`, `t` (0..1) along the segment: a dash is on
+/// while `fract((d - offset) / period) * period` is within its length (0.8 then, weighted by the
+/// dash weight), the gap cuts the line within a half-width of each end's threshold.
+pub(crate) fn dash_gap(c: &[f32; 8], s: &Segment, d: f32, t: f32) -> f32 {
+    let on = |q: [f32; 4]| {
+        let period = q[0] + q[1];
+        let x = (d - c[4]) / period;
+        // NaN (no period) is off, as in BG3's comparison.
+        if (x - x.floor()) * period <= q[0] { 1.0 } else { 0.0 }
+    };
+    let dash = (on(s.dash[0]) * (1.0 - t) + on(s.dash[1]) * t) * 0.8;
+    let open = |q: [f32; 4]| if (d - q[3]).abs() > c[5] { 1.0 } else { 0.0 };
+    let gap = open(s.dash[0]) * (1.0 - t) + open(s.dash[1]) * t;
+    (dash * (1.0 - c[2]) + c[2]) * gap
+}
+
+/// The line's weight at `d`, `t` (the tube's cross profile comes from the strip texture).
+#[cfg(test)]
+pub(crate) fn weight(c: &[f32; 8], s: &Segment, d: f32, t: f32) -> f32 {
+    fade(c, d) * dash_gap(c, s, d, t)
+}
+
+/// BG3's world metres to Bevy yards: the inverse of `bg3 = k + YD * (-x, y, z)`.
+pub(crate) fn bevy_from_bg3(k: [f32; 3], p: [f32; 3]) -> Vec3 {
+    Vec3::new((k[0] - p[0]) / YD, (p[1] - k[1]) / YD, (p[2] - k[2]) / YD)
+}
+
+/// The piece length (yards) for a route: short where BG3 dashes it.
+fn piece_len(c: &[f32; 8], segs: &[Segment]) -> f32 {
+    if c[2] >= 0.999 {
+        return PIECE;
+    }
+    let shortest = segs
+        .iter()
+        .flat_map(|s| [s.dash[0][0], s.dash[0][1], s.dash[1][0], s.dash[1][1]])
+        .filter(|v| *v > 0.0)
+        .fold(f32::MAX, f32::min);
+    (shortest / YD / 4.0).clamp(MIN_PIECE, PIECE)
+}
+
+#[derive(Resource)]
+struct RouteLine {
+    path: PathBuf,
+    tav: Option<PathBuf>,
+    frame: u64,
+    last_seq: u32,
+    route: Option<Route>,
+    dirty: bool,
+    /// Receiving surfaces and ground lock when last projected: a tile streaming in, or the lock
+    /// moving, projects again.
+    surfaces: usize,
+    lock: f32,
+    strip: Vec<EffectVertex>,
+    anchor: Vec3,
+    strip_tex: Handle<Image>,
+    owner: Entity,
+    logged: bool,
+}
+
+pub(super) fn build(app: &mut App, tav_dir: PathBuf, link_dir: Option<PathBuf>) {
+    let (path, tav) = (tav_dir.join("bg3route.bin"), link_dir.map(|d| d.join("tav.bin")));
+    app.add_systems(Startup, move |mut commands: Commands, mut images: ResMut<Assets<Image>>| {
+        let owner = commands.spawn(Name::new("wowbg3 route line")).id();
+        commands.insert_resource(RouteLine {
+            path: path.clone(),
+            tav: tav.clone(),
+            frame: 0,
+            last_seq: 0,
+            route: None,
+            dirty: false,
+            surfaces: 0,
+            lock: 0.0,
+            strip: Vec::new(),
+            anchor: Vec3::ZERO,
+            strip_tex: images.add(strip_texture()),
+            owner,
+            logged: false,
+        });
+    })
+    .add_systems(Update, (read_route, project_route.after(read_route)))
+    .add_systems(PostUpdate, push_route.after(begin_effect_frame));
+}
+
+/// White, with alpha across the strip as BG3's tube shades it: half the chord through the tube
+/// over its radius, `sqrt(1 - x²)` at `x` from the middle.
+fn strip_texture() -> Image {
+    let (w, h) = (4u32, 32u32);
+    let mut px = Vec::with_capacity((w * h * 4) as usize);
+    for y in 0..h {
+        let x = ((y as f32 + 0.5) / h as f32 - 0.5).abs() * 2.0;
+        let a = (1.0 - x * x).max(0.0).sqrt();
+        for _ in 0..w {
+            px.extend_from_slice(&[255, 255, 255, (a * 255.0).round() as u8]);
+        }
+    }
+    Image::new(
+        Extent3d { width: w, height: h, depth_or_array_layers: 1 },
+        TextureDimension::D2,
+        px,
+        TextureFormat::Rgba8Unorm,
+        RenderAssetUsages::RENDER_WORLD,
+    )
+}
+
+fn read_route(mut r: ResMut<RouteLine>) {
+    r.frame += 1;
+    if r.frame % 2 != 0 {
+        return;
+    }
+    if r.route.as_ref().is_some_and(|q| !q.segments.is_empty()) && r.frame % 30 == 0 {
+        // World mode stopped (BG3 gone, no empty record): no line left over.
+        let alive = r.tav.as_ref().is_none_or(|t| {
+            std::fs::metadata(t)
+                .and_then(|m| m.modified())
+                .is_ok_and(|m| m.elapsed().is_ok_and(|e| e.as_secs_f32() < GONE_SECS))
+        });
+        if !alive {
+            r.route = None;
+            r.dirty = true;
+        }
+    }
+    let Ok(raw) = std::fs::read(&r.path) else { return };
+    let Some(route) = decode_route(&raw) else { return };
+    if route.seq == r.last_seq {
+        return;
+    }
+    r.last_seq = route.seq;
+    if !r.logged && !route.segments.is_empty() {
+        r.logged = true;
+        info!("wowbg3 route: BG3's route line, {} segments (record {})", route.segments.len(), route.seq);
+    }
+    r.route = Some(route);
+    r.dirty = true;
+}
+
+/// Projects the line onto WoW's surfaces when it changed (or a receiving tile arrived, or the
+/// ground lock moved).
+fn project_route(mut r: ResMut<RouteLine>, decals: WorldDecal, world: WorldPoint) {
+    let surfaces = decals.receiver_count();
+    let lock = crate::wowbg3_lead::ground_lock();
+    if !r.dirty && surfaces == r.surfaces && (lock - r.lock).abs() < 0.25 {
+        return;
+    }
+    r.dirty = false;
+    r.surfaces = surfaces;
+    r.lock = lock;
+    let RouteLine { route, strip, anchor, .. } = &mut *r;
+    strip.clear();
+    let (Some(route), Some(k)) = (route.as_ref(), super::bg3_map()) else { return };
+    let c = &route.consts;
+    let map = |p: [f32; 3]| bevy_from_bg3(k, p) - Vec3::Y * lock;
+    // WoW's ground under a point: the terrain when it lies near the point's mapped height (else
+    // the mapped height, for floors of buildings and bridges, which the projection's slab finds).
+    let ground = |p: Vec3| {
+        world.terrain_height_under(p).filter(|g| (g - p.y).abs() < SNAP).map_or(p, |g| Vec3::new(p.x, g, p.z))
+    };
+    let step_max = piece_len(c, &route.segments);
+    let mut pieces = 0;
+    for s in &route.segments {
+        let (a, b) = (map(s.start), map(s.end));
+        let flat = Vec2::new(b.x - a.x, b.z - a.z);
+        let len = flat.length();
+        if len < 0.01 || pieces >= MAX_PIECES {
+            continue;
+        }
+        let dir = flat / len;
+        let n = ((len / step_max).ceil() as usize).clamp(1, MAX_PIECES - pieces);
+        pieces += n;
+        let step = len / n as f32;
+        let half = (s.radius / YD).max(0.01);
+        let (d0, d1) = (s.dash[0][2], s.dash[1][2]);
+        for i in 0..n {
+            let tm = (i as f32 + 0.5) / n as f32;
+            // Dashes and gaps per piece (crisp ends), the fades per vertex.
+            let dg = dash_gap(c, s, d0 + (d1 - d0) * tm, tm);
+            if dg <= 0.0 {
+                continue;
+            }
+            let mid = ground(a.lerp(b, tm));
+            let reach = 1.0 + step;
+            // `in_frame`: x' = dx cos - dz sin along the segment, z' across it.
+            let frame = DecalFrame {
+                center: mid,
+                sin: -dir.y,
+                cos: dir.x,
+                min_x: -step * 0.5 - 0.01,
+                max_x: step * 0.5 + 0.01,
+                min_z: -half,
+                max_z: half,
+                min_y: -reach,
+                max_y: reach,
+            };
+            let at = strip.len();
+            let t_of = |x: f32| ((tm * len + x) / len).clamp(0.0, 1.0);
+            decals.project(strip, &frame, |p| dg * fade(c, d0 + (d1 - d0) * t_of(p.x)), |x, z| frame.rect_uv(x, z));
+            for v in &mut strip[at..] {
+                let t = t_of((Vec2::new(v.pos[0], v.pos[2]) - Vec2::new(mid.x, mid.z)).dot(dir));
+                for (ch, out) in v.color.iter_mut().take(3).enumerate() {
+                    *out = s.colour[0][ch] * (1.0 - t) + s.colour[1][ch] * t;
+                }
+            }
+        }
+    }
+    *anchor = route.segments.first().map_or(Vec3::ZERO, |s| map(s.start));
+}
+
+/// Draws the projected line every frame: alpha blended, unlit, unfogged, at the selection ring's
+/// rung (over the ground, under everything else).
+fn push_route(r: Option<Res<RouteLine>>, cam: Query<Entity, With<WorldCamera>>, mut draw: WorldEffectDraw) {
+    let Some(r) = r else { return };
+    if r.strip.is_empty() {
+        return;
+    }
+    let Ok(cam) = cam.single() else { return };
+    let mut batch = draw
+        .batch(cam, r.strip_tex.id())
+        .alpha()
+        .anchored(r.anchor)
+        .rung(benilla_world::sky_order::Rung::RING, benilla_world::sky_order::Rung::DECAL_RASTER)
+        .owner(r.owner);
+    batch.vertices(&r.strip);
+    batch.tris();
+}
