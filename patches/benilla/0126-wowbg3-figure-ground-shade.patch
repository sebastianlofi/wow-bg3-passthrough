+/// Patch 0126: the ground shade of BG3's figures for BG3's own lighting. WoW shades a unit as a whole by the baked
+/// shadow of the ground under it (`entity_shade.rs`); BG3 draws the party's figures itself, so their roots here
+/// ("wowbg3 Tav", "wowbg3 companion N": hidden, still sampled and ramped like any unit) say what WoW would show:
+/// `$WOW_BG3_LINK_DIR/wowshade.txt`, "WSH1 <count>" then one line a figure, "<x y z, WoW yards> <0 lit .. 1
+/// shadowed>", written whole (rename) when a figure moved 0.3 yd or its level 0.02.
+fn shade_export(figures: &Query<(&Name, &GlobalTransform, &benilla_world::entity_shade::GroundShade)>) {
+    static LAST: std::sync::Mutex<Vec<[f32; 4]>> = std::sync::Mutex::new(Vec::new());
+    let Some(dir) = std::env::var_os("WOW_BG3_LINK_DIR") else { return };
+    let mut now: Vec<[f32; 4]> = figures
+        .iter()
+        .filter(|(name, _, _)| name.as_str().starts_with("wowbg3 "))
+        .map(|(_, gt, shade)| {
+            let p = benilla_assets::coords::bevy_to_wow(gt.translation());
+            [p[0], p[1], p[2], shade.shadowed()]
+        })
+        .collect();
+    now.sort_by(|a, b| a.partial_cmp(b).unwrap_or(std::cmp::Ordering::Equal));
+    let Ok(mut last) = LAST.lock() else { return };
+    let same = last.len() == now.len()
+        && last.iter().zip(now.iter()).all(|(a, b)| {
+            (a[0] - b[0]).abs() < 0.3 && (a[1] - b[1]).abs() < 0.3 && (a[2] - b[2]).abs() < 0.3 && (a[3] - b[3]).abs() < 0.02
+        });
+    if same {
+        return;
+    }
+    let mut text = format!("WSH1 {}\n", now.len());
+    for f in &now {
+        text.push_str(&format!("{:.2} {:.2} {:.2} {:.3}\n", f[0], f[1], f[2], f[3]));
+    }
+    let path = std::path::Path::new(&dir).join("wowshade.txt");
+    let tmp = path.with_extension("tmp");
+    if std::fs::write(&tmp, text).is_ok() && std::fs::rename(&tmp, &path).is_ok() {
+        *last = now;
+    }
+}
