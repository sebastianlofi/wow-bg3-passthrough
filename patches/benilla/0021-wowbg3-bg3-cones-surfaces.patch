-            }
-        }
-        let fov_key = k.fov.round().clamp(1.0, 180.0) as u32;
-        let tex = textures.entry(fov_key).or_insert_with(|| images.add(fan_texture(fov_key as f32))).clone();
-        let r = k.range / YD;
-        let hw = half_width(r, fov_key as f32);
-        let dir = Vec2::new(-yaw.sin(), -yaw.cos());
-        let perp = Vec2::new(-dir.y, dir.x);
-        let mut strip = Vec::new();
-        let (nx, nz) = ((r / TILE).ceil().max(1.0) as usize, (2.0 * hw / TILE).ceil().max(1.0) as usize);
-        let (tx, tz) = (r / nx as f32, 2.0 * hw / nz as f32);
-        for i in 0..nx {
