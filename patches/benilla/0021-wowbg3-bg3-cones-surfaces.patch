-/// Draws the projected cones every frame: alpha blended, unlit, unfogged, at the selection ring's
-/// rung (over the ground, under everything else), like BG3's route line.
-fn push_cones(c: Option<Res<Cones>>, cam: Query<Entity, With<WorldCamera>>, mut draw: WorldEffectDraw) {
-    let Some(c) = c else { return };
-    if c.drawn.is_empty() {
-        return;
-    }
-    let Ok(cam) = cam.single() else { return };
-    for d in c.drawn.values() {
-        if d.strip.is_empty() {
-            continue;
-        }
-        let mut batch = draw
-            .batch(cam, d.tex.id())
-            .alpha()
-            .anchored(d.at)
-            .rung(benilla_world::sky_order::Rung::RING, benilla_world::sky_order::Rung::DECAL_RASTER)
-            .owner(c.owner);
-        batch.vertices(&d.strip);
-        batch.tris();
-    }
-}
