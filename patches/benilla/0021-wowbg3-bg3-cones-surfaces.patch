-//! WOW-BG3 (local fork, patch 0020): enemy vision cones on WoW's ground. From
-//! playtesting: the cones must show, while sneaking and with Shift. BG3 drew none over
-//! the void (harness: a sneaking Tav, a hostile wolf stand-in in view, Shift held: no cone
-//! in BG3's own frame and no draw for one), and one drawn by BG3 would lie on BG3's floor, not on
-//! WoW's hills. `Cones.lua` (BG3's client) lists the hostile mobs whose stand-in would show one in
-//! `cones.bin` in the link folder: "CON1", seq u32, flags u32 (1 Tav sneaking, 2 Shift held), n u32,
-//! n x (guid hi u32, guid lo u32, sight range f32 metres, field of view f32 degrees, flags u32),
-//! seq again. Each cone is a fan at the WoW mob, along its facing (its stand-in looks the same way,
-//! `Mirrors.lua`), as long as BG3's sight range and as wide as its field of view, projected onto
-//! WoW's receiving surfaces in tiles (the route line's ground-decal projector) so it lies on hills,
-//! in BG3's red, unlit and unfogged. A file older than [`STALE_SECS`] (BG3 or world mode gone)
-//! shows nothing. Child of `wowbg3_fx`.
-
-use std::collections::HashMap;
-use std::path::PathBuf;
-
-use benilla_world::decal::{DecalFrame, WorldDecal};
-use benilla_world::particles::buffer::{begin_effect_frame, EffectVertex, WorldEffectDraw};
-use benilla_world::view::WorldCamera;
-use benilla_world::world_point::WorldPoint;
-use bevy::asset::RenderAssetUsages;
-use bevy::prelude::*;
-use bevy::render::render_resource::{Extent3d, TextureDimension, TextureFormat};
-
-use crate::net::{Guid, SelfPlayer};
-
-/// Metres per yard (BG3 to WoW).
-const YD: f32 = 0.9144;
-/// A cone file this old (seconds) shows nothing: `Cones.lua` rewrites it at least once a second.
-const STALE_SECS: f32 = 2.5;
-/// Projection tile edge (yards): each tile is projected around WoW's ground at its middle.
-const TILE: f32 = 4.0;
-/// How far (yards) WoW's terrain may lie from the mob's height and still be the tile's ground.
-const SNAP: f32 = 6.0;
-/// Vertical reach (yards) of a tile's projection around its ground.
-const REACH: f32 = 3.0;
-/// BG3's red (cones of enemies that would attack), gamma RGB.
-const RED: [f32; 3] = [0.86, 0.12, 0.08];
-/// Texture size of a cone's shape (along x across).
-const TEX: u32 = 128;
-
-/// One cone from `cones.bin`.
-#[derive(Clone, Copy, Debug, PartialEq)]
-pub(crate) struct Cone {
-    pub(crate) guid: u64,
-    /// Sight range (metres) and field of view (degrees), BG3's.
-    pub(crate) range: f32,
-    pub(crate) fov: f32,
-}
-
-/// Decodes `cones.bin`: (seq, flags, cones), `None` when torn or foreign.
-pub(crate) fn decode_cones(b: &[u8]) -> Option<(u32, u32, Vec<Cone>)> {
-    const REC: usize = 20;
-    if b.len() < 20 || &b[0..4] != b"CON1" {
-        return None;
-    }
-    let u = |o: usize| b.get(o..o + 4).map(|s| u32::from_le_bytes(s.try_into().unwrap()));
-    let f = |o: usize| b.get(o..o + 4).map(|s| f32::from_le_bytes(s.try_into().unwrap()));
-    let (seq, flags, n) = (u(4)?, u(8)?, u(12)? as usize);
-    if n > 256 || b.len() != 16 + REC * n + 4 || u(16 + REC * n)? != seq {
-        return None;
-    }
-    let mut cones = Vec::with_capacity(n);
-    for i in 0..n {
-        let o = 16 + REC * i;
-        let (range, fov) = (f(o + 8)?, f(o + 12)?);
-        if !(range.is_finite() && range > 0.0 && range < 200.0 && fov.is_finite() && fov > 0.0) {
-            continue;
-        }
-        cones.push(Cone { guid: (u64::from(u(o)?) << 32) | u64::from(u(o + 4)?), range, fov: fov.min(180.0) });
-    }
-    Some((seq, flags, cones))
-}
-
-/// The fan's half-width across its frame (yards) for range `r` (yards) and field of view `fov`
-/// (degrees, at most 180).
-pub(crate) fn half_width(r: f32, fov: f32) -> f32 {
-    r * (fov.to_radians() * 0.5).sin().max(0.05)
-}
-
-/// The fan's weight at (x along the facing, z across) for range `r` and field of view `fov`:
-/// a translucent fill, brighter toward the mob, and a stronger rim at the arc and the sides.
-pub(crate) fn fan_alpha(x: f32, z: f32, r: f32, fov: f32) -> f32 {
-    let d = (x * x + z * z).sqrt() / r;
-    let half = fov.to_radians() * 0.5;
-    let ang = z.abs().atan2(x);
-    if d > 1.0 || ang > half {
-        return 0.0;
-    }
-    let rim_arc = (1.0 - d) * r; // yards from the arc
-    let rim_side = (half - ang) * d * r; // about yards from the nearer side
-    let rim = rim_arc.min(rim_side);
-    let fill = 0.16 + 0.14 * (1.0 - d);
-    if rim < 0.35 { 0.62 } else { fill }
-}
-
-/// A cone's shape for one field of view: u along the facing (0 the mob, 1 the range), v across
-/// (0..1 over twice the half-width), white with the fan's weight in alpha.
-fn fan_texture(fov: f32) -> Image {
-    // Drawn for a range of 16 m (the rim's width in yards scales with it; close enough for 11 to 20 m).
-    let r = 16.0 / YD;
-    let hw = half_width(r, fov);
-    let mut px = Vec::with_capacity((TEX * TEX * 4) as usize);
-    for vy in 0..TEX {
-        let z = ((vy as f32 + 0.5) / TEX as f32 * 2.0 - 1.0) * hw;
-        for ux in 0..TEX {
-            let x = (ux as f32 + 0.5) / TEX as f32 * r;
-            let a = fan_alpha(x, z, r, fov);
-            px.extend_from_slice(&[255, 255, 255, (a * 255.0).round() as u8]);
-        }
-    }
-    Image::new(
-        Extent3d { width: TEX, height: TEX, depth_or_array_layers: 1 },
-        TextureDimension::D2,
-        px,
-        TextureFormat::Rgba8Unorm,
-        RenderAssetUsages::RENDER_WORLD,
-    )
-}
-
-/// A projected cone.
-struct Drawn {
-    /// Where it was projected from: the mob's position, facing (radians) and the receiving surfaces.
-    at: Vec3,
-    yaw: f32,
-    surfaces: usize,
-    strip: Vec<EffectVertex>,
-    tex: Handle<Image>,
-}
-
-#[derive(Resource)]
-struct Cones {
-    path: PathBuf,
-    frame: u64,
-    stamp: Option<std::time::SystemTime>,
-    last_seq: u32,
-    flags: u32,
-    list: Vec<Cone>,
-    drawn: HashMap<u64, Drawn>,
-    textures: HashMap<u32, Handle<Image>>,
-    owner: Entity,
-    logged: u32,
-}
-
-pub(super) fn build(app: &mut App, link_dir: Option<PathBuf>) {
-    let Some(dir) = link_dir else { return };
-    let path = dir.join("cones.bin");
-    app.add_systems(Startup, move |mut commands: Commands| {
-        let owner = commands.spawn(Name::new("wowbg3 vision cones")).id();
-        commands.insert_resource(Cones {
-            path: path.clone(),
-            frame: 0,
-            stamp: None,
-            last_seq: 0,
-            flags: 0,
-            list: Vec::new(),
-            drawn: HashMap::new(),
-            textures: HashMap::new(),
-            owner,
-            logged: 0,
-        });
-    })
-    .add_systems(Update, (read_cones, project_cones.after(read_cones)))
-    .add_systems(PostUpdate, push_cones.after(begin_effect_frame));
-}
-
-fn read_cones(c: Option<ResMut<Cones>>) {
-    let Some(mut c) = c else { return };
-    c.frame += 1;
-    if c.frame % 3 != 0 {
-        return;
-    }
-    let md = std::fs::metadata(&c.path).ok();
-    let modified = md.as_ref().and_then(|m| m.modified().ok());
-    let fresh = modified.is_some_and(|m| m.elapsed().is_ok_and(|e| e.as_secs_f32() < STALE_SECS));
-    if !fresh {
-        if !c.list.is_empty() || c.flags != 0 {
-            c.list.clear();
-            c.flags = 0;
-            c.drawn.clear();
-        }
-        return;
-    }
-    if modified == c.stamp {
-        return;
-    }
-    let Ok(raw) = std::fs::read(&c.path) else { return };
-    let Some((seq, flags, list)) = decode_cones(&raw) else { return };
-    c.stamp = modified;
-    if seq == c.last_seq {
-        return;
-    }
-    c.last_seq = seq;
-    if list != c.list || flags != c.flags {
-        if c.logged < 20 && list.len() != c.list.len() {
-            c.logged += 1;
-            info!(
-                "wowbg3 cones: {} cones (Tav sneaking {}, Shift {}){}",
-                list.len(),
-                flags & 1 != 0,
-                flags & 2 != 0,
-                list.first().map_or(String::new(), |k| format!(", first {:016x} {:.1} m {:.0} degrees", k.guid, k.range, k.fov))
-            );
-        }
-        c.drawn.retain(|g, _| list.iter().any(|k| k.guid == *g));
-        c.list = list;
-        c.flags = flags;
-    }
-}
