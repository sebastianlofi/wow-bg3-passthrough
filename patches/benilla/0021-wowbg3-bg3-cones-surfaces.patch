-    if c.list.is_empty() {
-        if !c.drawn.is_empty() {
-            c.drawn.clear();
-        }
-        return;
-    }
-    let surfaces = decals.receiver_count();
-    let Cones { list, drawn, textures, .. } = &mut *c;
-    for k in list.iter() {
-        let Some((_, tf)) = units.iter().find(|(g, _)| g.0 == k.guid) else {
-            drawn.remove(&k.guid);
-            continue;
-        };
-        let at = tf.translation;
-        // WoW orientation: a unit at yaw o faces (-sin o, 0, -cos o) in Bevy.
-        let yaw = tf.rotation.to_euler(EulerRot::YXZ).0;
-        if let Some(d) = drawn.get(&k.guid) {
-            let turned = ((d.yaw - yaw + std::f32::consts::PI).rem_euclid(std::f32::consts::TAU) - std::f32::consts::PI).abs();
-            if d.surfaces == surfaces && d.at.distance_squared(at) < 0.15 * 0.15 && turned < 0.03 {
