+/// Patch 0021: the inline textures' FXT1 copies out of the blob, each draw's key renamed to its
+/// content's ([`SIGHT_INLINE`]); a key that does not fit the blob becomes 3 (neutral).
+fn inline_textures(f: &mut FxFrame) {
+    let mut named: HashMap<u64, u64> = HashMap::new();
+    for d in &mut f.draws {
+        for s in &mut d.sets {
+            for slot in &mut s.slots {
+                let k = match &mut slot.res {
+                    SlotRes::Image(k) | SlotRes::Combined(k, _) => k,
+                    _ => continue,
+                };
+                if *k & SIGHT_INLINE != SIGHT_INLINE {
+                    continue;
+                }
+                let raw = *k;
+                *k = *named.entry(raw).or_insert_with(|| {
+                    let at = (raw & 0xffff_ffff) as usize;
+                    let size = ((raw >> 32) & 0x3fff_ffff) as usize;
+                    let Some(b) = f.blob.get(at..at.saturating_add(TexFile::DATA).saturating_add(size)) else { return 3 };
+                    if b.len() != TexFile::DATA + size || &b[..4] != b"FXT1" {
+                        return 3;
+                    }
+                    let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+                    for &x in b {
+                        h ^= u64::from(x);
+                        h = h.wrapping_mul(0x0100_0000_01b3);
+                    }
+                    let key = INLINE_KEY | (h & !SIGHT_INLINE);
+                    if !f.inline.iter().any(|(c, _)| *c == key) {
+                        f.inline.push((key, Arc::new(b.to_vec())));
+                    }
+                    key
+                });
+            }
+        }
+    }
 }
 
