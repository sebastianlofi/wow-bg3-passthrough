+// ── WOW-BG3 patch 0090: BG3's see-through, ported from its wall materials ──
+// BG3 cuts what stands between its camera and the character in every wall's own material shader
+// (`Base_*_FOR` in Materials.pak): two capsules from an engine block, each from one shared point to
+// a target with a size `R`, and the cloud noise `REF_Cloud_B` on the wall's own texture
+// coordinates. `n = 2·cloud(uv·2).r − 1`; per capsule `v = clamp(max(d + 0.5·n, 0) / R, 0, 1)`, `d`
+// the fragment's distance to the segment (its closest point clamped to the segment's box, BG3's
+// own clamp); the fragment goes where the smaller `v` is below one half. The noise is fixed to the
+// wall and the capsule moves with her, so the edge eats into the wall in ragged strokes as she
+// walks. Here the shared point is the eye, rows 21 to 24 of the shared light carry the capsules
+// (`lighting::global_light`, `crate::see_through`), and the noise is the buffer's last region.
+// The one change: BG3 opts each object in, so its floors are never cut; WoW draws floors and walls
+// with one shader, so only what is nearer the eye than the target (by `cut_params.y`) is cut.
+
+// Where this struct's last array starts, in rows: the noise's row (`cut_params.x`) is reached from
+// it. Checked against the buffer's regions by `global_light`'s tests.
+const WOW_SEE_TAIL: u32 = 57881u;
+
+// One texel of the noise (`REF_Cloud_B`'s red, 512 x 512, wrapping), 0 to 1.
+fn wow_see_texel(base: u32, p: vec2<i32>) -> f32 {
+    let k = u32(p.y & 511) * 512u + u32(p.x & 511);
+    return wow_light.see_tail[base - WOW_SEE_TAIL + k / 4u][k % 4u];
+}
+
+// The noise at `uv`, filtered as BG3's sampler does (bilinear, wrapping); 0.5 (no change to the
+// edge) while there is none.
+fn wow_see_noise(uv: vec2<f32>) -> f32 {
+    let base = u32(wow_light.cut_params.x);
+    if (base == 0u) {
+        return 0.5;
+    }
+    let p = fract(uv) * 512.0 - 0.5;
+    let i = vec2<i32>(floor(p));
+    let f = p - floor(p);
+    let a = mix(wow_see_texel(base, i), wow_see_texel(base, i + vec2<i32>(1, 0)), f.x);
+    let b = mix(wow_see_texel(base, i + vec2<i32>(0, 1)), wow_see_texel(base, i + vec2<i32>(1, 1)), f.x);
+    return mix(a, b, f.y);
+}
+
+// One capsule's coverage at `world_pos`, BG3's line for line: 1 untouched, under 0.5 cut.
+fn wow_see_capsule(c: vec4<f32>, eye: vec3<f32>, world_pos: vec3<f32>, n: f32, amp: f32, near: f32) -> f32 {
+    if (c.w <= 0.0) {
+        return 1.0;
+    }
+    let ab = c.xyz - eye;
+    let ap = world_pos - eye;
+    let ab2 = dot(ab, ab);
+    if (ab2 < 1e-4) {
+        return 1.0;
+    }
+    // Only what stands between the camera and her, past `near` on both of two tests. Toward the
+    // camera along the line to her: the ground she stands on and the floor in front of her feet lie
+    // below that line's start and stay. And in front of her on the ground plane, toward the camera:
+    // nothing behind her stays open at any height. (With the first test alone, a camera looking down
+    // steeply took the upper part of the wall behind her: in a playtest, "the circle
+    // sometimes opens up the wall BEHIND the avatar depending on the camera angle".)
+    let from_her = world_pos - c.xyz;
+    let to_eye = eye - c.xyz;
+    if (dot(from_her, normalize(to_eye)) < near) {
+        return 1.0;
+    }
+    let level = vec3<f32>(to_eye.x, 0.0, to_eye.z);
+    if (dot(level, level) > 1e-6 && dot(from_her, normalize(level)) < near) {
+        return 1.0;
+    }
+    let t = dot(ap, ab) / ab2;
+    let q = clamp(eye + ab * t, min(eye, c.xyz), max(eye, c.xyz));
+    return clamp(max(n * amp + distance(world_pos, q), 0.0) / c.w, 0.0, 1.0);
+}
+
+// Does BG3's see-through take this fragment? (BG3: `v · k − 0.5 · k < 0`, `k` the object's own
+// see-through scalar, 1 for whatever WoW draws through here.)
+fn wow_cut(world_pos: vec3<f32>, uv: vec2<f32>) -> bool {
+    let eye_for = wow_light.cut_eye;
+    // A view drawn from somewhere else (a portrait booth, the minimap bake, the login backdrop)
+    // shares this buffer and must not be cut; the eye the capsules start at says which.
+    let eye = view.world_position.xyz;
+    if (distance(eye, eye_for.xyz) > 0.25) {
+        return false;
+    }
+    let p = wow_light.cut_params;
+    if (wow_light.cut_a.w <= 0.0 && wow_light.cut_b.w <= 0.0) {
+        return false;
+    }
+    let n = wow_see_noise(uv * p.z) * 2.0 - 1.0;
+    let v = min(wow_see_capsule(wow_light.cut_a, eye, world_pos, n, eye_for.w, p.y),
+                wow_see_capsule(wow_light.cut_b, eye, world_pos, n, eye_for.w, p.y));
+    return v < 0.5;
+}
