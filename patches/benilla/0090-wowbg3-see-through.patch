diff --git a/crates/benilla-app/src/wowbg3_see.rs b/crates/benilla-app/src/wowbg3_see.rs
new file mode 100644
index 0000000..e459787
--- /dev/null
+++ b/crates/benilla-app/src/wowbg3_see.rs
@@ -0,0 +1,286 @@
+//! WOW-BG3 patch 0090: BG3's see-through, the producer half.
+//!
+//! BG3 cuts the geometry between its camera and the controlled character away with two capsules and
+//! a cloud noise in every wall's own material (the law is in [`benilla_world::see_through`]). In
+//! world mode that geometry is WoW's and benilla draws it, so the cut is made here: this module
+//! aims the capsules, loads the noise, and [`benilla_world::see_through::SeeThrough`] carries them
+//! to `lighting::global_light`, which packs them into the shared light buffer that `terrain.wgsl`,
+//! `static_gx.wgsl` and `wow_model.wgsl` read.
+//!
+//! Where they point: from the eye to BG3's character (`tav.bin`, the same position her figure is
+//! drawn at), at chest height. In a fight BG3's camera leaves her to follow whoever's turn it is, so
+//! the second capsule can follow what the camera looks at — the point where its forward ray crosses
+//! her height plane, which is the active combatant's ground when the camera has centred on one.
+//! That one is off by default (`look=1` switches it on): with the camera looking ahead while
+//! walking it eats into whatever stands in the distance, which nobody has asked for.
+//!
+//! The noise: `$WOW_BG3_LINK_DIR/see-noise.r8`, BG3's `REF_Cloud_B` red channel as 512 x 512 bytes,
+//! which the mod makes from the player's own BG3 data (nothing of BG3's ships with benilla). Until
+//! it is there the cut has a clean edge, tried again every half second.
+//!
+//! Tuning without a rebuild: `$WOW_BG3_LINK_DIR/seethrough.txt`, `key=value` a line, re-read every
+//! half second. The same keys are environment variables with a `WOW_BG3_SEE_` prefix
+//! (`WOW_BG3_SEE_RADIUS=4.4`), and `WOW_BG3_SEE=0` switches the whole thing off.
+
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use benilla_world::see_through::{Cut, SeeNoise, SeeThrough, SEE_NOISE_SIZE};
+use benilla_world::view::WorldCamera;
+use bevy::camera::Projection;
+use bevy::prelude::*;
+
+/// Her chest above her feet (yd): the plugin's own `kChestM` (1.37 m), which is where its eye
+/// clearance measures from, so both ends of the camera agree on what "she" is.
+const CHEST: f32 = 1.5;
+
+/// The see-through's settings. Defaults chosen for BG3's orbit camera, 5 to 12 yd from her.
+#[derive(Resource, Clone, Copy, Debug)]
+pub(crate) struct SeeSettings {
+    on: bool,
+    /// BG3's capsule size `R` in yards: the cut reaches `R / 2` from the line to her, give or take
+    /// the noise. BG3's own value is written by its engine straight into GPU memory and could not
+    /// be read (a scan of its buffers); this one is matched by eye to BG3's frames.
+    radius: f32,
+    /// The cap that keeps the cut a window in the picture instead of the whole picture: its reach
+    /// (`R / 2`) never exceeds this share of the screen's half height at her distance. At BG3's
+    /// closest camera (6.75 yd from her chest, 55 degrees of vertical field) an uncapped cut is
+    /// wider than the screen, and then everything in front of her goes, the ground included:
+    /// A playtest showed exactly that, "the ground is going see-through at the bottom there, that
+    /// doesn't make sense".
+    screen: f32,
+    /// Whether WoW's terrain is cut with the rest. Off: a hill or the ground in front of her is
+    /// never removed, which is what the eye clearance already keeps the camera out of; the cut is
+    /// then doodads, buildings and props alone.
+    terrain: bool,
+    near: f32,
+    /// The noise's reach in yards: BG3's `0.5 · n` in its metres.
+    amp: f32,
+    /// The noise's scale on texture coordinates: BG3's `uv · 2`.
+    scale: f32,
+    /// The second capsule on what the camera looks at (off by default; see the module note).
+    look: bool,
+    /// How far the look point must be from her before the second capsule is used (yd).
+    look_apart: f32,
+}
+
+impl Default for SeeSettings {
+    fn default() -> Self {
+        Self {
+            on: true,
+            radius: 4.4,
+            screen: 0.45,
+            terrain: false,
+            // Her body's depth: a wall she stands against lies within it and must never count as
+            // in front of her (0.15 left a torn patch on the wall at her shoulder).
+            near: 0.6,
+            amp: 0.5 / 0.9144,
+            scale: 2.0,
+            look: false,
+            look_apart: 2.5,
+        }
+    }
+}
+
+impl SeeSettings {
+    /// One `key=value`; unknown keys are ignored so a file can carry notes.
+    fn set(&mut self, key: &str, value: &str) {
+        let num = value.parse::<f32>().ok();
+        let flag = || matches!(value, "1" | "on" | "true" | "yes");
+        match key {
+            "on" => self.on = flag(),
+            "look" => self.look = flag(),
+            "terrain" => self.terrain = flag(),
+            "radius" => self.radius = num.unwrap_or(self.radius),
+            "screen" => self.screen = num.unwrap_or(self.screen),
+            "near" => self.near = num.unwrap_or(self.near),
+            "amp" => self.amp = num.unwrap_or(self.amp),
+            "scale" => self.scale = num.unwrap_or(self.scale),
+            "apart" => self.look_apart = num.unwrap_or(self.look_apart),
+            _ => {}
+        }
+    }
+
+    fn from_env() -> Self {
+        let mut s = Self::default();
+        if std::env::var_os("WOW_BG3_SEE").is_some_and(|v| v == "0") {
+            s.on = false;
+        }
+        for key in ["radius", "screen", "terrain", "near", "amp", "scale", "look", "apart"] {
+            if let Ok(v) = std::env::var(format!("WOW_BG3_SEE_{}", key.to_uppercase())) {
+                s.set(key, v.trim());
+            }
+        }
+        s
+    }
+}
+
+/// The live settings file and when it was last read, and the noise file until it is loaded.
+#[derive(Resource)]
+struct SeeFile {
+    path: PathBuf,
+    next: Instant,
+    seen: Option<std::time::SystemTime>,
+    noise: Option<PathBuf>,
+}
+
+/// BG3's noise from `see-noise.r8` (512 x 512 bytes, the red channel), or `None` while it is not
+/// there or not that size.
+fn load_noise(path: &std::path::Path) -> Option<SeeNoise> {
+    let bytes = std::fs::read(path).ok()?;
+    (bytes.len() == SEE_NOISE_SIZE * SEE_NOISE_SIZE)
+        .then(|| SeeNoise(Arc::new(bytes.iter().map(|&b| f32::from(b) / 255.0).collect())))
+}
+
+pub(crate) fn build(app: &mut App, dir: PathBuf) {
+    let s = SeeSettings::from_env();
+    info!(
+        "wowbg3 see-through: {} ({:?}); tune it live in {:?}",
+        if s.on { "on" } else { "off" },
+        s,
+        dir.join("seethrough.txt")
+    );
+    app.insert_resource(s)
+        .insert_resource(SeeFile {
+            path: dir.join("seethrough.txt"),
+            next: Instant::now(),
+            seen: None,
+            noise: Some(dir.join("see-noise.r8")),
+        })
+        .add_systems(
+            PostUpdate,
+            (read_settings, aim)
+                .chain()
+                // After the frame's final camera pose (patch 0026's `keep_bg3_pose`) and before
+                // `lighting::global_light::build_light_data`, which runs after propagation.
+                .after(crate::wowbg3_lead::keep_bg3_pose)
+                .before(bevy::transform::TransformSystems::Propagate),
+        );
+}
+
+/// Re-reads `seethrough.txt` when it has changed, at most twice a second, and loads the noise
+/// once it is there.
+fn read_settings(mut commands: Commands, mut f: ResMut<SeeFile>, mut s: ResMut<SeeSettings>) {
+    if Instant::now() < f.next {
+        return;
+    }
+    f.next = Instant::now() + Duration::from_millis(500);
+    if let Some(path) = f.noise.clone() {
+        if let Some(noise) = load_noise(&path) {
+            info!("wowbg3 see-through: BG3's noise from {path:?}");
+            commands.insert_resource(noise);
+            f.noise = None;
+        }
+    }
+    let Ok(meta) = std::fs::metadata(&f.path) else {
+        // The file is gone: back to the environment's settings, once. Without this a file that said
+        // `on=0` and was then deleted kept the cut off for the rest of the session.
+        if f.seen.take().is_some() {
+            *s = SeeSettings::from_env();
+            info!("wowbg3 see-through: {:?} removed, back to {:?}", f.path, *s);
+        }
+        return;
+    };
+    let when = meta.modified().ok();
+    if when == f.seen {
+        return;
+    }
+    f.seen = when;
+    let Ok(text) = std::fs::read_to_string(&f.path) else {
+        return;
+    };
+    let mut fresh = SeeSettings::from_env();
+    for line in text.lines() {
+        let line = line.split('#').next().unwrap_or("").trim();
+        if let Some((k, v)) = line.split_once('=') {
+            fresh.set(k.trim(), v.trim());
+        }
+    }
+    info!("wowbg3 see-through: {:?} read: {fresh:?}", f.path);
+    *s = fresh;
+}
+
+/// Aims this frame's capsules.
+fn aim(
+    s: Res<SeeSettings>,
+    tav: Option<Res<crate::wowbg3_lead::TavFollow>>,
+    cam: Query<(&Transform, &Projection), With<WorldCamera>>,
+    mut out: ResMut<SeeThrough>,
+) {
+    let mut want = SeeThrough {
+        near: s.near.max(0.0),
+        noise_amp: s.amp.max(0.0),
+        noise_scale: s.scale,
+        terrain: s.terrain,
+        ..SeeThrough::default()
+    };
+    // Off, no world mode (no fresh `tav.bin`) or no camera: every size stays 0, which the shaders
+    // read as "cut nothing".
+    let here = crate::wowbg3_lead::tav_if_fresh(tav.as_deref());
+    if let (true, Some(at), Ok((tf, proj))) = (s.on, here, cam.single()) {
+        let chest = at + Vec3::Y * CHEST;
+        let eye = tf.translation;
+        want.eye = eye;
+        want.cuts[0] = Cut { at: chest, radius: radius_at(&s, proj, eye.distance(chest)) };
+        if s.look {
+            if let Some(look) = look_point(eye, *tf.forward(), chest.y) {
+                if look.distance(chest) > s.look_apart {
+                    want.cuts[1] = Cut { at: look, radius: radius_at(&s, proj, eye.distance(look)) };
+                }
+            }
+        }
+    }
+    if *out != want {
+        *out = want;
+    }
+}
+
+/// The capsule's size `R` in yards for a target `dist` away: the asked-for one, capped so that its
+/// reach (`R / 2`) on screen is never wider than `screen` of the half height (see
+/// [`SeeSettings::screen`]).
+fn radius_at(s: &SeeSettings, proj: &Projection, dist: f32) -> f32 {
+    let half = match proj {
+        Projection::Perspective(p) => (p.fov * 0.5).tan(),
+        _ => 0.5,
+    };
+    s.radius.min(2.0 * s.screen.max(0.0) * half * dist)
+}
+
+/// Where the camera's forward ray crosses the horizontal plane at `height`, while the camera looks
+/// down at it steeply enough for the crossing to mean anything and near enough to be in the scene.
+fn look_point(eye: Vec3, forward: Vec3, height: f32) -> Option<Vec3> {
+    let down = -forward.y;
+    if down < 0.2 {
+        return None;
+    }
+    let t = (eye.y - height) / down;
+    (t > 0.5 && t < 120.0).then(|| eye + forward * t)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_shallow_camera_has_no_look_point() {
+        assert!(look_point(Vec3::new(0.0, 10.0, 0.0), Vec3::new(1.0, -0.1, 0.0).normalize(), 1.5).is_none());
+    }
+
+    #[test]
+    fn a_camera_looking_down_meets_the_plane_where_it_points() {
+        let p = look_point(Vec3::new(0.0, 11.5, 0.0), Vec3::new(0.0, -1.0, 0.0), 1.5).expect("a point");
+        assert!((p - Vec3::new(0.0, 1.5, 0.0)).length() < 1e-3, "{p:?}");
+    }
+
+    #[test]
+    fn a_key_that_is_not_ours_leaves_the_settings_alone() {
+        let mut s = SeeSettings::default();
+        let before = s.radius;
+        s.set("colour", "red");
+        s.set("radius", "nonsense");
+        assert_eq!(s.radius, before);
+        s.set("radius", "6.25");
+        assert!((s.radius - 6.25).abs() < 1e-6);
+    }
+}
