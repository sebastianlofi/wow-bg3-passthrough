+//! WOW-BG3 patch 0090: the see-through, the engine's half, ported from BG3's own wall materials.
+//!
+//! BG3 cuts the geometry between its camera and the character away, so she is never hidden by a
+//! tree, a hut or a roof. It does it in every wall's own material shader (`Base_*_FOR` and kin in
+//! `Materials.pak`; read with a SPIR-V disassembler, its names from the DX12 build): an
+//! engine block (set 0, binding 6) carries two **capsules**, each from one shared point to a target
+//! with a size `R`, and a texture the materials bind by id, `REF_Cloud_B` (512 x 512 cloud noise).
+//! Per fragment: `n = 2·cloud(uv·2).r − 1`; for each capsule the distance `d` from the fragment to
+//! the segment (its closest point clamped to the segment's box, as BG3 does), then
+//! `v = clamp(max(d + 0.5·n, 0) / R, 0, 1)`; the fragment is discarded where the smaller `v` is
+//! below one half. Seen down the line of sight a capsule is the "circle" round her, and because the
+//! noise is fixed to the wall's own texture coordinates while the capsule moves with her, its edge
+//! eats into the wall in ragged strokes as she walks: the effect is the noise, not a dither.
+//!
+//! In world mode the occluder is WoW's and is drawn here, so the same law runs in WoW's shaders:
+//! [`crate::lighting::global_light`] packs this resource into the shared light buffer (rows 21 to
+//! 24) and uploads [`SeeNoise`] once into the buffer's last region, and `terrain.wgsl`,
+//! `static_gx.wgsl` and `wow_model.wgsl` (WMO batches alone) apply it. The shared point is the eye.
+//! One thing WoW lacks: BG3 opts each object in (`CanSeeThrough`), so its floors are never cut;
+//! WoW draws floors and walls with one shader, so a fragment is cut only when it is nearer the eye
+//! than the target by [`SeeThrough::near`].
+//!
+//! Who writes it: `benilla-app`'s `wowbg3_see`, from BG3's character (`tav.bin`) and the world
+//! camera, and the noise from `see-noise.r8` in the link folder (the mod makes it from the
+//! player's own BG3 data; nothing of BG3's ships with benilla). With [`SeeThrough::default`] (every
+//! size 0) the shaders take their old path.
+
+use std::sync::Arc;
+
+use bevy::prelude::*;
+use bevy::render::extract_resource::ExtractResource;
+
+/// One capsule: its target and its size.
+#[derive(Clone, Copy, Default, Debug, PartialEq)]
+pub struct Cut {
+    /// The capsule's far end in Bevy world space (the near end is the eye).
+    pub at: Vec3,
+    /// BG3's `R` in yards: the cut reaches `R / 2` from the segment, give or take the noise; `0`
+    /// switches this capsule off.
+    pub radius: f32,
+}
+
+/// This frame's see-through capsules. Two, as BG3's block has: the hero, and in a fight whoever
+/// the camera has moved on to.
+#[derive(Resource, Clone, Copy, Default, Debug, PartialEq)]
+pub struct SeeThrough {
+    pub cuts: [Cut; 2],
+    /// The eye the capsules start at: a view whose own eye is elsewhere (a portrait booth, the
+    /// minimap bake, the login backdrop) must not be cut, and comparing the eye is the one test that
+    /// needs nothing per view.
+    pub eye: Vec3,
+    /// How far in front of a target (yd) the cut stops, so the ground she stands on is never cut.
+    pub near: f32,
+    /// The noise's reach in yards: BG3's `0.5 · n` is in its metres, so 0.5 m.
+    pub noise_amp: f32,
+    /// The noise's scale on a mesh's texture coordinates: BG3's `uv · 2`.
+    pub noise_scale: f32,
+    /// Whether WoW's terrain is cut with the rest (`terrain.wgsl` reads it). Off by default: the
+    /// ground in front of her going see-through is not what anyone wants, and a hill between the
+    /// camera and her is already what the plugin's eye clearance moves the camera out of.
+    pub terrain: bool,
+}
+
+impl SeeThrough {
+    /// Is any capsule live? (`global_light` packs zeros otherwise, which the shaders read as off.)
+    pub fn live(&self) -> bool {
+        self.cuts.iter().any(|c| c.radius > 0.0)
+    }
+}
+
+/// BG3's `REF_Cloud_B` red channel, [`SEE_NOISE_SIZE`] squared, row-major, 0 to 1.
+#[derive(Resource, Clone, ExtractResource)]
+pub struct SeeNoise(pub Arc<Vec<f32>>);
+
+/// The noise's side in texels.
+pub const SEE_NOISE_SIZE: usize = 512;
+
+/// Registers the resource. The producer lives in `benilla-app`; a run without it leaves the
+/// default, and the shaders their old path.
+pub fn plugin(app: &mut App) {
+    app.init_resource::<SeeThrough>();
+}
