+// Does BG3's see-through take this fragment? (BG3: `v · k − 0.5 · k < 0`, `k` the object's own
+// see-through scalar, 1 for whatever WoW draws through here.)
+fn wow_cut(world_pos: vec3<f32>, uv: vec2<f32>) -> bool {
+    let eye_for = wow_light.cut_eye;
+    // A view drawn from somewhere else (a portrait booth, the minimap bake, the login backdrop)
+    // shares this buffer and must not be cut; the eye the capsules start at says which.
+    let eye = view.world_position.xyz;
+    if (distance(eye, eye_for.xyz) > 0.25) {
+        return false;
+    }
+    let p = wow_light.cut_params;
+    if (wow_light.cut_a.w <= 0.0 && wow_light.cut_b.w <= 0.0) {
+        return false;
+    }
+    let n = wow_see_noise(uv * p.z) * 2.0 - 1.0;
+    let v = min(wow_see_capsule(wow_light.cut_a, eye, world_pos, n, eye_for.w, p.y),
+                wow_see_capsule(wow_light.cut_b, eye, world_pos, n, eye_for.w, p.y));
+    return v < 0.5;
+}
