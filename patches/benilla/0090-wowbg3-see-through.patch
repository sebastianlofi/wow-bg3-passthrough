+// One capsule's coverage at `world_pos`, BG3's line for line: 1 untouched, under 0.5 cut.
+fn wow_see_capsule(c: vec4<f32>, eye: vec3<f32>, world_pos: vec3<f32>, n: f32, amp: f32, near: f32) -> f32 {
+    if (c.w <= 0.0) {
+        return 1.0;
+    }
+    let ab = c.xyz - eye;
+    let ap = world_pos - eye;
+    let ab2 = dot(ab, ab);
+    if (ab2 < 1e-4) {
+        return 1.0;
+    }
+    // Only what stands between the camera and her, past `near` on both of two tests. Toward the
+    // camera along the line to her: the ground she stands on and the floor in front of her feet lie
+    // below that line's start and stay. And in front of her on the ground plane, toward the camera:
+    // nothing behind her stays open at any height. (With the first test alone, a camera looking down
+    // steeply took the upper part of the wall behind her: in a playtest, "the circle
+    // sometimes opens up the wall BEHIND the avatar depending on the camera angle".)
+    let from_her = world_pos - c.xyz;
+    let to_eye = eye - c.xyz;
+    if (dot(from_her, normalize(to_eye)) < near) {
+        return 1.0;
+    }
+    let level = vec3<f32>(to_eye.x, 0.0, to_eye.z);
+    if (dot(level, level) > 1e-6 && dot(from_her, normalize(level)) < near) {
+        return 1.0;
+    }
+    let t = dot(ap, ab) / ab2;
+    let q = clamp(eye + ab * t, min(eye, c.xyz), max(eye, c.xyz));
+    return clamp(max(n * amp + distance(world_pos, q), 0.0) / c.w, 0.0, 1.0);
+}
