+// What a figure's fragment needs from its maps, fetched where derivatives are defined.
+struct TavFetch {
+    // The shading normal (normal map and detail, flipped toward the viewer on back faces), the
+    // geometric normal (flipped alike) and BG3's hair direction (world).
+    n: vec3<f32>,
+    ng: vec3<f32>,
+    hair_t: vec3<f32>,
+    // Roughness after BG3's specular antialiasing, specular level, metalness (a hair's backlit),
+    // occlusion; the extra map (a skin's profile data, a hair's scatter in .w).
+    rough: f32,
+    spec: f32,
+    metal: f32,
+    ao: f32,
+    extra: vec4<f32>,
+};
+
+// sRGB to linear: a debug view's value, which the frame's encode then shows as it is.
+fn tav_lin(c: vec3<f32>) -> vec3<f32> {
+    let x = max(c, vec3<f32>(0.0));
+    return select(pow((x + 0.055) / 1.055, vec3<f32>(2.4)), x / 12.92, x <= vec3<f32>(0.04045));
+}
+
+// Linear to sRGB (flag 16, `WOW_BG3_TAV_OUT=gamma`).
+fn tav_srgb(c: vec3<f32>) -> vec3<f32> {
+    let x = clamp(c, vec3<f32>(0.0), vec3<f32>(1.0));
+    return select(1.055 * pow(x, vec3<f32>(1.0 / 2.4)) - 0.055, x * 12.92, x <= vec3<f32>(0.0031308));
+}
+
+// WoW's light on an entity M2 for the normal n (the fragment's `lit_exterior`, the multiplier patch
+// 0006 puts on her albedo): the `Model2.bls` lobe at the entity's intensity when the sun is on,
+// else the FFP N·L.
+fn tav_wow_lit(n: vec3<f32>, L: vec3<f32>, intensity: f32, doodad: bool) -> vec3<f32> {
+    if (!doodad) {
+        return clamp(wow_light.light_ambient.rgb + wow_light.light_diffuse.rgb * max(dot(n, L), 0.0), vec3<f32>(0.0), vec3<f32>(1.0));
+    }
+    let quad = vec4<f32>(n.x * n.y, n.y * n.z, n.z * n.z, n.x * n.z);
+    let x2y2 = n.x * n.x - n.y * n.y;
+    let sun_dc = wow_light.grade.yzw * intensity;
+    let lobe = vec3<f32>(
+        wow_light.sh_c10_r.w + sun_dc.x
+            + intensity * (dot(wow_light.sh_c10_r.xyz, n) + dot(wow_light.sh_c13_r, quad) + wow_light.sh_c16.x * x2y2),
+        wow_light.sh_c10_g.w + sun_dc.y
+            + intensity * (dot(wow_light.sh_c10_g.xyz, n) + dot(wow_light.sh_c13_g, quad) + wow_light.sh_c16.y * x2y2),
+        wow_light.sh_c10_b.w + sun_dc.z
+            + intensity * (dot(wow_light.sh_c10_b.xyz, n) + dot(wow_light.sh_c13_b, quad) + wow_light.sh_c16.z * x2y2),
+    );
+    return clamp(lobe, vec3<f32>(0.0), vec3<f32>(1.0));
