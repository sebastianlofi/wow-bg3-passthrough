+
+// WoW's ambient alone (the lobe's DC without the sun's bands, or the FFP ambient).
+fn tav_wow_ambient(doodad: bool) -> vec3<f32> {
+    return clamp(
+        select(
+            wow_light.light_ambient.rgb,
+            vec3<f32>(wow_light.sh_c10_r.w, wow_light.sh_c10_g.w, wow_light.sh_c10_b.w),
+            doodad,
+        ),
+        vec3<f32>(0.0),
+        vec3<f32>(1.0),
+    );
