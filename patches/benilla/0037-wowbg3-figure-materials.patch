+        return tav_lin(nv * 0.5 + vec3<f32>(0.5));
+    } else if (dbg == 3u) {
+        return tav_lin(vec3<f32>(f.rough, f.metal, f.ao));
+    } else if (dbg == 4u) {
+        return specular;
+    } else if (dbg == 5u) {
+        return diffuse;
+    } else if (dbg == 6u) {
+        return tav_lin(f.extra.rgb);
+    }
+    // 0, or 7: the lit figure (7 without WoW's highlight, in the fragment; 8 is WoW's law there).
+    return diffuse + specular;
+}
