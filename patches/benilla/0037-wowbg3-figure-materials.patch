+// BG3's hair diffuse of the sun (UE4's): sqrt(albedo) / π, a wrapped N·L mixed with the
+// Kajiya-Kay term, times the scatter (G-buffer extra .w) and the colour toward full saturation in
+// shadow (`shadow` 1 = lit).
+fn tav_hair_diffuse(T: vec3<f32>, N: vec3<f32>, L: vec3<f32>, albedo: vec3<f32>, scatter: f32, shadow: f32) -> vec3<f32> {
+    let lum = max(dot(albedo, vec3<f32>(0.3, 0.59, 0.11)), 1e-4);
+    let tint = pow(max(abs(albedo / lum), vec3<f32>(1e-4)), vec3<f32>(1.0 - shadow * shadow));
