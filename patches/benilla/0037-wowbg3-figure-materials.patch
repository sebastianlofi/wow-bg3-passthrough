+
+// The light BG3's specular sees from the sun: its direction moved onto the sun's disc (0.0046 rad)
+// toward BG3's reflection vector, exactly as `ClusteredLighting` does (`reflect(V, N)`).
+fn tav_sun_disc(N: vec3<f32>, V: vec3<f32>, L: vec3<f32>) -> vec3<f32> {
+    let R = reflect(V, N);
+    let d = dot(L, R);
+    let s = R - L * d;
+    let disc = normalize(L * 0.99998945 + s * inverseSqrt(max(dot(s, s), 1e-12)) * 0.0045900648);
+    return select(R, disc, d < 0.99998945);
