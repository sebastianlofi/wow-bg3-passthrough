+            specular += TAV_PI * sun * tav_hair_spec(ht, V, L, albedo, f.rough, f.metal);
+        }
+    } else {
+        let metal = clamp(f.metal, 0.0, 1.0);
+        let diff_col = albedo * (1.0 - metal);
+        let f0 = mix(vec3<f32>(0.16 * f.spec * f.spec), albedo, metal);
+        var a2_a = pow(f.rough, 4.0);
+        var a2_b = a2_a;
+        var lobe_mix = 0.0;
+        let e_n = tav_wow_lit(N, L, intensity, doodad);
+        var e_diff = e_n;
+        if (model > 2.5) {
+            // Skin (model 3): the diffusion profile's two specular lobes (roughness scales of the raw
+            // roughness, at least 0.09, mixed toward the plain lobe by metalness as BG3 does), and
+            // the light diffused under the skin: BG3 blurs the lit skin on screen per colour by the
+            // profile; here each colour sees the normal map that much flattened toward the mesh's
+            // normal (the red farthest), the profile's scatter colour × distance deciding how much.
+            let r_raw = max(f.rough, 0.09);
+            let ra = max(clamp(m.tav_b.x * r_raw, 0.0, 1.0), 0.09);
+            let rb = max(clamp(m.tav_b.y * r_raw, 0.0, 1.0), 0.09);
+            let rr = f.rough * f.rough;
+            a2_a = pow(mix(ra * ra, rr, metal), 2.0);
+            a2_b = pow(mix(rb * rb, rr, metal), 2.0);
+            lobe_mix = m.tav_b.z;
+            // (The light at the mesh's normal mixed in per colour: WoW's lobe is smooth in the normal.)
+            let w = clamp(m.tav_c.xyz * (min(m.tav_b.w, 30.0) / 30.0) * 0.75, vec3<f32>(0.0), vec3<f32>(0.85));
+            e_diff = mix(e_n, tav_wow_lit(f.ng, L, intensity, doodad), w);
+        }
+        diffuse = diff_col * (max(e_diff - (1.0 - f.ao) * e_amb, vec3<f32>(0.0)) + e_point);
+        if (model > 2.5 && f.extra.a > 0.0) {
