+
+// The split-sum environment BRDF (Karis' analytic fit of the lookup table BG3 samples).
+fn tav_env_brdf(f0: vec3<f32>, r: f32, nov: f32) -> vec3<f32> {
+    let rr = r * vec4<f32>(-1.0, -0.0275, -0.572, 0.022) + vec4<f32>(1.0, 0.0425, 1.04, -0.04);
+    let a004 = min(rr.x * rr.x, exp2(-9.28 * nov)) * rr.x + rr.y;
+    let ab = vec2<f32>(-1.04, 1.04) * a004 + rr.zw;
+    return f0 * ab.x + ab.y;
