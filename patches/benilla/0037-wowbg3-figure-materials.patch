+// BG3's hair (`ClusteredLighting` model 5, UE4's Marschner hair): R, TT and TRT lobes of the sun
+// along the strand T, without N·L; `backlit` scales TT and the back-lit R (G-buffer metalness).
+fn tav_hair_spec(T: vec3<f32>, V: vec3<f32>, L: vec3<f32>, albedo: vec3<f32>, r: f32, backlit: f32) -> vec3<f32> {
+    let sl = clamp(dot(T, L), -1.0, 1.0);
+    let sv = clamp(dot(T, V), -1.0, 1.0);
+    // cos(½|asin(sv) − asin(sl)|) through the half-angle identity (no asin or cos per fragment).
+    let cos_d = sqrt(max(1.0 - sv * sv, 0.0)) * sqrt(max(1.0 - sl * sl, 0.0)) + sv * sl;
+    let cos_td = max(sqrt(clamp(0.5 + 0.5 * cos_d, 0.0, 1.0)), 1e-3);
+    let lp = L - T * sl;
+    let vp = V - T * sv;
+    let cos_phi = dot(lp, vp) * inverseSqrt(dot(lp, lp) * dot(vp, vp) + 1e-4);
+    let cos_half_phi = sqrt(clamp(0.5 * cos_phi + 0.5, 0.0, 1.0));
+    let r2 = r * r;
+    let B = vec3<f32>(r2 * 1.4142135 * cos_half_phi, r2 * 0.5, r2 * 2.0);
+    let shift = -0.13988569 * (0.99755102 * cos_half_phi * sqrt(max(1.0 - sv * sv, 0.0)) - 0.069942847 * sv);
+    let x = max(abs(vec3<f32>(sl + sv) - vec3<f32>(shift, 0.035, 0.14)), vec3<f32>(1e-4));
+    let Mp = exp(-0.5 * x * x / (B * B)) / (B * 2.5066283);
+    let vol = dot(V, L);
+    let lobe_r = 0.25 * cos_half_phi * tav_fresnel_hair(1.0 - sqrt(clamp(0.5 * vol + 0.5, 0.0, 1.0)))
+        * mix(1.0, backlit, clamp(-vol, 0.0, 1.0)) * Mp.x;
