+/// The levels of a full mip chain from `w` x `h` down to 1x1.
+pub(crate) fn mip_count(w: u32, h: u32) -> u32 {
+    32 - w.max(h).max(1).leading_zeros()
+}
+
+/// Patch 0037: a `.tvt`'s own lower mip levels (flag [`TVT_MIPS`]): `max(1, size >> k)` RGBA8 rows each, after
+/// level 0; empty without the flag or when the file is short.
+pub(crate) fn decode_tvt_mips(b: &[u8]) -> Vec<&[u8]> {
+    let Some((w, h, flags, _)) = decode_tvt(b) else { return Vec::new() };
+    if flags & TVT_MIPS == 0 {
+        return Vec::new();
+    }
+    let mut out = Vec::new();
+    let mut at = 16 + w as usize * h as usize * 4;
+    let (mut lw, mut lh) = (w as usize, h as usize);
+    while lw > 1 || lh > 1 {
+        lw = (lw / 2).max(1);
+        lh = (lh / 2).max(1);
+        let n = lw * lh * 4;
+        let Some(level) = b.get(at..at + n) else { return Vec::new() };
+        out.push(level);
+        at += n;
+    }
+    out
+}
