+    var specular = vec3<f32>(0.0);
+    if (model > 4.5) {
+        // Hair (model 5): BG3's ambient is its environment on both sides (0.3 at N, 0.7 at −N);
+        // WoW's ambient has no side, so it is the plain ambient (with occlusion).
