+
+// BG3's lighting of one figure fragment under WoW's light; linear radiance (or a debug view).
+fn tav_bg3(
+    f: TavFetch,
+    albedo: vec3<f32>,
+    P: vec3<f32>,
+    L: vec3<f32>,
+    intensity: f32,
+    doodad: bool,
+    point_g: vec3<f32>,
