+    let lobe_trt = pow(alb, vec3<f32>(0.8 / cos_td))
+        * (exp(17.0 * cos_phi - 16.78) * pow(max(abs(1.0 - f_trt), 1e-4), 2.0) * f_trt) * Mp.z;
