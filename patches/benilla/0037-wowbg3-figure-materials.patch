+/// Patch 0037: the debug view (`<tav dir>/tavdebug`, 0 to 10; [`TavDebug`]) set on every material she wears, when
+/// the file changes (looked at every 60 frames).
+fn tav_debug_view(mut d: ResMut<TavDraw>, mut materials: ResMut<Assets<WowModelMaterial>>) {
+    if d.frame % 60 != 45 {
+        return;
+    }
+    let path = d.dir.join("tavdebug");
+    let stamp = std::fs::metadata(&path).and_then(|m| m.modified()).ok();
+    if stamp == d.debug.stamp {
+        return;
+    }
+    d.debug.stamp = stamp;
+    let view = std::fs::read_to_string(&path).ok().and_then(|t| t.trim().parse::<u32>().ok()).unwrap_or(0).min(10);
+    if view == d.debug.view {
+        return;
+    }
+    d.debug.view = view;
+    let mut n = 0;
+    for h in d.surface_mats.values() {
+        if let Some(m) = materials.get_mut(h) {
+            // WoW's law (`tav_a.x` < 0) reads only whether a view is on (no highlight).
+            m.extension.tav_a.z = view as f32;
+            n += 1;
+        }
+    }
+    info!("wowbg3 tav: debug view {view} on {n} materials (tavdebug: 1 albedo, 2 normal, 3 rough/metal/occl, 4 specular, 5 diffuse, 6 extra, 7 lit, 8 WoW's law, 9 base colour, 10 constant; no highlight)");
