+
+// BG3's GGX of the sun (Frostbite's), times N·L: Schlick's Fresnel, the height-correlated Smith
+// visibility with alpha ((r + 1) / 2)², and the distribution with alpha² `a2_a`, or two lobes
+// mixed (`ClusteredLighting` model 3, the skin's dual specular).
+fn tav_spec_sun(N: vec3<f32>, V: vec3<f32>, L: vec3<f32>, r: f32, f0: vec3<f32>, a2_a: f32, a2_b: f32, lobe_mix: f32) -> vec3<f32> {
+    let Ld = tav_sun_disc(N, V, L);
+    let H = normalize(V + Ld);
+    let noh = clamp(dot(N, H), 0.0, 1.0);
+    let nold = clamp(dot(N, Ld), 0.0, 1.0);
+    let nov = max(dot(N, V), 1e-5);
+    let ldoh = clamp(dot(Ld, H), 0.0, 1.0);
+    let k = (r + 1.0) * 0.5;
+    let k2 = k * k;
+    let vis = 0.5 / (nold * sqrt(nov * nov * (1.0 - k2) + k2) + nov * sqrt(nold * nold * (1.0 - k2) + k2));
+    let F = f0 + (vec3<f32>(1.0) - f0) * pow(max(1.0 - ldoh, 1e-4), 5.0);
+    let da = noh * noh * (a2_a - 1.0) + 1.0;
+    let db = noh * noh * (a2_b - 1.0) + 1.0;
+    let D = mix(a2_a / (TAV_PI * da * da), a2_b / (TAV_PI * db * db), lobe_mix);
+    return F * (vis * D * clamp(dot(N, L), 0.0, 1.0));
