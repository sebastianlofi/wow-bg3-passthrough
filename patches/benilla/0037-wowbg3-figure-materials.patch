+            // ears, fingers): the sun from behind through the thickness the map's B remaps, scaled
+            // by its G, tinted by the profile.
+            let thick = m.tav_c.w + (m.tav_d.w - m.tav_c.w) * f.extra.b;
+            let s = max(m.tav_c.xyz * 0.096609399 * (m.tav_b.w * f.extra.g), vec3<f32>(1e-4));
+            let t = exp2(-0.48089835 * thick / s);
+            let back = clamp((0.25881907 - dot(N, L)) * 0.63106394, 0.0, 1.0);
+            diffuse = diffuse + diff_col * m.tav_d.xyz * (t * (t * t + vec3<f32>(3.0))) * sun * (back * intensity);
+        }
+        specular = TAV_PI * sun * tav_spec_sun(N, V, L, f.rough, f0, a2_a, a2_b, lobe_mix)
+            + e_amb * tav_env_brdf(f0, f.rough, nov) * f.ao;
