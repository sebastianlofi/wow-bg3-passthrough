+    let a = 1.0 / (0.36 * cos_td + 1.19 / cos_td);
+    let h = cos_half_phi * (1.0 + a * (0.6 - 0.8 * cos_phi));
+    let f_tt = tav_fresnel_hair(1.0 - cos_td * sqrt(clamp(1.0 - h * h, 0.0, 1.0)));
+    let ha = max(abs(h * a), 1e-4);
+    let lobe_tt = pow(alb, vec3<f32>(0.5 * sqrt(max(1.0 - ha * ha, 0.0)) / cos_td))
+        * (exp(-3.65 * cos_phi - 3.98) * pow(max(abs(1.0 - f_tt), 1e-4), 2.0)) * backlit * Mp.y;
