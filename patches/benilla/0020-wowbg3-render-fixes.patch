+/// A `tavmesh.bin` header's mesh records: (key, kind, part, vertex count, index count).
+type MeshHeads = Vec<(u64, u32, u32, u32, u32)>;
+
+/// The plan number, mapping and mesh records of a `tavmesh.bin` without decoding its blobs.
+pub(crate) fn mesh_heads(b: &[u8]) -> Option<(u32, [f32; 3], [f32; 3], MeshHeads)> {
+    if b.get(0..4)? != b"TVM1" || u32_at(b, 4)? != 1 {
+        return None;
+    }
+    let (seq, n) = (u32_at(b, 8)?, u32_at(b, 12)? as usize);
+    if n > 256 {
+        return None;
+    }
+    let f3 = |o| -> Option<[f32; 3]> { Some([f32_at(b, o)?, f32_at(b, o + 4)?, f32_at(b, o + 8)?]) };
+    let heads = (0..n)
+        .map(|i| {
+            let h = 40 + 64 * i;
+            Some((u64_at(b, h)?, u32_at(b, h + 8)?, u32_at(b, h + 12)?, u32_at(b, h + 16)?, u32_at(b, h + 20)?))
+        })
+        .collect::<Option<MeshHeads>>()?;
+    Some((seq, f3(16)?, f3(28)?, heads))
+}
+
+/// Whether a file's mesh records are the loaded figure's meshes, in order.
+pub(crate) fn same_meshes(f: &MeshFile, heads: &MeshHeads) -> bool {
+    f.meshes.len() == heads.len()
+        && f.meshes.iter().zip(heads).all(|(m, h)| {
+            (m.key, m.kind, m.part, m.pos.len() as u32, m.idx.len() as u32) == (h.0, h.1, h.2, h.3, h.4)
+        })
+}
+
+/// Whether pose `p` can pose figure `f`: its own plan's, or a record for every mesh the figure needs
+/// (by key: the plan number changes without the meshes changing, and the layer writes poses of a new
+/// plan before benilla has its meshes).
+pub(crate) fn pose_fits(f: &MeshFile, p: &PoseFile) -> bool {
+    !p.recs.is_empty()
+        && (f.seq == p.seq
+            || f.meshes.iter().all(|m| {
+                let want = m.skin_from.unwrap_or(m.key);
+                p.recs.iter().any(|r| r.key == want)
+            }))
+}
+
+/// The plan number of the pose this frame draws: the pace packet's (`wowbg3_pace`), else
+/// `tavpose.bin`'s header.
+fn pose_seq(pace: Option<&crate::wowbg3_pace::Pace>, dir: &Path) -> Option<u32> {
+    if let Some(k) = pace.and_then(|p| p.current.as_ref()) {
+        return (k.pose.get(0..4) == Some(b"TVP1".as_slice())).then(|| u32_at(&k.pose, 4)).flatten();
+    }
+    use std::io::Read;
+    let mut b = [0u8; 8];
+    std::fs::File::open(dir.join("tavpose.bin")).ok()?.read_exact(&mut b).ok()?;
+    (&b[0..4] == b"TVP1").then(|| u32::from_le_bytes([b[4], b[5], b[6], b[7]]))
+}
