+/// Patch 0133: the storey clip as it is drawn (patch 0095: what lies over a height inside her building's footprint is
+/// not drawn), for BG3's cursor: a click must go through what is not there. The plugin measured a ceiling of its own
+/// over her, which in a stairwell or under a tall hall is far above the height drawn from here, and clicks landed on
+/// walls nobody could see (a playtest report). `$WOW_BG3_LINK_DIR/wowclip.txt`, one line "WCL1 <1 while the clip
+/// shows, else 0> <height> <x0> <z0> <x1> <z1>": metres in BG3's axes from the hero's figure (BG3's x is WoW's y, its
+/// z WoW's -x, both this client's -x and z), written whole (rename) when a value moved 5 cm.
+fn clip_export(
+    rooms: &Query<(&Name, &GlobalTransform, &benilla_world::entity_shade::ShadeOnlyRoot)>,
+    clip: &benilla_world::see_through::SeeClip,
+) {
+    static LAST: std::sync::Mutex<Option<[f32; 6]>> = std::sync::Mutex::new(None);
+    const M: f32 = 0.9144;
+    let Some(dir) = std::env::var_os("WOW_BG3_LINK_DIR") else { return };
+    let Some(h) = rooms.iter().find(|(name, _, _)| name.as_str() == "wowbg3 Tav").map(|(_, gt, _)| gt.translation()) else { return };
+    let v = if clip.level() > 0 {
+        [1.0, (clip.y - h.y) * M, -(clip.hi.x - h.x) * M, (clip.lo.y - h.z) * M, -(clip.lo.x - h.x) * M, (clip.hi.y - h.z) * M]
+    } else {
+        [0.0; 6]
+    };
+    let Ok(mut last) = LAST.lock() else { return };
+    if last.is_some_and(|p| p.iter().zip(v.iter()).all(|(a, b)| (a - b).abs() < 0.05)) {
+        return;
+    }
+    let text = format!("WCL1 {} {:.2} {:.2} {:.2} {:.2} {:.2}\n", v[0] as u8, v[1], v[2], v[3], v[4], v[5]);
+    let path = std::path::Path::new(&dir).join("wowclip.txt");
+    let tmp = path.with_extension("tmp");
+    if std::fs::write(&tmp, text).is_ok() && std::fs::rename(&tmp, &path).is_ok() {
+        *last = Some(v);
+    }
+}
