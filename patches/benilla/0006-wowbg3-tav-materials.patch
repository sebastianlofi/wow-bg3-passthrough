+/// One `tavtex.txt` line: `<mesh key> <albedo> <flags> [<normal or -> <surface or ->]`; an albedo
+/// of `-` (or flag 2) hides the mesh (BG3's VFX parts).
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct TexLine {
+    pub(crate) key: u64,
+    pub(crate) albedo: Option<String>,
+    pub(crate) flags: u32,
+    pub(crate) normal: Option<String>,
+    pub(crate) surface: Option<String>,
