+    fn quad(x0: f32, q: [f32; 4], mirrored: bool) -> (Vec<Vec3>, Vec<[f32; 2]>, Vec<[f32; 4]>, Vec<u32>) {
+        let pos = vec![
+            Vec3::new(x0, 0.0, 0.0),
+            Vec3::new(x0 + 1.0, 0.0, 0.0),
+            Vec3::new(x0 + 1.0, 1.0, 0.0),
