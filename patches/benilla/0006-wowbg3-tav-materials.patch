+/// One mip level down: 2x2 box averages of the bytes (albedo: sRGB bytes; surface data: linear).
+fn box_mip(prev: &[u8], cw: usize, ch: usize) -> (Vec<u8>, usize, usize) {
+    let (nw, nh) = ((cw / 2).max(1), (ch / 2).max(1));
+    let mut next = vec![0u8; nw * nh * 4];
+    for y in 0..nh {
+        for x in 0..nw {
+            for c in 0..4 {
+                let at = |xx: usize, yy: usize| prev[((yy.min(ch - 1)) * cw + xx.min(cw - 1)) * 4 + c] as u32;
+                let s = at(2 * x, 2 * y) + at(2 * x + 1, 2 * y) + at(2 * x, 2 * y + 1) + at(2 * x + 1, 2 * y + 1);
+                next[(y * nw + x) * 4 + c] = ((s + 2) / 4) as u8;
+            }
+        }
+    }
+    (next, nw, nh)
+}
+
+/// One mip level down for a normal map (RGB = n·½ + ½): the box average of the vectors,
+/// renormalised, so detail fades toward the surface normal instead of shortening.
+pub(crate) fn normal_mip(prev: &[u8], cw: usize, ch: usize) -> (Vec<u8>, usize, usize) {
+    let (nw, nh) = ((cw / 2).max(1), (ch / 2).max(1));
+    let mut next = vec![0u8; nw * nh * 4];
+    for y in 0..nh {
+        for x in 0..nw {
+            let mut v = Vec3::ZERO;
+            for (dx, dy) in [(0, 0), (1, 0), (0, 1), (1, 1)] {
+                let o = ((2 * y + dy).min(ch - 1) * cw + (2 * x + dx).min(cw - 1)) * 4;
+                v += Vec3::new(prev[o] as f32, prev[o + 1] as f32, prev[o + 2] as f32) / 127.5 - Vec3::ONE;
+            }
+            let l = v.length();
+            let v = if l > 1e-6 { v / l } else { Vec3::Z };
+            let o = (y * nw + x) * 4;
+            for (c, val) in [v.x, v.y, v.z].into_iter().enumerate() {
+                next[o + c] = ((val * 0.5 + 0.5) * 255.0 + 0.5).clamp(0.0, 255.0) as u8;
+            }
+            next[o + 3] = 255;
+        }
+    }
+    (next, nw, nh)
 }
 
