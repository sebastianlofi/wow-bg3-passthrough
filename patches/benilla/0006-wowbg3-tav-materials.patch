+
+pub(crate) fn parse_tex_line(line: &str) -> Option<TexLine> {
+    let f: Vec<&str> = line.split_whitespace().collect();
+    if f.len() < 3 {
+        return None;
+    }
+    let file = |i: usize| f.get(i).filter(|s| **s != "-").map(|s| s.to_string());
+    Some(TexLine {
+        key: u64::from_str_radix(f[0], 16).ok()?,
+        albedo: file(1),
+        flags: f[2].parse().ok()?,
+        normal: file(3),
+        surface: file(4),
+    })
+}
+
+impl TexLine {
+    pub(crate) fn hidden(&self) -> bool {
+        self.flags & TVT_HIDDEN != 0 || self.albedo.is_none()
+    }
+}
