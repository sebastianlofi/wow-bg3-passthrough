+#ifdef WOW_TAV_SURFACE
+// GGX (Trowbridge-Reitz) with Smith-Schlick visibility and Schlick Fresnel, times N·L.
+fn tav_ggx(N: vec3<f32>, V: vec3<f32>, L: vec3<f32>, perceptual_roughness: f32, f0: vec3<f32>) -> vec3<f32> {
+    let a = perceptual_roughness * perceptual_roughness;
+    let a2 = a * a;
+    let H = normalize(L + V);
+    let nl = max(dot(N, L), 0.0);
+    let nv = max(dot(N, V), 1e-4);
+    let nh = max(dot(N, H), 0.0);
+    let vh = max(dot(V, H), 0.0);
+    let d = nh * nh * (a2 - 1.0) + 1.0;
+    let D = a2 / (3.14159265 * d * d);
+    let k = a * 0.5;
+    let vis = 0.25 / ((nl * (1.0 - k) + k) * (nv * (1.0 - k) + k));
+    let F = f0 + (vec3<f32>(1.0) - f0) * pow(1.0 - vh, 5.0);
+    return D * vis * F * nl;
+}
+#endif
