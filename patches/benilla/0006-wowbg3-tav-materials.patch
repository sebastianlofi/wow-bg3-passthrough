+/// A `.tvt` as an image for one role, loaded once per file and role.
+fn load_tvt(
+    textures: &mut HashMap<(String, Role), Handle<Image>>,
+    images: &mut Assets<Image>,
+    dir: &Path,
+    file: &str,
+    role: Role,
+    logged: &mut HashSet<String>,
+) -> Option<Handle<Image>> {
+    if let Some(h) = textures.get(&(file.to_string(), role)) {
+        return Some(h.clone());
+    }
+    let decoded = std::fs::read(dir.join(file)).ok().and_then(|raw| {
+        let (w, h, flags, px) = decode_tvt(&raw)?;
+        // Normal and surface maps are linear data (flag 4); an albedo is sRGB.
+        if (role != Role::Albedo) != (flags & TVT_LINEAR != 0) && logged.insert(file.to_string()) {
+            warn!("wowbg3 tav: {file} flags {flags} do not match its use as {role:?}");
+        }
+        Some(tvt_image(w, h, px, role))
+    });
+    let Some(image) = decoded else {
+        if logged.insert(file.to_string()) {
+            warn!("wowbg3 tav: {file} did not load");
+        }
+        return None;
+    };
+    let handle = images.add(image);
+    textures.insert((file.to_string(), role), handle.clone());
+    Some(handle)
+}
