WOW-BG3 benilla patch 0054: the effects library's default folder without a machine path.

- wowbg3_fx.rs: with $WOW_BG3_FX_DIR unset, the effects replay reads fx/ in the capture folder,
  found as the capture layer and the render plugin find it ($WOWBG3_CAPTURE_DIR, else /logs/capture
  when it exists, else $XDG_DATA_HOME/wow-bg3/capture or ~/.local/share/wow-bg3/capture). Patch
  0005 had the test harness's fixed folder as this default. The release sets $WOW_BG3_FX_DIR itself
  (tools/wowbg3-coord.py), so the release behaves as before.

--- a/crates/benilla-app/src/wowbg3_fx.rs
+++ b/crates/benilla-app/src/wowbg3_fx.rs
@@ -1397,13 +1397,32 @@
     }
 }
 
+/// The effects library the BG3 side writes when `$WOW_BG3_FX_DIR` is unset: `fx/` in the capture
+/// folder, found as the capture layer and the render plugin find it (`$WOWBG3_CAPTURE_DIR`, else
+/// `/logs/capture` when it exists, else `$XDG_DATA_HOME/wow-bg3/capture` or
+/// `~/.local/share/wow-bg3/capture`).
+fn default_fx_dir() -> PathBuf {
+    let capture = match std::env::var_os("WOWBG3_CAPTURE_DIR").filter(|d| !d.is_empty()) {
+        Some(d) => PathBuf::from(d),
+        None if std::path::Path::new("/logs/capture").is_dir() => PathBuf::from("/logs/capture"),
+        None => {
+            let data = match std::env::var_os("XDG_DATA_HOME").filter(|d| !d.is_empty()) {
+                Some(d) => PathBuf::from(d),
+                None => PathBuf::from(std::env::var_os("HOME").filter(|h| !h.is_empty()).unwrap_or_else(|| "/tmp".into()))
+                    .join(".local/share"),
+            };
+            data.join("wow-bg3/capture")
+        }
+    };
+    capture.join("fx")
+}
+
 pub(crate) fn build(app: &mut App) {
     if std::env::var_os("WOW_BG3_LEAD").is_none() {
         return;
     }
     let tav_dir = std::env::var_os("WOW_BG3_TAV_DIR").map_or_else(|| PathBuf::from("/tmp/wowbg3/tav"), PathBuf::from);
-    let fx_dir = std::env::var_os("WOW_BG3_FX_DIR")
-        .map_or_else(|| PathBuf::from("/logs/capture/fx"), PathBuf::from);
+    let fx_dir = std::env::var_os("WOW_BG3_FX_DIR").map_or_else(default_fx_dir, PathBuf::from);
     let exposure = std::env::var("WOW_BG3_FX_EXPOSURE")
         .ok()
         .and_then(|v| v.trim().parse::<f32>().ok())
