+/// WOW-BG3 (local fork, patch 0047): BG3's own "Talk" on a WoW NPC (its context
+/// menu, or a left click on the stand-in) reaches WoW. `link/wowuse.bin` (BG3 -> WoW, 24 bytes,
+/// little endian): `WUS1`, seq u32, guid lo u32, guid hi u32, verb u32 (1 talk), seq again. A new seq
+/// runs the right-click dispatcher's talk on that unit, as a right click would: in reach the NPC's
+/// service (gossip, quests, vendor...), out of reach the walk, which world mode turns into BG3's
+/// errand. The record found at the first read is history. Logs `wowbg3 use: talk GUID`.
+#[derive(Resource)]
+pub(crate) struct Bg3Use {
+    path: std::path::PathBuf,
+    last: Option<u32>,
+    frame: u32,
+}
+
+impl Bg3Use {
+    /// In world mode (`WOW_BG3_LEAD` and the link folder) only.
+    pub(crate) fn from_env() -> Option<Self> {
+        std::env::var_os("WOW_BG3_LEAD")?;
+        let dir = std::env::var_os("WOW_BG3_LINK_DIR")?;
+        Some(Self { path: std::path::PathBuf::from(dir).join("wowuse.bin"), last: None, frame: 0 })
+    }
+}
+
+/// Decodes `wowuse.bin`: (seq, guid, verb); `None` when torn or foreign.
+pub(crate) fn decode_use(b: &[u8]) -> Option<(u32, u64, u32)> {
+    if b.len() < 24 || b.get(0..4)? != b"WUS1" {
+        return None;
+    }
+    let u = |o: usize| u32::from_le_bytes(b[o..o + 4].try_into().unwrap());
+    let seq = u(4);
+    (seq != 0 && seq == u(20)).then(|| (seq, u64::from(u(8)) | (u64::from(u(12)) << 32), u(16)))
+}
+
+pub(super) fn act_on_bg3_use(
+    mut dispatch: Dispatch,
+    index: Res<crate::net::GuidIndex>,
+    link: Option<ResMut<Bg3Use>>,
+) {
+    let Some(mut link) = link else { return };
+    link.frame = link.frame.wrapping_add(1);
+    if link.frame % 3 != 0 {
+        return;
+    }
+    let Some((seq, guid, verb)) = std::fs::read(&link.path).ok().and_then(|b| decode_use(&b)) else {
