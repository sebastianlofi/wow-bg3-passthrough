+//! WOW-BG3 (local fork, patch 0047): WoW's quest cursors for BG3, written once
+//! from the player's own WoW files so the release needs no Python (`link/tools/wowcursor.py` is the
+//! harness twin; same layout and scaling). In world mode, at start, when any is missing:
+//! `<SE>/wow-bg3/cursors/quest-available.cur`, `quest-available-pressed.cur`, `quest-turnin.cur`,
+//! `quest-turnin-pressed.cur`: one-image Windows .cur files as BG3's own (32 x 32, 32-bit BGRA
+//! bottom-up with an empty AND mask, hotspot 0,0), the icon (`Interface\GossipFrame\
+//! AvailableQuestIcon.blp`, `ActiveQuestIcon.blp`) cropped to its drawn box (alpha) and scaled (Lanczos-3, as
+//! Pillow's LANCZOS, on premultiplied alpha) to 30 px on its long side at 1,1, or 26 px at 3,3
+//! pressed. `WowCursor.lua` points two unused BG3 cursor types at them. Off-thread; logs
+//! `wowbg3 cursors:`.
+
+use std::path::{Path, PathBuf};
+
+use bevy::prelude::*;
+
+use benilla_assets::{AssetSet, LockRecover, WorldAssets};
+
+const SIZE: usize = 32;
+const ICONS: [(&str, &str); 2] = [
+    ("quest-available", "Interface\\GossipFrame\\AvailableQuestIcon.blp"),
+    ("quest-turnin", "Interface\\GossipFrame\\ActiveQuestIcon.blp"),
+];
+
+pub(crate) fn build(app: &mut App, link: PathBuf) {
+    if std::env::var_os("WOW_BG3_LEAD").is_none() {
+        return;
+    }
+    let Some(dir) = link.parent().map(|p| p.join("cursors")) else { return };
+    app.insert_resource(CursorDir(dir)).add_systems(Startup, write_cursors.after(AssetSet::Open));
+}
+
+#[derive(Resource)]
+struct CursorDir(PathBuf);
+
+fn write_cursors(dir: Res<CursorDir>, assets: Option<Res<WorldAssets>>) {
+    let dir = dir.0.clone();
+    let names = ["quest-available", "quest-available-pressed", "quest-turnin", "quest-turnin-pressed"];
+    if names.iter().all(|n| dir.join(format!("{n}.cur")).exists()) {
+        return;
+    }
+    let Some(assets) = assets else { return };
+    let chain = assets.chain.clone();
+    let _ = std::thread::Builder::new().name("wowbg3-cursors".into()).spawn(move || {
+        for (stem, path) in ICONS {
+            let icon = chain
+                .lock_recover()
+                .read_file(path)
+                .map_err(|e| format!("{e:#}"))
+                .and_then(|b| benilla_formats::blp_to_rgba(&b).map_err(|e| format!("{e:#}")));
+            let (w, h, rgba) = match icon {
+                Ok(v) => v,
+                Err(e) => {
+                    warn!("wowbg3 cursors: {path}: {e}");
+                    continue;
+                }
+            };
+            for pressed in [false, true] {
+                let img = cursor_image(&rgba, w as usize, h as usize, pressed);
+                let name = format!("{stem}{}.cur", if pressed { "-pressed" } else { "" });
+                match write(&dir, &name, &cur_bytes(&img)) {
+                    Ok(p) => info!("wowbg3 cursors: wrote {p:?}"),
+                    Err(e) => warn!("wowbg3 cursors: {name}: {e}"),
+                }
+            }
+        }
+    });
+}
+
+fn write(dir: &Path, name: &str, bytes: &[u8]) -> std::io::Result<PathBuf> {
+    std::fs::create_dir_all(dir)?;
+    let p = dir.join(name);
+    let tmp = p.with_extension("tmp");
+    std::fs::write(&tmp, bytes)?;
+    std::fs::rename(&tmp, &p)?;
+    Ok(p)
+}
+
+/// A one-image .cur: header, entry, BITMAPINFOHEADER (height doubled), BGRA rows bottom-up, mask.
+fn cur_bytes(rgba: &[u8]) -> Vec<u8> {
+    let (w, h) = (SIZE as u32, SIZE as u32);
+    let mut px = Vec::with_capacity(SIZE * SIZE * 4);
+    for y in (0..SIZE).rev() {
+        for x in 0..SIZE {
+            let s = (y * SIZE + x) * 4;
+            px.extend_from_slice(&[rgba[s + 2], rgba[s + 1], rgba[s], rgba[s + 3]]);
+        }
+    }
+    let mask = vec![0u8; SIZE * SIZE / 8];
+    let mut bmp = Vec::new();
+    for v in [40u32] {
+        bmp.extend_from_slice(&v.to_le_bytes());
+    }
+    bmp.extend_from_slice(&(w as i32).to_le_bytes());
+    bmp.extend_from_slice(&((h * 2) as i32).to_le_bytes());
+    bmp.extend_from_slice(&1u16.to_le_bytes());
+    bmp.extend_from_slice(&32u16.to_le_bytes());
+    bmp.extend_from_slice(&0u32.to_le_bytes());
+    bmp.extend_from_slice(&((px.len() + mask.len()) as u32).to_le_bytes());
+    for _ in 0..4 {
+        bmp.extend_from_slice(&0u32.to_le_bytes());
+    }
+    bmp.extend_from_slice(&px);
+    bmp.extend_from_slice(&mask);
+    let mut out = Vec::new();
+    out.extend_from_slice(&0u16.to_le_bytes());
+    out.extend_from_slice(&2u16.to_le_bytes());
+    out.extend_from_slice(&1u16.to_le_bytes());
+    out.extend_from_slice(&[w as u8, h as u8, 0, 0]);
+    out.extend_from_slice(&0u16.to_le_bytes()); // hotspot x
+    out.extend_from_slice(&0u16.to_le_bytes()); // hotspot y
+    out.extend_from_slice(&(bmp.len() as u32).to_le_bytes());
+    out.extend_from_slice(&22u32.to_le_bytes());
+    out.extend_from_slice(&bmp);
+    out
+}
+
+/// The icon cropped to its drawn box (alpha non-zero, as Pillow's RGBA getbbox), scaled to 30 px
+/// (26 pressed) on its long side, placed at 1,1 (3,3 pressed) in a transparent 32 x 32.
+fn cursor_image(rgba: &[u8], w: usize, h: usize, pressed: bool) -> Vec<u8> {
+    let mut out = vec![0u8; SIZE * SIZE * 4];
+    let lit = |x: usize, y: usize| rgba[(y * w + x) * 4 + 3] != 0;
+    let (mut x0, mut y0, mut x1, mut y1) = (w, h, 0, 0);
+    for y in 0..h {
+        for x in 0..w {
+            if lit(x, y) {
+                x0 = x0.min(x);
+                y0 = y0.min(y);
+                x1 = x1.max(x + 1);
+                y1 = y1.max(y + 1);
+            }
+        }
+    }
+    if x1 <= x0 || y1 <= y0 {
+        (x0, y0, x1, y1) = (0, 0, w, h);
+    }
+    let (gw, gh) = (x1 - x0, y1 - y0);
+    let target = if pressed { 26.0 } else { 30.0 };
+    let scale = target / gw.max(gh) as f64;
+    let (nw, nh) = (((gw as f64 * scale).round() as usize).max(1), ((gh as f64 * scale).round() as usize).max(1));
+    // Premultiplied f64 source.
+    let mut src = vec![[0f64; 4]; gw * gh];
+    for y in 0..gh {
+        for x in 0..gw {
+            let s = ((y + y0) * w + x + x0) * 4;
+            let a = f64::from(rgba[s + 3]) / 255.0;
+            src[y * gw + x] = [f64::from(rgba[s]) * a, f64::from(rgba[s + 1]) * a, f64::from(rgba[s + 2]) * a, f64::from(rgba[s + 3])];
+        }
+    }
+    let horiz = resample(&src, gw, gh, nw, true);
+    let full = resample(&horiz, nw, gh, nh, false);
+    let off = if pressed { 3 } else { 1 };
+    for y in 0..nh.min(SIZE - off) {
+        for x in 0..nw.min(SIZE - off) {
+            let [r, g, b, a] = full[y * nw + x];
+            let a8 = a.round().clamp(0.0, 255.0);
+            let un = |c: f64| if a8 > 0.0 { (c * 255.0 / a8).round().clamp(0.0, 255.0) } else { 0.0 };
+            let d = ((y + off) * SIZE + x + off) * 4;
+            out[d] = un(r) as u8;
+            out[d + 1] = un(g) as u8;
+            out[d + 2] = un(b) as u8;
+            out[d + 3] = a8 as u8;
+        }
+    }
+    out
+}
+
+fn lanczos3(x: f64) -> f64 {
+    if x == 0.0 {
+        return 1.0;
+    }
+    if x.abs() >= 3.0 {
+        return 0.0;
+    }
+    let px = std::f64::consts::PI * x;
+    3.0 * px.sin() * (px / 3.0).sin() / (px * px)
+}
+
+/// One axis of a Lanczos-3 resize (Pillow's convolution: support widened when shrinking).
+fn resample(src: &[[f64; 4]], w: usize, h: usize, n: usize, horizontal: bool) -> Vec<[f64; 4]> {
+    let len = if horizontal { w } else { h };
+    let scale = len as f64 / n as f64;
+    let support = 3.0 * scale.max(1.0);
+    let (ow, oh) = if horizontal { (n, h) } else { (w, n) };
+    let mut out = vec![[0f64; 4]; ow * oh];
+    for i in 0..n {
+        let centre = (i as f64 + 0.5) * scale;
+        let lo = ((centre - support).floor().max(0.0)) as usize;
+        let hi = ((centre + support).ceil() as usize).min(len);
+        let mut weights: Vec<(usize, f64)> = (lo..hi).map(|j| (j, lanczos3((j as f64 + 0.5 - centre) / scale.max(1.0)))).collect();
+        let sum: f64 = weights.iter().map(|w| w.1).sum();
+        if sum != 0.0 {
+            for w in &mut weights {
+                w.1 /= sum;
+            }
+        }
+        let lines = if horizontal { h } else { w };
+        for l in 0..lines {
+            let mut acc = [0f64; 4];
+            for &(j, wt) in &weights {
+                let s = if horizontal { src[l * w + j] } else { src[j * w + l] };
+                for c in 0..4 {
+                    acc[c] += s[c] * wt;
+                }
+            }
+            let d = if horizontal { l * ow + i } else { i * ow + l };
+            out[d] = acc;
+        }
+    }
+    out
+}
