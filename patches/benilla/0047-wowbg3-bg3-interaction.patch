+    if vendor >> 48 != 0xF130 {
+        return;
+    }
+    *seq = seq.wrapping_add(1).max(1);
+    let mut rec = [0u8; 20];
+    rec[0..4].copy_from_slice(b"WTR1");
+    rec[4..8].copy_from_slice(&seq.to_le_bytes());
+    rec[8..12].copy_from_slice(&(vendor as u32).to_le_bytes());
+    rec[12..16].copy_from_slice(&((vendor >> 32) as u32).to_le_bytes());
+    rec[16..20].copy_from_slice(&seq.to_le_bytes());
+    let tmp = path.with_extension("tmp");
+    match std::fs::write(&tmp, rec).and_then(|()| std::fs::rename(&tmp, &*path)) {
