+/// Patch 0124: a slot file mapped shared (address, length), kept by the writer thread for its slot.
+struct FileMap(usize, usize);
+
+impl Drop for FileMap {
+    fn drop(&mut self) {
+        // SAFETY: the address and length are this mapping's own (mmap below); nothing else unmaps it.
+        unsafe { libc::munmap(self.0 as *mut libc::c_void, self.1) };
+    }
+}
+
+/// Patch 0124: colour at `ca` and depth at `da` copied into the slot file's shared mapping, two halves of each on four
+/// threads at once (copies into the mapping take no file lock; four `pwrite`s of one file ran one after another).
+#[cfg(unix)]
+fn write_parallel(map: &mut Option<FileMap>, f: &std::fs::File, color: &[u8], ca: u64, depth: &[u8], da: u64) -> bool {
+    use std::os::unix::io::AsRawFd;
+    let end = (da as usize).max(ca as usize + color.len()).max(da as usize + depth.len());
+    if map.as_ref().is_none_or(|m| m.1 < end) {
+        *map = None;
+        if f.metadata().map_or(true, |m| (m.len() as usize) < end) && f.set_len(end as u64).is_err() {
+            return false;
+        }
+        // SAFETY: a shared, writable mapping of `end` bytes of this open file (now at least that long).
+        let p = unsafe { libc::mmap(std::ptr::null_mut(), end, libc::PROT_READ | libc::PROT_WRITE, libc::MAP_SHARED, f.as_raw_fd(), 0) };
+        if p == libc::MAP_FAILED {
+            return false;
+        }
+        *map = Some(FileMap(p as usize, end));
+    }
+    let base = map.as_ref().map_or(0, |m| m.0);
+    let half = |b: &[u8]| (b.len() / 2) & !4095;
+    let (ch, dh) = (half(color), half(depth));
+    let parts: [(&[u8], usize); 4] =
+        [(&color[..ch], ca as usize), (&color[ch..], ca as usize + ch), (&depth[..dh], da as usize), (&depth[dh..], da as usize + dh)];
+    let copy = move |(src, at): (&[u8], usize)| {
+        // SAFETY: `at + src.len()` is within the mapping (`end` above), and the four parts do not overlap.
+        unsafe { std::ptr::copy_nonoverlapping(src.as_ptr(), (base + at) as *mut u8, src.len()) };
+    };
+    std::thread::scope(|s| {
+        let hs: Vec<_> = parts[1..].iter().map(|&p| s.spawn(move || copy(p))).collect();
+        copy(parts[0]);
+        hs.into_iter().all(|h| h.join().is_ok())
+    })
+}
