+/// The nearest attackable mob within `PULL_RANGE` that is not in `skip` (only `entry` if given).
+fn nearest_mob(scan: &Scan, from: Vec3, skip: &HashSet<u64>, entry: Option<u32>) -> Option<(u64, f32)> {
+    scan.attackable
+        .iter()
+        .filter(|(g, _, _, e)| !skip.contains(g) && entry.is_none_or(|want| *e == want))
