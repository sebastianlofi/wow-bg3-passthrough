+/// A chat line from the server: a `WOWBG3 ...` system line is taken here and kept out of the
+/// chat frame (true).
+pub(crate) fn server_line(chat_type: u8, text: &str) -> bool {
+    const CHAT_MSG_SYSTEM: u8 = 0x0A;
+    if chat_type != CHAT_MSG_SYSTEM || !text.starts_with("WOWBG3 ") {
+        return false;
+    }
+    if let Ok(mut s) = SHARED.lock() {
+        let w: Vec<&str> = text.split_whitespace().collect();
+        if w.get(1) == Some(&"mob") && w.last() == Some(&"aggro") {
+            if let Some(g) = w.get(3).and_then(|g| u64::from_str_radix(g, 16).ok()) {
+                if s.server_aggro.len() < 64 {
+                    s.server_aggro.push_back(g);
+                }
+            }
+        }
+        if s.server_lines.len() < 256 {
+            s.server_lines.push_back(text.to_string());
+        }
+    }
+    true
+}
