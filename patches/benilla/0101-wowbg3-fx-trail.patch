+/// Patch 0101: what the last frames replayed, for the crash report: BG3's shaders run here without
+/// the checks wgpu puts on its own, so a bad read in one loses the device with nothing else to say which.
+const TRAIL_FRAMES: usize = 240;
+static TRAIL: std::sync::Mutex<std::collections::VecDeque<String>> = std::sync::Mutex::new(std::collections::VecDeque::new());
+
+fn note_trail(set: &FxFrameSet, skipped: usize) {
+    use std::fmt::Write as _;
+    let frame = &set.frame;
+    let mut line = format!("frame {} blob {} bytes, {} draws, {skipped} skipped:", frame.frame, frame.blob.len(), frame.draws.len());
+    for d in &frame.draws {
+        let _ = write!(line, " [pipe {:016x} count {} inst {} first {} vo {} fi {} idx {}+{} vbs {} sets {}]", d.pipe, d.count, d.instances,
+            d.first, d.vertex_offset, d.first_instance, d.index_blob, d.index_size, d.vbs.len(), d.sets.len());
+    }
+    if let Ok(mut t) = TRAIL.try_lock() {
+        if t.len() == TRAIL_FRAMES {
+            t.pop_front();
+        }
+        t.push_back(line);
+    }
+}
+
+/// Patch 0101: the trail, newest last. Never waits: a panic can hold anything.
+pub(crate) fn trail_text() -> String {
+    let at_camp = crate::wowbg3_frames::at_camp();
+    match TRAIL.try_lock() {
+        Ok(t) => format!("at camp: {at_camp}\n{}\n", t.iter().cloned().collect::<Vec<_>>().join("\n")),
+        Err(_) => format!("at camp: {at_camp}\ntrail busy\n"),
+    }
+}
