+/// The writer thread: waits for each frame's mapping (polling the device without blocking it)
+/// and writes it into its slot file, framed by the sequence number, then frees the pair.
+fn writer(rx: mpsc::Receiver<Job>, path: std::path::PathBuf, device: RenderDevice, stats: Arc<Mutex<ExportStats>>) {
+    let mut files: [Option<std::fs::File>; 2] = [None, None];
+    let mut warned = false;
+    let mut logged_at = Instant::now();
+    while let Ok(job) = rx.recv() {
+        let t0 = Instant::now();
+        let mut lost = false;
+        while job.mapped.iter().any(|m| m.load(Ordering::Acquire) == 0) {
+            let _ = device.poll(bevy::render::render_resource::PollType::Poll);
+            if job.submitted.elapsed() > Duration::from_secs(2) {
+                lost = true;
+                break;
+            }
+            std::thread::sleep(Duration::from_micros(150));
+        }
+        let mut ok = !lost && job.mapped.iter().all(|m| m.load(Ordering::Acquire) == 1);
+        let map_us = t0.elapsed().as_micros() as u64;
+        let t1 = Instant::now();
+        let seq = u32::from_le_bytes(job.header[4..8].try_into().unwrap());
