diff --git a/crates/benilla-app/src/wowbg3_pace.rs b/crates/benilla-app/src/wowbg3_pace.rs
new file mode 100644
index 0000000..effd60d
--- /dev/null
+++ b/crates/benilla-app/src/wowbg3_pace.rs
@@ -0,0 +1,302 @@
+//! WOW-BG3 (local fork, patch 0013): frame pacing. A test on the desktop (
+//! BG3 fullscreen 3440x1440 at 60): Tav looked lower frame rate than the world and the camera
+//! staggered. benilla drew on its own 60 Hz clock with the newest BG3 camera record, Tav blended
+//! one BG3 frame behind on BG3's clock (patch 0007), and the capture layer took the newest WoW
+//! frame at each BG3 present: three clocks.
+//!
+//! Frame packets: at every BG3 present the capture layer writes Tav's pose (`tavpose.bin`) with
+//! the plugin's camera record read at that same present appended: the `TVC1` trailer, the last
+//! 128 bytes of the file: "TVC1", frame u32 (the pose header's), present time f64
+//! (CLOCK_MONOTONIC s), present index u64, the `BGC1` record (96 bytes, zeros when it was torn),
+//! its seq u32, "TVC1". While packets come, benilla draws exactly one frame per packet:
+//! [`wait_packet`] holds the start of the next frame until a new packet is there (at most
+//! [`MAX_WAIT`]), the world camera takes the packet's camera record (`wowbg3_lead`) and Tav
+//! exactly the packet's pose (`wowbg3_tav`, no blending), so Tav and the world always come from
+//! the same BG3 state and advance together, once per BG3 frame. Without packets for [`STALE`]
+//! (world mode off, BG3 gone, an old layer) benilla runs on its own clock as before.
+//! `WOW_BG3_PACE=off` turns it off. Run with `WOW_NOVSYNC=1`: benilla's own present (never shown,
+//! headless gamescope) must not hold it to its own 60 Hz.
+//!
+//! Every exported frame (`wowbg3_frames`) carries [`FrameTag`]: the packet and the camera record
+//! it was drawn from, so the layer can composite the WoW frame drawn for the camera of the BG3
+//! frame it presents. `pace` log lines every [`LOG_EVERY`] frames.
+
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use bevy::prelude::*;
+use bevy::render::extract_resource::ExtractResource;
+
+/// No packet for this long: benilla runs on its own clock.
+const STALE: Duration = Duration::from_millis(250);
+/// The longest a frame waits for the next packet (BG3 hitching or loading).
+const MAX_WAIT: Duration = Duration::from_millis(60);
+/// How often the pose file is checked while waiting.
+const POLL: Duration = Duration::from_micros(250);
+const LOG_EVERY: u64 = 600;
+const TRAILER: usize = 128;
+
+/// One BG3 present's packet.
+#[derive(Clone)]
+pub(crate) struct Packet {
+    pub(crate) frame: u32,
+    pub(crate) present_time: f64,
+    /// The `BGC1` camera record read at that present (`None` when it was torn or missing).
+    pub(crate) cam: Option<[u8; 96]>,
+    /// The whole pose file (`wowbg3_tav::decode_pose` reads it).
+    pub(crate) pose: Arc<Vec<u8>>,
+}
+
+/// Decodes the `TVC1` trailer of a pose file: (frame, present time, present index, camera record).
+pub(crate) fn decode_trailer(b: &[u8]) -> Option<(u32, f64, u64, Option<[u8; 96]>)> {
+    if b.len() < 24 + TRAILER || b.get(0..3)? != b"TVP" {
+        return None;
+    }
+    let t = &b[b.len() - TRAILER..];
+    if &t[0..4] != b"TVC1" || &t[124..128] != b"TVC1" {
+        return None;
+    }
+    let frame = u32::from_le_bytes(t[4..8].try_into().ok()?);
+    let header_frame = u32::from_le_bytes(b[8..12].try_into().ok()?);
+    if frame != header_frame {
+        return None;
+    }
+    let time = f64::from_le_bytes(t[8..16].try_into().ok()?);
+    let index = u64::from_le_bytes(t[16..24].try_into().ok()?);
+    let mut cam = [0u8; 96];
+    cam.copy_from_slice(&t[24..120]);
+    let seq = u32::from_le_bytes(t[120..124].try_into().ok()?);
+    let whole = seq != 0 && &cam[0..4] == b"BGC1" && u32::from_le_bytes(cam[4..8].try_into().ok()?) == seq;
+    Some((frame, time, index, whole.then_some(cam)))
+}
+
+/// The packet this frame is drawn from (`None` while running on benilla's own clock).
+#[derive(Resource)]
+pub(crate) struct Pace {
+    path: PathBuf,
+    enabled: bool,
+    pub(crate) current: Option<Packet>,
+    /// (inode, modification time ns) of the pose file last read.
+    stamp: Option<(u64, i64)>,
+    last_frame: u32,
+    last_at: Option<Instant>,
+    stats: PaceStats,
+}
+
+#[derive(Default)]
+struct PaceStats {
+    frames: u64,
+    lockstep: u64,
+    waits: u64,
+    wait_us: u64,
+    wait_max_us: u64,
+    timeouts: u64,
+    skipped: u64,
+    frame_at: Option<Instant>,
+    frame_us: Vec<u64>,
+    /// BG3 present to the start of this frame (µs), from the packet's present time.
+    latency_us: u64,
+    latency_max_us: u64,
+}
+
+/// What the exported frame was drawn from, extracted into the render world (`wowbg3_frames`).
+#[derive(Resource, Clone, Copy, Default, ExtractResource)]
+pub(crate) struct FrameTag {
+    /// The packet (BG3 present, tavpose.bin's frame), 0 none.
+    pub(crate) packet: u32,
+    /// The `bg3cam.bin` record the world camera followed, 0 none.
+    pub(crate) cam: u32,
+    /// Bit 0: drawn in lockstep from a packet.
+    pub(crate) flags: u32,
+    /// `wowbg3_lead::depth_offset` for this frame (the render world runs a frame behind).
+    pub(crate) depth_offset: f32,
+}
+
+/// CLOCK_MONOTONIC in seconds (the clock BG3's layer and plugin stamp with).
+pub(crate) fn mono_seconds() -> f64 {
+    let mut ts = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    // SAFETY: clock_gettime writes the timespec it is given.
+    unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut ts) };
+    ts.tv_sec as f64 + ts.tv_nsec as f64 * 1e-9
+}
+
+pub(crate) fn build(app: &mut App) {
+    if std::env::var_os("WOW_BG3_LEAD").is_none() {
+        return;
+    }
+    let dir = std::env::var_os("WOW_BG3_TAV_DIR").map_or_else(|| PathBuf::from("/tmp/wowbg3/tav"), PathBuf::from);
+    let enabled = std::env::var("WOW_BG3_PACE").map_or(true, |v| v != "off");
+    info!(
+        "wowbg3 pace: {} (packets from {:?}, vsync {})",
+        if enabled { "one frame per BG3 present while packets come" } else { "off" },
+        dir.join("tavpose.bin"),
+        if crate::video::novsync_env() { "off" } else { "on: set WOW_NOVSYNC=1" }
+    );
+    app.insert_resource(Pace {
+        path: dir.join("tavpose.bin"),
+        enabled,
+        current: None,
+        stamp: None,
+        last_frame: 0,
+        last_at: None,
+        stats: PaceStats::default(),
+    })
+    .init_resource::<FrameTag>()
+    .add_systems(First, wait_packet)
+    .add_systems(Last, tag_frame);
+}
+
+/// (inode, mtime ns) of the file, cheap enough to check every [`POLL`].
+fn stamp(path: &std::path::Path) -> Option<(u64, i64)> {
+    use std::os::unix::fs::MetadataExt;
+    let md = std::fs::metadata(path).ok()?;
+    Some((md.ino(), md.mtime() * 1_000_000_000 + md.mtime_nsec()))
+}
+
+/// A new packet, if the pose file changed and holds one.
+fn take_packet(p: &mut Pace) -> Option<Packet> {
+    let st = stamp(&p.path)?;
+    if p.stamp == Some(st) {
+        return None;
+    }
+    let raw = std::fs::read(&p.path).ok()?;
+    p.stamp = Some(st);
+    let (frame, present_time, _present_index, cam) = decode_trailer(&raw)?;
+    if frame == p.last_frame {
+        return None;
+    }
+    Some(Packet { frame, present_time, cam, pose: Arc::new(raw) })
+}
+
+/// Start of a frame: wait for the next packet while packets come.
+fn wait_packet(mut p: ResMut<Pace>) {
+    let now = Instant::now();
+    if let Some(at) = p.stats.frame_at {
+        let us = now.duration_since(at).as_micros() as u64;
+        p.stats.frame_us.push(us);
+    }
+    p.stats.frame_at = Some(now);
+    p.stats.frames += 1;
+    if p.enabled {
+        let start = Instant::now();
+        let mut waited = false;
+        loop {
+            if let Some(pk) = take_packet(&mut p) {
+                if p.last_frame != 0 && pk.frame.wrapping_sub(p.last_frame) > 1 && pk.frame.wrapping_sub(p.last_frame) < 1000 {
+                    p.stats.skipped += u64::from(pk.frame.wrapping_sub(p.last_frame) - 1);
+                }
+                p.last_frame = pk.frame;
+                p.last_at = Some(Instant::now());
+                let lat = ((mono_seconds() - pk.present_time) * 1e6).max(0.0) as u64;
+                p.stats.latency_us += lat;
+                p.stats.latency_max_us = p.stats.latency_max_us.max(lat);
+                p.current = Some(pk);
+                break;
+            }
+            // No packets lately: benilla's own clock.
+            if p.last_at.is_none_or(|t| t.elapsed() > STALE) {
+                p.current = None;
+                break;
+            }
+            if start.elapsed() > MAX_WAIT {
+                p.stats.timeouts += 1;
+                break;
+            }
+            waited = true;
+            std::thread::sleep(POLL);
+        }
+        if waited {
+            let us = start.elapsed().as_micros() as u64;
+            p.stats.waits += 1;
+            p.stats.wait_us += us;
+            p.stats.wait_max_us = p.stats.wait_max_us.max(us);
+        }
+    } else {
+        p.current = None;
+    }
+    if p.current.is_some() {
+        p.stats.lockstep += 1;
+    }
+    if p.stats.frames.is_multiple_of(LOG_EVERY) {
+        let s = &mut p.stats;
+        s.frame_us.sort_unstable();
+        let n = s.frame_us.len().max(1);
+        let pct = |q: f64| s.frame_us.get(((n - 1) as f64 * q) as usize).copied().unwrap_or(0) as f64 / 1e3;
+        let mean = s.frame_us.iter().sum::<u64>() as f64 / n as f64 / 1e3;
+        info!(
+            "wowbg3 pace: {} frames, {} in lockstep; frame interval ms mean {:.2} p50 {:.2} p95 {:.2} max {:.2}; packet waits {} ({:.2} ms avg, max {:.2}), \
+             timeouts {}, packets skipped {}, BG3 present to frame start {:.2} ms avg (max {:.2})",
+            LOG_EVERY,
+            s.lockstep,
+            mean,
+            pct(0.5),
+            pct(0.95),
+            pct(1.0),
+            s.waits,
+            if s.waits > 0 { s.wait_us as f64 / s.waits as f64 / 1e3 } else { 0.0 },
+            s.wait_max_us as f64 / 1e3,
+            s.timeouts,
+            s.skipped,
+            if s.lockstep > 0 { s.latency_us as f64 / s.lockstep as f64 / 1e3 } else { 0.0 },
+            s.latency_max_us as f64 / 1e3
+        );
+        let frames = s.frames;
+        *s = PaceStats { frames, frame_at: s.frame_at, ..Default::default() };
+    }
+}
+
+/// The camera record of this frame's packet (lockstep only).
+pub(crate) fn packet_camera(p: &Pace) -> Option<[u8; 96]> {
+    p.current.as_ref().and_then(|k| k.cam)
+}
+
+/// End of a frame's update: what it was drawn from, for the export.
+fn tag_frame(p: Res<Pace>, mut tag: ResMut<FrameTag>) {
+    *tag = FrameTag {
+        packet: p.current.as_ref().map_or(0, |k| k.frame),
+        cam: crate::wowbg3_lead::camera_seq(),
+        flags: u32::from(p.current.is_some()),
+        depth_offset: crate::wowbg3_lead::depth_offset(),
+    };
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn pose_file(frame: u32, cam_seq: u32) -> Vec<u8> {
+        let mut b = vec![0u8; 24];
+        b[0..4].copy_from_slice(b"TVP1");
+        b[8..12].copy_from_slice(&frame.to_le_bytes());
+        let mut t = [0u8; 128];
+        t[0..4].copy_from_slice(b"TVC1");
+        t[4..8].copy_from_slice(&frame.to_le_bytes());
+        t[8..16].copy_from_slice(&12.5f64.to_le_bytes());
+        t[16..24].copy_from_slice(&77u64.to_le_bytes());
+        if cam_seq != 0 {
+            t[24..28].copy_from_slice(b"BGC1");
+            t[28..32].copy_from_slice(&cam_seq.to_le_bytes());
+            t[88..92].copy_from_slice(&cam_seq.to_le_bytes());
+        }
+        t[120..124].copy_from_slice(&cam_seq.to_le_bytes());
+        t[124..128].copy_from_slice(b"TVC1");
+        b.extend_from_slice(&t);
+        b
+    }
+
+    #[test]
+    fn decodes_the_trailer() {
+        let (frame, time, index, cam) = decode_trailer(&pose_file(9, 41)).expect("a trailer");
+        assert_eq!((frame, time, index), (9, 12.5, 77));
+        let cam = cam.expect("a camera record");
+        assert_eq!(&cam[0..4], b"BGC1");
+        assert_eq!(u32::from_le_bytes(cam[4..8].try_into().unwrap()), 41);
+        assert!(decode_trailer(&pose_file(9, 0)).unwrap().3.is_none(), "no camera record");
+        let mut other = pose_file(9, 41);
+        other[8..12].copy_from_slice(&10u32.to_le_bytes());
+        assert!(decode_trailer(&other).is_none(), "trailer of another frame");
+        let old = &pose_file(9, 41)[..24];
+        assert!(decode_trailer(old).is_none(), "a pose file without a trailer");
+    }
+}
