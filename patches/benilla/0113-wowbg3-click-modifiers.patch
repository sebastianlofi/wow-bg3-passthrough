+/// Patch 0113: presses and lets go of the modifier keys on benilla's keyboard so that `to` is held
+/// (from `from`), as winit's own key messages: `IsShiftKeyDown` and the rest read that keyboard.
+fn set_mods(
+    keys: &mut MessageWriter<bevy::input::keyboard::KeyboardInput>,
+    window: Entity,
+    from: u32,
+    to: u32,
+) {
+    use bevy::input::keyboard::{Key, KeyboardInput};
+    use bevy::input::ButtonState;
+    for (bit, key_code, logical_key) in [
+        (MOD_SHIFT, KeyCode::ShiftLeft, Key::Shift),
+        (MOD_CTRL, KeyCode::ControlLeft, Key::Control),
+        (MOD_ALT, KeyCode::AltLeft, Key::Alt),
+    ] {
+        let state = match (from & bit != 0, to & bit != 0) {
+            (false, true) => ButtonState::Pressed,
+            (true, false) => ButtonState::Released,
+            _ => continue,
+        };
+        keys.write(KeyboardInput { key_code, logical_key, state, text: None, repeat: false, window });
+    }
 }
 
