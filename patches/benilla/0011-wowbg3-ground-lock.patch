+/// WoW's ground under Tav (Bevy y, yards): the walking collision's floor within the lock's reach,
+/// else the terrain.
+fn ground_under(
+    collide: &benilla_world::collision::WorldCollision,
+    world: &benilla_world::world_point::WorldPoint,
+    tav: Vec3,
+) -> Option<f32> {
+    let origin = tav + Vec3::Y * LOCK_REACH;
+    collide
+        .ray_body(origin, Dir3::NEG_Y, 2.0 * LOCK_REACH)
+        .map(|h| origin.y - h.distance)
+        .or_else(|| world.terrain_height_under(tav))
+}
+
+/// Ground lock target (see the module notes, patch 0011); `follow_bg3` eases toward it.
+fn keep_ground_lock(
+    mut t: ResMut<TavFollow>,
+    collide: benilla_world::collision::WorldCollision,
+    world: benilla_world::world_point::WorldPoint,
+    mut runs: Local<u64>,
+) {
+    let Some(tav) = t.tav else { return };
+    t.want = match ground_under(&collide, &world, tav) {
+        Some(g) if (tav.y - g).abs() < LOCK_REACH => tav.y - g,
+        _ => 0.0,
+    };
+    *runs += 1;
+    if *runs % 600 == 1 {
+        info!(
+            "wowbg3 ground: lock {:.2} yd, benilla's clearance moved the eye in {} frames so far, kept the plugin's in {} under 0.6 yd",
+            t.lock,
+            CLEARANCE_FIRED.load(Ordering::Relaxed),
+            PLUGIN_KEPT.load(Ordering::Relaxed)
+        );
+    }
+}
