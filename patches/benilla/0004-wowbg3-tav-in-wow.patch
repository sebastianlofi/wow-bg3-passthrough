+/// A baked texture as a mipmapped, anisotropically filtered image (sharp up close, calm at a
+/// distance). Mips are 2x2 box averages of the sRGB bytes.
+fn tav_image(w: u32, h: u32, px: &[u8]) -> Image {
+    use bevy::image::{ImageAddressMode, ImageFilterMode, ImageSampler, ImageSamplerDescriptor};
+    let mut data = px.to_vec();
+    let (mut cw, mut ch, mut levels) = (w as usize, h as usize, 1u32);
+    let mut prev = px.to_vec();
+    while cw > 1 || ch > 1 {
+        let (nw, nh) = ((cw / 2).max(1), (ch / 2).max(1));
+        let mut next = vec![0u8; nw * nh * 4];
+        for y in 0..nh {
+            for x in 0..nw {
+                for c in 0..4 {
+                    let at = |xx: usize, yy: usize| prev[((yy.min(ch - 1)) * cw + xx.min(cw - 1)) * 4 + c] as u32;
+                    let s = at(2 * x, 2 * y) + at(2 * x + 1, 2 * y) + at(2 * x, 2 * y + 1) + at(2 * x + 1, 2 * y + 1);
+                    next[(y * nw + x) * 4 + c] = ((s + 2) / 4) as u8;
+                }
+            }
+        }
+        data.extend_from_slice(&next);
+        prev = next;
+        cw = nw;
+        ch = nh;
+        levels += 1;
+    }
+    let mut image = Image::new(
+        bevy::render::render_resource::Extent3d { width: w, height: h, depth_or_array_layers: 1 },
+        bevy::render::render_resource::TextureDimension::D2,
+        px.to_vec(),
+        bevy::render::render_resource::TextureFormat::Rgba8UnormSrgb,
+        RenderAssetUsages::RENDER_WORLD,
+    );
+    image.data = Some(data);
+    image.texture_descriptor.mip_level_count = levels;
+    image.sampler = ImageSampler::Descriptor(ImageSamplerDescriptor {
+        address_mode_u: ImageAddressMode::Repeat,
+        address_mode_v: ImageAddressMode::Repeat,
+        mag_filter: ImageFilterMode::Linear,
+        min_filter: ImageFilterMode::Linear,
+        mipmap_filter: ImageFilterMode::Linear,
+        anisotropy_clamp: 8,
+        ..default()
+    });
+    image
+}
+
+/// Decodes a `.tvt` texture (`TVT1`, width, height, flags; RGBA8 sRGB rows).
+pub(crate) fn decode_tvt(b: &[u8]) -> Option<(u32, u32, u32, &[u8])> {
+    if b.get(0..4)? != b"TVT1" {
+        return None;
+    }
+    let (w, h, flags) = (u32_at(b, 4)?, u32_at(b, 8)?, u32_at(b, 12)?);
+    let n = (w as usize).checked_mul(h as usize)?.checked_mul(4)?;
+    (w > 0 && h > 0 && w <= 8192 && h <= 8192).then_some(())?;
+    Some((w, h, flags, b.get(16..16 + n)?))
+}
+
+/// Puts the baked textures (link/tools/tavtex.py, `tavtex.txt`) on her meshes: alpha-tested
+/// where the material cuts out (hair, fur, lace), hidden where WoW cannot draw it (tear lines,
+/// lash shadows).
+fn load_textures(
+    mut commands: Commands,
+    mut d: ResMut<TavDraw>,
+    mut images: ResMut<Assets<Image>>,
+    mut materials: ResMut<Assets<WowModelMaterial>>,
+    light: Option<Res<benilla_world::lighting::SharedLightBuffer>>,
+) {
+    if d.frame % 30 != 15 || d.root.is_none() {
+        return;
+    }
+    let Some(light) = light else { return };
+    let path = d.dir.join("tavtex.txt");
+    let Ok(mtime) = std::fs::metadata(&path).and_then(|m| m.modified()) else { return };
+    let Some(seq) = d.file.as_ref().map(|f| f.seq) else { return };
+    if d.tex_stamp == Some((mtime, seq)) {
+        return;
+    }
+    let Ok(text) = std::fs::read_to_string(&path) else { return };
+    let mut lines = text.lines();
+    let head: Vec<&str> = lines.next().unwrap_or("").split_whitespace().collect();
+    if head.len() < 3 || head[0] != "TAVTEX" || head[2].parse::<u32>().ok() != Some(seq) {
+        return; // the baker has not caught up with this plan yet
+    }
+    d.tex_stamp = Some((mtime, seq));
+    let mut applied = 0;
+    for line in lines {
+        let f: Vec<&str> = line.split_whitespace().collect();
+        if f.len() < 3 {
+            continue;
+        }
+        let (Ok(key), Ok(flags)) = (u64::from_str_radix(f[0], 16), f[2].parse::<u32>()) else { continue };
+        let Some(part) = d.parts.iter().find(|p| p.key == key).map(|p| p.entity) else { continue };
+        if flags & 2 != 0 {
+            commands.entity(part).insert(Visibility::Hidden);
+            continue;
+        }
+        let file = f[1].to_string();
+        if !d.textures.contains_key(&file) {
+            let Ok(raw) = std::fs::read(d.dir.join(&file)) else { continue };
+            let Some((w, h, fl, px)) = decode_tvt(&raw) else { continue };
+            let image = tav_image(w, h, px);
+            let handle = images.add(image);
+            d.textures.insert(file.clone(), (handle, fl));
+        }
+        let (handle, _) = d.textures[&file].clone();
+        let TavDraw { cache, .. } = &mut *d;
+        let material = model_material(
+            cache,
+            &mut materials,
+            Some(handle),
+            if flags & 1 != 0 { ModelBlend::AlphaTest } else { ModelBlend::Opaque },
+            true,
+            false,
+            false,
+            false,
+            false,
+            false,
+            false,
+            false,
+            FogPolicy::Scene,
+            false,
+            ShadeSel::Lit,
+            0,
+            None,
+            None,
+            None,
+            None,
+            false,
+            false,
+            &light.0,
+            None,
+        );
+        commands.entity(part).insert((MeshMaterial3d(material), Visibility::Inherited));
+        applied += 1;
+    }
+    info!("wowbg3 tav: textures for plan {seq} on {applied} meshes");
+}
+
+fn apply_pose(
+    mut d: ResMut<TavDraw>,
+    mut meshes: ResMut<Assets<Mesh>>,
+    mut roots: Query<(&mut Transform, &mut Visibility)>,
+) {
+    let Some(root) = d.root else { return };
+    let raw = std::fs::read(d.dir.join("tavpose.bin")).ok();
+    let pose = raw.as_deref().and_then(decode_pose);
+    let now = SystemTime::now().duration_since(UNIX_EPOCH).map_or(0.0, |t| t.as_secs_f64());
+    let seq_ok = |p: &PoseFile| d.file.as_ref().is_some_and(|f| f.seq == p.seq) && !p.recs.is_empty();
+    let fresh = pose.as_ref().is_some_and(|p| seq_ok(p) && (now - p.time).abs() < STALE_SECS);
+    let Ok((mut tf, mut vis)) = roots.get_mut(root) else { return };
+    if !fresh {
+        if *vis != Visibility::Hidden && d.last_pose_at.is_none_or(|t| t.elapsed().as_secs_f32() > 0.5) {
+            *vis = Visibility::Hidden;
+        }
+        return;
+    }
+    let pose = pose.unwrap();
+    if pose.frame == d.last_pose {
+        return;
+    }
+    d.last_pose = pose.frame;
+    d.last_pose_at = Some(Instant::now());
+    let TavDraw { file, parts, scratch, logged, .. } = &mut *d;
+    let Some(file) = file.as_ref() else { return };
+    // Her root: the first mesh's object origin, mapped; the ground lock lowers her with the camera.
+    let Some(anchor) = pose.recs.iter().find(|r| r.flags & 1 != 0) else { return };
+    let origin = wow_to_bevy(bg3_to_wow(Vec3::new(anchor.world[4], anchor.world[5], anchor.world[6]), file.centre, file.wow))
+        - Vec3::Y * crate::wowbg3_lead::ground_lock();
+    tf.translation = origin;
+    tf.rotation = Quat::IDENTITY;
+    if *vis != Visibility::Inherited {
+        *vis = Visibility::Inherited;
+    }
+    let (pos, nrm) = scratch;
+    for (m, part) in file.meshes.iter().zip(parts.iter()) {
+        debug_assert_eq!(m.key, part.key);
+        let want = m.skin_from.unwrap_or(m.key);
+        let Some(rec) = pose.recs.iter().find(|r| r.key == want && r.flags & 1 != 0) else { continue };
+        if !m.weights.is_empty() && rec.palette.is_empty() {
+            continue;
+        }
+        pose_mesh(m, rec, pos, nrm);
+        let lift = Vec3::Y * crate::wowbg3_lead::ground_lock();
+        let p: Vec<[f32; 3]> = pos
+            .iter()
+            .map(|v| (wow_to_bevy(bg3_to_wow(*v, file.centre, file.wow)) - lift - origin).to_array())
+            .collect();
+        let n: Vec<[f32; 3]> = nrm.iter().map(|v| bg3_dir_to_bevy(*v).normalize_or_zero().to_array()).collect();
+        if let Some(mesh) = meshes.get_mut(&part.mesh) {
+            mesh.insert_attribute(Mesh::ATTRIBUTE_POSITION, p);
+            mesh.insert_attribute(Mesh::ATTRIBUTE_NORMAL, n);
+        }
+    }
+    *logged += 1;
+    if *logged % 600 == 1 {
+        info!("wowbg3 tav: pose {} at {origin:?}", pose.frame);
+    }
+}
