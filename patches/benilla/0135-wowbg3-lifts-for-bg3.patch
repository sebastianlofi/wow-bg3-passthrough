+//! WOW-BG3 (local fork, patch 0135): WoW's lifts for BG3's side of a ride.
+//!
+//! A lift (an elevator, a tram car: game object type 11) moves on the client's own clock along
+//! `TransportAnimation.dbc` (`transport`). BG3 carries its characters on a platform of its own that
+//! must make the same moves, so every frame in world mode `link/wowlifts.bin` says where each lift
+//! on the map is and where the keyframe span it is on ends, with the time left to that end: one
+//! straight move at one speed, which BG3's own platform move repeats (`Lifts.lua`).
+//!
+//! `wowlifts.bin`: `WBL1`, seq u32, count u32, count x (guid u64, entry u32, flags u32 (1 moving),
+//! period ms u32, cycle ms u32, WoW x y z now f32, WoW x y z of the span's end f32, ms to it
+//! u32), seq again. Written whole (a temporary file renamed over it).
+
+use std::path::PathBuf;
+
+use bevy::prelude::*;
+
+use crate::net::Guid;
+use crate::transport::{LiftNow, Transport, TransportAnchor};
+
+#[derive(Resource)]
+struct LiftsOut {
+    path: PathBuf,
+    seq: u32,
+    frames: u64,
+}
+
+pub(crate) fn build(app: &mut App, dir: PathBuf) {
+    app.insert_resource(LiftsOut { path: dir.join("wowlifts.bin"), seq: 0, frames: 0 })
+        .add_systems(Update, write_lifts.after(benilla_world::schedule::WorldStage::Input));
+    info!("wowbg3 lifts: WoW's lifts go to wowlifts.bin every frame in world mode");
+}
+
+/// One lift's record.
+fn encode(guid: u64, l: &LiftNow, out: &mut Vec<u8>) {
+    out.extend_from_slice(&guid.to_le_bytes());
+    out.extend_from_slice(&l.entry.to_le_bytes());
+    out.extend_from_slice(&u32::from(l.moving).to_le_bytes());
+    out.extend_from_slice(&l.period_ms.to_le_bytes());
+    out.extend_from_slice(&l.cycle_ms.to_le_bytes());
+    for v in l.pos.iter().chain(l.to.iter()) {
+        out.extend_from_slice(&v.to_le_bytes());
+    }
+    out.extend_from_slice(&l.to_ms.to_le_bytes());
+}
+
+fn write_lifts(mut out: ResMut<LiftsOut>, lifts: Query<(&Guid, &Transport, &TransportAnchor)>) {
+    if !crate::wowbg3_lead::body::active() {
+        return;
+    }
+    let mut body = Vec::new();
+    let mut n = 0u32;
+    for (guid, transport, anchor) in &lifts {
+        if let Some(l) = transport.lift_now(anchor) {
+            encode(guid.0, &l, &mut body);
+            n += 1;
+        }
+    }
+    out.seq = out.seq.wrapping_add(1).max(1);
+    let mut bytes = Vec::with_capacity(16 + body.len());
+    bytes.extend_from_slice(b"WBL1");
+    bytes.extend_from_slice(&out.seq.to_le_bytes());
+    bytes.extend_from_slice(&n.to_le_bytes());
+    bytes.extend_from_slice(&body);
+    bytes.extend_from_slice(&out.seq.to_le_bytes());
+    let tmp = out.path.with_extension("tmp");
+    if std::fs::write(&tmp, &bytes).is_ok() {
+        let _ = std::fs::rename(&tmp, &out.path);
+    }
+    out.frames += 1;
+    if out.frames.is_multiple_of(3000) {
+        info!("wowbg3 lifts: {} frames of wowlifts.bin, {n} lifts now", out.frames);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_record_is_52_bytes_in_the_documented_order() {
+        let l = LiftNow {
+            entry: 20649,
+            period_ms: 16667,
+            cycle_ms: 5000,
+            pos: [1.0, 2.0, 3.0],
+            moving: true,
+            to: [1.0, 2.0, 40.0],
+            to_ms: 250,
+        };
+        let mut b = Vec::new();
+        encode(0xF120_0050_A900_0001, &l, &mut b);
+        assert_eq!(b.len(), 52);
+        assert_eq!(u64::from_le_bytes(b[0..8].try_into().unwrap()), 0xF120_0050_A900_0001);
+        assert_eq!(u32::from_le_bytes(b[8..12].try_into().unwrap()), 20649);
+        assert_eq!(u32::from_le_bytes(b[12..16].try_into().unwrap()), 1);
+        assert_eq!(f32::from_le_bytes(b[44..48].try_into().unwrap()), 40.0);
+        assert_eq!(u32::from_le_bytes(b[48..52].try_into().unwrap()), 250);
+    }
+}
