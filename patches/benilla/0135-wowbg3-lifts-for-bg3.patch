+    /// WOW-BG3 (patch 0135): a lift as BG3's side of a ride needs it this frame (`wowbg3_lifts`):
+    /// where the car is, and the end of the keyframe span it is on with the time left to it. A
+    /// span is one straight move at one speed (or a rest), so BG3's own platform can make the
+    /// same move. `None` for a boat or a zeppelin.
+    pub(crate) fn lift_now(&self, anchor: &TransportAnchor) -> Option<LiftNow> {
+        let Drive::Lift(l) = &self.drive else {
+            return None;
+        };
+        let cycle = self.cycle_ms(anchor);
+        let (pos, moving) = elevator_sample(&l.frames, l.base_pos, l.quat, cycle);
+        let hi = l.frames.partition_point(|f| f.time_ms <= cycle).min(l.frames.len() - 1);
+        let end = l.frames[hi].time_ms;
+        let (to, _) = elevator_sample(&l.frames, l.base_pos, l.quat, end);
+        Some(LiftNow {
+            entry: l.entry,
+            period_ms: l.period_ms,
+            cycle_ms: cycle,
+            pos,
+            moving,
+            to,
+            to_ms: end.saturating_sub(cycle),
+        })
+    }
+
     /// The live sample for an anchor, the pose the tick writes this frame; for instruments.
     pub(crate) fn sample_at(&self, anchor: &TransportAnchor, here: u32) -> TransportSample {
         self.sample(self.cycle_ms(anchor), here)
     }
 }
 
