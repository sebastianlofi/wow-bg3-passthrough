+    // Once a second: frames with effects, and why the others had none (effects that blink).
+    match (&live, &l.frame) {
+        (Some(_), _) => l.gaps.0 += 1,
+        (None, Some(f)) if f.draws.is_empty() => l.gaps.1 += 1,
+        (None, Some(_)) => l.gaps.2 += 1,
+        (None, None) => l.gaps.3 += 1,
+    }
+    if l.gaps_since.elapsed().as_secs_f32() >= 1.0 {
+        if l.gaps.0 > 0 && l.gaps.1 + l.gaps.2 + l.gaps.3 > 0 {
+            info!(
+                "wowbg3 fx: last second: {} frames with effects, {} on an empty BG3 frame, {} on a stale one, {} with none picked (camera seq {cam})",
+                l.gaps.0, l.gaps.1, l.gaps.2, l.gaps.3
+            );
+        }
+        l.gaps = (0, 0, 0, 0);
+        l.gaps_since = std::time::Instant::now();
+    }
