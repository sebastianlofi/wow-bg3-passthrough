+//! WOW-BG3 (local fork, patch 0041): a WoW-side teleport moves BG3's character.
+//!
+//! In world mode the own body follows BG3's character every frame (`wowbg3_lead::body`), so a
+//! teleport the server makes (hearthstone, a graveyard, a GM `.tele`, a summon) was undone within a
+//! second: the follow put the body back on her. Now a server teleport of our own body while world
+//! mode runs (`MSG_MOVE_TELEPORT_ACK` on the same map, `SMSG_NEW_WORLD` to another) asks the world
+//! bridge to move world mode there, the same request `link/tools/tele.sh` makes:
+//! `wow-bg3/world-move.json` {RunId, Seq, Wow: [x, y, z], Map, What, Arrived: true}. `Arrived`
+//! says WoW's character already stands there (no server teleport of the bridge's own). The bridge
+//! stops world mode and starts it again with that point under the hero, so she stands where WoW
+//! put the body. Until she does (her packet root within [`ARRIVE`] yd of the destination) the body
+//! follow and the Click to Move fallback leave the body where the server put it; after [`GIVE_UP`]
+//! s without her the follow resumes (the old behaviour) and the log says so.
+//!
+//! Not asked: outside world mode (no fresh `tav.bin`), during a BG3 fight (the bridge refuses
+//! moves then; the follow puts the body back as before), while another move is in flight (a
+//! `world-move.json` for this run newer than `world-move-result.json`: the bridge's own cross-continent
+//! teleport for tele.sh), and for a destination within [`NEAR`] yd of her.
+
+use std::path::PathBuf;
+use std::sync::Mutex;
+use std::time::Instant;
+
+use benilla_assets::coords::wow_to_bevy;
+use bevy::prelude::*;
+
+/// Yards between the destination and BG3's character under which nothing is asked.
+const NEAR: f32 = 5.0;
+/// Yards between her packet root and the destination that count as arrived.
+const ARRIVE: f32 = 20.0;
+/// Seconds the body is held at the destination waiting for her.
+const GIVE_UP: f32 = 90.0;
+
+struct Hold {
+    at: Vec3,
+    since: Instant,
+}
+
+static HOLD: Mutex<Option<Hold>> = Mutex::new(None);
+
+/// True while a server teleport holds the body away from `aim` (Bevy world): she has not arrived
+/// at the destination yet. Clears the hold once she has, or after [`GIVE_UP`].
+pub(crate) fn held_away(aim: Vec3) -> bool {
+    let Ok(mut g) = HOLD.lock() else { return false };
+    let Some(h) = g.as_ref() else { return false };
+    let gap = Vec2::new(aim.x - h.at.x, aim.z - h.at.z).length();
+    if gap < ARRIVE {
+        info!("wowbg3 teleport: BG3's character is at the destination ({gap:.1} yd); the body follows her again");
+        *g = None;
+        return false;
+    }
+    if h.since.elapsed().as_secs_f32() > GIVE_UP {
+        warn!("wowbg3 teleport: BG3's character did not come to the destination in {GIVE_UP} s ({gap:.0} yd away); the body follows her again");
+        *g = None;
+        return false;
+    }
+    true
+}
+
+/// True while a hold is on (for the Click to Move fallback, which has no aim of its own).
+pub(crate) fn holding() -> bool {
+    HOLD.lock().ok().is_some_and(|g| g.is_some())
+}
+
+#[derive(Resource)]
+struct TeleLink {
+    /// The SE folder's `wow-bg3` (the link folder's parent).
+    io: PathBuf,
+    asked: u64,
+}
+
+pub(crate) fn build(app: &mut App, dir: PathBuf) {
+    if std::env::var_os("WOW_BG3_LEAD").is_none() {
+        return;
+    }
+    let Some(io) = dir.parent().map(PathBuf::from) else { return };
+    info!("wowbg3 teleport: a server teleport in world mode moves BG3's character ({:?})", io.join("world-move.json"));
+    app.insert_resource(TeleLink { io, asked: 0 }).add_systems(Update, on_teleport);
+}
+
+/// `"Key": "text"` or `"Key": 12` from a small flat JSON object.
+fn json_field<'a>(text: &'a str, key: &str) -> Option<&'a str> {
+    let at = text.find(&format!("\"{key}\""))? + key.len() + 2;
+    let rest = text[at..].trim_start().strip_prefix(':')?.trim_start();
+    if let Some(s) = rest.strip_prefix('"') {
+        return s.split('"').next();
+    }
+    let end = rest.find([',', '}', '\n']).unwrap_or(rest.len());
+    Some(rest[..end].trim())
+}
+
+/// (RunId of the BG3 run, Seq of the newest request and of the newest answer for it).
+fn move_state(io: &std::path::Path) -> Option<(String, u64, u64)> {
+    let client = std::fs::read_to_string(io.join("m3-client.json")).ok()?;
+    let run = json_field(&client, "RunId")?.to_string();
+    let seq_of = |name: &str| -> u64 {
+        std::fs::read_to_string(io.join(name)).ok().filter(|t| json_field(t, "RunId") == Some(run.as_str())).and_then(|t| json_field(&t, "Seq")?.parse().ok()).unwrap_or(0)
+    };
+    Some((run.clone(), seq_of("world-move.json"), seq_of("world-move-result.json")))
+}
+
+fn on_teleport(
+    mut link: ResMut<TeleLink>,
+    mut same: MessageReader<crate::net::TeleportMessage>,
+    mut cross: MessageReader<crate::net::WorldportMessage>,
+    map: Option<Res<benilla_world::world_map::CurrentMap>>,
+    follow: Option<Res<crate::wowbg3_lead::TavFollow>>,
+) {
+    let mut dest: Option<([f32; 3], u32, &str)> = None;
+    for t in same.read() {
+        if let Some(m) = map.as_deref() {
+            dest = Some((t.position, m.0, "same map"));
+        }
+    }
+    for w in cross.read() {
+        // A port onto a boat carries a deck-local position: not a place on the map.
+        if w.transport_entry.is_none() {
+            dest = Some((w.position, w.map_id, "another map"));
+        }
+    }
+    let Some((wow, map_id, kind)) = dest else { return };
+    let Some(tav) = crate::wowbg3_lead::tav_if_fresh(follow.as_deref()) else {
+        debug!("wowbg3 teleport: server teleport ({kind}) outside world mode, nothing to move");
+        return;
+    };
+    let at = wow_to_bevy(wow);
+    let gap = Vec2::new(at.x - tav.x, at.z - tav.z).length();
+    if gap < NEAR {
+        return;
+    }
+    if crate::wowbg3_lead::bg3_combat() {
+        warn!("wowbg3 teleport: server teleport ({kind}, {gap:.0} yd) during a BG3 fight: not moved, the body follows BG3's character back");
+        return;
+    }
+    let Some((run, req, done)) = move_state(&link.io) else {
+        warn!("wowbg3 teleport: no BG3 run id (m3-client.json); not moved");
+        return;
+    };
+    if req > done {
+        info!("wowbg3 teleport: server teleport ({kind}) while world move {req} is in flight; the bridge's own move");
+        return;
+    }
+    let seq = req.max(done) + 1;
+    let body = format!(
+        "{{\"RunId\": \"{run}\", \"Seq\": {seq}, \"Wow\": [{:.3}, {:.3}, {:.3}], \"Map\": {map_id}, \"What\": \"WoW server teleport\", \"Arrived\": true}}",
+        wow[0], wow[1], wow[2]
+    );
+    let path = link.io.join("world-move.json");
+    let tmp = path.with_extension("json.tmp");
+    match std::fs::write(&tmp, body.as_bytes()).and_then(|()| std::fs::rename(&tmp, &path)) {
+        Ok(()) => {
+            link.asked += 1;
+            info!(
+                "wowbg3 teleport: the server moved the body {gap:.0} yd ({kind}, map {map_id}, WoW {:.1} {:.1} {:.1}); asked world mode to move there (move {seq})",
+                wow[0], wow[1], wow[2]
+            );
+            if let Ok(mut g) = HOLD.lock() {
+                *g = Some(Hold { at, since: Instant::now() });
+            }
+        }
+        Err(e) => warn!("wowbg3 teleport: could not write {path:?}: {e}"),
+    }
+}
