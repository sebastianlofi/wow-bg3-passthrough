+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn pose(recs: &[(u32, u32, [f32; 4], [f32; 3])]) -> Vec<u8> {
+        let mut b = Vec::new();
+        b.extend_from_slice(b"TVP1");
+        b.extend_from_slice(&1u32.to_le_bytes());
+        b.extend_from_slice(&7u32.to_le_bytes());
+        b.extend_from_slice(&(recs.len() as u32).to_le_bytes());
+        b.extend_from_slice(&1.5f64.to_le_bytes());
+        for (bones, flags, q, t) in recs {
+            b.extend_from_slice(&9u64.to_le_bytes());
+            b.extend_from_slice(&bones.to_le_bytes());
+            b.extend_from_slice(&flags.to_le_bytes());
+            for v in q.iter().chain(t.iter()).chain([1.0f32, 1.0, 1.0].iter()) {
+                b.extend_from_slice(&v.to_le_bytes());
+            }
+            b.extend(std::iter::repeat_n(0u8, 48 * *bones as usize));
+        }
+        b
+    }
+
+    #[test]
+    fn finds_the_root_record() {
+        let b = pose(&[(3, 0, [0.0, 0.0, 0.0, 1.0], [9.0, 9.0, 9.0]), (2, 1, [0.0, 0.5, 0.0, 0.5], [1.0, 2.0, 3.0])]);
+        let (t, q) = pose_root(&b).unwrap();
+        assert_eq!(t, [1.0, 2.0, 3.0]);
+        assert_eq!(q, [0.0, 0.5, 0.0, 0.5]);
+        assert!(pose_root(b"TVP2xxxxxxxxxxxxxxxxxxxx").is_none());
+    }
+
+    #[test]
+    fn facing_follows_bg3s_minus_z() {
+        // Identity: BG3 -z is (0, -1), WoW (-dz, dx) = (1, 0): orientation 0.
+        assert!(bg3_yaw_to_wow([0.0, 0.0, 0.0, 1.0]).abs() < 1e-6);
+        // Yaw a about +y: -z = (-sin a, -cos a) in BG3, WoW (cos a, -sin a): orientation -a.
+        let a: f32 = 0.7;
+        let o = bg3_yaw_to_wow([0.0, (a / 2.0).sin(), 0.0, (a / 2.0).cos()]);
+        assert!((o + a).abs() < 1e-5, "{o}");
+    }
+
+    #[test]
+    fn steers_onto_her_this_frame() {
+        *SHARED.lock().unwrap() = Some(Shared::default());
+        SHARED.lock().unwrap().as_mut().unwrap().aim =
+            Some(Aim { at: Vec3::new(3.0, 0.0, -4.0), yaw: 0.3, packet: 1, steady: 1.0 });
+        let f = steer(Vec3::ZERO, 0.0, 0.01, true).unwrap();
+        assert!(f.moving);
+        assert_eq!(f.speed, MAX_SPEED);
+        // Bevy yaw y walks toward (-sin y, -cos y): (3, -4) / 5.
+        let dir = Quat::from_rotation_y(f.yaw) * Vec3::NEG_Z;
+        assert!((dir - Vec3::new(0.6, 0.0, -0.8)).length() < 1e-5, "{dir:?}");
+        // The mover stopped 1 yd short: placed on her.
+        let mut p = Vec3::new(2.4, 0.0, -3.2);
+        assert!(settle(&mut p));
+        assert_eq!(p, Vec3::new(3.0, 0.0, -4.0));
+        // On her after a walk: still walking (no speed) for a few frames, then standing, her facing.
+        for _ in 1..STILL_FRAMES {
+            let f = steer(Vec3::new(3.0, 0.0, -4.0), 0.0, 0.01, true).unwrap();
+            assert!(f.moving && f.speed == 0.0);
+        }
+        let f = steer(Vec3::new(3.0, 0.0, -4.0), 0.0, 0.01, true).unwrap();
+        assert!(!f.moving && (f.yaw - 0.3).abs() < 1e-6);
+        // Standing on her and pushed off by the mover (a WoW collision): put back, no walk.
+        let f = steer(Vec3::new(3.0, 0.0, -4.0), 0.3, 0.01, true).unwrap();
+        assert!(!f.moving);
+        let mut pushed = Vec3::new(4.5, 0.0, -4.0);
+        assert!(settle(&mut pushed));
+        assert_eq!(pushed, Vec3::new(3.0, 0.0, -4.0));
+        // A corpse stays.
+        let f = steer(Vec3::ZERO, 0.0, 0.01, false).unwrap();
+        assert!(!f.moving && f.yaw == 0.0);
+        // A jump of more than FAR waits for a steady aim.
+        SHARED.lock().unwrap().as_mut().unwrap().aim =
+            Some(Aim { at: Vec3::new(300.0, 0.0, 0.0), yaw: 0.3, packet: 2, steady: 0.1 });
+        let f = steer(Vec3::ZERO, 0.0, 0.01, true).unwrap();
+        assert!(!f.moving);
+        let mut z = Vec3::ZERO;
+        assert!(!settle(&mut z));
+        SHARED.lock().unwrap().as_mut().unwrap().aim =
+            Some(Aim { at: Vec3::new(300.0, 0.0, 0.0), yaw: 0.3, packet: 3, steady: 0.6 });
+        assert!(steer(Vec3::ZERO, 0.0, 0.01, true).unwrap().moving);
+        *SHARED.lock().unwrap() = None;
+    }
+}
