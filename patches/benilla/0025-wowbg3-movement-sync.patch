+//! WOW-BG3 (local fork, patch 0025): in world mode the own
+//! WoW body stands where WoW draws BG3's character, in the same frame.
+//!
+//! Before, `tav.bin` (`WorldMode.lua`, every third BG3 tick, read every fourth WoW frame) re-armed
+//! Click to Move once she was 1.5 yd from the body, which then ran after her at its own run speed:
+//! in the harness the body trailed her by 1.4 yd (0.36 s) whenever she walked, so the server's
+//! position and everything WoW draws from the own body (the wade ripples and wake in shallow
+//! water, the blob of foam when she steps in) came late.
+//!
+//! Now every frame drawn in lockstep (`wowbg3_pace`) takes her root from that frame's BG3 packet,
+//! the pose `wowbg3_tav` draws her with: the first object marked as her root (pose flags bit 0),
+//! mapped with the mapping of `tavmesh.bin` and lowered by the ground lock, as `TavFeet`. Only while
+//! world mode runs, which `tav.bin` says (`WorldMode.lua` writes it only then, with her position in
+//! WoW from the live mapping): a fresh `tav.bin` within [`MATCH`] yd of the packet's root. Without
+//! that gate a world-mode Stop (she goes home into BG3's level while the layer still sends poses)
+//! put the body 1608 yd away in the harness, where it fell to its death. A jump of more than
+//! [`FAR`] yd (a release as a ghost) waits until the aim has held for [`FAR_HOLD`] s. The
+//! controller (`player::controller`) then drives the body there through its own mover: forward,
+//! along her bearing, at the speed that lands it on her this frame ([`steer`]), facing her own
+//! facing while she stands. WoW's ground, water (wade ripples, the swim latch) and wire (start,
+//! heartbeat, stop, facing) see an ordinary walk. What the mover could not close (a WoW collision
+//! she does not have, a jump of more than [`SNAP`] yd such as a release as a ghost) is closed by
+//! placing the body on her ([`settle`]); vmangos takes the position (its movement anticheat is off
+//! on the test server). A corpse, a stun or a root, or the settle hold after a teleport, keeps the
+//! body where it is.
+//!
+//! Without packets (world mode off, an older layer, `WOW_BG3_PACE=off`) or with
+//! `WOW_BG3_BODY=ctm`, the old Click to Move follow (`wowbg3_lead`) runs instead. Logs `wowbg3
+//! body:` every 600 frames: frames followed, mean and largest gap left after the mover, snaps.
+
+use std::path::PathBuf;
+use std::sync::Mutex;
+
+use benilla_assets::coords::wow_to_bevy;
+use bevy::prelude::*;
+
+/// Yards the mover may leave between the body and her before the body is placed on her (a WoW
+/// collision she does not have: harness, 0.24 yd left standing and 0.8 yd walking).
+pub(crate) const SNAP: f32 = 0.1;
+/// Yards between the packet's root and `tav.bin`'s position that still read as the same world mode
+/// (`tav.bin` is up to three BG3 ticks and four WoW frames older).
+const MATCH: f32 = 4.0;
+/// Milliseconds a `tav.bin` record stays fresh.
+const TAV_FRESH_MS: u64 = 300;
+/// Yards of a jump that waits for a steady aim ([`FAR_HOLD`] seconds).
+const FAR: f32 = 50.0;
+const FAR_HOLD: f32 = 0.5;
+/// Yards under which the body stands (no start and stop flicker from rounding)...
+const STILL: f32 = 0.03;
+/// ...for this many frames in a row: a repeated packet (BG3 hitching) is no stop and start.
+const STILL_FRAMES: u32 = 4;
+/// Radians a standing body may differ from her facing before it turns.
+const TURN: f32 = 0.05;
+/// Seconds a packet's pose stays the follow's aim (BG3 hitching); older, Click to Move takes over.
+const STALE_SECS: f64 = 0.5;
+/// Yards per second the mover is never asked for (a frame of 2 ms over a whole snap).
+const MAX_SPEED: f32 = 400.0;
+
+/// Where she is in this frame's packet.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct Aim {
+    /// Bevy world, at her feet (the ground lock applied).
+    pub(crate) at: Vec3,
+    /// Bevy yaw (WoW orientation) of her facing.
+    pub(crate) yaw: f32,
+    /// The packet (BG3 present) it came from.
+    pub(crate) packet: u32,
+    /// Seconds the gate has passed without a break (see the module notes).
+    pub(crate) steady: f32,
+}
+
+/// What the controller does with the body this frame ([`steer`]).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct Follow {
+    /// Walk forward this frame.
+    pub(crate) moving: bool,
+    /// The facing to take (Bevy yaw).
+    pub(crate) yaw: f32,
+    /// Yards per second that land the body on her this frame.
+    pub(crate) speed: f32,
+}
+
+#[derive(Default)]
+struct Shared {
+    aim: Option<Aim>,
+    /// The aim [`steer`] steered to this frame (what [`settle`] checks).
+    steered: Option<Vec3>,
+    /// Frames in a row the body has been on her while walking (see [`STILL_FRAMES`]).
+    still: u32,
+    walking: bool,
+    /// This frame's steer was a stand (a placement then is a hold in place, not a missed walk).
+    standing: bool,
+    /// Standing frames whose body something pushed off her (put back).
+    pinned: u64,
+    followed: u64,
+    gap_sum: f64,
+    gap_max: f32,
+    snaps: u64,
+    /// Frames whose packet root did not match `tav.bin` (not world mode), for the log.
+    refused: u64,
+}
+
+static SHARED: Mutex<Option<Shared>> = Mutex::new(None);
+
+/// The body follow runs this frame (a fresh packet pose): Click to Move's follow stands aside.
+pub(crate) fn active() -> bool {
+    SHARED.lock().ok().is_some_and(|s| s.as_ref().is_some_and(|s| s.aim.is_some()))
+}
+
+/// The pose file's root record: (translate, rotation quaternion xyzw) in BG3's world, from the
+/// first object flagged as her root (`tavpose.bin`: "TVP1", seq, frame, n, time f64, then n x (key
+/// u64, bones u32, flags u32, world: quat xyzw, translate xyz, scale xyz f32, palette 48 x bones)).
+pub(crate) fn pose_root(b: &[u8]) -> Option<([f32; 3], [f32; 4])> {
+    if b.get(0..4)? != b"TVP1" {
+        return None;
+    }
+    let u = |o: usize| -> Option<u32> { Some(u32::from_le_bytes(b.get(o..o + 4)?.try_into().ok()?)) };
+    let f = |o: usize| -> Option<f32> { Some(f32::from_le_bytes(b.get(o..o + 4)?.try_into().ok()?)) };
+    let n = u(12)? as usize;
+    if n > 256 {
+        return None;
+    }
+    let mut at = 24;
+    for _ in 0..n {
+        let bones = u(at + 8)? as usize;
+        let flags = u(at + 12)?;
+        if bones > 512 {
+            return None;
+        }
+        if flags & 1 != 0 {
+            let q = [f(at + 16)?, f(at + 20)?, f(at + 24)?, f(at + 28)?];
+            let t = [f(at + 32)?, f(at + 36)?, f(at + 40)?];
+            return (q.iter().chain(t.iter()).all(|v| v.is_finite())).then_some((t, q));
+        }
+        at += 56 + 48 * bones;
+    }
+    None
+}
+
+/// A BG3 rotation's facing as a WoW orientation (= Bevy yaw): a character faces along its rotated
+/// -z (`LinkLive.lua`), and world mode's mapping turns a BG3 direction (dx, dz) into WoW's (-dz, dx).
+pub(crate) fn bg3_yaw_to_wow(q: [f32; 4]) -> f32 {
+    let [x, y, z, w] = q;
+    let (fx, fz) = (2.0 * (x * z + w * y), 1.0 - 2.0 * (x * x + y * y));
+    (-fx).atan2(fz)
+}
+
+/// The smallest signed difference a - b of two angles.
+fn angle_diff(a: f32, b: f32) -> f32 {
+    let mut d = (a - b) % std::f32::consts::TAU;
+    if d > std::f32::consts::PI {
+        d -= std::f32::consts::TAU;
+    } else if d < -std::f32::consts::PI {
+        d += std::f32::consts::TAU;
+    }
+    d
+}
+
+/// This frame's steering for a body at `pos` facing `face`, over a frame of `dt` s; None when the
+/// follow is off this frame (no fresh aim), so the controller runs as before. `may_move` false (a
+/// corpse, a root or stun, the settle hold) keeps the body still but still answers (no Click to Move).
+pub(crate) fn steer(pos: Vec3, face: f32, dt: f32, may_move: bool) -> Option<Follow> {
+    let mut g = SHARED.lock().ok()?;
+    let s = g.as_mut()?;
+    let aim = s.aim?;
+    let gap = Vec2::new(aim.at.x - pos.x, aim.at.z - pos.z);
+    let d = gap.length();
+    if d > FAR && aim.steady < FAR_HOLD {
+        // A long jump waits for a steady aim (the body holds meanwhile).
+        s.steered = None;
+        return Some(Follow { moving: false, yaw: face, speed: 0.0 });
+    }
+    if !may_move || d < STILL {
+        // Standing on her: still held there (a WoW collision she stands in pushes the capsule out
+        // while it stands; harness: 1 to 3 yd every other frame), with no walk.
+        s.steered = may_move.then_some(aim.at);
+        s.standing = true;
+        s.still = s.still.saturating_add(1);
+        if may_move && s.walking && s.still < STILL_FRAMES {
+            // Still walking (a repeated packet): forward at no speed, the facing kept.
+            return Some(Follow { moving: true, yaw: face, speed: 0.0 });
+        }
+        s.walking = false;
+        let yaw = if may_move && angle_diff(aim.yaw, face).abs() > TURN { aim.yaw } else { face };
+        return Some(Follow { moving: false, yaw, speed: 0.0 });
+    }
+    s.still = 0;
+    s.walking = true;
+    s.standing = false;
+    s.steered = Some(aim.at);
+    // Forward along her bearing: Bevy yaw y walks toward (-sin y, -cos y).
+    let yaw = (-gap.x).atan2(-gap.y);
+    Some(Follow { moving: true, yaw, speed: (d / dt.max(1e-3)).min(MAX_SPEED) })
+}
+
+/// After the mover: what it left between the body and her this frame. Beyond [`SNAP`] the body
+/// is placed on her (true). Only after a [`steer`] that moved.
+pub(crate) fn settle(pos: &mut Vec3) -> bool {
+    let Ok(mut g) = SHARED.lock() else { return false };
+    let Some(s) = g.as_mut() else { return false };
+    let Some(at) = s.steered.take() else { return false };
+    let gap = Vec2::new(at.x - pos.x, at.z - pos.z).length();
+    s.followed += 1;
+    s.gap_sum += f64::from(gap);
+    s.gap_max = s.gap_max.max(gap);
+    if gap > SNAP {
+        if s.standing {
+            s.pinned += 1;
+        } else {
+            s.snaps += 1;
+            if s.snaps <= 20 || s.snaps.is_multiple_of(100) {
+                info!("wowbg3 body: placed on BG3's character ({gap:.2} yd the mover did not close; {} so far)", s.snaps);
+            }
+        }
+        *pos = at;
+        return true;
+    }
+    false
+}
+
+#[derive(Resource)]
+struct BodyAim {
+    /// Since when the gate has passed without a break.
+    steady_since: Option<std::time::Instant>,
+    mesh: PathBuf,
+    /// `tavmesh.bin`'s mapping (BG3 centre, WoW origin), read once a second.
+    mapping: Option<([f32; 3], [f32; 3])>,
+    frame: u64,
+    last_packet: u32,
+}
+
+pub(crate) fn build(app: &mut App) {
+    if std::env::var_os("WOW_BG3_LEAD").is_none() {
+        return;
+    }
+    if std::env::var("WOW_BG3_BODY").is_ok_and(|v| v.trim() == "ctm") {
+        info!("wowbg3 body: WOW_BG3_BODY=ctm, the body follows BG3's character by Click to Move");
+        return;
+    }
+    let dir = std::env::var_os("WOW_BG3_TAV_DIR").map_or_else(|| PathBuf::from("/tmp/wowbg3/tav"), PathBuf::from);
+    if let Ok(mut g) = SHARED.lock() {
+        *g = Some(Shared::default());
+    }
+    info!("wowbg3 body: the own body follows BG3's character frame by frame (packet poses)");
+    app.insert_resource(BodyAim { steady_since: None, mesh: dir.join("tavmesh.bin"), mapping: None, frame: 0, last_packet: 0 })
+        .add_systems(Update, aim.before(crate::player::PlayerControlSet));
+}
+
+/// The header of `tavmesh.bin`: BG3 centre and WoW origin of world mode's mapping.
+fn read_mapping(path: &std::path::Path) -> Option<([f32; 3], [f32; 3])> {
+    use std::io::Read;
+    let mut b = [0u8; 40];
+    std::fs::File::open(path).ok()?.read_exact(&mut b).ok()?;
+    if &b[0..4] != b"TVM1" {
+        return None;
+    }
+    let f = |o: usize| f32::from_le_bytes(b[o..o + 4].try_into().unwrap());
+    let m = ([f(16), f(20), f(24)], [f(28), f(32), f(36)]);
+    m.0.iter().chain(m.1.iter()).all(|v| v.is_finite()).then_some(m)
+}
+
+/// Her root in this frame's packet, for [`steer`].
+fn aim(
+    mut a: ResMut<BodyAim>,
+    pace: Option<Res<crate::wowbg3_pace::Pace>>,
+    follow: Option<Res<super::TavFollow>>,
+) {
+    a.frame += 1;
+    if a.mapping.is_none() || a.frame % 60 == 1 {
+        if let Some(m) = read_mapping(&a.mesh) {
+            a.mapping = Some(m);
+        }
+    }
+    let now = crate::wowbg3_pace::mono_seconds();
+    let packet = pace.as_deref().and_then(|p| p.current.as_ref());
+    let fresh = packet.filter(|p| (now - p.present_time).abs() < STALE_SECS);
+    let aim = match (fresh, a.mapping) {
+        (Some(p), Some((centre, wow))) => pose_root(&p.pose).map(|(t, q)| Aim {
+            at: wow_to_bevy(crate::wowbg3_tav::bg3_to_wow(Vec3::from_array(t), centre, wow))
+                - Vec3::Y * crate::wowbg3_lead::ground_lock(),
+            yaw: bg3_yaw_to_wow(q),
+            packet: p.frame,
+            steady: 0.0,
+        }),
+        _ => None,
+    };
+    // The gate: world mode runs (a fresh `tav.bin`) and the packet's root is where it says she is.
+    let seen = super::TAV_SEEN_MS.load(std::sync::atomic::Ordering::Relaxed);
+    let tav = follow.as_deref().and_then(|t| t.tav).filter(|_| {
+        seen != 0 && super::clock_ms().saturating_sub(seen) < TAV_FRESH_MS
+    });
+    let matched = aim.filter(|x| tav.is_some_and(|t| Vec2::new(t.x - x.at.x, t.z - x.at.z).length() < MATCH));
+    let refused = aim.is_some() && matched.is_none();
+    if matched.is_some() {
+        a.steady_since.get_or_insert_with(std::time::Instant::now);
+    } else {
+        a.steady_since = None;
+    }
+    let steady = a.steady_since.map_or(0.0, |t| t.elapsed().as_secs_f32());
+    let aim = matched.map(|x| Aim { steady, ..x });
+    if let Some(x) = aim {
+        a.last_packet = x.packet;
+    }
+    if a.frame % 600 == 0 {
+        info!("wowbg3 body: aim {:?} (packet {}, mapping {})", aim.map(|x| x.at), a.last_packet, a.mapping.is_some());
+    }
+    if let Ok(mut g) = SHARED.lock() {
+        if let Some(s) = g.as_mut() {
+            s.aim = aim;
+            s.refused += u64::from(refused);
+            if a.frame % 600 == 0 && s.followed > 0 {
+                info!(
+                    "wowbg3 body: {} frames followed, gap after the mover mean {:.3} yd, max {:.3}; {} placed on her walking, {} standing; {} packet roots away from tav.bin (not followed)",
+                    s.followed,
+                    s.gap_sum / s.followed as f64,
+                    s.gap_max,
+                    s.snaps,
+                    s.pinned,
+                    s.refused
+                );
+                s.gap_max = 0.0;
+            }
+        }
+    }
+}
