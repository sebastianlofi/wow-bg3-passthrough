+/// Reads `wowmobs.bin` back: (seq, ms, mobs); None for a torn or foreign file (BG3's readers are
+/// `Mirrors.lua` and `MirrorsClient.lua`; this one checks the format).
+#[cfg(test)]
+pub(crate) fn decode_mobs_live(b: &[u8]) -> Option<(u32, f64, Vec<MobLive>)> {
+    if b.len() < 24 || &b[0..4] != b"WMB1" {
+        return None;
+    }
+    let u = |o: usize| u32::from_le_bytes(b[o..o + 4].try_into().unwrap());
+    let f = |o: usize| f32::from_le_bytes(b[o..o + 4].try_into().unwrap());
+    let (seq, n) = (u(4), u(8) as usize);
+    if n > 512 || b.len() != 24 + MOBS_LIVE_REC * n || u(20 + MOBS_LIVE_REC * n) != seq {
+        return None;
+    }
+    let t = f64::from_le_bytes(b[12..20].try_into().unwrap());
+    let mobs = (0..n)
+        .map(|i| {
+            let o = 20 + MOBS_LIVE_REC * i;
+            MobLive {
+                guid: (u64::from(u(o)) << 32) | u64::from(u(o + 4)),
+                pos: [f(o + 8), f(o + 12), f(o + 16)],
+                orient: f(o + 20),
+                vel: [f(o + 24), f(o + 28), f(o + 32)],
+                flags: u(o + 36),
+            }
+        })
+        .collect();
+    Some((seq, t, mobs))
+}
