+/// Patch 0025: `wowmobs.bin`, every frame in world mode (see the module notes): the mobs `mobs.txt`
+/// lists, where this frame draws them (after the splines and `fight_hold`).
+fn stream_mobs_live(
+    mut live: ResMut<MobsLive>,
+    f: Res<Fight>,
+    player: Res<Player>,
+    time: Res<Time>,
+    units: Query<(&Guid, &Transform), Without<SelfPlayer>>,
+) {
+    if !f.world || !player.active {
+        return;
+    }
+    let started = std::time::Instant::now();
+    let now = time.elapsed_secs_f64();
+    let held: HashSet<u64> = SHARED.lock().map(|s| s.held.clone()).unwrap_or_default();
+    let mut mobs = Vec::with_capacity(f.mirror_near.len());
+    for (g, tf) in &units {
+        if !f.mirror_near.contains(&g.0) {
+            continue;
+        }
+        let pos = bevy_to_wow(tf.translation);
+        let vel = match live.prev.get(&g.0) {
+            Some((p, t, _)) if now - t > 1e-4 && now - t < 0.5 => {
+                let dt = (now - t) as f32;
+                let step = [(pos[0] - p[0]) / dt, (pos[1] - p[1]) / dt, (pos[2] - p[2]) / dt];
+                let speed = (step[0] * step[0] + step[1] * step[1] + step[2] * step[2]).sqrt();
+                if speed > MOBS_LIVE_JUMP { [0.0; 3] } else { step }
+            }
+            // Same frame time (a repeated frame): keep the last velocity.
+            Some((_, t, v)) if now - t <= 1e-4 => *v,
+            _ => [0.0; 3],
+        };
+        live.prev.insert(g.0, (pos, now, vel));
+        let moving = vel[0] * vel[0] + vel[1] * vel[1] > 0.01;
+        mobs.push(MobLive {
+            guid: g.0,
+            pos,
+            orient: tf.rotation.to_euler(EulerRot::YXZ).0,
+            vel,
+            flags: (if held.contains(&g.0) { MOB_HELD } else { 0 }) | (if moving { MOB_MOVING } else { 0 }),
+        });
+    }
+    live.prev.retain(|_, (_, t, _)| now - *t < 2.0);
+    live.seq = live.seq.wrapping_add(1).max(1);
+    let bytes = encode_mobs_live(live.seq, crate::wowbg3_pace::mono_seconds() * 1000.0, &mobs);
+    let tmp = live.path.with_extension("tmp");
+    if std::fs::write(&tmp, &bytes).is_ok() {
+        let _ = std::fs::rename(&tmp, &live.path);
+    }
+    let us = started.elapsed().as_micros() as u64;
+    live.frames += 1;
+    live.write_us.0 += us;
+    live.write_us.1 = live.write_us.1.max(us);
+    if live.frames.is_multiple_of(3000) {
+        info!(
+            "wowbg3 mobs live: {} frames of wowmobs.bin, {} mobs now, {:.0} us a frame (max {})",
+            live.frames,
+            mobs.len(),
+            live.write_us.0 as f64 / 3000.0,
+            live.write_us.1
+        );
+        live.write_us = (0, 0);
+    }
+}
