+/// One mob in `wowmobs.bin` (patch 0025): where this frame draws it.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(crate) struct MobLive {
+    pub(crate) guid: u64,
+    /// WoW yards.
+    pub(crate) pos: [f32; 3],
+    /// WoW orientation (radians), the drawn model's.
+    pub(crate) orient: f32,
+    /// WoW yards per second, from the last frame.
+    pub(crate) vel: [f32; 3],
