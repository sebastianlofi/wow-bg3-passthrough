+
+/// `wowmobs.bin` (see the module notes).
+pub(crate) fn encode_mobs_live(seq: u32, t_ms: f64, mobs: &[MobLive]) -> Vec<u8> {
+    let mut b = Vec::with_capacity(24 + MOBS_LIVE_REC * mobs.len());
+    b.extend_from_slice(b"WMB1");
+    b.extend_from_slice(&seq.to_le_bytes());
+    b.extend_from_slice(&(mobs.len() as u32).to_le_bytes());
+    b.extend_from_slice(&t_ms.to_le_bytes());
+    for m in mobs {
+        b.extend_from_slice(&((m.guid >> 32) as u32).to_le_bytes());
+        b.extend_from_slice(&(m.guid as u32).to_le_bytes());
+        for v in m.pos.iter().chain([m.orient].iter()).chain(m.vel.iter()) {
+            b.extend_from_slice(&v.to_le_bytes());
+        }
+        b.extend_from_slice(&m.flags.to_le_bytes());
+    }
+    b.extend_from_slice(&seq.to_le_bytes());
+    b
+}
