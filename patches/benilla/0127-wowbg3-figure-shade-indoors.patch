+/// WOW-BG3 patch 0127: a shade root with no lit part of its own (BG3 draws the figure that stands there). The
+/// interior classifier asks only anchors with lit parts where they stand, so such a root was never told that it is
+/// indoors or on a WMO's floor, and its light chased the baked shadow of the terrain under the building: inside a
+/// crypt the figure's shade flipped between lit and shadowed every yard or two (a playtest report). The same
+/// question, asked the same way (a unit's down-ray attach), when the root has moved or a building streamed in.
+#[derive(Component, Default)]
+pub struct ShadeOnlyRoot {
+    asked: bool,
+    last: Vec3,
+    generation: u32,
+}
+
+fn classify_shade_only_roots(
+    residency: Res<crate::interior::WmoResidency>,
+    wmos: Res<Assets<benilla_assets::WmoModel>>,
+    instances: Query<(Entity, &crate::wmo_portal::WmoPortalInstance)>,
+    streamer: Option<Res<TerrainStreamer>>,
+    adt_tiles: Res<Assets<AdtTile>>,
+    mut roots: Query<(&GlobalTransform, &mut GroundShade, &mut ShadeOnlyRoot)>,
+) {
+    let Some(streamer) = streamer else {
+        return;
+    };
+    for (gt, mut shade, mut root) in &mut roots {
+        let pos = gt.translation();
+        if root.asked && root.generation == residency.generation() && pos.distance_squared(root.last) < 1e-4 {
+            continue;
+        }
+        let (verdict, _) = crate::wmo_portal::indoor_verdict_at(
+            &wmos,
+            instances.iter(),
+            &streamer,
+            &adt_tiles,
+            pos,
+            crate::wmo_portal::LightAttach::DownRay,
+        );
+        let on_wmo = matches!(verdict, crate::wmo_portal::IndoorVerdict::OutdoorsOnWmo);
+        let indoor = matches!(
+            verdict,
+            crate::wmo_portal::IndoorVerdict::DayNight | crate::wmo_portal::IndoorVerdict::Baked { .. }
+        );
+        if shade.on_wmo != on_wmo {
+            shade.on_wmo = on_wmo;
+        }
+        if shade.indoor != indoor {
+            shade.indoor = indoor;
+        }
+        root.asked = true;
+        root.last = pos;
+        root.generation = residency.generation();
+    }
+}
+
