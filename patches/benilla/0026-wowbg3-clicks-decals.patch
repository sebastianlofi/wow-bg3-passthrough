+/// Patch 0026: WoW's decal receivers (terrain and WMO faces in the frame's decal boxes, Bevy world)
+/// into the decal normal at BG3's extent: BG3's encoding of the face normal in BG3's camera axes
+/// (right, up, forward; Bevy's view looks down -z) where the receiver is the surface WoW drew there,
+/// nothing elsewhere (the target stays (0, 0): projected decals discard there).
+const WGSL_RECV: &str = r#"
+@group(2) @binding(0) var wow_depth: texture_depth_2d;
+
+struct RIn {
+    @location(0) pos: vec3<f32>,
+    @location(1) n: vec3<f32>,
+};
+struct ROut {
+    @builtin(position) pos: vec4<f32>,
+    @location(0) nv: vec3<f32>,
+    @location(1) pv: vec3<f32>,
+};
+
+@vertex
+fn vs_recv(v: RIn) -> ROut {
+    var o: ROut;
+    o.pos = P.clip_from_world * vec4<f32>(v.pos, 1.0);
+    o.nv = (P.view_from_world * vec4<f32>(v.n, 0.0)).xyz;
+    o.pv = (P.view_from_world * vec4<f32>(v.pos, 1.0)).xyz;
+    return o;
+}
+
+struct RFrag {
+    @location(0) normal: vec4<f32>,
+    @location(1) lin: f32,
+};
+
+@fragment
+fn fs_recv(in: ROut) -> RFrag {
+    let vsz = P.sizes.zw;
+    let q = vec2<i32>(clamp(floor(in.pos.xy * vsz / P.sizes.xy), vec2<f32>(0.0), vsz - 1.0));
+    let d = textureLoad(wow_depth, q, 0);
+    if (d <= 0.0) {
+        discard;
+    }
+    // WoW's drawn surface and this receiver, as view z (yards); reverse infinite: z = near / depth.
+    let zs = P.depth.x / d;
+    let zf = -in.pv.z;
+    if (abs(zf - zs) > P.recv.x + P.recv.y * zs) {
+        discard;
+    }
+    var n = normalize(in.nv);
+    if (dot(n, in.pv) > 0.0) {
+        n = -n;
+    }
+    let b = vec3<f32>(n.x, n.y, -n.z);
+    let k = max(1.0 - b.z, 1e-4);
+    var o: RFrag;
+    o.normal = vec4<f32>((b.x / k + 1.7777) / 3.5554, (b.y / k + 1.7777) / 3.5554, 0.0, 1.0);
+    // WoW's linear depth there, exactly as the prep pass writes it (special key 4).
+    let z = max((zs + P.depth.y) * P.depth.w + P.proj.z, 0.01);
+    o.lin = min(z / P.depth.z, 1.0);
+    return o;
+}
