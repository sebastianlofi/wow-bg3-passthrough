+// Patch 0026: WoW's decal receivers under BG3's projected decals
+
+/// This frame's decal receivers: terrain and WMO triangles inside the replayed projected decals'
+/// boxes, in Bevy's world (yards), 6 floats a vertex (position, face normal), and the box count.
+#[derive(Resource, Clone, Default, ExtractResource)]
+pub(crate) struct FxReceivers {
+    pub(crate) verts: Arc<Vec<f32>>,
+    pub(crate) boxes: u32,
+}
+
+/// The 8 corners of a projected decal's box in BG3's world (metres): its object block (set 1
+/// binding 0, row-major, applied as `[p, 1] * M`) maps the unit box [-0.5, 0.5]^3 (the decal
+/// shaders discard outside it) to an offset from BG3's eye `eye`.
+pub(crate) fn decal_box_corners(world: &[f32], eye: Vec3) -> Option<[Vec3; 8]> {
+    if world.len() < 16 || !world[..16].iter().all(|v| v.is_finite()) {
+        return None;
+    }
+    let row = |r: usize| Vec3::new(world[r * 4], world[r * 4 + 1], world[r * 4 + 2]);
+    let (x, y, z, t) = (row(0), row(1), row(2), row(3));
+    let mut out = [Vec3::ZERO; 8];
+    for (i, c) in out.iter_mut().enumerate() {
+        let s = |b: usize| if i >> b & 1 == 1 { 0.5 } else { -0.5 };
+        *c = eye + x * s(0) + y * s(1) + z * s(2) + t;
+    }
+    Some(out)
+}
+
+/// BG3 to Bevy, world mode's mapping (`bg3 = k + YD * (-x, y, z)`), less the ground lock (benilla
+/// lowers the world camera and Tav by it; `cam_pose` adds it back the other way).
+pub(crate) fn bevy_from_bg3(k: [f32; 3], lock: f32, p: Vec3) -> Vec3 {
+    Vec3::new((k[0] - p.x) / YD, (p.y - k[1]) / YD - lock, (p.z - k[2]) / YD)
+}
+
+/// Each frame: the receiver triangles inside every projected decal's box, by WoW's ground-decal
+/// projector (`WorldDecal`: terrain and WMO faces). A box is gathered once however many draws
+/// share it; one larger than [`RECV_MAX_BOX`] is not a ground decal and gets none.
+fn gather_receivers(
+    ext: Res<FxExtract>,
+    decals: benilla_world::decal::WorldDecal,
+    mut out: ResMut<FxReceivers>,
+    mut scratch: Local<Vec<benilla_world::particles::buffer::EffectVertex>>,
+) {
+    let Some(set) = ext.set.as_ref() else {
+        if out.boxes > 0 || !out.verts.is_empty() {
+            *out = FxReceivers::default();
+        }
+        return;
+    };
+    let Some(k) = crate::wowbg3_fx::bg3_map() else { return };
+    let lock = crate::wowbg3_lead::ground_lock();
+    let f = &set.frame;
+    let floats = |off: u32, n: usize| -> Option<Vec<f32>> {
+        let b = f.blob.get(off as usize..off as usize + n * 4)?;
+        Some(b.chunks_exact(4).map(|x| f32::from_le_bytes(x.try_into().unwrap())).collect())
+    };
+    let mut verts: Vec<f32> = Vec::new();
+    let mut seen = HashSet::new();
+    let mut boxes = 0u32;
+    for d in &f.draws {
+        if !projected_decal(d, &set.recipes) {
+            continue;
+        }
+        let buf = |s: u32, b: u32| {
+            d.sets.iter().find(|x| x.set == s).and_then(|x| x.slots.iter().find(|y| y.binding == b)).and_then(|y| match y.res {
+                SlotRes::Buffer { blob, size } => Some((blob, size)),
+                _ => None,
+            })
+        };
+        let (Some((b2, s2)), Some((b0, s0))) = (buf(0, 2), buf(1, 0)) else { continue };
+        if s2 < 224 || s0 < 128 || !seen.insert(b0) {
+            continue;
+        }
+        let (Some(vb), Some(m)) = (floats(b2, 56), floats(b0, 16)) else { continue };
+        let Some(corners) = decal_box_corners(&m, Vec3::new(vb[52], vb[53], vb[54])) else { continue };
+        let (lo, hi) = corners.iter().fold((Vec3::splat(f32::MAX), Vec3::splat(f32::MIN)), |(a, b), c| (a.min(*c), b.max(*c)));
+        if (hi - lo).max_element() > RECV_MAX_BOX {
+            continue;
+        }
+        boxes += 1;
+        let (a, b) = (bevy_from_bg3(k, lock, lo), bevy_from_bg3(k, lock, hi));
+        let (lo, hi) = (a.min(b), a.max(b));
+        let c = (lo + hi) * 0.5;
+        let frame = benilla_world::decal::DecalFrame {
+            center: c,
+            sin: 0.0,
+            cos: 1.0,
+            min_x: lo.x - c.x,
+            max_x: hi.x - c.x,
+            min_z: lo.z - c.z,
+            max_z: hi.z - c.z,
+            min_y: lo.y - c.y,
+            max_y: hi.y - c.y,
+        };
+        scratch.clear();
+        if !decals.project(&mut scratch, &frame, |_| 1.0, |_, _| [0.0, 0.0]) {
+            continue;
+        }
+        for t in scratch.chunks_exact(3) {
+            if verts.len() / 18 >= RECV_MAX_TRIS {
+                break;
+            }
+            let p = [Vec3::from(t[0].pos), Vec3::from(t[1].pos), Vec3::from(t[2].pos)];
+            let n = (p[1] - p[0]).cross(p[2] - p[0]).normalize_or_zero();
+            if n == Vec3::ZERO {
+                continue;
+            }
+            for q in p {
+                verts.extend_from_slice(&[q.x, q.y, q.z, n.x, n.y, n.z]);
+            }
+        }
+    }
+    *out = FxReceivers { verts: Arc::new(verts), boxes };
+}
+
+impl FxGpu {
+    /// Patch 0026: this frame's receivers into the vertex buffer (grown as needed).
+    fn upload_receivers(&mut self, dev: &wgpu::Device, queue: &wgpu::Queue, recv: Option<&FxReceivers>) {
+        let verts: &[f32] = recv.map_or(&[], |r| r.verts.as_slice());
+        self.recv_boxes = recv.map_or(0, |r| r.boxes);
+        let n = (verts.len() / 6) as u32;
+        let need = (verts.len() * 4) as u64;
+        if need == 0 {
+            self.recv_n = 0;
