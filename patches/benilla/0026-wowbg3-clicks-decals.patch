+/// Patch 0026: BG3's camera of this frame (set in `Update` by [`follow_bg3`]) once more, just before
+/// transforms propagate, over anything that wrote the world camera since.
+fn keep_bg3_pose(s: Res<LeadStream>, mut cam: Query<(&mut Transform, &mut Projection), With<WorldCamera>>) {
+    let (Some((at, rot, fov)), Ok((mut tf, mut proj))) = (s.held, cam.single_mut()) else {
+        return;
+    };
+    if tf.translation != at || tf.rotation != rot {
+        tf.translation = at;
+        tf.rotation = rot;
+    }
+    if let Projection::Perspective(p) = proj.as_mut() {
+        if p.fov != fov {
+            p.fov = fov;
+        }
+    }
+}
