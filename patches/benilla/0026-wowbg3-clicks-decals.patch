+/// Patch 0026: the lowest and highest index in `ix` (little-endian u16 or u32), the
+/// primitive restart value left out for a strip that restarts; `None` when there is none.
+pub(crate) fn index_span(ix: &[u8], wide: bool, restart: bool) -> Option<(u32, u32)> {
+    let mut span: Option<(u32, u32)> = None;
+    let mut take = |v: u32| span = Some(span.map_or((v, v), |(a, b)| (a.min(v), b.max(v))));
+    if wide {
+        for c in ix.chunks_exact(4) {
+            let v = u32::from_le_bytes([c[0], c[1], c[2], c[3]]);
+            if !(restart && v == u32::MAX) {
+                take(v);
+            }
+        }
+    } else {
+        for c in ix.chunks_exact(2) {
+            let v = u16::from_le_bytes([c[0], c[1]]) as u32;
+            if !(restart && v == 0xffff) {
+                take(v);
+            }
+        }
+    }
+    span
+}
