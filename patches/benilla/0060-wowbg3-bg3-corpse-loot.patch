 /// The pointer link (`wowbg3_lead.rs`) asks this for the unit under BG3's cursor: a mirrored mob
 /// is BG3's to click (its stand-in), not WoW's. Patch 0027: a mirrored friendly NPC (one WoW does
 /// not let you attack) stays WoW's; BG3 keeps such a click only for an attack (`WorldMode.lua`).
+/// WOW-BG3 (patch 0060): the corpse under BG3's cursor belongs to a mirrored mob, so BG3 loots it
+/// through its stand-in's corpse (BG3's loot window) and WoW never hears of the click.
+pub(crate) fn bg3_corpse(guid: Option<u64>) -> bool {
+    guid.is_some_and(|g| SHARED.lock().is_ok_and(|s| s.corpses.contains(&g)))
+}
