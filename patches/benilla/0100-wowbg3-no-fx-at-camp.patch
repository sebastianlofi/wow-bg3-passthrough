+++ b/crates/benilla-app/src/wowbg3_frames.rs
@@ -69,6 +69,11 @@
     INTERFACE_ONLY.load(Ordering::Relaxed)
 }
 
+/// Patch 0100: the party is at camp (`wowcamp.flag`).
+pub(crate) fn at_camp() -> bool {
+    INTERFACE_ONLY.load(Ordering::Relaxed)
+}
