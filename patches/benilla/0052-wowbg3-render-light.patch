+// Patch 0052: WoW's light in the units it is used in. WoW's own models multiply
+// their gamma-space texel by `lit` (gamma bytes in, gamma bytes out); her albedo is linear, so with
+// `WOW_BG3_TAV_OUT=gamma` (flag 16) and flag 32 the light is taken to linear first and her encoded
+// result is `srgb(albedo) × lit` for a plain diffuse surface, as a WoW model with that texel shows.
+// Before (flag 32 off), linear albedo × gamma `lit`, encoded, showed `srgb(albedo) × lit^(1/2.4)`:
+// brighter than WoW's world in its light, flatter between lit and shaded sides (seen in
+// playtesting). `WOW_BG3_TAV_LIGHT=linear` turns flag 32 off.
+fn tav_light(c: vec3<f32>) -> vec3<f32> {
+    if ((u32(max(m.tav_a.w, 0.0)) & 32u) != 0u) {
+        return tav_lin(clamp(c, vec3<f32>(0.0), vec3<f32>(1.0)));
+    }
+    return c;
+}
