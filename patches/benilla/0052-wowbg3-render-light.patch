+/// Patch 0052: the terrain pass's light on level ground in full sun (`terrain.wgsl`: `clamp(ambient +
+/// diffuse × max(N·L, 0))` per channel, gamma), as bytes, byte 3 = 1.
+fn ground_light(l: &benilla_world::lighting::WowLighting) -> [u8; 4] {
+    let up = benilla_assets::coords::wow_to_bevy([0.0, 0.0, 1.0]).normalize();
+    let ndotl = up.dot(-l.sun_dir.normalize_or_zero()).max(0.0);
+    let c = |i: usize| ((l.ambient[i] + l.diffuse[i] * ndotl).clamp(0.0, 1.0) * 255.0 + 0.5) as u8;
+    [c(0), c(1), c(2), 1]
+}
