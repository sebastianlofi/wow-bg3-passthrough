+/// `UNIT_FIELD_FLAGS` bit 25: not selectable (script triggers and the like; never mirrored).
+const NOT_SELECTABLE: u32 = 1 << 25;
+
+/// Patch 0027: `mobs.txt`'s REACTION for a creature: 1 hostile, 0 neutral (both attackable, as
+/// before), 2 a friendly NPC WoW does not let the player attack. None: a player, a player's pet,
+/// a dead or unselectable creature.
+fn reaction(
+    store: &ObjectStore,
+    me: &ObjectStore,
+    factions: Option<&Factions>,
+    reps: &Reputations,
+) -> Option<u8> {
+    let f = &store.0;
+    if f.object_type() == Some(ObjectType::Player)
+        || f.unit_health().unwrap_or(0) == 0
+        || f.unit_flags() & (PLAYER_CONTROLLED | NOT_SELECTABLE) != 0
+    {
+        return None;
+    }
+    Some(fightable(store, me, factions, reps).map_or(2, u8::from))
+}
