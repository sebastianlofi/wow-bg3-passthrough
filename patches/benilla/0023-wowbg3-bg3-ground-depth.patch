+/// Patch 0023: BG3's full-screen corner rays (set 0 binding 1, floats 28..39) for camera `c` and
+/// far plane `far`; `w` keeps each ray's fourth float.
+pub(crate) fn corner_rays(c: &CamPose, far: f32, w: [f32; 3]) -> [f32; 12] {
+    let mut o = [0f32; 12];
+    for (i, (x, y)) in [(-1.0f32, 1.0f32), (3.0, 1.0), (-1.0, -3.0)].into_iter().enumerate() {
+        let r = (c.fwd + c.right * (x / c.p00) + c.up * (y / c.p11)) * far;
+        o[i * 4..i * 4 + 3].copy_from_slice(&r.to_array());
+        o[i * 4 + 3] = w[i];
+    }
+    o
+}
