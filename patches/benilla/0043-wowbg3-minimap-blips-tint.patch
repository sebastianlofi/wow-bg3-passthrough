+/// Patch 0043: composites the interior tiles north up round `centre` and writes the image and
+/// `minimap.json` as [`export`] does; (file, bytes, tiles).
+#[allow(clippy::too_many_arguments)]
+fn export_indoor(
+    chain: &Arc<Mutex<benilla_formats::Chain>>,
+    tiles: &[IndoorTile],
+    local_from_world: bevy::math::Affine3A,
+    centre: [f32; 2],
+    z: f32,
+    dir: &Path,
+    file: &str,
+    (run, seq): (u64, u32),
+    map: u32,
+) -> Result<(String, usize, u32), String> {
+    use benilla_assets::coords::wow_to_bevy;
+    // Decode every tile once.
+    let mut decoded: Vec<Option<(u32, u32, Vec<u8>)>> = Vec::with_capacity(tiles.len());
+    for t in tiles {
+        let read = chain.lock_recover().read_file(&t.path);
+        decoded.push(read.ok().and_then(|b| benilla_formats::blp_to_rgba(&b).ok()).filter(|(w, h, _)| *w > 0 && *h > 0));
+    }
+    let n = (2.0 * INDOOR_HALF / 0.5) as u32;
+    let mut out = dds_header(n, n);
+    let head = out.len();
+    out.resize(head + (n * n * 4) as usize, 0);
+    let px = &mut out[head..];
+    let alpha_ref = (super::INTERIOR_TILE_ALPHA_REF * 255.0).round() as u8;
+    for r in 0..n {
+        // North at the top, west on the left, as the outdoor image.
+        let x = centre[0] + INDOOR_HALF - (r as f32 + 0.5) * 0.5;
+        for c in 0..n {
+            let y = centre[1] + INDOOR_HALF - (c as f32 + 0.5) * 0.5;
+            let m = bevy_to_wow(local_from_world.transform_point3(wow_to_bevy([x, y, z])));
+            // Later tiles draw over earlier ones (the reference's order); alpha-tested.
+            for (t, d) in tiles.iter().zip(&decoded).rev() {
+                let Some((tw, th, rgba)) = d else { continue };
+                let u = (m[0] - t.min[0]) / (t.max[0] - t.min[0]);
+                let v = (t.max[1] - m[1]) / (t.max[1] - t.min[1]);
+                if !(0.0..1.0).contains(&u) || !(0.0..1.0).contains(&v) {
+                    continue;
+                }
+                let (sx, sy) = ((u * *tw as f32) as u32, (v * *th as f32) as u32);
+                let s = ((sy.min(th - 1) * tw + sx.min(tw - 1)) * 4) as usize;
+                if rgba[s + 3] < alpha_ref {
+                    continue;
+                }
+                let d = ((r * n + c) * 4) as usize;
                 px[d] = rgba[s + 2];
                 px[d + 1] = rgba[s + 1];
                 px[d + 2] = rgba[s];
                 px[d + 3] = 255;
-            }
-        }
-        tiles += 1;
+                break;
+            }
+        }
     }
     let bytes = out.len();
     write_atomic(&dir.join("minimap").join(file), &out)?;
+    let (x0, x1, y0, y1) = (centre[0] - INDOOR_HALF, centre[0] + INDOOR_HALF, centre[1] - INDOOR_HALF, centre[1] + INDOOR_HALF);
+    let count = decoded.iter().filter(|d| d.is_some()).count() as u32;
     let json = format!(
-        "{{\"Run\":{run},\"Seq\":{seq},\"File\":\"{file}\",\"Map\":{map},\"X0\":{x0:.3},\"X1\":{x1:.3},\"Y0\":{y0:.3},\"Y1\":{y1:.3},\"Width\":{w},\"Height\":{h},\"Tiles\":{tiles}}}\n"
+        "{{\"Run\":{run},\"Seq\":{seq},\"File\":\"{file}\",\"Map\":{map},\"X0\":{x0:.3},\"X1\":{x1:.3},\"Y0\":{y0:.3},\"Y1\":{y1:.3},\"Width\":{n},\"Height\":{n},\"Tiles\":{count},\"Indoor\":true}}\n"
     );
     write_atomic(&dir.join("minimap.json"), json.as_bytes())?;
-    Ok((file.to_string(), bytes, tiles))
-}
