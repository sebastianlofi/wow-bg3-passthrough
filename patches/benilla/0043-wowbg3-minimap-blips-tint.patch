+        if !matches!(net.kind, EntityKind::Unit | EntityKind::Player) || !unit_dot_eligible(store, self_guid) {
+            continue;
+        }
+        let Some(w) = near(tf) else { continue };
+        if statuses.get(&guid.0).copied().and_then(quest_dot_cell).is_some() {
+            out.push((3, w, guid.0));
+            continue;
+        }
+        let (dyn_flags, creeping) = store.map(|s| (s.0.unit_dynamic_flags(), s.0.unit_is_stealthed())).unwrap_or((0, false));
+        if tracked_creature(tracking, store.map(|s| types.of(s)), dyn_flags, creeping) {
+            out.push((1, w, guid.0));
+        }
+    }
+    out
+}
