+/// Patch 0043: what the blip list reads (the blip layer's inputs without the HUD's hover, ping and
+/// Lua VM, which this never touches).
+pub(super) type BlipData<'w, 's> = (
+    Res<'w, crate::ui_quest::QuestGiver>,
+    Res<'w, crate::net::GuidIndex>,
+    Query<'w, 's, &'static GlobalTransform, With<crate::net::NetEntity>>,
+    Res<'w, crate::ui_party::GroupState>,
+    super::blips::TrackedCandidates<'w, 's>,
+    Query<'w, 's, (&'static crate::net::ObjectStore, &'static crate::net::Guid), With<crate::net::SelfPlayer>>,
+    Res<'w, crate::names::NameCache>,
+    Res<'w, crate::go_templates::GameObjectTemplates>,
+    Option<Res<'w, crate::go_templates::Locks>>,
+);
