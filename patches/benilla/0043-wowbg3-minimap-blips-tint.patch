+/// Patch 0043: the indoor image to show, if the own body is inside a building with interior
+/// minimap art: (key, tiles in draw order, local-from-world, centre WoW x y, WoW z).
+#[allow(clippy::type_complexity)]
+fn indoor_job(
+    player: &Player,
+    assets: &MinimapAssets,
+    instances: &Query<&benilla_world::wmo_portal::WmoPortalInstance>,
+    wmos: &Assets<benilla_assets::WmoModel>,
+    wp: &benilla_world::world_point::WorldPoint,
+    asset_server: &AssetServer,
+    map: u32,
+) -> Option<(Key, Vec<IndoorTile>, bevy::math::Affine3A, [f32; 2], f32)> {
+    use std::hash::{Hash, Hasher};
+    let (world_from_local, model, stem, in_group) = super::minimap_interior(player, instances, wmos, wp, asset_server)?;
+    let drawable = super::interior::interior_group_selection(model, &world_from_local, player.pos, INDOOR_RADIUS, in_group);
+    // The reference's draw order: by storey height from the player's, her own group last.
+    let player_z = bevy_to_wow(world_from_local.inverse().transform_point3(player.pos))[2];
+    let sort_key = |gi: usize| -> f32 {
+        if gi == in_group {
+            f32::MAX
+        } else {
+            let gn = &model.group_nav[gi];
+            0.5 * (gn.bbox_min[2] + gn.bbox_max[2]) - player_z
+        }
+    };
+    let mut order: Vec<usize> = (0..model.group_nav.len()).filter(|&gi| drawable[gi]).collect();
+    order.sort_by(|&a, &b| sort_key(a).total_cmp(&sort_key(b)));
+    let mut tiles = Vec::new();
+    for &gi in &order {
+        let gn = &model.group_nav[gi];
+        let (nx, tw_x) = benilla_assets::minimap_grid::group_axis_grid(gn.bbox_max[0] - gn.bbox_min[0]);
+        let (ny, tw_y) = benilla_assets::minimap_grid::group_axis_grid(gn.bbox_max[1] - gn.bbox_min[1]);
+        for col in 0..nx {
+            for row in 0..ny {
+                // As WoW's interior branch: the cell plus the outer-edge bleed, stretched by the
+                // half-texel inset (`super::texel_stretch`).
+                let bleed = |edge: bool| if edge { super::EDGE_BLEED_YD } else { 0.0 };
+                let x0 = gn.bbox_min[0] + col as f32 * tw_x - bleed(col == 0);
+                let x1 = gn.bbox_min[0] + (col + 1) as f32 * tw_x + bleed(col + 1 == nx);
+                let y0 = gn.bbox_min[1] + row as f32 * tw_y - bleed(row == 0);
+                let y1 = gn.bbox_min[1] + (row + 1) as f32 * tw_y + bleed(row + 1 == ny);
+                let key = format!("{stem}_{gi:03}_{col:02}_{row:02}.blp");
+                let Some(hash) = assets.translate.get(&key) else { continue };
+                let (cx, cy) = (0.5 * (x0 + x1), 0.5 * (y0 + y1));
+                let hx = 0.5 * (x1 - x0) * super::texel_stretch(tw_x);
+                let hy = 0.5 * (y1 - y0) * super::texel_stretch(tw_y);
+                tiles.push(IndoorTile { path: format!("textures\\Minimap\\{hash}"), min: [cx - hx, cy - hy], max: [cx + hx, cy + hy] });
+            }
+        }
+    }
+    if tiles.is_empty() {
+        return None;
+    }
+    let wow = bevy_to_wow(player.pos);
+    let snap = |v: f32| (v / INDOOR_STEP).round() as i32;
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    stem.hash(&mut h);
+    in_group.hash(&mut h);
+    drawable.hash(&mut h);
+    let (sx, sy) = (snap(wow[0]), snap(wow[1]));
+    let key = Key { map, tx: u32::MAX, ty: u32::MAX, tint: [255; 3], indoor: Some((h.finish(), sx, sy)) };
+    Some((key, tiles, world_from_local.inverse(), [sx as f32 * INDOOR_STEP, sy as f32 * INDOOR_STEP], wow[2]))
+}
