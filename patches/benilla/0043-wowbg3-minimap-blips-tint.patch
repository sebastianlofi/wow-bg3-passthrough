+/// Patch 0043 (see the module notes): WoW's minimap blips round the view point for BG3's minimap.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn export_blips(
+    mut ex: ResMut<BlipExport>,
+    st: Res<WowBg3Minimap>,
+    assets: Option<Res<MinimapAssets>>,
+    world: Option<Res<WorldAssets>>,
+    map: Option<Res<CurrentMap>>,
+    player: Res<Player>,
+    time: Res<Time<bevy::time::Real>>,
+    subject: Option<Res<crate::player::ViewSubject>>,
+    inputs: BlipData,
+    death_net: Res<crate::death::DeathNet>,
+) {
+    let Some(dir) = st.dir.clone() else { return };
+    let now = time.elapsed_secs_f64();
+    if now < ex.next || !player.active || player.pos == Vec3::ZERO {
+        return;
+    }
+    ex.next = now + BLIP_EVERY;
+    let (Some(assets), Some(map)) = (assets, map) else { return };
+    if !ex.icons_written {
+        if let Some(world) = world.as_deref() {
+            ex.icons_written = true;
+            let chain = world.chain.clone();
+            let out = dir.join("minimap").join("objecticons.dds");
+            let _ = std::thread::Builder::new().name("wowbg3-icons".into()).spawn(move || {
+                let read = chain.lock_recover().read_file("Interface\\Minimap\\ObjectIcons.blp");
+                match read.map_err(|e| format!("{e:#}")).and_then(|b| benilla_formats::blp_to_rgba(&b).map_err(|e| format!("{e:#}"))) {
+                    Ok((w, h, rgba)) => {
+                        let mut bytes = dds_header(w, h);
+                        for p in rgba.chunks_exact(4) {
+                            bytes.extend_from_slice(&[p[2], p[1], p[0], p[3]]);
+                        }
+                        match write_atomic(&out, &bytes) {
+                            Ok(()) => info!("wowbg3 minimap: blip icons written ({w}x{h}, {:?})", out),
+                            Err(e) => warn!("wowbg3 minimap: blip icons: {e}"),
+                        }
+                    }
+                    Err(e) => warn!("wowbg3 minimap: ObjectIcons.blp: {e}"),
+                }
+            });
+        }
+    }
+    let (quest, guids, unit_pos, group, tracked, self_store, names, go_templates, locks) = inputs;
+    let me = self_store.iter().next();
+    let tracking = me
+        .map(|(s, _)| super::blips::SelfTracking {
+            creatures: s.0.player_track_creatures(),
+            resources: s.0.player_track_resources(),
+            stealthed: s.0.player_track_stealthed(),
+        })
+        .unwrap_or_default();
+    let at = bevy_to_wow(subject.as_deref().map_or(player.pos, |s| s.point(player.pos)));
+    let mut dots = super::blips::list_dots(
+        at,
+        BLIP_RANGE,
+        tracking,
+        &tracked,
+        quest.statuses(),
+        me.map(|(_, g)| g.0),
+        &names,
+        &go_templates,
+        locks.as_deref().map(|l| &l.0),
+        assets.forms.as_ref(),
+    );
+    for m in group.party_slots() {
+        if let Some((x, y)) = super::blips::party_member_pos(m, &group, &guids, &unit_pos) {
+            if ((x - at[0]).powi(2) + (y - at[1]).powi(2)).sqrt() <= BLIP_RANGE {
+                dots.push((4, [x, y, at[2]], m.guid));
+            }
+        }
+    }
+    dots.sort_by_key(|d| (d.0, d.2));
+    let mut list = String::new();
+    for (i, (cell, w, _)) in dots.iter().enumerate() {
+        if i > 0 {
+            list.push(',');
+        }
+        list += &format!("[{cell},{:.1},{:.1},{:.1}]", w[0], w[1], w[2]);
+    }
+    let corpse = death_net
+        .corpse
+        .filter(|c| c.display_map == map.0 as i32)
+        .map_or("null".to_string(), |c| format!("[{:.1},{:.1},{:.1}]", c.position[0], c.position[1], c.position[2]));
+    let body = format!("\"Map\":{},\"Blips\":[{list}],\"Corpse\":{corpse}", map.0);
+    if body == ex.last {
+        return;
+    }
+    ex.last = body.clone();
+    ex.seq = ex.seq.wrapping_add(1);
+    let json = format!("{{\"Seq\":{},{body}}}\n", ex.seq);
+    if let Err(e) = write_atomic(&dir.join("minimap-blips.json"), json.as_bytes()) {
+        warn!("wowbg3 minimap: blips: {e}");
+    }
+}
