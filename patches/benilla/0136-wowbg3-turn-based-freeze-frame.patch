+/// Whether turn-based mode holds this unit on its frame: the animation driver leaves such a unit alone.
+pub(crate) fn turn_frozen(entity: Entity) -> bool {
+    TURN_FROZEN.lock().is_ok_and(|s| s.contains(&entity))
