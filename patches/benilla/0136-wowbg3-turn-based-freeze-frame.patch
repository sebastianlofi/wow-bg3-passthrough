+
+/// Patch 0136. BG3 stops every character its turn-based mode takes on the frame it is in (their time factor is
+/// 0) until the environment's turn. WoW's creatures the mode holds stood still under the server's hold and went
+/// on breathing, looking about and hammering: a playtest report asked for BG3's freeze frame. A unit the bridge
+/// lists as held (`mirrored.txt` `h`) and no fight has taken has its animations paused where they are, and the
+/// animation driver passes it over ([`turn_frozen`]), so nothing new starts on it: no gait change when the
+/// server's stop arrives, no fidget, and none of the sounds an animation plays. Let go (the environment's turn,
+/// the mode left, a fight took it), it goes on from that frame.
+fn turn_freeze(mut units: Query<(Entity, &Guid, &mut AnimationPlayer), Without<SelfPlayer>>) {
+    let held: HashSet<u64> =
+        SHARED.lock().map(|s| s.frozen.difference(&s.held).copied().collect()).unwrap_or_default();
+    let Ok(mut frozen) = TURN_FROZEN.lock() else {
+        return;
+    };
+    if held.is_empty() && frozen.is_empty() {
+        return;
+    }
+    let mut now = HashSet::new();
+    for (entity, guid, mut player) in &mut units {
+        if held.contains(&guid.0) {
+            // Each frame: whatever another system started on it since stands still too.
+            player.pause_all();
+            now.insert(entity);
+        } else if frozen.contains(&entity) {
+            player.resume_all();
+        }
+    }
+    if now.len() != frozen.len() {
+        info!("wowbg3 turn freeze: {} models on their frame (were {})", now.len(), frozen.len());
+    }
+    *frozen = now;
+}
