+    if (!safe_read(state, &vtable, sizeof(vtable)) || vtable == nullptr
+        || !safe_read(&vtable[kPrepareReadySlot], &fn, sizeof(fn)) || fn == nullptr
+        || !safe_read(fn, code, sizeof(code))
