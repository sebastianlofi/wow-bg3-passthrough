+// PrepareRunning -> Running (WOW-BG3 patch 0004).
+// ecl::GameStatePrepareRunning is not left through a queued state: the client
+// switches to Running itself once the state's vtable slot 6 answers yes (it
+// reads the state's done flag at +0x14, set by the per-frame slot 5 when the
+// level's start is synced, and one more engine flag). Holding the queued
+// StopLoading or PrepareRunning instead (patch 0003) keeps BG3's server in
+// Sync, so nothing of the level can run under the held loading screen. Here
+// slot 6 is hooked when the first PrepareRunning is queued: while a plugin's
+// state gate holds "PrepareRunning" -> "Running", a yes is answered "not yet".
+// Slot 5 still runs every frame, so the client keeps talking to the server,
+// which goes Running and runs the level while BG3's loading screen stays up.
+// The slot's code is checked first (its first instruction, cmp byte
+// [rdi+0x14], 0); anything else is left alone and logged.
+constexpr std::size_t kPrepareReadySlot = 6;
+constexpr unsigned char kPrepareReadyCode[] = {0x80, 0x7f, 0x14, 0x00};
+using ReadyProc = std::uint64_t (*)(void*, void*, void*, void*);
+std::atomic<ReadyProc> g_prepare_ready{nullptr};
+std::atomic<bool> g_prepare_tried{false};
+
+std::uint64_t prepare_running_ready_hook(void* state, void* a, void* b, void* c) {
+    const std::uint64_t ready = g_prepare_ready.load(std::memory_order_acquire)(state, a, b, c);
+    if ((ready & 0xff) == 0) return ready;
+    if (plugins_state_held("PrepareRunning", "Running")) {
+        if (!g_prepare_holding.exchange(true)) {
+            char const* server = server_game_state();
+            logf("gamestate: a plugin holds the client in PrepareRunning (server %s)",
+                 server != nullptr ? server : "?");
+        }
+        return ready & ~std::uint64_t{0xff};
+    }
+    if (g_prepare_holding.exchange(false)) {
+        logf("gamestate: the client's PrepareRunning is released");
+    }
+    return ready;
+}
