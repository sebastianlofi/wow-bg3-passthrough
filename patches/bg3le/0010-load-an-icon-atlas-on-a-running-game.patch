+// Ext.StaticData.LoadIconAtlas: BG3 reads its icon atlases once, at boot. This runs BG3's own load of one atlas
+// file on a running game, for an atlas whose files did not exist then (1 loaded or already there, 0 BG3 refused
+// the file, -1 no map or the function was not found).
+extern "C" int bg3le_load_icon_atlas(char const* path) {
+    auto* map = atlas_map();
+    const std::uintptr_t at = bg3le::target::TextureAtlasMapLoad();
+    if (map == nullptr || path == nullptr || at == 0) return -1;
+    const bg3se::STDString lsPath(path);
+    using Load = bool (*)(bg3se::TextureAtlasMap*, bg3se::STDString const*);
+    return reinterpret_cast<Load>(bg3le::load_bias() + at)(map, &lsPath) ? 1 : 0;
+}
