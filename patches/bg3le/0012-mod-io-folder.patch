 // ---- files ----------------------------------------------------------------
 
+// WOW-BG3 patch 0012: Ext.IO's NAME/ is DIR (an absolute folder), for a native plugin at init.
+extern "C" bool bg3le_io_root_add(char const* name, char const* dir) {
+    if (name == nullptr || name[0] == '\0' || std::strchr(name, '/') != nullptr || std::strstr(name, "..") != nullptr
+        || dir == nullptr || dir[0] != '/') {
+        return false;
+    }
+    {
+        std::lock_guard<std::mutex> held(g_io_roots_lock);
+        g_io_roots[name] = dir;
+    }
+    bg3le::logf("io: Ext.IO's %s/ is %s", name, dir);
+    return true;
+}
+
+// The registered folders, for the boot overrides (patch 0006): up to CAP of them into OUT; the count.
+extern "C" int bg3le_io_root_dirs(char const** out, int cap) {
+    std::lock_guard<std::mutex> held(g_io_roots_lock);
+    int n = 0;
+    for (auto const& r : g_io_roots) {
+        if (n >= cap) break;
+        out[n++] = r.second.c_str();
+    }
+    return n;
+}
