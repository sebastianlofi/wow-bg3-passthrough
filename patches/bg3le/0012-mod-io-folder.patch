+// WOW-BG3 patch 0012: a mod's own IO folder. A native plugin names a top-level folder of Ext.IO's user root and
+// where it really lives (bg3le_io_root_add, before any Lua runs); Ext.IO paths under that name read and write
+// there, so a mod keeps what it makes in its own folder. Every other path is upstream's.
+std::mutex g_io_roots_lock;
+std::map<std::string, std::string> g_io_roots;
+
+bool resolve_user(char const* relative, std::string* out) {
+    char const* slash = relative != nullptr ? std::strchr(relative, '/') : nullptr;
+    if (slash != nullptr && slash[1] != '\0') {
+        std::lock_guard<std::mutex> held(g_io_roots_lock);
+        auto it = g_io_roots.find(std::string(relative, static_cast<std::size_t>(slash - relative)));
+        if (it != g_io_roots.end()) return resolve_under(it->second, slash + 1, out);
+    }
+    return resolve_under(extender_root(), relative, out);
+}
