 }
 
+// Ext._Internal.InjectMouse(kind, button, down, x, y) -- src/sdl_forward.cpp,
+// WOW-BG3 harness only: pointer warp/motion (kind 0) or one button edge (kind 1).
+extern "C" void bg3le_sdl_inject_mouse(int kind, int button, bool down, int x, int y);
+int l_inject_mouse(lua_State* L) {
+    bg3le_sdl_inject_mouse((int)luaL_checkinteger(L, 1), (int)luaL_checkinteger(L, 2),
+                           lua_toboolean(L, 3) != 0, (int)luaL_checkinteger(L, 4),
+                           (int)luaL_checkinteger(L, 5));
+    return 0;
+}
