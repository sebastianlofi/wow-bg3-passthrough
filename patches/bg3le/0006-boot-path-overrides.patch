+
+// WOW-BG3: overrides for the files RPGStats::Load reads, which Lua cannot give: the client's mods load after it.
+// <Script Extender folder>/boot-path-overrides.txt, one "game path<TAB>absolute file" a line, the game path as
+// Ext.IO.AddPathOverride takes it. Under WOW-BG3's launcher (WOWBG3_SHM) its coordinator writes the file at every
+// start, moments after BG3 starts: wait a little for this start's. Without it, or when late, whatever is there.
+extern "C" void bg3le_path_overrides_boot() {
+    if (g_real == nullptr) return;
+    char const* xdg = std::getenv("XDG_DATA_HOME");
+    char const* home = std::getenv("HOME");
+    if ((xdg == nullptr || *xdg == 0) && home == nullptr) return;
+    const std::string file = ((xdg != nullptr && *xdg != 0) ? std::string(xdg) : std::string(home) + "/.local/share")
+                             + "/Larian Studios/Baldur's Gate 3/Script Extender/boot-path-overrides.txt";
+    if (std::getenv("WOWBG3_SHM") != nullptr) {
+        struct stat st{};
+        for (int i = 0; i < 150 && !(::stat(file.c_str(), &st) == 0 && st.st_mtime >= g_process_start); i++) {
+            ::usleep(100000);
+        }
+    }
+    std::ifstream in(file);
+    std::string line;
+    int count = 0;
+    while (std::getline(in, line)) {
+        const std::size_t tab = line.find('\t');
+        if (tab == std::string::npos) continue;
+        std::string from = absolute(line.substr(0, tab).c_str());
+        std::unique_lock<std::shared_mutex> held(g_lock);
+        g_overrides[std::move(from)] = line.substr(tab + 1);
+        g_any.store(true, std::memory_order_relaxed);
+        count++;
+    }
+    bg3le::logf("io: %d path override(s) from %s", count, file.c_str());
+}
