+bool ends_with(std::string const& s, char const* tail) {
+    const std::size_t n = std::strlen(tail);
+    return s.size() >= n && s.compare(s.size() - n, n, tail) == 0;
+}
+
+// The string items of the JSON array "key": [...] in text, or nothing.
+// Config.json is small and flat; the array holds plain file names.
+std::vector<std::string> json_string_array(std::string const& text, char const* key) {
+    std::vector<std::string> out;
+    const std::string quoted = std::string("\"") + key + "\"";
+    std::size_t at = text.find(quoted);
+    if (at == std::string::npos) return out;
+    at = text.find_first_not_of(" \t\r\n", at + quoted.size());
+    if (at == std::string::npos || text[at] != ':') return out;
+    at = text.find_first_not_of(" \t\r\n", at + 1);
+    if (at == std::string::npos || text[at] != '[') return out;
+    const std::size_t end = text.find(']', at);
+    if (end == std::string::npos) return out;
+    for (std::size_t i = at + 1; i < end;) {
+        const std::size_t open = text.find('"', i);
+        if (open == std::string::npos || open > end) break;
+        const std::size_t close = text.find('"', open + 1);
+        if (close == std::string::npos || close > end) break;
+        out.push_back(text.substr(open + 1, close - open - 1));
+        i = close + 1;
+    }
+    return out;
+}
+
+// Plugins mods ship beside their archives: for Mods/<Name>.pak with a folder
+// Mods/<Name>/, each plain .so file name the archive's
+// Mods/<Folder>/ScriptExtender/Config.json lists under "NativePlugins",
+// taken from Mods/<Name>/. Only names the archive itself declares load, so a
+// stray library dropped in the folder does not.
+std::vector<std::string> mod_plugin_files() {
+    std::vector<std::string> out;
+    char const* home = std::getenv("HOME");
+    if (home == nullptr) return out;
+    const std::string mods = std::string(home) + "/.local/share/Larian Studios/Baldur's Gate 3/Mods";
+    DIR* d = ::opendir(mods.c_str());
+    if (d == nullptr) return out;
+    std::vector<std::string> paks;
+    while (dirent* e = ::readdir(d)) {
+        std::string name = e->d_name;
+        if (name.size() > 4 && ends_with(name, ".pak")) paks.push_back(name);
+    }
+    ::closedir(d);
+    std::sort(paks.begin(), paks.end());
+    for (std::string const& pak : paks) {
+        const std::string folder = mods + "/" + pak.substr(0, pak.size() - 4);
+        struct stat st{};
+        if (::stat(folder.c_str(), &st) != 0 || !S_ISDIR(st.st_mode)) continue;
+        std::vector<std::string> names;
+        bg3le::pak_read(
+            (mods + "/" + pak).c_str(),
+            [](char const* name) {
+                const std::string n = name;
+                // Mods/<Folder>/ScriptExtender/Config.json, one folder deep.
+                return n.rfind("Mods/", 0) == 0 && ends_with(n, "/ScriptExtender/Config.json")
+                       && n.find('/', 5) == n.size() - std::strlen("/ScriptExtender/Config.json");
+            },
+            [&](char const*, char const* data, std::size_t size) {
+                for (std::string const& n : json_string_array(std::string(data, size), "NativePlugins")) {
+                    names.push_back(n);
+                }
+            });
+        for (std::string const& n : names) {
+            if (n.empty() || n.find('/') != std::string::npos || n[0] == '.' || !ends_with(n, ".so")) {
+                statusf("WARNING: %s lists native plugin \"%s\", which is not a plain .so file name; ignored",
+                        pak.c_str(), n.c_str());
+                continue;
+            }
+            const std::string file = folder + "/" + n;
+            if (::stat(file.c_str(), &st) != 0) {
+                statusf("WARNING: %s lists native plugin %s, which is not in %s", pak.c_str(), n.c_str(),
+                        folder.c_str());
+                continue;
+            }
+            logf("plugins: %s ships %s", pak.c_str(), file.c_str());
+            out.push_back(file);
+        }
+    }
+    return out;
+}
