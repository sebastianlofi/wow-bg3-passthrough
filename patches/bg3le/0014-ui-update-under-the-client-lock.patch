+// The client state's lock, held by src/noesis_ui.cpp around the game's
+// Noesis View::Update: the game runs that update on its job workers while the
+// client's Lua reads the same element tree (Ext.UI hands out bare pointers),
+// so Lua could read an element the update was freeing. Recursive, as the
+// UI's routed events take it again from inside the update.
+extern "C" void bg3le_client_lock_hold(bool held) {
+    if (held) {
+        g_client_lock.lock();
+    } else {
+        g_client_lock.unlock();
+    }
+}
