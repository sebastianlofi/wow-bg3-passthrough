+// The game runs View::Update on its job workers, and the client's Lua reads
+// the same element tree from the client's thread through Ext.UI's bare
+// pointers: measured 40 to 50 times a session, the two overlapped, and a walk
+// of the main menu read an element the update had just freed (signal 11 in
+// push_dependency). The update runs under the client state's lock, which the
+// client's Lua holds whenever it runs and which the UI's routed events already
+// take from inside the update; a long wait for it is logged.
+class UpdateHeld {
+public:
+    UpdateHeld() {
+        const auto from = std::chrono::steady_clock::now();
+        bg3le_client_lock_hold(true);
+        const auto waited = std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now() - from).count();
+        static std::atomic<int> logged{0};
+        if (waited >= 8000 && logged.fetch_add(1) < 20) {
+            logf("noesis: View::Update waited %.1f ms for the client's Lua", waited / 1000.0);
+        }
+    }
+    ~UpdateHeld() { bg3le_client_lock_hold(false); }
+    UpdateHeld(UpdateHeld const&) = delete;
+    UpdateHeld& operator=(UpdateHeld const&) = delete;
+};
+
 std::uint64_t update_hook(void* view, double time) {
     saw_view(view);
+    UpdateHeld held;
     return g_update(view, time);
 }
 
 std::uint64_t update_thunk_hook(void* iview, double time) {
     saw_view(static_cast<char*>(iview) - kIViewOffset);
+    UpdateHeld held;
     return g_update_thunk(iview, time);
 }
 
