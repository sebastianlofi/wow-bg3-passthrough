+
+// What the engine's own constructor leaves in a new SpellPrototype where a zeroed bg3se one differs (the
+// constructor is inlined in the stats load's spell loop, bg3+0x6487d0a on this build, just before Init).
+// Init builds the rest from the stat -- its MetaConditions (the conditions the AI tests a spell by) and the
+// recharge range among them -- and relies on these: a zeroed prototype came out of Init with no
+// MetaConditions and no recharge, and BG3's AI never cast the spell (slot A, a boot copy and its twin made in
+// play from the same stats entry compared byte by byte).
+bool engine_defaults(SpellPrototype* proto) {
+    auto* raw = reinterpret_cast<unsigned char*>(proto);
+    auto put32 = [raw](std::size_t at, std::uint32_t v) { std::memcpy(raw + at, &v, sizeof(v)); };
+    put32(0x000, 0xffffffffu);  // StatsObjectIndex
+    put32(0x008, 0xffffffffu);  // SpellId
+    put32(0x048, 0xffffffffu);  // SpellContainerId
+    const std::uint16_t dice = 1;  // DiceValue 1, Cooldown 0
+    std::memcpy(raw + 0x054, &dice, sizeof(dice));
+    // A one-slot array with its buffer allocated, as the constructor makes it.
+    void* buffer = bg3se::GameAllocRaw(0x10);
+    if (buffer == nullptr) return false;
+    std::memset(buffer, 0, 0x10);
+    std::memcpy(raw + 0x2b0, &buffer, sizeof(buffer));
+    put32(0x2b8, 1);
+    put32(0x2bc, 0);
+    put32(0x2c0, 0xffffffffu);
+    for (std::size_t at : {std::size_t(0x310), std::size_t(0x314), std::size_t(0x318)}) put32(at, 0xffffffffu);
+    const float steer = 1.0f;
+    std::memcpy(raw + 0x330, &steer, sizeof(steer));
+    return true;
 }
 
