+// What the engine's own constructor leaves in a new SpellPrototype where a zeroed bg3se one differs (the
+// constructor is inlined in the stats load's spell loop, bg3+0x6487d0a on this build, just before Init).
+// Init builds the rest from the stat -- its MetaConditions (the conditions the AI tests a spell by) and the
+// recharge range among them -- and relies on these: a zeroed prototype came out of Init with no
+// MetaConditions and no recharge, and BG3's AI never cast the spell (slot A, a boot copy and its twin made in
+// play from the same stats entry compared byte by byte).
+bool engine_defaults(SpellPrototype* proto) {
+    auto* raw = reinterpret_cast<unsigned char*>(proto);
+    auto put32 = [raw](std::size_t at, std::uint32_t v) { std::memcpy(raw + at, &v, sizeof(v)); };
+    put32(0x000, 0xffffffffu);  // StatsObjectIndex
+    put32(0x008, 0xffffffffu);  // SpellId
+    put32(0x048, 0xffffffffu);  // SpellContainerId
+    const std::uint16_t dice = 1;  // DiceValue 1, Cooldown 0
+    std::memcpy(raw + 0x054, &dice, sizeof(dice));
+    // A one-slot array with its buffer allocated, as the constructor makes it.
+    void* buffer = bg3se::GameAllocRaw(0x10);
+    if (buffer == nullptr) return false;
+    std::memset(buffer, 0, 0x10);
+    std::memcpy(raw + 0x2b0, &buffer, sizeof(buffer));
+    put32(0x2b8, 1);
+    put32(0x2bc, 0);
+    put32(0x2c0, 0xffffffffu);
+    for (std::size_t at : {std::size_t(0x310), std::size_t(0x314), std::size_t(0x318)}) put32(at, 0xffffffffu);
+    const float steer = 1.0f;
+    std::memcpy(raw + 0x330, &steer, sizeof(steer));
+    return true;
+}
+
+// The spell loader's MetaConditions builder: run(manager, count, prototypes, job) builds each prototype's
+// MetaConditions (the conditions BG3's SpellMetaCondition resources add to the spells their filters match)
+// and moves them into it (bg3+0x3835bd0 on this build, a generic routine; the load calls it from
+// bg3+0x3e4b7ee with every prototype and a job whose vtable is image+0x7923be8, whose call entry is
+// bg3+0x5ecbc00). A spell made after the load never went through it. The load's call is seen through a hook
+// on the routine's call sites, which keeps the manager and the job's data; add_spell then runs the same
+// routine on the new prototype alone.
+using MetaRunFn = void (*)(void*, int, void* const*, void*, void*, void*);
+MetaRunFn g_meta_run = nullptr;
+std::atomic<void*> g_meta_manager{nullptr};
+std::atomic<void*> g_meta_job_data{nullptr};
+constexpr std::uintptr_t kMetaRun = 0x3835bd0;
+constexpr std::uintptr_t kMetaJobVtable = 0x7923be8;
+constexpr std::uintptr_t kMetaJobCall = 0x5ecbc00;
+const unsigned char kMetaRunBytes[] = {0x55, 0x41, 0x57, 0x41, 0x56, 0x41, 0x55, 0x41, 0x54, 0x53,
+                                       0x48, 0x81, 0xec, 0x28, 0x01, 0x00, 0x00};
+
+bool is_meta_job(void const* job) {
+    const std::uintptr_t bias = load_bias();
+    std::uintptr_t vt = 0, call = 0;
+    return job != nullptr && safe_read(job, &vt, sizeof(vt)) && vt == bias + kMetaJobVtable
+        && safe_read((void const*)(vt + 5 * sizeof(void*)), &call, sizeof(call)) && call == bias + kMetaJobCall;
+}
+
+void meta_run_hook(void* manager, int count, void* const* items, void* job, void* a5, void* a6) {
+    if (g_meta_manager.load() == nullptr && is_meta_job(job)) {
+        void* data = nullptr;
+        if (safe_read((char const*)job + sizeof(void*), &data, sizeof(data)) && data != nullptr) {
+            g_meta_job_data.store(data);
+            g_meta_manager.store(manager);
+            logf("stat sync: the spell loader's MetaConditions builder seen (%d prototypes)", count);
+        }
+    }
+    g_meta_run(manager, count, items, job, a5, a6);
 }
 
+// The new spell's MetaConditions, built by the loader's own routine. False if the load's call was not seen.
+bool build_meta_conditions(SpellPrototype* proto) {
+    void* manager = g_meta_manager.load();
+    void* data = g_meta_job_data.load();
+    if (g_meta_run == nullptr || manager == nullptr || data == nullptr) return false;
+    struct { std::uintptr_t Vtable; void* Data; } job{load_bias() + kMetaJobVtable, data};
+    void* items[1] = {proto};
+    g_meta_run(manager, 1, items, &job, nullptr, nullptr);
+    return true;
+}
