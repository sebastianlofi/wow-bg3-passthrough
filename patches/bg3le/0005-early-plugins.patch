+
+// The early plugins (bg3le_plugin.h, vk_device): on the game's first vkCreatePipelineCache or
+// vkCreateSwapchainKHR, on that thread, before the game makes its Vulkan objects (WOW-BG3 patch
+// 0005: its render plugin must see the pipelines BG3 makes before its event loop starts).
+void plugins_load_early() {
+    if (g_early_done.load(std::memory_order_acquire)) return;
+    std::lock_guard<std::mutex> loading(g_load_mutex);
+    if (g_early_done.exchange(true, std::memory_order_acq_rel)) return;
+    std::vector<std::string> early;
+    plugin_files(&early);
+    for (std::string const& file : early) {
+        logf("plugins: %s starts early (device %p)", file.c_str(), g_vk_device.load());
+        load_one(file);
+    }
+}
+
+// On the game's first SDL_PollEvent: the engine and its allocator are up.
+void plugins_load() {
+    static bool done = false;
+    if (done) return;
+    done = true;
+    // However loading ends, frame handlers are then published and closed.
+    struct Publish {
+        ~Publish() { g_frames_ready.store(true, std::memory_order_release); }
